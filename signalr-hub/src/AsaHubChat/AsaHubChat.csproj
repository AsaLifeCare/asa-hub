<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- SignalR, authentication and the HTTP client factory ship in the ASP.NET Core shared framework: no NuGet packages. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AsaHubChat</RootNamespace>
    <AssemblyName>AsaHubChat</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsaHubChat.Tests" />
  </ItemGroup>

</Project>
