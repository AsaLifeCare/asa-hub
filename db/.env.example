# asa-hub-db environment: copy to db/.env (git-ignored) and fill the values there, never here.
# compose.yaml reads it; POSTGRES_DB/USER default to asa_hub, the two sync periods to 60 s and 1800 s.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# seconds between asa-hub-db-sync's passes (it stores the record books' staged checks)
HUB_DB_SYNC_EVERY_S=
# seconds between full passes
HUB_DB_FULL_EVERY_S=
