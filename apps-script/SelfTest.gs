        hiringMatrixTab_ = function (ctx, tab) {
          if (tab === 'Conditions') return [recRow(terminal)];
          if (tab === 'Facts') {
            return [{ 'Fact ID': 'hiring.interview.recommendation',
                      'Current Source': 'entity_in_person_interviews.recommendation', Type: 'string' }];
          }
          return [];
        };
        hubSetStatus_ = function (cid, st) { calls.push('status:' + st); return true; };
        hiringArchiveAndTell_ = function (cid, reason, user, stage) {
          calls.push('archive:' + stage + ':' + reason);
          return { marked: true, told: true };
        };
        hubBustTalentCache_ = function () {};
        var run = function (status, rec, archived, iv) {
          calls = [];
          snap = {
            cand: { candidateid: 'CAN_STDECLINE01', status: status, archived: archived ? 'true' : '' },
            __iv: iv || { recommendation: rec, interviewername: 'Probe Interviewer', score: '3' }
          };
          var n = hiringTerminalEndsRun_('board', snap);
          return n + '|' + calls.length;
        };
        var declined = run('In Person', 'Decline');
        var declinedCalls = calls.slice();
        stAssert_(out, 'decisions: a Decline at the interview ends the run — Not Hiring, the Archive and the letter, ' +
                       'through the scorecard\'s own doors',
                  declined === '1|2' && declinedCalls[0] === 'status:Not Hiring' &&
                  declinedCalls[1].indexOf('archive:interview:Interview declined by Probe Interviewer') === 0 &&
                  declinedCalls[1].indexOf(HIRING_BOARD_DECLINE_CONDITION) !== -1,
                  JSON.stringify({ declined: declined, calls: declinedCalls }));
        stEq_(out, 'decisions: Hold stays open — the candidate is not touched', run('In Person', 'Hold'), '0|0');
        stEq_(out, 'decisions: Advance is not an end', run('In Person', 'Advance'), '0|0');
        stEq_(out, 'decisions: a blank recommendation ends nothing', run('In Person', ''), '0|0');
        stEq_(out, 'decisions: somebody already archived is never ended twice', run('In Person', 'Decline', true), '0|0');
        stEq_(out, 'decisions: a person moved past the interview is the mover\'s call, not the sweep\'s',
              run('Onboarding', 'Decline'), '0|0');
        terminal = HIRING_BOARD_DECLINE_BEFORE;
        stEq_(out, 'decisions: under the shipped words even a Decline ended nothing — the gap this closes',
              run('In Person', 'Decline'), '0|0');

        // THE SWEEP'S COPY IS OLD; THE ROWS ARE READ AGAIN BEFORE ANYTHING IS WRITTEN.
        terminal = HIRING_BOARD_DECLINE_AFTER;
        freshReads = 0;
        now = { cand: { candidateid: 'CAN_STDECLINE01', status: 'Not Hiring', archived: 'true' },
                __iv: { recommendation: 'Decline', interviewername: 'Probe Interviewer', score: '3' } };
        var stale = run('In Person', 'Decline');
        stAssert_(out, 'decisions: a copy older than the scorecard\'s closure ends nothing — the record is read ' +
                       'again under the claim, and it already says Not Hiring',
                  stale === '0|0' && freshReads === 1, JSON.stringify({ stale: stale, freshReads: freshReads }));
        now = { cand: { candidateid: 'CAN_STDECLINE01', status: 'In Person', archived: '' },
                __iv: { recommendation: 'Hold', interviewername: 'Probe Interviewer', score: '6' } };
        stEq_(out, 'decisions: a Decline the interviewer has since changed to Hold ends nothing',
              run('In Person', 'Decline'), '0|0');
        now = null;
        var claimKey = hubDecisionClaimKey_('CAN_STDECLINE01');
        var cacheC = CacheService.getScriptCache();
        cacheC.put(claimKey, 'somebody-else', 60);
        var whileHeld = run('In Person', 'Decline');
        var stillTheirs = cacheC.get(claimKey) === 'somebody-else';
        cacheC.remove(claimKey);
        stAssert_(out, 'decisions: somebody deciding this person right now is left to it — the sweep looks again ' +
                       'next pass, and never releases a claim it does not hold',
                  whileHeld === '0|0' && stillTheirs, JSON.stringify({ whileHeld: whileHeld, stillTheirs: stillTheirs }));

        // THE EXACT WORD OVER A BROADER CELL.
        terminal = '{"fact":"hiring.interview.recommendation","not_equals_ci":"advance"}';
        var broad = [run('In Person', 'Hold'), run('In Person', '', false, {}),
                     run('In Person', '', false, { recommendation: '', status: 'Scheduled' })].join(',');
        stEq_(out, 'decisions: a cell broader than the word closes nobody — Hold, no interview yet and a blank ' +
                   'scheduled row all stay open', broad, '0|0,0|0,0|0');
        stEq_(out, 'decisions: and under that broader cell a real Decline still ends the run',
              run('In Person', 'Decline'), '1|2');
      } finally {
        hiringMatrixTab_ = heldTab; hubSetStatus_ = heldSet; hiringArchiveAndTell_ = heldArch;
        hubBustTalentCache_ = heldBust; hubEvidenceFresh_ = heldFresh;
      }
    })();
    var sweepSrc = stCode_(hiringConditionsSweepMaybe_);
    stAssert_(out, 'decisions: the machine sweep moves the cell and ends the runs — no screen pays for either',
              sweepSrc.indexOf('hiringBoardDeclineRuleOnce_(') !== -1 &&
              sweepSrc.indexOf('hiringTerminalEndsRun_(') !== -1, '');
    var ivSrc = stCode_(interviewSaveHeld_);
    stAssert_(out, 'decisions: the scorecard door itself still ends the run on Decline and keeps Hold where it is',
              ivSrc.indexOf("rec === 'Decline'") !== -1 && ivSrc.indexOf("hubSetStatus_(cid, 'Not Hiring'") !== -1 &&
              ivSrc.indexOf('hiringArchiveAndTell_(') !== -1 && ivSrc.indexOf("rec === 'Advance' && gate.ok") !== -1 &&
              ivSrc.indexOf('hubEvidenceFresh_(cid)') !== -1, '');

    /* ── THE SCORECARD WAITS FOR ITS ANSWER, AND SIGNS ONE AT A TIME ───── */
    stEq_(out, 'scorecard: a signed Decline waits for its answer — the tool tier, so a refusal reaches the ' +
               'interviewer instead of the ledger\'s "accepted" and a card taken off the board by mistake',
          HUB_POLICY.interviewSave.lane, 'tool');
    (function () {
      var heldCan = interviewCanRecord_, heldHeld = interviewSaveHeld_;
      var ran = 0, key = hubDecisionClaimKey_('CAN_STSCORE0001');
      var cacheS = CacheService.getScriptCache();
      try {
        interviewCanRecord_ = function () { return true; };
        interviewSaveHeld_ = function () { ran++; return { status: 200, data: { saved: true } }; };
        cacheS.put(key, 'another-signature', 60);
        var busy = HUB_ACTIONS.interviewSave({ candidate_id: 'CAN_STSCORE0001' }, { role: 'interviewer', email: 'p@x' });
        var theirs = cacheS.get(key) === 'another-signature';
        cacheS.remove(key);
        var free = HUB_ACTIONS.interviewSave({ candidate_id: 'CAN_STSCORE0001' }, { role: 'interviewer', email: 'p@x' });
        stAssert_(out, 'scorecard: a second signature while one is being recorded is told so and writes nothing; ' +
                       'the claim is let go once the first is done',
                  busy.status === 409 && busy.busy === true && theirs && ran === 1 && free.status === 200 &&
                  !cacheS.get(key), JSON.stringify({ busy: busy, ran: ran, free: free }));
      } finally {
        interviewCanRecord_ = heldCan; interviewSaveHeld_ = heldHeld;
        try { cacheS.remove(key); } catch (eK) { /* the TTL retires it */ }
      }
    })();

    /* ── A WRITE IS READ BACK BY ITS OWN EXECUTION ─────────────────────── */
    var nobodyKey = hiringBookTabKey_('rt_ZZNOMEMO', 'Facts');
    var emptyKey = hiringBookTabKey_('rt_ZZEMPTYM', 'Facts');
    HIRING_TAB_MEMO[emptyKey] = [];
    hiringFactsReadBack_('ZZNOMEMO_RUNTIME', [{ 'Subject ID': 'x', Value: 'y' }]);
    hiringFactsReadBack_('ZZEMPTYM_RUNTIME', [{ 'Subject ID': 'x', Value: 'y' }]);
    stAssert_(out, 'read-back: a runtime nobody has read is left unread, and an empty copy — what a failed read ' +
                   'leaves — is never turned into a one-person tab',
              HIRING_TAB_MEMO[nobodyKey] === undefined && HIRING_TAB_MEMO[emptyKey].length === 0, '');
    delete HIRING_TAB_MEMO[emptyKey];

    /* ── ACCEPT ON THE PHONE SCREEN, OVER THE RUNTIME ITSELF ──────────── */
    (function () {
      var stamp = String(new Date().getTime()).slice(-8);
      var rid = stamp + '_STPROBE';
      var T = { cand: 'st_cands_' + stamp, res: 'st_resume_' + stamp, phone: 'st_phone_' + stamp };
      var FH = ['Fact Key', 'Subject ID', 'Value', 'Type', 'Source', 'Evidence', 'Recorded At', 'Recorded By', 'Instance ID'];
      var grid = [FH.slice()];
      var seed = function (sub, tab, col, val) {
        grid.push(['legacy.' + tab + '.' + col, sub, val, '', 'dissolution:' + tab + '.' + col, '', 't', 'selftest', '']);
      };
      var A = 'CAN_STACCEPT0001', B = 'CAN_STACCEPT0002', C = 'CAN_STACCEPT0003', E = 'CAN_STACCEPT0005';
      // D: pressed while another press holds the claim; F: pressed through the shared link
      var D = 'CAN_STACCEPT0004', F = 'CAN_STACCEPT0006';
      [A, B, C, E, D, F].forEach(function (cid) {
        seed(cid, T.cand, 'status', 'Phone Screen');
        seed(cid, T.cand, 'candidatename', 'Probe ' + cid.slice(-1));
        seed(cid, T.res, 'decisionstatus', 'Advance');
      });
      // B: the automated line started and captured words, never finished
      seed(B, T.phone, 'screenstatus', 'In Progress');
      seed(B, T.phone, 'transcripttext', 'captured words');
      // E: a finished screen, as the line leaves it
      seed(E, T.phone, 'screenstatus', 'Completed');
      seed(E, T.phone, 'transcripttext', 'the whole call');
      var factsSheet = {
        getDataRange: function () {
          return { getValues: function () { return grid.map(function (r) { return r.slice(); }); } };
        },
        getLastColumn: function () { return FH.length; },
        getRange: function (r, c, nr, nc) {
          return { getValues: function () {
            return grid.slice(r - 1, r - 1 + (nr || 1)).map(function (x) { return x.slice(c - 1, c - 1 + (nc || 1)); });
          } };
        },
        appendRow: function (row) { grid.push(row.map(function (v) { return String(v == null ? '' : v); })); }
      };
      var held = { rid: hubRuntimeId_, ridFor: hiringRuntimeFor_, open: ssOpen_, diss: hiringTabDissolved_,
                   mode: hiringBookMode_, status: hubSetStatus_, sched: hubScheduleInterview_,
                   arch: hiringArchiveAndTell_, tc: TALENT_CANDIDATES_TAB, tr: TALENT_RESUME_TAB,
                   tp: TALENT_PHONE_TAB };
      var moves = [];
      var user = { role: 'manager', email: 'selftest@asa' };
      var screenOf = function (cid) {
        return (hiringLegacyRows_(T.phone) || []).filter(function (r) { return r.candidateid === cid; })[0] || {};
      };
      var decide = function (cid, value) {
        return HUB_ACTIONS.setDecision({ candidate_id: cid, checkpoint: 'advance-decision', value: value }, user);
      };
      try {
        hubRuntimeId_ = function () { return rid; };
        hiringRuntimeFor_ = function () { return rid; };
        ssOpen_ = function () {
          return { getId: function () { return rid; },
                   getSheetByName: function (n) { return n === 'Facts' ? factsSheet : null; } };
        };
        hiringTabDissolved_ = function (t) { return t === T.cand || t === T.res || t === T.phone; };
        // the code gate: the Board's own verdict over the same rows is the live half's
        hiringBookMode_ = function () { return { id: '', status: '' }; };
        // the status lands in the runtime as a fact, the way the real door's does, so a LATER press reads where the…
        hubSetStatus_ = function (cid, st) { moves.push(cid + '>' + st); seed(cid, T.cand, 'status', st); return true; };
        hubScheduleInterview_ = function (cid) { moves.push(cid + ':scheduled'); return true; };
        hiringArchiveAndTell_ = function (cid) { moves.push(cid + ':archived'); return { marked: true }; };
        TALENT_CANDIDATES_TAB = T.cand; TALENT_RESUME_TAB = T.res; TALENT_PHONE_TAB = T.phone;

        var a = decide(A, 'Advance');
        var sA = screenOf(A);
        stAssert_(out, 'accept: a candidate the automated line never reached is ATTESTED and moves to Interview — ' +
                       'the 409 "No phone screen recorded" is gone',
                  a.status === 200 && a.data.moved_to === 'interview' && a.data.gate_passed === true &&
                  moves.indexOf(A + '>In Person') !== -1 && moves.indexOf(A + ':scheduled') !== -1,
                  JSON.stringify({ a: a, moves: moves }));
        stAssert_(out, 'accept: the record carries the decision and the same attestation the Manual screen button signs',
                  sA.finalresult === 'Advance' && sA.screenstatus === 'Completed' && sA.manualscreen === 'true' &&
                  sA.screenedby === 'asa-hub:manual-screen:selftest@asa', JSON.stringify(sA));

        var b = decide(B, 'Advance');
        var sB = screenOf(B);
        stAssert_(out, 'accept: a screen the line started and never finished is completed by the press — and the ' +
                       'words it captured stay',
                  b.status === 200 && b.data.moved_to === 'interview' && sB.screenstatus === 'Completed' &&
                  sB.manualscreen === 'true' && sB.transcripttext === 'captured words' && sB.finalresult === 'Advance',
                  JSON.stringify({ b: b, sB: sB }));

        var e = decide(E, 'Advance');
        var sE = screenOf(E);
        stAssert_(out, 'accept: a finished screen is only decided, never re-attested',
                  e.status === 200 && e.data.moved_to === 'interview' && sE.finalresult === 'Advance' &&
                  !sE.manualscreen && sE.transcripttext === 'the whole call', JSON.stringify({ e: e, sE: sE }));

        var c = decide(C, 'Decline');
        var sC = screenOf(C);
        stAssert_(out, 'accept: Decline needs no call on the record — the run ends, and nothing is attested',
                  c.status === 200 && c.data.declined === true && moves.indexOf(C + '>Not Hiring') !== -1 &&
                  moves.indexOf(C + ':archived') !== -1 && sC.finalresult === 'Decline' && !sC.manualscreen,
                  JSON.stringify({ c: c, sC: sC, moves: moves }));

        var movesOf = function (cid) { return moves.filter(function (m) { return m.indexOf(cid) === 0; }); };

        // THE SECOND PRESS (the ledger holds two Accepts in one second): the first already moved A to Interview and…
        var screenA = JSON.stringify(screenOf(A)), movedA = movesOf(A).length;
        // caught, so a door that goes on past the stage reads as THIS check failing rather than as the whole…
        var a2;
        try { a2 = decide(A, 'Advance'); } catch (eA2) { a2 = { threw: String((eA2 && eA2.message) || eA2) }; }
        stAssert_(out, 'accept: a second Accept after the first moved the card is told where the person is — the ' +
                       'screen is not rewritten, nobody is moved or booked twice',
                  a2.status === 409 && a2.already_at === 'interview' && JSON.stringify(screenOf(A)) === screenA &&
                  movesOf(A).length === movedA, JSON.stringify({ a2: a2, moves: movesOf(A) }));

        // TWO PRESSES AT ONCE: the first still holds D's claim.
        var cacheA = CacheService.getScriptCache(), keyD = hubDecisionClaimKey_(D);
        cacheA.put(keyD, 'the-first-press', 60);
        var d2 = decide(D, 'Advance');
        var dTheirs = cacheA.get(keyD) === 'the-first-press';
        cacheA.remove(keyD);
        stAssert_(out, 'accept: a press while another is being recorded is refused as busy — nothing attested, ' +
                       'nothing moved, and the first press keeps its claim',
                  d2.status === 409 && d2.busy === true && dTheirs && !screenOf(D).manualscreen &&
                  !screenOf(D).finalresult && movesOf(D).length === 0, JSON.stringify({ d2: d2, moves: movesOf(D) }));
        var d3 = decide(D, 'Advance');
        stAssert_(out, 'accept: and once it is let go the next press decides — the claim is released after every press',
                  d3.status === 200 && d3.data.moved_to === 'interview' && !cacheA.get(keyD),
                  JSON.stringify(d3));

        // A DECLINE PRESSED TWICE mails the owners once.
        var c2 = decide(C, 'Decline');
        stAssert_(out, 'accept: a Decline pressed again after the run ended answers "declined" without a second ' +
                       'letter or a second move',
                  c2.status === 200 && c2.data.declined === true && c2.data.already === true &&
                  movesOf(C).join() === [C + '>Not Hiring', C + ':archived'].join(),
                  JSON.stringify({ c2: c2, moves: movesOf(C) }));

        // THE SHARED LINK SIGNS FOR NOBODY: its only identity is its token, so an Advance there on an unscreened…
        var heldTok = candFormCidByToken_;
        var fLink;
        try {
          candFormCidByToken_ = function () { return F; };
          fLink = candFormSubmitPub_({ t: 'probe', kind: 'decision', checkpoint: 'advance-decision', value: 'Advance' });
        } finally { candFormCidByToken_ = heldTok; }
        var sF = screenOf(F);
        stAssert_(out, 'accept: the shared link\'s Advance on an unscreened candidate attests nothing and moves ' +
                       'nobody — "No phone screen recorded", as before',
                  fLink.status === 409 && /No phone screen recorded/.test(fLink.message) && !sF.manualscreen &&
                  !sF.finalresult && movesOf(F).length === 0, JSON.stringify({ fLink: fLink, sF: sF }));

        // THE INTERVIEW'S RECOMMENDATION IS SIGNED ON THE SCORECARD — the Flow view sent it here and got a bare 400…
        var movesAll = moves.length;
        var ir = HUB_ACTIONS.setDecision({ candidate_id: E, checkpoint: 'interview-recommendation', value: 'Decline' }, user);
        stAssert_(out, 'decisions: the interview recommendation is refused here and names the Scorecard — ' +
                       'nothing written, nobody closed',
                  ir.status === 400 && /Scorecard/.test(ir.message) && moves.length === movesAll, JSON.stringify(ir));
      } finally {
        hubRuntimeId_ = held.rid; hiringRuntimeFor_ = held.ridFor; ssOpen_ = held.open;
        hiringTabDissolved_ = held.diss; hiringBookMode_ = held.mode; hubSetStatus_ = held.status;
        hubScheduleInterview_ = held.sched; hiringArchiveAndTell_ = held.arch;
        TALENT_CANDIDATES_TAB = held.tc; TALENT_RESUME_TAB = held.tr; TALENT_PHONE_TAB = held.tp;
        var factsKey = hiringBookTabKey_('rt_' + rid.slice(0, 8), 'Facts');
        delete HIRING_TAB_MEMO[factsKey];
        var cache = CacheService.getScriptCache();
        [T.cand, T.res, T.phone].forEach(function (t) {
          delete HIRING_LEGACY_MEMO[t];
          delete RUNTIME_SHEET_MEMO[t];
          ['hiring_legacy_v1_', 'hiring_legacy_rev_', 'hiring_rawhdr_v1_'].forEach(function (p) {
            try { cache.remove(p + t); } catch (eC) { /* the TTL retires it */ }
          });
        });
        try { cache.remove(factsKey); } catch (eF) { /* the TTL retires it */ }
      }
    })();
    stEq_(out, 'accept: a decision waits for its answer — the tool tier, so a refusal reaches the screen of the ' +
               'person who pressed instead of the ledger\'s "accepted"',
          HUB_POLICY.setDecision.lane, 'tool');
  } finally {
    hubSysLog_ = heldLog;
  }
}

// ------------------------------------------------------------------ MED DEL — the settings left the code, and the…
function stMedDel_(out) {
  var missing = { ok: false, why: 'the house is not minted yet', rows: [] };
  var broke = medDelCatalogBuild_(missing, null);
  stAssert_(out, 'med del: an UNREADABLE catalogue is never an empty one — every level, ' +
            'every employment status and every timing still stands',
            broke.levels.join('|') === MEDDEL_LEVELS.join('|') &&
            broke.levelColumns['Med 2'] === MEDDEL_LEVEL_COLUMNS['Med 2'] &&
            broke.levelHeaders['Med 3'] === MEDDEL_LEVEL_HEADERS['Med 3'] &&
            broke.activeStatuses.yes === 1 && broke.activeStatuses.other === 1 &&
            broke.settings.windowDays === MEDDEL_DEFAULTS.windowDays &&
            broke.ok === false && !!broke.why && broke.source === 'code',
            JSON.stringify(broke).slice(0, 300));

  var rows = [
    { kind: 'setting', name: 'windowDays', value: '90' },
    { kind: 'level', name: 'Med 1', value: 'med_1_exp_date', label: 'Med 1 Exp Date' },
    { kind: 'level', name: 'Med 2', value: 'med_2_exp_date', label: 'Med 2 Exp Date' },
    { kind: 'level', name: 'Med 3', value: 'med_3_exp_date', label: 'Med 3 Exp Date' },
    { kind: 'active_status', name: 'yes' }, { kind: 'active_status', name: 'active' }
  ];
  var live = medDelCatalogBuild_({ ok: true, why: '', rows: rows }, null);
  stEq_(out, 'med del: an edit in the sheet reaches the lane — the detection window is the ' +
             'sheet\'s, with no push and no publish', live.settings.windowDays, 90);
  stEq_(out, 'med del: a timing the sheet does not carry still answers from the shipped copy',
        live.settings.scrapeAfterDays, MEDDEL_DEFAULTS.scrapeAfterDays);
  stAssert_(out, 'med del: the employment statuses are the sheet\'s when the sheet names any',
            live.activeStatuses.yes === 1 && live.activeStatuses.active === 1 &&
            live.activeStatuses.other === undefined, JSON.stringify(live.activeStatuses));

  // PHASE 0 AND THE AUTO-CANCEL, which are the two the catalogue can kill.
  var emptied = medDelCatalogBuild_({ ok: true, why: '', rows: [
    { kind: 'level', name: 'Med 1', value: 'med_1_exp_date', label: 'x', enabled: 'no' },
    { kind: 'level', name: 'Med 2', value: 'med_2_exp_date', label: 'x', enabled: 'no' },
    { kind: 'level', name: 'Med 3', value: 'med_3_exp_date', label: 'x', enabled: 'no' },
    { kind: 'active_status', name: 'yes', enabled: 'no' }
  ] }, null);
  stAssert_(out, 'med del: a catalogue whose every level is switched off does NOT stop ' +
            'detection — phase 0 would find nothing and no renewal would ever start again',
            emptied.levels.join('|') === MEDDEL_LEVELS.join('|') &&
            emptied.groups.levels === 'code' && emptied.refused.length > 0,
            JSON.stringify(emptied.refused));
  stAssert_(out, 'med del: a catalogue whose every employment status is switched off does NOT ' +
            'cancel everybody — the auto-cancel reads the shipped three instead',
            emptied.activeStatuses.yes === 1 && emptied.activeStatuses.other === 1 &&
            emptied.activeStatuses.active === 1 && emptied.groups.statuses === 'code',
            JSON.stringify(emptied.activeStatuses));

  // PHASE 5 writes ONE cell of the employee Master, under a header the sheet now names.
  var pii = medDelCatalogBuild_({ ok: true, why: '', rows: [
    { kind: 'level', name: 'Med 1', value: 'ssn', label: 'SSN#' },
    { kind: 'level', name: 'Med 2', value: 'med_2_exp_date', label: 'Med 2 Exp Date' },
    { kind: 'level', name: 'Med 9', value: 'date_of_birth', label: 'DOB' }
  ] }, null);
  stAssert_(out, 'med del: a level pointed at protected employee data is refused — the shipped ' +
            'column stands for a level that had one, an invented level never joins, and ' +
            'nothing widens the Master projection',
            pii.levelColumns['Med 1'] === 'med_1_exp_date' &&
            pii.levels.join('|') === 'Med 1|Med 2' &&
            pii.masterFields.join('|').indexOf('ssn') === -1 &&
            pii.masterFields.join('|').indexOf('date_of_birth') === -1 &&
            pii.refused.join(' ').indexOf('"Med 1"') !== -1 &&
            pii.refused.join(' ').indexOf('the level was skipped') !== -1,
            JSON.stringify(pii.refused));

  var added = medDelCatalogBuild_({ ok: true, why: '', rows: rows.concat([
    { kind: 'level', name: 'Med 4', value: 'med_4_exp_date', label: 'Med 4 Exp Date' }
  ]) }, null);
  stAssert_(out, 'med del: a fourth certification declared only in the sheet is detected, and ' +
            'its Master column is the ONE thing the projection gains',
            added.levels.join('|') === 'Med 1|Med 2|Med 3|Med 4' &&
            added.masterFields.length === MEDDEL_MASTER_FIELDS.length + 1 &&
            added.masterFields[added.masterFields.length - 1] === 'med_4_exp_date',
            JSON.stringify(added.masterFields));

  // THE LEGACY OVERRIDE ROW is not retired by this move; the sheet outranks it.
  var both = medDelCatalogBuild_({ ok: true, why: '', rows: rows },
                                 { windowDays: 45, cancelAfterDays: 30 });
  stAssert_(out, 'med del: the legacy medDelConfig row still applies where the sheet is silent, ' +
            'and the sheet wins where both speak',
            both.settings.windowDays === 90 && both.settings.cancelAfterDays === 30,
            JSON.stringify(both.settings));

  // THE PHASES THEMSELVES — asserted on their own source, because running them needs the Master, the people list…
  var sweep = stCode_(medDelSweep_);
  stAssert_(out, 'med del: phase 0 detects expiring certs from the CATALOGUE\'s levels and ' +
            'columns, and the auto-cancel asks it which statuses mean employed',
            sweep.indexOf('cat.levels') !== -1 && sweep.indexOf('cat.levelColumns') !== -1 &&
            sweep.indexOf('cat.activeStatuses') !== -1 &&
            sweep.indexOf('MEDDEL_LEVELS') === -1 &&
            sweep.indexOf('MEDDEL_ACTIVE_STATUSES') === -1, '');
  stEq_(out, 'med del: the sweep reads the catalogue ONCE for the whole pass — a cache expiry ' +
             'mid-sweep must not judge half the flows against different levels',
        (sweep.match(/medDelCat_\(\)/g) || []).length, 1);
  stAssert_(out, 'med del: phase 5 writes the renewed date under the catalogue\'s Master header',
            stCode_(medDelMasterWriteExp_).indexOf('medDelCat_().levelHeaders') !== -1, '');
  stAssert_(out, 'med del: the Master is projected through the catalogue, so a level added in ' +
            'the sheet can be read at all',
            stCode_(medDelMasterRows_).indexOf('medDelCat_().masterFields') !== -1, '');
  stAssert_(out, 'med del: the Start and Seed doors validate against the catalogue\'s levels',
            stCode_(HUB_ACTIONS.medDelStart).indexOf('cat.levels') !== -1 &&
            stCode_(HUB_ACTIONS.medDelSeed).indexOf('cat.levels') !== -1, '');
  stAssert_(out, 'med del: the board is TOLD when the settings came from the shipped copy — a ' +
            'screen quoting shipped numbers while somebody edits the sheet is a screen lying',
            stCode_(HUB_ACTIONS.medDelFlows).indexOf('medDelCatState_') !== -1, '');
  stAssert_(out, 'med del: the lane never CREATES the catalogue — a missing house stays ' +
            'missing instead of being resurrected as an empty tab in HUB_DB',
            stCode_(medDelCatalogRows_).indexOf('hubTabSheet_') !== -1 &&
            stCode_(medDelCatalogRows_).indexOf('hubTabEnsure_') === -1, '');

  // THE WRITE-BACK CELL.
  var wb = medDelCatalogBuild_({ ok: true, why: '', rows: [
    { kind: 'level', name: 'Med 1', value: 'med_1_exp_date', label: 'SSN#' },
    { kind: 'level', name: 'Med 2', value: 'med_2_exp_date', label: 'Date of Birth' },
    { kind: 'level', name: 'Med 3', value: 'med_3_exp_date', label: 'Home Address' }
  ] }, null);
  stAssert_(out, 'med del: a write-back header naming protected employee data is refused and ' +
            'the shipped header stands — the renewed date can never be written over an SSN or ' +
            'a date of birth',
            wb.levelHeaders['Med 1'] === MEDDEL_LEVEL_HEADERS['Med 1'] &&
            wb.levelHeaders['Med 2'] === MEDDEL_LEVEL_HEADERS['Med 2'] &&
            wb.refused.join(' ').indexOf('write-back header "SSN#"') !== -1,
            JSON.stringify(wb.refused));
  stAssert_(out, 'med del: a write-back header naming an ordinary Master column that is not an ' +
            'expiration date is refused too — this lane writes one kind of cell and no other',
            wb.levelHeaders['Med 3'] === MEDDEL_LEVEL_HEADERS['Med 3'] &&
            wb.refused.join(' ').indexOf('does not read like an expiration column') !== -1,
            JSON.stringify(wb.refused));

  // A LEVEL SWITCHED OFF IS A DETECTION DECISION, NOT A WRITE-BACK ONE.
  var off3 = medDelCatalogBuild_({ ok: true, why: '', rows: [
    { kind: 'level', name: 'Med 1', value: 'med_1_exp_date', label: 'Med 1 Exp Date' },
    { kind: 'level', name: 'Med 2', value: 'med_2_exp_date', label: 'Med 2 Exp Date' },
    { kind: 'level', name: 'Med 3', value: 'med_3_exp_date', label: 'Med 3 Exp Date',
      enabled: 'no' }
  ] }, null);
  stAssert_(out, 'med del: a level switched off leaves the detection list but KEEPS its ' +
            'write-back header, so a renewal already in flight is not stranded with the old ' +
            'expiration still on the Master',
            off3.levels.join('|') === 'Med 1|Med 2' &&
            off3.levelColumns['Med 3'] === undefined &&
            off3.levelHeaders['Med 3'] === MEDDEL_LEVEL_HEADERS['Med 3'],
            JSON.stringify(off3.levelHeaders));
  stAssert_(out, 'med del: and phase 5 does NOT close a flow whose Master write failed — it is ' +
            'held open and retried, the way a failed scrape already is',
            sweep.indexOf('master_write_failed') !== -1 &&
            sweep.indexOf("held ? 'active' : 'complete'") !== -1, '');

  // AN ILLEGIBLE CELL IS NOT A DECLARED NO.
  var ticked = medDelCatalogBuild_({ ok: true, why: '', rows: [
    { kind: 'active_status', name: 'yes', enabled: 'x' },
    { kind: 'active_status', name: 'other', enabled: 'n/a' },
    { kind: 'active_status', name: 'active', enabled: '' }
  ] }, null);
  stAssert_(out, 'med del: a word in `enabled` that is neither yes nor no leaves the row ON and ' +
            'is named on the board — a tick nobody can parse must never be the thing that ' +
            'cancels a renewal',
            ticked.activeStatuses.yes === 1 && ticked.activeStatuses.other === 1 &&
            ticked.activeStatuses.active === 1 && ticked.refused.length === 2 &&
            ticked.groups.statuses === 'sheet', JSON.stringify(ticked.refused));
  stAssert_(out, 'med del: and the words that really do mean no still switch a row off',
            medDelCatalogSwitch_('no') === 'off' && medDelCatalogSwitch_('OFF') === 'off' &&
            medDelCatalogSwitch_('false') === 'off' && medDelCatalogSwitch_('') === 'on' &&
            medDelCatalogSwitch_('yes') === 'on' && medDelCatalogSwitch_('x') === '?', '');

  // THE CACHE IS SHARED ACROSS WORLDS AND PLACES; THE KEY MUST NOT BE.
  stAssert_(out, 'med del: the catalogue\'s cache key is qualified the way every other tab ' +
            'cache is, so one place\'s settings are never served to another',
            stCode_(medDelCatalogKey_).indexOf('cacheScope_') !== -1 &&
            medDelCatalogKey_().indexOf(MEDDEL_CATALOG_CACHE_KEY) === 0 &&
            medDelCatalogKey_() !== MEDDEL_CATALOG_CACHE_KEY, medDelCatalogKey_());

  // A NAMED PUSH LEAVES FILES BEHIND IN SILENCE.
  stAssert_(out, 'med del: every door reaches the catalogue through a seam that answers the ' +
            'shipped copy when MedDelCatalog.gs is not in the project at all',
            stCode_(medDelCat_).indexOf('typeof medDelCatalog_') !== -1 &&
            stCode_(medDelCat_).indexOf('medDelCatShipped_') !== -1 &&
            stCode_(medDelCatState_).indexOf('typeof medDelCatalogState_') !== -1, '');
  var shippedCat = medDelCatShipped_();
  stAssert_(out, 'med del: and that shipped copy is the real one — the same levels, columns, ' +
            'headers, statuses and timings, so nothing disappears and nobody is cancelled',
            shippedCat.levels.join('|') === MEDDEL_LEVELS.join('|') &&
            shippedCat.levelColumns['Med 2'] === MEDDEL_LEVEL_COLUMNS['Med 2'] &&
            shippedCat.levelHeaders['Med 3'] === MEDDEL_LEVEL_HEADERS['Med 3'] &&
            shippedCat.activeStatuses.other === 1 &&
            shippedCat.settings.windowDays === MEDDEL_DEFAULTS.windowDays &&
            shippedCat.masterFields.join('|') === MEDDEL_MASTER_FIELDS.join('|') &&
            shippedCat.ok === false && shippedCat.source === 'code',
            JSON.stringify(shippedCat).slice(0, 300));

  // THE WORDS DID NOT MOVE TWICE.
  stAssert_(out, 'med del: the four messages are still Smart Comms situations and were NOT ' +
            'copied into the catalogue',
            MEDDEL_SMART_SEEDS.length === 4 &&
            JSON.stringify(live).indexOf('sms_text') === -1, '');
}

// ------------------------------------------------------------------ THE EXAMPLES CATALOGUE — the rows left the…

/** One stand-in tab: a header, some rows, a clock, and a mode that can refuse. */
function stExamplesSheet_(header, rows, mode, zone) {
  var grid = [header.slice()];
  rows.forEach(function (r) { grid.push(r.slice()); });
  return {
    getName: function () { return 'stand-in'; },
    getParent: function () {
      return {
        getId: function () { return 'stand-in'; },
        // The reader asks the book what clock it keeps before it believes a single date in it — cellText_ is only…
        getSpreadsheetTimeZone: function () { return zone || 'Etc/GMT'; }
      };
    },
    getLastColumn: function () { return header.length; },
    getRange: function () {
      return { getValues: function () { return [header.slice()]; } };
    },
    getDataRange: function () {
      return { getValues: function () {
        if (mode === 'unreadable') throw new Error('the tab answered but the range did not');
        return grid;
      } };
    }
  };
}

/** A small catalogue, one of each shape — enough to exercise every rule. */
function stExamplesRows_() {
  return {
    example_shop_items: [
      ['EX_SHOP_A', 'A cordless vacuum', 'Household', 550, 'for the house', 'watching'],
      ['EX_SHOP_B', 'A power bank', 'Electronics', 100, '', 'watching']
    ],
    example_shop_prices: [
      ['EX_PRICE_A1', 'EX_SHOP_A', 529, 'the cheaper one']
    ],
    example_skills: [
      ['EX_SKILL_A', 'Medication administration', 'Direct Care', 'the five rights', 'true']
    ],
    example_attempts: [
      ['EX_ATT_A1', 'EX_SKILL_A', '2026-07-21T14:00:00.000Z', 'true', 'false', 'example']
    ],
    example_trips: [
      ['EX_TRIP_A', 'Columbus, OH', 'USA', 'a conference', 'completed', '2026-06-10',
       '2026-06-12', 'Arthur Torres', 'the reason', 'the outcome', 1200, 1043,
       '2026-05-28T15:00:00.000Z']
    ]
  };
}

/** The spec for one catalogue tab. */
function stExamplesSpec_(tab) {
  var hit = null;
  EX_CATALOGUE.forEach(function (s) { if (s.tab === tab) hit = s; });
  return hit;
}

// Run `body` with the catalogue and both destinations stood in for.
function stExamplesRun_(shape, body) {
  var held = {
    sheet: exCatalogueSheet_, owner: exOwnerId_, house: houseIdFor_, moved: houseMoved_,
    again: exDepotAgain_, rows: exDestinationRows_,
    create: createRow_, update: updateRowById_, remove: deleteRowById_
  };
  var made = [], changed = [], killed = [], reads = 0, forgot = 0;
  var rows = shape.rows || stExamplesRows_();

  exCatalogueSheet_ = function (tab) {
    reads++;
    if (shape.missing === tab) return null;
    // A HOUSE MINTED A MINUTE AGO: the router answers null off the 300 s switchboard copy and the tab is there all…
    if (shape.minted === tab && !forgot) return null;
    if (shape.unreachable === tab) throw new Error('the house did not answer');
    var spec = stExamplesSpec_(tab);
    var header = (shape.header && shape.header[tab]) || spec.header;
    return stExamplesSheet_(header, rows[tab] || [],
                            shape.unreadable === tab ? 'unreadable' : 'ok',
                            shape.zone);
  };
  exDepotAgain_ = function () { forgot++; };
  exOwnerId_ = function () { return shape.owner === undefined ? 'U_OWNER' : shape.owner; };
  houseIdFor_ = function () { return shape.declared ? 'a_declared_book' : ''; };
  houseMoved_ = function () { return !!shape.movedOn; };
  exDestinationRows_ = function (resource) {
    if (shape.unreadableDest === resource) throw new Error('the destination did not answer');
    return ((shape.live && shape.live[resource]) || []).map(function (r) {
      var copy = {};
      for (var k in r) { if (Object.prototype.hasOwnProperty.call(r, k)) copy[k] = r[k]; }
      return copy;
    });
  };
  createRow_ = function (resource, record) {
    if (shape.refuseWrite === resource) {
      return { error: { status: 422, message: 'the store files rows against a subject' } };
    }
    made.push({ resource: resource, record: record });
    return record;
  };
  updateRowById_ = function (resource, patch) {
    if (shape.refuseUpdate === resource) {
      return { error: { status: 404, message: 'No "' + resource + '" record with id "' + patch.id + '".' } };
    }
    changed.push({ resource: resource, patch: patch });
    return patch;
  };
  deleteRowById_ = function (resource, id) {
    if (shape.refuseDelete === id || shape.refuseDelete === resource) {
      return { error: { status: 404, message: 'No "' + resource + '" record with id "' + id + '".' } };
    }
    killed.push(resource + ':' + id);
    return {};
  };

  exCatalogueBump_();
  var thrown = '', result = null;
  try { result = body(); }
  catch (e) { thrown = String((e && e.message) || e); }
  finally {
    exCatalogueSheet_ = held.sheet; exOwnerId_ = held.owner; houseIdFor_ = held.house;
    houseMoved_ = held.moved; exDepotAgain_ = held.again; exDestinationRows_ = held.rows;
    createRow_ = held.create; updateRowById_ = held.update; deleteRowById_ = held.remove;
    exCatalogueBump_();
  }
  return { made: made, changed: changed, killed: killed, reads: reads, forgot: forgot,
           thrown: thrown, result: result };
}

/** Every record one resource received. */
function stExamplesOf_(run, resource) {
  return run.made.filter(function (m) { return m.resource === resource; })
                 .map(function (m) { return m.record; });
}

/** Every patch one resource received. */
function stExamplesPatched_(run, resource) {
  return run.changed.filter(function (m) { return m.resource === resource; })
                    .map(function (m) { return m.patch; });
}

// What a run PUT in the destinations, shaped as what they would hold next time — so a second run is judged against…
function stExamplesLanded_(run) {
  var live = {};
  run.made.forEach(function (m) {
    if (!live[m.resource]) live[m.resource] = [];
    var row = {};
    for (var k in m.record) {
      if (Object.prototype.hasOwnProperty.call(m.record, k)) row[k] = m.record[k];
    }
    live[m.resource].push(row);
  });
  return live;
}

/** A catalogue with one cell of one row replaced. */
function stExamplesWith_(tab, index, column, value) {
  var rows = stExamplesRows_();
  var at = stExamplesSpec_(tab).header.indexOf(column);
  rows[tab] = rows[tab].map(function (r) { return r.slice(); });
  rows[tab][index][at] = value;
  return rows;
}

function stExamples_(out) {
  /* ── THE CATALOGUE READS, AND EVERY ROW IS WRITTEN ───────────────── */
  var good = stExamplesRun_({}, function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a catalogue that reads cleanly is written row for row',
            good.thrown === '' && good.made.length === 6,
            good.thrown || (good.made.length + ' rows written'));
  stAssert_(out, 'examples: every row written carries its EX_ id, because that is the only thing ' +
                 'the removal job can find it by',
            good.made.length === 6 && good.made.every(function (m) {
              return String(m.record.id).indexOf(EX_PREFIX) === 0;
            }), JSON.stringify(good.made.map(function (m) { return m.record.id; })));

  var item = stExamplesOf_(good, 'shopperItems')[0];
  stAssert_(out, 'examples: an item is written under the owner, with the cells the sheet holds',
            item && item.id === 'EX_SHOP_A' && item.ownerId === 'U_OWNER' &&
            item.category === 'Household' && item.status === 'watching' &&
            item.targetPrice === 550, JSON.stringify(item));

  var price = stExamplesOf_(good, 'shopperPrices')[0];
  stAssert_(out, 'examples: an estimate keeps the label that says a loader typed it — the sheet ' +
                 'names the number, never the author',
            price && price.estimate === 529 && price.source === EX_PRICE_SOURCE &&
            price.model === EX_PRICE_MODEL, JSON.stringify(price));

  var trip = stExamplesOf_(good, 'travelTrips')[0];
  stAssert_(out, 'examples: a trip that carries a decision carries the decider with it',
            trip && trip.status === 'completed' && trip.budget === 1200 &&
            trip.actualCost === 1043 && trip.decidedBy === EX_OWNER_EMAIL,
            JSON.stringify(trip));

  var attempt = stExamplesOf_(good, 'learnAttempts')[0];
  stAssert_(out, 'examples: true and false survive the sheet as the words the screens read',
            attempt && attempt.correct === 'true' && attempt.helped === 'false',
            JSON.stringify(attempt));

  /* ── A SECOND RUN OVER AN UNCHANGED CATALOGUE COSTS NOTHING ──────── */
  var landed = stExamplesLanded_(good);
  var twice = stExamplesRun_({ live: landed }, function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a second run over the same catalogue writes nothing and changes nothing',
            twice.thrown === '' && twice.made.length === 0 && twice.changed.length === 0,
            JSON.stringify(twice.made) + JSON.stringify(twice.changed));
  stAssert_(out, 'examples: and it says unchanged rather than counting work it did not do',
            twice.result.join(' | ').indexOf('0 written, 0 updated, 2 unchanged') !== -1,
            twice.result.join(' | '));
  stAssert_(out, 'examples: the stamp made at write time is not a difference — a price is not ' +
                 'rewritten every run to move its own timestamp',
            stExamplesPatched_(twice, 'shopperPrices').length === 0,
            JSON.stringify(stExamplesPatched_(twice, 'shopperPrices')));

  // ── THE ONE THING THE MOVE EXISTS FOR: AN EDIT REACHES THE SCREEN ─ The rows left the code so that a person…
  var editedRows = stExamplesWith_('example_shop_items', 0, 'name', 'A different vacuum');
  var at = stExamplesSpec_('example_shop_items').header;
  editedRows.example_shop_items[0][at.indexOf('category')] = 'Electronics';
  editedRows.example_shop_items[0][at.indexOf('target_price')] = 400;
  var edited = stExamplesRun_({ live: landed, rows: editedRows },
                              function () { return runLoadExamples(); });
  var patch = stExamplesPatched_(edited, 'shopperItems')[0];
  stAssert_(out, 'examples: a cell edited AFTER the first load is what the next run puts on the ' +
                 'screen — the whole reason the rows left the code',
            edited.thrown === '' && edited.made.length === 0 &&
            stExamplesPatched_(edited, 'shopperItems').length === 1 &&
            patch && patch.id === 'EX_SHOP_A' && patch.name === 'A different vacuum' &&
            patch.category === 'Electronics' && patch.targetPrice === 400,
            edited.thrown || JSON.stringify(edited.changed));
  stAssert_(out, 'examples: only the row that changed is written, and only the cells that changed',
            edited.changed.length === 1 && patch &&
            Object.keys(patch).sort().join(',') === 'category,id,name,targetPrice',
            JSON.stringify(edited.changed));
  stAssert_(out, 'examples: the report says how many were updated, not how many were "already there"',
            edited.result.join(' | ').indexOf('0 written, 1 updated, 1 unchanged') !== -1,
            edited.result.join(' | '));

  var reStatus = stExamplesRun_({ live: landed,
                                  rows: stExamplesWith_('example_trips', 0, 'status', 'cancelled') },
                                function () { return runLoadExamples(); });
  stEq_(out, 'examples: a trip somebody cancelled in the sheet is cancelled in the destination',
        String((stExamplesPatched_(reStatus, 'travelTrips')[0] || {}).status), 'cancelled');

  /* ── A ROW THE CATALOGUE DOES NOT NAME IS NEVER TOUCHED ──────────── */
  var beside = { shopperItems: landed.shopperItems.concat([{ id: 'a real person\'s item',
                                                             name: 'theirs' }]) };
  for (var k in landed) { if (!beside[k]) beside[k] = landed[k]; }
  var alongside = stExamplesRun_({ live: beside }, function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a row the catalogue never named is neither written nor rewritten',
            alongside.thrown === '' && alongside.made.length === 0 && alongside.changed.length === 0,
            JSON.stringify(alongside.changed));

  /* ── THE CATALOGUE IS READ ONCE PER EXECUTION ────────────────────── */
  var cached = stExamplesRun_({}, function () {
    exCatalogue_(); exCatalogue_(); exCatalogue_();
    return true;
  });
  stEq_(out, 'examples: the catalogue is read once and held, not once per ask',
        cached.reads, EX_CATALOGUE.length);

  /* ── MISSING, UNREACHABLE, UNREADABLE — NOTHING IS WRITTEN ───────── */
  var gone = stExamplesRun_({ missing: 'example_trips' }, function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a catalogue nobody has minted stops the whole load, names itself, and ' +
                 'says what to run',
            gone.made.length === 0 && gone.thrown.indexOf('example_trips') !== -1 &&
            gone.thrown.indexOf('no tab of that name answers') !== -1 &&
            gone.thrown.indexOf('mint_examples_house.py') !== -1, gone.thrown);
  stAssert_(out, 'examples: the four tabs that DID read are not written on their own',
            gone.made.length === 0,
            'a demo that arrives without its trips is a demo nobody can judge');

  stAssert_(out, 'examples: before saying a catalogue does not exist, the depot itself is asked — ' +
                 'past the 300 s copy every router question is answered from',
            gone.forgot === 1, 'exDepotAgain_ was called ' + gone.forgot + ' times');

  // ── MINTED A MINUTE AGO IS NOT MINTED NEVER ─────────────────────── switchboardValues_ holds its map for 300 s…
  var justMinted = stExamplesRun_({ minted: 'example_shop_items' },
                                  function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a catalogue minted a minute ago loads, instead of sending somebody to ' +
                 'mint it a second time',
            justMinted.thrown === '' && justMinted.made.length === 6 && justMinted.forgot === 1,
            justMinted.thrown || JSON.stringify(justMinted.made.length));

  var quiet = stExamplesRun_({ missing: 'example_trips', declared: true, movedOn: true },
                             function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a house the depot DOES name, with the switch on, that did not answer ' +
                 'is told apart from a catalogue that was never minted — nobody is sent to mint ' +
                 'it twice',
            quiet.made.length === 0 && quiet.thrown.indexOf('did not answer with the tab') !== -1 &&
            quiet.thrown.indexOf('mint_examples_house.py') === -1, quiet.thrown);

  var halfDeclared = stExamplesRun_({ missing: 'example_trips', declared: true },
                                    function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a pointer with the switch still off is its own answer — the tool ' +
                 'writes both, and running it again is the fix',
            halfDeclared.made.length === 0 &&
            halfDeclared.thrown.indexOf('does not say on') !== -1 &&
            halfDeclared.thrown.indexOf('mint_examples_house.py') !== -1, halfDeclared.thrown);

  stAssert_(out, 'examples: the router itself answers null for a tab nobody declared — it does ' +
                 'not throw, which is why the message above cannot be a house outage',
            hubTabSheet_('a_tab_nobody_ever_declared') === null,
            'hubTabSheet_ answered something other than null');

  var unreachable = stExamplesRun_({ unreachable: 'example_skills' },
                                   function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a house that throws is a refusal, never an empty list',
            unreachable.made.length === 0 &&
            unreachable.thrown.indexOf('did not answer') !== -1, unreachable.thrown);

  var unreadable = stExamplesRun_({ unreadable: 'example_attempts' },
                                  function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a tab that is there and cannot be read says exactly that',
            unreadable.made.length === 0 &&
            unreadable.thrown.indexOf('could not be read') !== -1, unreadable.thrown);

  var shape = stExamplesRun_({ header: { example_shop_items: ['id', 'name', 'category'] } },
                             function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a tab missing a column is refused by the names of the columns',
            shape.made.length === 0 && shape.thrown.indexOf('target_price') !== -1 &&
            shape.thrown.indexOf('status') !== -1, shape.thrown);

  /* ── A WORD THE SCREENS DO NOT KNOW ──────────────────────────────── */
  var bad = stExamplesRun_({ rows: stExamplesWith_('example_shop_items', 0, 'category', 'Spaceship') },
                           function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a category the screen does not know is refused by name, never filed ' +
                 'under Other',
            bad.made.length === 0 && bad.thrown.indexOf('EX_SHOP_A') !== -1 &&
            bad.thrown.indexOf('Spaceship') !== -1 &&
            bad.thrown.indexOf('Household') !== -1, bad.thrown);
  var badStatus = stExamplesRun_({ rows: stExamplesWith_('example_shop_items', 0, 'status', 'maybe') },
                                 function () { return runLoadExamples(); });
  stAssert_(out, 'examples: an item status outside the three the screen knows is refused the same way',
            badStatus.made.length === 0 && badStatus.thrown.indexOf('maybe') !== -1 &&
            badStatus.thrown.indexOf('watching') !== -1, badStatus.thrown);
  var badTrip = stExamplesRun_({ rows: stExamplesWith_('example_trips', 0, 'status', 'maybe') },
                               function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a trip status outside TRIP_STATUSES is refused with the list',
            badTrip.made.length === 0 && badTrip.thrown.indexOf('proposed') !== -1,
            badTrip.thrown);

  /* ── A ROW THAT LOST ITS ID IS NEVER WRITTEN ─────────────────────── */
  var noId = stExamplesRun_({ rows: stExamplesWith_('example_skills', 0, 'id', '') },
                            function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a row with no id is refused — it could never be taken away again',
            noId.made.length === 0 && noId.thrown.indexOf('the id cell is empty') !== -1 &&
            noId.thrown.indexOf('Medication administration') !== -1, noId.thrown);
  var wrongId = stExamplesRun_({ rows: stExamplesWith_('example_skills', 0, 'id', 'SKILL_A') },
                               function () { return runLoadExamples(); });
  stAssert_(out, 'examples: an id without the prefix is refused — the removal job finds the rows ' +
                 'by nothing else',
            wrongId.made.length === 0 && wrongId.thrown.indexOf(EX_PREFIX) !== -1, wrongId.thrown);
  var twin = stExamplesRun_({ rows: stExamplesWith_('example_shop_items', 1, 'id', 'EX_SHOP_A') },
                            function () { return runLoadExamples(); });
  stAssert_(out, 'examples: one id twice is refused rather than one row silently skipped',
            twin.made.length === 0 && twin.thrown.indexOf('used twice') !== -1, twin.thrown);

  /* ── AN ESTIMATE BELONGS TO AN ITEM ──────────────────────────────── */
  var orphan = stExamplesRun_({ rows: stExamplesWith_('example_shop_prices', 0, 'item_id', 'EX_SHOP_Z') },
                              function () { return runLoadExamples(); });
  stAssert_(out, 'examples: an estimate pointing at no item is refused, not written to hang there',
            orphan.made.length === 0 && orphan.thrown.indexOf('EX_SHOP_Z') !== -1 &&
            orphan.thrown.indexOf('example_shop_items') !== -1, orphan.thrown);
  var loose = stExamplesRun_({ rows: stExamplesWith_('example_attempts', 0, 'skill_id', 'EX_SKILL_Z') },
                             function () { return runLoadExamples(); });
  stAssert_(out, 'examples: an attempt at no skill is refused the same way',
            loose.made.length === 0 && loose.thrown.indexOf('EX_SKILL_Z') !== -1, loose.thrown);

  // ── A WORD IS DATA, NOT A METHOD ────────────────────────────────── `constructor`, `__proto__`, `toString` and…
  ['constructor', '__proto__', 'toString', 'hasOwnProperty', 'valueOf'].forEach(function (word) {
    var poison = stExamplesRun_({ rows: stExamplesWith_('example_shop_prices', 0, 'item_id', word) },
                                function () { return runLoadExamples(); });
    stAssert_(out, 'examples: item_id "' + word + '" is a pointer to nothing and is refused, ' +
                   'not written as an estimate hanging off no item',
              poison.made.length === 0 && poison.thrown.indexOf(word) !== -1,
              poison.thrown || JSON.stringify(poison.made));
    var named = stExamplesRun_({ rows: stExamplesWith_('example_trips', 0, 'id', EX_PREFIX + word) },
                               function () { return runLoadExamples(); });
    stAssert_(out, 'examples: and an id ending in "' + word + '" is still one row, written once — ' +
                   'the duplicate check must not answer yes to a word it has never seen',
              named.thrown === '' && stExamplesOf_(named, 'travelTrips').length === 1 &&
              String(stExamplesOf_(named, 'travelTrips')[0].id) === EX_PREFIX + word,
              named.thrown || JSON.stringify(stExamplesOf_(named, 'travelTrips')));
  });

  // ── A DATE THAT IS NOT A DATE ───────────────────────────────────── A cell Sheets stores AS A DATE comes back as…
  var shifted = stExamplesRun_({ rows: stExamplesWith_('example_trips', 0, 'start_date',
                                                       '2026-06-10T04:00:00.000Z') },
                               function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a start_date that arrived as an instant is refused by name, never ' +
                 'written as a trip that starts four hours into the day',
            shifted.made.length === 0 && shifted.thrown.indexOf('start_date') !== -1 &&
            shifted.thrown.indexOf('YYYY-MM-DD') !== -1, shifted.thrown);
  var endShifted = stExamplesRun_({ rows: stExamplesWith_('example_trips', 0, 'end_date', '10/06/2026') },
                                  function () { return runLoadExamples(); });
  stAssert_(out, 'examples: an end_date typed the other way round is refused rather than sorted ' +
                 'as text nobody can read',
            endShifted.made.length === 0 && endShifted.thrown.indexOf('end_date') !== -1,
            endShifted.thrown);
  var loosely = stExamplesRun_({ rows: stExamplesWith_('example_attempts', 0, 'at', '2026-08-06') },
                               function () { return runLoadExamples(); });
  stAssert_(out, 'examples: an attempt at a day rather than a moment is refused — the ladder is ' +
                 'counted in the order things happened',
            loosely.made.length === 0 && loosely.thrown.indexOf('at reads') !== -1, loosely.thrown);
  var undecided = stExamplesRun_({ rows: stExamplesWith_('example_trips', 0, 'decided_at', '') },
                                 function () { return runLoadExamples(); });
  stAssert_(out, 'examples: an empty decided_at is a trip nobody has decided, not a bad cell',
            undecided.thrown === '' &&
            String((stExamplesOf_(undecided, 'travelTrips')[0] || {}).decidedBy) === '',
            undecided.thrown);

  /* ── THE BOOK'S OWN CLOCK ────────────────────────────────────────── */
  var wrongClock = stExamplesRun_({ zone: 'America/New_York' },
                                  function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a catalogue book on another clock is refused whole — this reader ' +
                 'takes a cell\'s UTC components for the words somebody typed',
            wrongClock.made.length === 0 && wrongClock.thrown.indexOf('America/New_York') !== -1 &&
            wrongClock.thrown.indexOf('Etc/GMT') !== -1, wrongClock.thrown);
  var utcBook = stExamplesRun_({ zone: 'Etc/GMT' }, function () { return runLoadExamples(); });
  stAssert_(out, 'examples: and the book the mint tool pins loads exactly as before',
            utcBook.thrown === '' && utcBook.made.length === 6, utcBook.thrown);

  /* ── A NUMBER THAT IS NOT A NUMBER ───────────────────────────────── */
  var money = stExamplesRun_({ rows: stExamplesWith_('example_trips', 0, 'actual_cost', '') },
                             function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a blank cost is nobody said, never zero — and it is refused rather ' +
                 'than read as on budget',
            money.made.length === 0 && money.thrown.indexOf('actual_cost') !== -1, money.thrown);

  /* ── AN EMPTY CATALOGUE IS NOT A BROKEN ONE ──────────────────────── */
  var empty = stExamplesRun_({ rows: { example_shop_items: [], example_shop_prices: [],
                                       example_skills: [], example_attempts: [],
                                       example_trips: [] } },
                             function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a catalogue somebody emptied on purpose writes nothing and says so, ' +
                 'without an error',
            empty.thrown === '' && empty.made.length === 0 && empty.result.length === 5,
            empty.thrown);

  /* ── THE OWNER IS STILL THE FIRST QUESTION ───────────────────────── */
  var nobody = stExamplesRun_({ owner: '' }, function () { return runLoadExamples(); });
  stAssert_(out, 'examples: an owner the users tab does not carry refuses the load before the ' +
                 'catalogue is even read',
            nobody.made.length === 0 && nobody.thrown.indexOf(EX_OWNER_EMAIL) !== -1 &&
            nobody.reads === 0, nobody.thrown);

  /* ── REMOVAL WORKS WITH THE CATALOGUE GONE ───────────────────────── */
  var swept = stExamplesRun_({
    missing: 'example_shop_items', unreachable: 'example_trips',
    live: {
      shopperItems: [{ id: 'EX_SHOP_A' }, { id: 'a real person\'s row' }],
      shopperPrices: [{ id: 'EX_PRICE_A1' }], learnSkills: [{ id: 'EX_SKILL_A' }],
      learnAttempts: [{ id: 'EX_ATT_A1' }], travelTrips: [{ id: 'EX_TRIP_A' }, { id: 'T_REAL' }]
    }
  }, function () { return runRemoveExamples(); });
  stAssert_(out, 'examples: the removal reads the destinations, never the catalogue — a deleted ' +
                 'house cannot strand the rows',
            swept.thrown === '' && swept.reads === 0 && swept.killed.length === 5,
            JSON.stringify(swept.killed));
  stAssert_(out, 'examples: a row that is not ours is not touched',
            swept.killed.indexOf('travelTrips:T_REAL') === -1 &&
            swept.killed.indexOf('travelTrips:EX_TRIP_A') !== -1, JSON.stringify(swept.killed));

  // ── A REFUSAL IS NOT A REMOVAL ──────────────────────────────────── deleteRowById_ answers…
  var refusedDelete = stExamplesRun_({
    refuseDelete: 'EX_TRIP_A',
    live: { shopperItems: [], shopperPrices: [], learnSkills: [], learnAttempts: [],
            travelTrips: [{ id: 'EX_TRIP_A' }] }
  }, function () { return runRemoveExamples(); });
  stAssert_(out, 'examples: a row the tab would not delete is reported as refused and ends the ' +
                 'job loudly — never counted as removed',
            refusedDelete.killed.length === 0 &&
            refusedDelete.thrown.indexOf('EX_TRIP_A') !== -1 &&
            refusedDelete.thrown.indexOf('travelTrips: 0 removed') !== -1,
            refusedDelete.thrown);

  var blindSweep = stExamplesRun_({
    unreadableDest: 'learnAttempts',
    live: { shopperItems: [], shopperPrices: [], learnSkills: [],
            learnAttempts: [{ id: 'EX_ATT_A1' }], travelTrips: [] }
  }, function () { return runRemoveExamples(); });
  stAssert_(out, 'examples: a destination that could not be READ is said to be unread — a tab ' +
                 'nobody could open is not a tab with nothing in it',
            blindSweep.killed.length === 0 &&
            blindSweep.thrown.indexOf('learnAttempts: NOT READ') !== -1 &&
            blindSweep.thrown.indexOf('still there') !== -1, blindSweep.thrown);

  /* ── AND THE LOAD COUNTS NOTHING IT DID NOT DO ───────────────────── */
  var refusedWrite = stExamplesRun_({ refuseWrite: 'learnSkills' },
                                    function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a destination that refuses a row says so — createRow_ answers with an ' +
                 'envelope, and a job that ignores it prints work it never did',
            refusedWrite.thrown.indexOf('EX_SKILL_A') !== -1 &&
            refusedWrite.thrown.indexOf('files rows against a subject') !== -1 &&
            refusedWrite.thrown.indexOf('learnSkills: 0 written') !== -1, refusedWrite.thrown);

  var refusedUpdate = stExamplesRun_({
    live: landed, refuseUpdate: 'shopperItems',
    rows: stExamplesWith_('example_shop_items', 0, 'name', 'A different vacuum')
  }, function () { return runLoadExamples(); });
  stAssert_(out, 'examples: an update the tab refuses is not counted as an update either',
            refusedUpdate.thrown.indexOf('EX_SHOP_A') !== -1 &&
            refusedUpdate.thrown.indexOf('0 written, 0 updated') !== -1, refusedUpdate.thrown);

  var blindWrite = stExamplesRun_({ unreadableDest: 'shopperPrices' },
                                  function () { return runLoadExamples(); });
  stAssert_(out, 'examples: a destination that cannot be read is not written to — appending under ' +
                 'an id that may already be there is how one id becomes two',
            blindWrite.made.filter(function (m) { return m.resource === 'shopperPrices'; }).length === 0 &&
            blindWrite.thrown.indexOf('shopperPrices: NOT WRITTEN') !== -1, blindWrite.thrown);
  stAssert_(out, 'examples: the destinations are read from the SHEET and never from Cache.gs\'s ' +
                 'copy of it — a list older than the tab would double an id',
            stCode_(exDestinationRows_).indexOf('readAll_(sheetFor_(resource))') !== -1 &&
            stCode_(runRemoveExamples).indexOf('listRows_') === -1 &&
            stCode_(exWrite_).indexOf('listRows_') === -1,
            stCode_(exDestinationRows_));

  // ── WHICH OF THESE ROWS A SCREEN WILL ACTUALLY SHOW ─────────────── travelTrips_ drops every EX_ id before…
  var hidden = EX_HIDDEN_RESOURCES.filter(function (resource) {
    return EX_CATALOGUE.filter(function (s) { return s.resource === resource; }).length === 0;
  });
  stAssert_(out, 'examples: every resource named as hidden is one this catalogue actually writes',
            hidden.length === 0, hidden.join(', '));
  stAssert_(out, 'examples: the Business Travel screen does refuse the demo rows, and the ' +
                 'catalogue says so out loud instead of letting a tab be edited into the void',
            stCode_(travelTrips_).indexOf("'EX_'") !== -1 &&
            EX_HIDDEN_RESOURCES.indexOf('travelTrips') !== -1,
            'Travel.gs filters the prefix; EX_HIDDEN_RESOURCES = ' + EX_HIDDEN_RESOURCES.join(', '));
  stAssert_(out, 'examples: a hidden destination is still written and still removed — the rows ' +
                 'did not change, only what is said about them',
            stExamplesOf_(good, 'travelTrips').length === 1 &&
            swept.killed.indexOf('travelTrips:EX_TRIP_A') !== -1,
            JSON.stringify(swept.killed));

  /* ── THE TWO JOBS STAY IN STEP ───────────────────────────────────── */
  var sweepSrc = stCode_(runRemoveExamples);
  var uncovered = EX_CATALOGUE.filter(function (spec) {
    return sweepSrc.indexOf("'" + spec.resource + "'") === -1;
  }).map(function (spec) { return spec.resource; });
  stAssert_(out, 'examples: every destination the loader writes is one the removal walks',
            uncovered.length === 0, uncovered.join(', '));

  /* ── THE ROWS REALLY DID LEAVE THE CODE ──────────────────────────── */
  var loadSrc = stCode_(runLoadExamples);
  stAssert_(out, 'examples: the loader reads the catalogue and carries no list of its own',
            loadSrc.indexOf('exCatalogue_()') !== -1 &&
            loadSrc.indexOf('Dyson') === -1 && loadSrc.indexOf('Columbus') === -1,
            'a second copy in the code is a second thing to edit, and the sheet would lose');
}

// The groups a Settings screen renders.
var ST_CONFIG_GROUPS = { messages: 1, recipients: 1, timing: 1, guard: 1, test: 1,
                         alerts: 1, access: 1, clients: 1, hiringapp: 1, platform: 1, mywork: 1 };

// THE CATALOGUE CAME OUT OF THE CODE — so this is what proves it still works.
function stAlertsCatalog_(out) {
  var heldSheet = hiringAlertsCatalogSheet_, heldLog = hubSysLog_;
  var heldCache = hiringAlertsCatalogCache_;
  var logged = [];
  var shipped = HIRING_ALERTS_CATALOG_SHIPPED;

  // A cache nobody else shares.
  var privateStore = {};
  hiringAlertsCatalogCache_ = function () {
    return {
      get: function (k) { return Object.prototype.hasOwnProperty.call(privateStore, 'c:' + k)
                                 ? privateStore['c:' + k] : null; },
      put: function (k, v) { privateStore['c:' + k] = String(v); },
      remove: function (k) { delete privateStore['c:' + k]; }
    };
  };

  /** A sheet handle over a grid, or one that throws like a dead Drive. */
  var fakeSheet = function (grid, throws) {
    return { getDataRange: function () {
      if (throws) throw new Error('Service Spreadsheets timed out');
      return { getValues: function () { return grid; } };
    } };
  };
  /** The whole shipped list as catalogue rows, each with a note of its own. */
  var gridOf = function (rows) {
    var grid = [['key', 'group', 'default_value', 'note']];
    rows.forEach(function (r) {
      grid.push([r.key, r.group, r.value, 'note for ' + r.key]);
    });
    return grid;
  };
  // A fresh read against `sheet`: both caches dropped, and the once-an-hour log gate reopened, so one case can…
  var use = function (sheet) {
    hiringAlertsCatalogBump_();
    // The PRIVATE store, never CacheService: the said-gate key is shared too, and a test that cleared it would…
    try { hiringAlertsCatalogCache_().remove(HIRING_ALERTS_CATALOG_SAID_KEY); } catch (eC) {}
    hiringAlertsCatalogSheet_ = function () { return sheet; };
    return hiringAlertsCatalog_();
  };
  var byKey = function (cat, key) {
    for (var i = 0; i < cat.rows.length; i++) if (cat.rows[i].key === key) return cat.rows[i];
    return null;
  };

  try {
    hubSysLog_ = function (who, event, message) { logged.push(event + ': ' + message); };

    // ---- 1.
    var full = gridOf(shipped);
    full.push(['zz_selftest_probe_not_a_setting', 'guard', 'probe value', 'a key that exists only in the sheet']);
    var present = use(fakeSheet(full, false));
    stAssert_(out, 'catalogue: the sheet answers, and the sheet is what the screens get',
              present.read === true && present.source === 'sheet' && present.ok === true &&
              present.rows.length === shipped.length + 1 && present.message === '',
              JSON.stringify({ read: present.read, source: present.source,
                               rows: present.rows.length, message: present.message }));
    stAssert_(out, 'catalogue: a key that exists ONLY in the sheet reaches Settings with its note',
              (function () {
                var r = byKey(present, 'zz_selftest_probe_not_a_setting');
                return !!r && r.group === 'guard' && r.value === 'probe value' &&
                       r.note === 'a key that exists only in the sheet';
              })(), 'a key added to the sheet must appear without a publish');
    stAssert_(out, 'catalogue: the sheet wins over the code — every note comes from the row',
              present.rows.every(function (r) { return String(r.note).indexOf('note for ') === 0 ||
                                                       r.key === 'zz_selftest_probe_not_a_setting'; }),
              'a shipped value overrode a cell somebody typed');
    stAssert_(out, 'catalogue: the order of the sheet is the order of the screen',
              present.rows[0].key === shipped[0].key &&
              present.rows[shipped.length].key === 'zz_selftest_probe_not_a_setting',
              'the rows were re-sorted, so the fields move about between reads');

    // ---- 2. a key only the code knows ---------------------------------
    var partial = use(fakeSheet(gridOf(shipped.slice(1)), false));
    stAssert_(out, 'catalogue: a key missing from the sheet is still drawn, from the last-resort copy',
              (function () {
                var r = byKey(partial, shipped[0].key);
                return !!r && r.group === shipped[0].group && r.value === shipped[0].value &&
                       r.note === '';
              })(), 'a key with a live value must never become invisible');
    stAssert_(out, 'catalogue: and the screen is TOLD which key lost its note',
              partial.read === true && partial.ok === false &&
              partial.shipped_only.length === 1 && partial.shipped_only[0] === shipped[0].key &&
              partial.message.indexOf(shipped[0].key) !== -1,
              JSON.stringify({ ok: partial.ok, only: partial.shipped_only }));

    // ---- 3. no house at all -------------------------------------------
    logged.length = 0;
    var gone = use(null);
    stAssert_(out, 'catalogue: with no house the shipped keys answer and nothing goes blank',
              gone.read === false && gone.source === 'shipped' &&
              gone.rows.length === shipped.length && gone.shipped_only.length === shipped.length,
              JSON.stringify({ read: gone.read, rows: gone.rows.length }));
    stAssert_(out, 'catalogue: and it SAYS SO — on the screen and in the log, never silently',
              gone.message.indexOf('could not be read') !== -1 &&
              gone.message.indexOf('still rule') !== -1 &&
              logged.length === 1 &&
              logged[0].indexOf('hiring_alerts_catalog') === 0,
              JSON.stringify({ message: gone.message.slice(0, 80), logged: logged }));
    // ONCE AN HOUR, not once a minute.
    hiringAlertsCatalogBump_();
    var again = hiringAlertsCatalog_();
    stAssert_(out, 'catalogue: the same outage is logged once an hour, and the answer never changes',
              logged.length === 1 && again.message === gone.message &&
              again.rows.length === gone.rows.length,
              JSON.stringify({ logged: logged.length }));

    // ---- 4. the house is there and will not be read --------------------
    var dead = use(fakeSheet(null, true));
    stAssert_(out, 'catalogue: a tab that throws is the same answer as no tab, with its own reason',
              dead.read === false && dead.rows.length === shipped.length &&
              dead.message.indexOf('could not be read') !== -1 &&
              dead.message.indexOf('timed out') !== -1,
              dead.message.slice(0, 120));

    // ---- 5. a header that cannot be trusted ----------------------------
    var noKey = use(fakeSheet([['name', 'group', 'default_value', 'note'],
                               ['sms_recipients', 'recipients', 'x', 'y']], false));
    stAssert_(out, 'catalogue: a header with no `key` column is refused, not guessed at',
              noKey.read === false && noKey.rows.length === shipped.length &&
              noKey.message.indexOf('`key` column') !== -1,
              noKey.message.slice(0, 120));
    var headerOnly = use(fakeSheet([['key', 'group', 'default_value', 'note']], false));
    stAssert_(out, 'catalogue: a tab with a header and no rows is EMPTY, not a catalogue of nothing',
              headerOnly.read === false && headerOnly.rows.length === shipped.length,
              JSON.stringify({ read: headerOnly.read, rows: headerOnly.rows.length }));

    // ---- 6. a key typed twice ------------------------------------------
    var twice = gridOf(shipped);
    twice.push([shipped[0].key, shipped[0].group, 'the correction', 'the corrected note']);
    var dup = use(fakeSheet(twice, false));
    stAssert_(out, 'catalogue: a key typed twice keeps its first place and its LAST words',
              dup.doubled === 1 && dup.rows.length === shipped.length &&
              dup.rows[0].key === shipped[0].key && dup.rows[0].value === 'the correction' &&
              dup.rows[0].note === 'the corrected note',
              JSON.stringify({ doubled: dup.doubled, rows: dup.rows.length,
                               first: dup.rows[0].value }));

    // ---- 7. the columns are found by NAME ------------------------------
    var moved = [['note', 'default_value', 'group', 'key']];
    shipped.forEach(function (r) { moved.push(['note for ' + r.key, r.value, r.group, r.key]); });
    var shifted = use(fakeSheet(moved, false));
    stAssert_(out, 'catalogue: the columns are found by name, so rearranging the sheet changes nothing',
              shifted.read === true && shifted.ok === true &&
              shifted.rows.length === shipped.length &&
              shifted.rows[0].key === shipped[0].key &&
              shifted.rows[0].note === 'note for ' + shipped[0].key,
              JSON.stringify(shifted.rows[0]));

    // ---- 8.
    var badGroup = gridOf(shipped);
    var guardAt = -1;
    for (var bg = 0; bg < shipped.length; bg++) {
      if (shipped[bg].key === 'staff_guard_mode') { guardAt = bg; break; }
    }
    badGroup[guardAt + 1][1] = 'guards';
    var typo = use(fakeSheet(badGroup, false));
    stAssert_(out, 'catalogue: a group the platform does not draw falls back to the shipped one',
              (function () {
                var r = byKey(typo, 'staff_guard_mode');
                return !!r && r.group === 'guard' && r.note === 'note for staff_guard_mode';
              })(), 'a mistyped group left the key on no screen at all');
    stAssert_(out, 'catalogue: and the screen is TOLD, by key and by the name that was typed',
              typo.ok === false && typo.repaired.length === 1 &&
              typo.repaired[0].indexOf('staff_guard_mode') === 0 &&
              typo.repaired[0].indexOf('"guards"') !== -1 &&
              typo.message.indexOf('staff_guard_mode') !== -1,
              JSON.stringify({ ok: typo.ok, repaired: typo.repaired }));
    var wildGroup = gridOf([{ key: 'sheet_only_wild', group: 'nowhere', value: 'x' }]);
    var wild = use(fakeSheet(wildGroup, false));
    stAssert_(out, 'catalogue: a sheet-only key with an unknown group falls to the general list',
              (function () {
                var r = byKey(wild, 'sheet_only_wild');
                return !!r && r.group === HIRING_ALERTS_CATALOG_GROUP_FALLBACK;
              })(), 'a key with no shipped group to fall back to must still be visible somewhere');

    // ---- 9.
    var blanked = gridOf(shipped);
    var floorAt = -1;
    for (var bf = 0; bf < shipped.length; bf++) {
      if (shipped[bf].key === 'escalation_floor_sms') { floorAt = bf; break; }
    }
    blanked[floorAt + 1][2] = '';
    var cleared = use(fakeSheet(blanked, false));
    stAssert_(out, 'catalogue: a cleared default falls back to the one shipped with the code',
              (function () {
                var r = byKey(cleared, 'escalation_floor_sms');
                return !!r && r.value === shipped[floorAt].value && r.value.indexOf('+1') === 0;
              })(), 'clearing a cell would have emptied the escalation floor');
    stAssert_(out, 'catalogue: and that correction is named too, never silent',
              cleared.ok === false && cleared.repaired.length === 1 &&
              cleared.repaired[0].indexOf('escalation_floor_sms') === 0 &&
              cleared.message.indexOf('escalation_floor_sms') !== -1,
              JSON.stringify({ ok: cleared.ok, repaired: cleared.repaired }));
    var legitimatelyBlank = byKey(cleared, 'test_mode');
    stAssert_(out, 'catalogue: a default that is blank in BOTH copies stays blank',
              !!legitimatelyBlank && legitimatelyBlank.value === '' &&
              cleared.repaired.length === 1,
              'a blank the code agrees with was treated as damage');

    // ---- 10.
    var healGrid = [['key', 'value', 'note'],
                    ['escalation_floor_sms', '#ERROR!', 'n'],
                    ['zz_selftest_probe_not_a_setting', '#ERROR!', 'n'],
                    ['messages_paused', '#ERROR!', 'n']];
    var wrote = {};
    var healSheet = {
      getDataRange: function () { return { getValues: function () { return healGrid; } }; },
      getRange: function (row, col) {
        return { setValue: function (v) { wrote[row + ':' + col] = v; healGrid[row - 1][col - 1] = v; } };
      },
      deleteRow: function () { throw new Error('the heal must not delete a row here'); }
    };
    // A key ONLY the sheet carries, with an empty default — the one case the code has nothing to check the blank…
    var healCatalog = gridOf(shipped);
    healCatalog.push(['zz_selftest_probe_not_a_setting', 'guard', '', 'only in the sheet']);
    logged.length = 0;
    use(fakeSheet(healCatalog, false));
    hiringAlertsHeal_(healSheet);
    // hubCellSafe_ on the way in: a default that starts with '+' is read by Sheets as a formula, which is how this…
    stAssert_(out, 'catalogue: the heal restores a real default over a #ERROR! cell',
              wrote['2:2'] === hubCellSafe_(shipped[floorAt].value),
              JSON.stringify({ wrote: wrote['2:2'] }));
    stAssert_(out, 'catalogue: a blank default only the SHEET knows is left alone, not written',
              wrote['3:2'] === undefined && healGrid[2][1] === '#ERROR!',
              JSON.stringify({ wrote: wrote['3:2'], cell: healGrid[2][1] }));
    stAssert_(out, 'catalogue: and it says which cell it would not blank',
              logged.some(function (l) {
                return l.indexOf('hiring_alerts_not_healed') === 0 &&
                       l.indexOf('zz_selftest_probe_not_a_setting') !== -1;
              }), JSON.stringify(logged));
    // AND NOTHING CHANGED FOR THE FORTY-FIVE: a default that is blank in both copies is a real default, and the…
    stAssert_(out, 'catalogue: a blank BOTH copies agree on still heals the cell to blank',
              wrote['4:2'] === '' && healGrid[3][1] === '',
              JSON.stringify({ wrote: wrote['4:2'], cell: healGrid[3][1] }));

    // ---- 11.
    var oddNames = gridOf(shipped);
    oddNames.push(['constructor', 'guard', 'still a value', 'a key named like a prototype member']);
    oddNames.push(['toString', 'guard', 'also a value', 'another one']);
    oddNames.push(['__proto__', 'guard', 'cannot be held', 'the one that cannot be stored']);
    var odd = use(fakeSheet(oddNames, false));
    stAssert_(out, 'catalogue: a key named after a prototype member is a row like any other',
              (function () {
                var c = byKey(odd, 'constructor'), t = byKey(odd, 'toString');
                return !!c && c.value === 'still a value' && !!t && t.value === 'also a value' &&
                       odd.doubled === 0;
              })(), JSON.stringify({ doubled: odd.doubled, rows: odd.rows.length }));
    stAssert_(out, 'catalogue: __proto__ is REFUSED and named — never silently dropped',
              byKey(odd, '__proto__') === null && odd.refused.length === 1 &&
              odd.refused[0] === '__proto__' && odd.ok === false &&
              odd.message.indexOf('__proto__') !== -1,
              JSON.stringify({ refused: odd.refused, message: odd.message.slice(0, 120) }));
    var twiceOdd = gridOf(shipped);
    twiceOdd.push(['constructor', 'guard', 'first', 'first note']);
    twiceOdd.push(['constructor', 'guard', 'second', 'second note']);
    var oddDup = use(fakeSheet(twiceOdd, false));
    stAssert_(out, 'catalogue: and such a key typed twice obeys the same duplicate law',
              oddDup.doubled === 1 && byKey(oddDup, 'constructor').value === 'second',
              JSON.stringify({ doubled: oddDup.doubled }));
  } finally {
    hiringAlertsCatalogSheet_ = heldSheet;
    hubSysLog_ = heldLog;
    hiringAlertsCatalogCache_ = heldCache;
    hiringAlertsCatalogBump_();
  }

  // ---- the last-resort copy's own laws --------------------------------- It is the thing that answers on a first…
  var shipKeys = {}, shipDup = [], shipStray = [], shipNoted = [];
  shipped.forEach(function (d) {
    if (shipKeys[d.key]) shipDup.push(d.key);
    shipKeys[d.key] = true;
    if (!ST_CONFIG_GROUPS[d.group || 'alerts']) shipStray.push(d.key + ' → "' + d.group + '"');
    if (Object.prototype.hasOwnProperty.call(d, 'note')) shipNoted.push(d.key);
  });
  stAssert_(out, 'catalogue: no key is in the last-resort copy twice',
            shipDup.length === 0, shipDup.join(', '));
  stAssert_(out, 'catalogue: every last-resort key belongs to a group a screen renders',
            shipStray.length === 0, shipStray.join(', '));
  stAssert_(out, 'catalogue: the last-resort copy carries NO notes — the prose stays in the sheet',
            shipNoted.length === 0,
            'a note is back in the code: ' + shipNoted.join(', '));
  stAssert_(out, 'catalogue: every last-resort row is a key, a group and a default',
            shipped.every(function (d) {
              return String(d.key || '').trim() !== '' &&
                     String(d.group || '').trim() !== '' && d.value !== undefined;
            }), 'a row of the shipped copy is incomplete');

  // ---- who asks the catalogue, and who must never ----------------------
  stAssert_(out, 'catalogue: the seeder, the heal and both doors read it through the one reader',
            stCode_(hiringAlertsSheet_).indexOf('hiringAlertsCatalogRows_()') !== -1 &&
            stCode_(hiringAlertsHeal_).indexOf('hiringAlertsCatalogRows_()') !== -1 &&
            stCode_(HUB_ACTIONS.hiringAlertsGet).indexOf('hiringAlertsCatalog_()') !== -1 &&
            stCode_(HUB_ACTIONS.hiringAlertsSet).indexOf('hiringAlertsCatalogRows_()') !== -1,
            'a second way of asking which keys exist is a second list to keep in step');
  // WHERE THE HOUSE IS OPENED, SAID CORRECTLY.
  stAssert_(out, 'catalogue: reading a CELL never names the catalogue',
            stCode_(hubCfgOn_).indexOf('Catalog') === -1 &&
            stCode_(hubCfgInt_).indexOf('Catalog') === -1,
            'the widest reads on this platform would pay for a second book');
  stAssert_(out, 'catalogue: the seeder is where the house IS opened, once per values-cache miss',
            stCode_(hiringAlertsSheet_).indexOf('hiringAlertsCatalogRows_()') !== -1 &&
            stCode_(hiringAlerts_).indexOf('hiringAlertsSheet_()') !== -1,
            'the seeder stopped asking the catalogue, so a key added to the sheet gets no row');
  stAssert_(out, 'catalogue: and that open is behind a memo, a 300s entry and the house memo',
            stCode_(hiringAlertsCatalog_).indexOf('HIRING_ALERTS_CATALOG_MEMO') !== -1 &&
            stCode_(hiringAlertsCatalog_).indexOf('HIRING_ALERTS_CATALOG_TTL') !== -1 &&
            stCode_(houseSheetFor_).indexOf('HOUSE_SHEET_MEMO') !== -1,
            'without all three the seeder would open a second book on every read');
  stAssert_(out, 'catalogue: the reader never CREATES the tab it reads',
            stCode_(hiringAlertsCatalogSheet_).indexOf('hubTabEnsure_') === -1 &&
            stCode_(hiringAlertsCatalogSheet_).indexOf('houseSheetFor_') !== -1,
            'an empty tab made by a reader is indistinguishable from a catalogue that lost its rows');
  stAssert_(out, 'catalogue: the Settings answer carries where the keys came from',
            stCode_(HUB_ACTIONS.hiringAlertsGet).indexOf('catalogue:') !== -1 &&
            stCode_(HUB_ACTIONS.hiringAlertsGet).indexOf('catalog.message') !== -1,
            'a screen that cannot tell the sheet from the fallback cannot say so');
  // THE SECTION ABOVE MAY NOT TOUCH THE SHARED CACHE — asserted, not trusted.
  var CACHE_SVC = 'Cache' + 'Service';
  stAssert_(out, 'catalogue: the reader reaches its cache through one function, so a test can stand elsewhere',
            stCode_(hiringAlertsCatalog_).indexOf(CACHE_SVC) === -1 &&
            stCode_(hiringAlertsCatalogBump_).indexOf(CACHE_SVC) === -1 &&
            stCode_(hiringAlertsCatalogCache_).indexOf(CACHE_SVC) !== -1,
            'the reader names the script cache itself, so the self-test cannot be kept out of it');
  stAssert_(out, 'catalogue: and this section never names the SHARED cache',
            stCode_(stAlertsCatalog_).split(CACHE_SVC).length === 1,
            'a fabricated catalogue in the shared cache is a fabricated row in the live tab');
  // ONE VOCABULARY, TWO PLACES THAT MUST NOT DRIFT.
  var vocabMismatch = [];
  HIRING_ALERTS_CATALOG_GROUPS.forEach(function (g) {
    if (!ST_CONFIG_GROUPS[g]) vocabMismatch.push(g + ' is in the reader and not in ST_CONFIG_GROUPS');
  });
  for (var sg in ST_CONFIG_GROUPS) {
    if (ST_CONFIG_GROUPS.hasOwnProperty(sg) && HIRING_ALERTS_CATALOG_GROUPS.indexOf(sg) === -1) {
      vocabMismatch.push(sg + ' is in ST_CONFIG_GROUPS and not in the reader');
    }
  }
  stAssert_(out, 'catalogue: the reader and this file know the SAME group vocabulary',
            vocabMismatch.length === 0, vocabMismatch.join(', '));
}

// THE IST CONFIGURATION, HELD STILL FOR ONE ASSERTION.
function stWithIstConfig_(cfg, source, fn) {
  var heldCfg = IST_CONFIG_MEMO;
  var heldSrc = IST_CONFIG_SOURCE;
  IST_CONFIG_MEMO = cfg || {};
  IST_CONFIG_SOURCE = source || 'sheet';
  try { return fn(); }
  finally { IST_CONFIG_MEMO = heldCfg; IST_CONFIG_SOURCE = heldSrc; }
}

/** The shipped floor as a plain map — what a read that failed must answer. */
function stIstFloor_() {
  var floor = {};
  IST_CONFIG_DEFAULTS.forEach(function (d) { floor[d.key] = String(d.value); });
  return floor;
}

// ------------------------------------------------------------------ IST CONFIG — the lane's vocabulary, and the…
function stIstConfig_(out) {
  var floor = stIstFloor_();

  /* ---- the shape of the declaration itself ---- */
  stAssert_(out, 'ist config: every key is declared once, with a group and a note',
            (function () {
              var seen = {}, ok = IST_CONFIG_DEFAULTS.length > 0;
              IST_CONFIG_DEFAULTS.forEach(function (d) {
                if (seen[d.key]) ok = false;
                seen[d.key] = true;
                if (!d.note || !d.group) ok = false;
              });
              return ok;
            })(),
            'a key with no note is a cell nobody can safely edit');

  /* ---- THE SHEET IS THERE ---- */
  stWithIstConfig_({ ist_non_person_names: 'OPEN, TBD' }, 'sheet', function () {
    stEq_(out, 'ist config: a cell in the sheet is what the reader answers',
          istCfgList_('ist_non_person_names').join('|'), 'OPEN|TBD');
    stAssert_(out, 'ist config: a key the sheet does not carry keeps its shipped value',
              istCfgText_('ist_stale_marker') === floor.ist_stale_marker,
              istCfgText_('ist_stale_marker'));
  });

  /* ---- THE SHEET IS MISSING (or unreadable): the floor, and SAID ---- */
  var floorLabels = istCfgBits_(floor.ist_non_person_names).length;
  stWithIstConfig_(floor, 'shipped', function () {
    stAssert_(out, 'ist config: a read that failed answers the shipped floor',
              istCfgText_('ist_gate_certification') === 'dodd' &&
              istCfgList_('ist_non_person_names').length === floorLabels,
              istCfgList_('ist_non_person_names').join('|'));
    stAssert_(out, 'ist config: a read that failed says so rather than looking normal',
              istConfigBlind_() === true && istConfigSource_() === 'shipped',
              istConfigSource_());
  });
  stWithIstConfig_(floor, 'last known', function () {
    stAssert_(out, 'ist config: the last copy that really came from the sheet counts as blind too',
              istConfigBlind_() === true, istConfigSource_());
  });

  /* ---- AN EMPTY OR NONSENSICAL CELL IS NOT AN EMPTY WORLD ---- */
  stWithIstConfig_({ ist_non_person_names: '', ist_cert_labels: ' , ; ',
                     ist_page_size: 'twenty', ist_cert_expiring_days: '0' }, 'sheet', function () {
    stAssert_(out, 'ist config: an empty list cell falls back to the shipped list',
              istCfgList_('ist_non_person_names').length === floorLabels,
              istCfgList_('ist_non_person_names').join('|'));
    stAssert_(out, 'ist config: a catalogue that parses to nothing is not a catalogue of nothing',
              istCfgPairs_('ist_cert_labels').order.length === 8,
              istCfgPairs_('ist_cert_labels').order.join('|'));
    stEq_(out, 'ist config: a page size that is not a number keeps the shipped one',
          istCfgInt_('ist_page_size', 5, 200), 25);
    stEq_(out, 'ist config: an expiring window of zero keeps the shipped one',
          istCfgInt_('ist_cert_expiring_days', 1, 365), 60);
  });

  /* ---- A ROW ONLY IN THE SHEET ---- */
  stWithIstConfig_({ ist_invented_key: 'hello' }, 'sheet', function () {
    var answer = HUB_ACTIONS.istConfigGet({}, { email: 'a@b', role: 'admin' });
    var named = false;
    (answer.data.unknown_rows || []).forEach(function (r) {
      if (r.key === 'ist_invented_key') named = true;
    });
    stAssert_(out, 'ist config: a row only in the sheet is NAMED, never swallowed', named,
              JSON.stringify(answer.data.unknown_rows));
    stAssert_(out, 'ist config: the rows it does read still answer beside it',
              answer.data.rows.length === IST_CONFIG_DEFAULTS.length,
              String(answer.data.rows.length));
  });

  /* ---- THE TWO DOORS ---- */
  stAssert_(out, 'ist config: a save of a key this version does not know REFUSES out loud',
            (function () {
              var r = HUB_ACTIONS.istConfigSet({ values: { not_a_key: 'x' } },
                                               { email: 'a@b', role: 'admin' });
              return r.status === 400 && String(r.message).indexOf('not_a_key') !== -1;
            })(),
            'a version-skewed screen must never read as "save does nothing"');
  stAssert_(out, 'ist config: neither door answers an employee or a service',
            HUB_ACTIONS.istConfigGet({}, { email: 'a@b', role: 'staff' }).status === 403 &&
            HUB_ACTIONS.istConfigSet({ values: {} }, { email: 'a@b', role: 'staff' }).status === 403 &&
            HUB_ACTIONS.istConfigGet({}, { email: 'a@b', role: 'admin', is_service: true }).status === 403);
  stAssert_(out, 'ist config: only an administrator saves — the manager role reads but never writes',
            HUB_ACTIONS.istConfigSet({ values: { ist_valid_days: '30' } },
                                     { email: 'a@b', role: 'manager' }).status === 403 &&
            HUB_POLICY.istConfigSet.roles.join(',') === 'admin');

  /* ---- WHO IS NOT A PERSON ---- */
  stWithIstConfig_(floor, 'sheet', function () {
    stAssert_(out, 'ist config: every shipped coverage label is skipped',
              istNotAPerson_('OPEN') && istNotAPerson_('open') && istNotAPerson_('NEW') &&
              istNotAPerson_('FAMILY') && istNotAPerson_('Location') && istNotAPerson_('NURSE') &&
              istNotAPerson_('STAFF') && istNotAPerson_('TBD') &&
              istNotAPerson_('WORKSHOP') && istNotAPerson_('Workshop AM'),
              'a coverage label left in grows an obligation against nobody');
    stAssert_(out, 'ist config: a real name is a person',
              !istNotAPerson_('Cassy Majors') && !istNotAPerson_('Ana Lopez'),
              'a rule that eats a name is worse than one that lets a label through');
    stAssert_(out, 'ist config: a blank cell is not a person either',
              istNotAPerson_('') && istNotAPerson_('   '));
  });
  stWithIstConfig_({ ist_non_person_names: 'OPEN', ist_non_person_contains: '' }, 'sheet',
    function () {
      stAssert_(out, 'ist config: a shortened list really does shorten the rule',
                istNotAPerson_('OPEN') && !istNotAPerson_('TBD'),
                'the cell is the rule, or it is decoration');
    });

  // ---- THE CERTIFICATION NOTE: a note about a CERTIFICATE, never a verdict about a person, and never a sentence a…
  var CERTS = {
    withdodd: { certs: { dodd: { expires: '2099-01-01' } } },
    expired: { certs: { dodd: { expires: '2020-03-04' } } },
    unreadable: { certs: { dodd: { expires: 'soon-ish' } } },
    other: { certs: { cpr: { expires: '2099-01-01' } } }
  };
  stWithIstConfig_(floor, 'sheet', function () {
    stEq_(out, 'ist note: a valid certificate says nothing at all',
          istCertNote_(CERTS, 'withdodd'), '');
    stEq_(out, 'ist note: no certificate on file reads exactly as it always did',
          istCertNote_(CERTS, 'other'), 'no DODD certification on file');
    stEq_(out, 'ist note: an unknown person reads exactly as it always did',
          istCertNote_(CERTS, 'nobody'), 'no DODD certification on file');
    stEq_(out, 'ist note: an expired certificate reads exactly as it always did',
          istCertNote_(CERTS, 'expired'), 'DODD expired 2020-03-04');
    stEq_(out, 'ist note: an unreadable date is said out loud, not swallowed',
          istCertNote_(CERTS, 'unreadable'), 'DODD date unreadable: soon-ish');
  });
  stWithIstConfig_({ ist_gate_certification: 'cpr', ist_gate_certification_label: 'CPR' },
    'sheet', function () {
      stEq_(out, 'ist note: the gate certification is the cell, not a literal',
            istCertNote_(CERTS, 'other'), '');
      stEq_(out, 'ist note: and the name in the sentence follows it',
            istCertNote_(CERTS, 'withdodd'), 'no CPR certification on file');
    });
  // THE LAW THAT OUTRANKS THE REST.
  stWithIstConfig_(floor, 'shipped', function () {
    stEq_(out, 'ist note: a blind config still reports on the certificate, unchanged',
          istCertNote_(CERTS, 'withdodd'), '');
    stEq_(out, 'ist note: and still names the missing one the same way',
          istCertNote_(CERTS, 'other'), 'no DODD certification on file');
  });

  /* ---- THE COURSE CATALOGUE, through Certs.gs' one door ---- */
  stWithIstConfig_(floor, 'sheet', function () {
    stEq_(out, 'ist config: the shipped catalogue is the eight courses it always was',
          certKeys_().join('|'), 'dodd|cpr|med1|med2|med3|mais|money|mandt');
    stEq_(out, 'ist config: a course reads by the name it always did',
          certLabel_('dodd'), 'DODD 8-Hour');
    stEq_(out, 'ist config: the expiring window is the sixty days it always was',
          certExpiringDays_(), 60);
    stEq_(out, 'ist config: the estate tabs are the ones they always were',
          [certSourceTab_('trainings'), certSourceTab_('mais'), certSourceTab_('master')].join('|'),
          'Trainings Status|Med Del Certs (MAIS)|Master');
    stEq_(out, 'ist config: the Master join is the seven columns it always was',
          certMasterColumns_().dodd_8_hour_exp + '|' + certMasterColumns_().mandt_exp_date,
          'dodd|mandt');
    stEq_(out, 'ist config: the tracker join still reads both DODD spellings',
          certTrainingKeys_()['dodd 8-hour exp'] + '|' + certTrainingKeys_()['dodd 8 hour exp'],
          'dodd|dodd');
  });
  stWithIstConfig_({ ist_cert_labels: 'dodd=Eight Hour, cpr=First Aid',
                     ist_cert_source_tabs: 'master=Master 2026' }, 'sheet', function () {
    stEq_(out, 'ist config: an edited catalogue reaches every reader of it',
          certLabel_('dodd') + '|' + certKeys_().join('|'), 'Eight Hour|dodd|cpr');
    stEq_(out, 'ist config: a tab renamed in the cell is the tab that is opened',
          certSourceTab_('master'), 'Master 2026');
    stEq_(out, 'ist config: a tab NOT named in the cell keeps its shipped name',
          certSourceTab_('mais'), 'Med Del Certs (MAIS)');
  });
  // A CATALOGUE THAT READS EMPTY WOULD REPORT EVERY PERSON AS HOLDING NOTHING.
  stWithIstConfig_({ ist_cert_labels: '' }, 'sheet', function () {
    stAssert_(out, 'ist config: an empty catalogue cell never empties the matrix',
              certKeys_().length === 8 && certMatrixColumns_().length === 8,
              certKeys_().join('|'));
  });

  // ---- WHAT A CATALOGUE EDIT MAY AND MAY NOT DO TO THE MATRIX ---- The law both checks serve: nothing anybody…
  stWithIstConfig_({ ist_cert_labels: 'dodd=DODD 8-Hour, cpr=CPR / First Aid' }, 'sheet',
    function () {
      stAssert_(out, 'ist matrix: a course dropped from the catalogue is still computed',
                certMatrixColumns_().length === 8 &&
                certMatrixColumns_().indexOf('mandt') !== -1,
                certMatrixColumns_().join('|'));
    });
  stWithIstConfig_({ ist_cert_labels: floor.ist_cert_labels + ', bbp=Bloodborne Pathogens' },
    'sheet', function () {
      var answerable = certAnswerableKeys_();
      var known = { dodd: { status: 'valid', expires: '2099-01-01' } };
      stAssert_(out, 'ist matrix: a course a source can answer for is known as such',
                answerable.dodd === true && answerable.mais === true &&
                answerable.mandt === true && !answerable.bbp,
                Object.keys(answerable).sort().join('|'));
      stAssert_(out, 'ist matrix: a course added to the catalogue alone is drawn, not asserted',
                certMatrixColumns_().indexOf('bbp') !== -1);
      stEq_(out, 'ist matrix: a course nothing can source never reads valid',
            certMatrixCell_(known, 'bbp', answerable).status, '');
      stEq_(out, 'ist matrix: and it never adds to needs-attention either',
            certMatrixCell_(known, 'bbp', answerable).attention, 0);
      stEq_(out, 'ist matrix: a sourced course with no entry still reads valid, as it always did',
            certMatrixCell_(known, 'cpr', answerable).status, 'valid');
      stEq_(out, 'ist matrix: a person nobody tracks still reads missing, as it always did',
            certMatrixCell_(null, 'cpr', answerable).status, 'missing');
      stEq_(out, 'ist matrix: and that one counts',
            certMatrixCell_(null, 'cpr', answerable).attention, 1);
      stEq_(out, 'ist matrix: an expired record is its own status and counts',
            certMatrixCell_({ dodd: { status: 'expired', expires: '2020-01-01' } },
                            'dodd', answerable).attention, 1);
    });

  /* ---- THE GATE CERTIFICATION IS A KEY, AND A WRONG ONE MAY NOT ACCUSE ---- */
  stWithIstConfig_({ ist_gate_certification: 'DODD', ist_gate_certification_label: 'DODD' },
    'sheet', function () {
      stEq_(out, 'ist note: the NAME typed where the key goes does not uncertify the company',
            istCertNote_(CERTS, 'withdodd'), '');
    });
  stWithIstConfig_({ ist_gate_certification: 'dodd8' }, 'sheet', function () {
    stEq_(out, 'ist note: a course key that does not exist falls back to the shipped one',
          istCertNote_(CERTS, 'other'), 'no DODD certification on file');
  });
  // the course list shrank under the gate: the key AND its name go back together
  stWithIstConfig_({ ist_gate_certification: 'cpr', ist_gate_certification_label: 'CPR',
                     ist_cert_labels: 'dodd=DODD 8-Hour' }, 'sheet', function () {
    stEq_(out, 'ist note: a refused gate takes its name back with it — never "CPR" about DODD data',
          istCertNote_(CERTS, 'expired'), 'DODD expired 2020-03-04');
    stEq_(out, 'ist note: the label is reported as answering its shipped value',
          !!istConfigProblems_().ist_gate_certification_label, true);
  });
  stAssert_(out, 'ist config: a gate certification outside the course list REFUSES',
            (function () {
              var r = HUB_ACTIONS.istConfigSet({ values: { ist_gate_certification: 'DODD' } },
                                               { email: 'a@b', role: 'admin' });
              return r.status === 400 && String(r.message).indexOf('DODD') !== -1;
            })(),
            'a silent fallback is a save that looked like it worked');
  stAssert_(out, 'ist config: a course added in the SAME save is a valid gate',
            (function () {
              try {
                var r = HUB_ACTIONS.istConfigSet({ values: {
                  ist_cert_labels: 'bbp=Bloodborne Pathogens', ist_gate_certification: 'bbp' } },
                  { email: 'a@b', role: 'admin' });
                return r.status !== 400;
              } catch (e) {
                // past the check and into the sheet, which needs Google here
                return true;
              }
            })(),
            'checking against the catalogue as it WAS would refuse a legitimate save');

  stIstConfigTyped_(out, floor);
}

/** The declared types, the doors that enforce them, the heal, and every Apps Script reader of a new key. */
function stIstConfigTyped_(out, floor) {
  /* ---- every cell checked by its declared type ---- */
  var badShipped = IST_CONFIG_DEFAULTS.filter(function (d) { return istConfigCheck_(d.key, d.value) !== ''; })
    .map(function (d) { return d.key; });
  stAssert_(out, 'ist types: every declared value passes its own check', badShipped.length === 0,
            badShipped.join(', '));
  var refusedEach = [['ist_valid_days', 'forever'], ['ist_trainer_must_be_free', 'maybe'],
                     ['ist_trained_scope', 'everyone'], ['ist_status_tints', 'owed=gold'],
                     ['ist_cert_source_fields', 'master.name=Employee Name'],
                     ['ist_note_expired', '{who} expired'], ['ist_cert_source_tabs', 'roster=Roster'],
                     ['ist_cert_tracker_statuses', '*=valid'], ['ist_non_person_names', ' , ; ']]
    .filter(function (c) { return !istConfigCheck_(c[0], c[1]); }).map(function (c) { return c[0]; });
  stAssert_(out, 'ist types: a bad cell of every type is refused', refusedEach.length === 0,
            refusedEach.join(', '));

  stWithIstConfig_(floor, 'sheet', function () {
    stAssert_(out, 'ist types: each new key reads the behaviour the code had',
              istCfgChoice_('ist_trained_scope') === 'house' && istCfgYes_('ist_trainer_must_be_free') &&
              istCfgChoice_('ist_trainer_when_no_hm') === 'approver' && istCfgYes_('ist_assigner_owns_training') &&
              istCfgYes_('ist_pair_requires_overlap') && istCfgInt_('ist_valid_days') === 0 &&
              istCfgInt_('ist_roster_lookback_days') === 0 && istCfgChoice_('ist_requirements_window') === 'own' &&
              istCfgInt_('ist_matrix_page_size') === 12 && istCfgInt_('ist_dashboard_months') === 12);
  });
  stWithIstConfig_({}, 'sheet', function () {
    stAssert_(out, 'ist types: an absent cell is the declared value',
              istCfgChoice_('ist_trained_scope') === 'house' && istCfgInt_('ist_valid_days') === 0 &&
              istCfgYes_('ist_trainer_must_be_free'));
  });
  stWithIstConfig_({ ist_valid_days: 'forever', ist_trained_scope: 'Client', ist_trainer_must_be_free: 'no',
                     ist_dashboard_months: '99', ist_status_tints: 'owed=gold' }, 'sheet', function () {
    stAssert_(out, 'ist types: an edited cell answers itself; a refused one answers the declared value',
              istCfgInt_('ist_valid_days') === 0 && istCfgChoice_('ist_trained_scope') === 'client' &&
              istCfgYes_('ist_trainer_must_be_free') === false && istCfgInt_('ist_dashboard_months') === 12 &&
              istCfgText_('ist_status_tints') === floor.ist_status_tints);
    var probs = istConfigProblems_();
    stAssert_(out, 'ist types: every refused cell is reported, and only those',
              Object.keys(probs).sort().join('|') === 'ist_dashboard_months|ist_status_tints|ist_valid_days',
              JSON.stringify(probs));
    var answer = HUB_ACTIONS.istConfigGet({}, { email: 'a@b', role: 'admin' });
    var row = null;
    answer.data.rows.forEach(function (r) { if (r.key === 'ist_valid_days') row = r; });
    stAssert_(out, 'ist types: the read sends the resolved value, the raw cell, its type, limits and problem',
              !!row && row.value === '0' && row.raw === 'forever' && row.type === 'int' && row.min === 0 &&
              row.max === 3650 && !!row.problem, JSON.stringify(row));
    stAssert_(out, 'ist types: the read sends the declared groups, the first-shift rules among them',
              (answer.data.groups || []).some(function (g) { return g.id === 'first_shift'; }));
  });

  var refused = HUB_ACTIONS.istConfigSet({ values: { ist_valid_days: 'forever', ist_status_tints: 'owed=gold' } },
                                         { email: 'a@b', role: 'admin' });
  stAssert_(out, 'ist types: a save the declaration refuses answers 400 naming every key, and writes nothing',
            refused.status === 400 && /ist_valid_days/.test(refused.message) &&
            /ist_status_tints/.test(refused.message) && /^Not saved/.test(refused.message),
            JSON.stringify(refused));

  /* ---- THE HEAL: missing keys are added; a value already there is never overwritten ---- */
  var grid = [['key', 'value', 'note'], ['ist_valid_days', '365', 'a note somebody wrote'],
              ['ist_cert_expiring_days', '#ERROR!', 'n']];
  var sheet = {
    isRuntimeBacked: false,
    getDataRange: function () { return { getValues: function () { return grid.map(function (r) { return r.slice(); }); } }; },
    appendRow: function (r) { grid.push(r.slice()); },
    getRange: function (r, c) { return { setValue: function (v) { grid[r - 1][c - 1] = v; } }; },
    deleteRow: function (i) { grid.splice(i - 1, 1); }
  };
  var heldEnsure = hubTabEnsure_, heldMemo = IST_CONFIG_MEMO, heldSrc = IST_CONFIG_SOURCE;
  try {
    hubTabEnsure_ = function () { return sheet; };
    istConfigSheet_();
    var seen = {}, dup = [];
    grid.slice(1).forEach(function (r) { if (seen[r[0]]) dup.push(r[0]); seen[r[0]] = r; });
    var missing = IST_CONFIG_DEFAULTS.filter(function (d) { return !seen[d.key]; }).map(function (d) { return d.key; });
    stAssert_(out, 'ist heal: every declared key missing from a live tab is added, once',
              missing.length === 0 && dup.length === 0, 'missing ' + missing.join(', ') + ' dup ' + dup.join(', '));
    stAssert_(out, 'ist heal: a value already in the tab is never overwritten',
              seen.ist_valid_days[1] === '365');
    stAssert_(out, 'ist heal: the note column says what the declaration says now',
              seen.ist_valid_days[2] === istConfigSpec_('ist_valid_days').note, String(seen.ist_valid_days[2]));
    stAssert_(out, 'ist heal: an added key carries its declared value and note',
              seen.ist_trained_scope[1] === 'house' && seen.ist_trained_scope[2] === istConfigSpec_('ist_trained_scope').note);
    stAssert_(out, 'ist heal: a cell that became a spreadsheet error is put back to its declared value',
              String(seen.ist_cert_expiring_days[1]) === '60', String(seen.ist_cert_expiring_days[1]));
    var before = grid.length;
    istConfigSheet_();
    stAssert_(out, 'ist heal: a second touch adds nothing', grid.length === before);
    // two executions healing the same duplicate: the second plans from the grid as it now stands
    grid.splice(3, 0, ['ist_page_size', '40', 'dup']);
    var plan = istConfigHealPlan_(grid.map(function (r) { return r.slice(); }));
    istConfigHeal_(sheet);
    istConfigHeal_(sheet);
    var counts = {};
    grid.slice(1).forEach(function (r) { counts[r[0]] = (counts[r[0]] || 0) + 1; });
    var lost = IST_CONFIG_DEFAULTS.filter(function (d) { return counts[d.key] !== 1; }).map(function (d) { return d.key; });
    stAssert_(out, 'ist heal: a duplicate is removed once; a second heal re-reads and removes nothing else',
              plan.doomed.length === 1 && grid.length === before && lost.length === 0, lost.join(', '));
  } finally {
    hubTabEnsure_ = heldEnsure; IST_CONFIG_MEMO = heldMemo; IST_CONFIG_SOURCE = heldSrc;
  }

  /* ---- Certs.gs: status words and columns ---- */
  stWithIstConfig_(floor, 'sheet', function () {
    stAssert_(out, 'ist certs: the shipped words — certified, ERROR skipped, the rest expired; tracker never valid',
              certStateOf_('ist_cert_mais_statuses', 'Certified', 'expired') === 'certified' &&
              certStateOf_('ist_cert_mais_statuses', 'ERROR 502', 'expired') === 'skip' &&
              certStateOf_('ist_cert_mais_statuses', 'Revoked', 'expired') === 'expired' &&
              certStateOf_('ist_cert_tracker_statuses', 'Expired', 'expiring') === 'expired' &&
              certStateOf_('ist_cert_tracker_statuses', 'Upcoming', 'expiring') === 'expiring');
    stAssert_(out, 'ist certs: the shipped columns — employee|name on Master',
              certSourceField_('master.name') === 'employee|name' && certSourceField_('mais.expires') === 'expiration');
  });
  stWithIstConfig_({ ist_cert_mais_statuses: 'active=certified, *=expired',
                     ist_cert_tracker_statuses: '*=valid',
                     ist_cert_source_fields: 'master.name=full_name' }, 'sheet', function () {
    stAssert_(out, 'ist certs: an edited word changes what it means; a word that would read valid is refused',
              certStateOf_('ist_cert_mais_statuses', 'Active', 'expired') === 'certified' &&
              certStateOf_('ist_cert_tracker_statuses', 'Upcoming', 'expiring') === 'expiring');
    stAssert_(out, 'ist certs: an edited column is read; a fact left out keeps its shipped column',
              certSourceField_('master.name') === 'full_name' && certSourceField_('mais.status') === 'status');
  });
  stAssert_(out, 'ist certs: | tries alternatives in order, + joins columns',
            certFieldOf_({ employee: '', name: 'Bo' }, 'employee|name') === 'Bo' &&
            certFieldOf_({ name: '', search_first: 'Ana', search_last: 'Lopez' },
                         'name|search_first+search_last') === 'Ana Lopez');

  /* ---- RequirementStates.gs: the window a training row counts against ---- */
  stAssert_(out, 'ist window: own — each requirement keeps its warn_days',
            reqWarnDays_({ category: 'training', warn_days: '30' }, 0) === 30 &&
            reqWarnDays_({ category: 'documents', warn_days: '14' }, 60) === 14 &&
            reqWarnDays_({ category: 'training', warn_days: '' }, 0) === 30);
  stAssert_(out, 'ist window: ist — a training row counts on the certification window',
            reqWarnDays_({ category: 'training', warn_days: '30' }, 60) === 60);
  stWithIstConfig_(floor, 'sheet', function () {
    stEq_(out, 'ist window: the shipped choice is own', reqIstWindow_(), 0);
  });
  stWithIstConfig_({ ist_requirements_window: 'ist', ist_cert_expiring_days: '45' }, 'sheet', function () {
    stEq_(out, 'ist window: ist hands the engine the certification window', reqIstWindow_(), 45);
  });

  /* ---- IST.gs: the roster lookback, and the ist_due row's own pacing ---- */
  var recent = new Date(Date.now() - 10 * 86400000).toISOString().slice(0, 10);
  var heldList = listRows_;
  try {
    listRows_ = function (t) {
      return t === 'shifts' ? [{ staff: 'Ana Lopez', house: 'H1', date: recent },
                               { staff: 'Ana Lopez', house: 'H1', date: '2020-01-01' },
                               { staff: 'OPEN', house: 'H1', date: recent }] : [];
    };
    stWithIstConfig_(floor, 'sheet', function () {
      var all = istStaffByHouse_();
      stAssert_(out, 'ist roster: 0 reads the whole history, and a coverage label is nobody',
                all.H1['Ana Lopez'].first === '2020-01-01' && all.H1['Ana Lopez'].last === recent && !all.H1.OPEN,
                JSON.stringify(all));
    });
    stWithIstConfig_({ ist_roster_lookback_days: '365' }, 'sheet', function () {
      var near = istStaffByHouse_();
      stEq_(out, 'ist roster: a lookback leaves older shifts out', near.H1['Ana Lopez'].first, recent);
    });
  } finally { listRows_ = heldList; }

  var heldSits = smartSituations_;
  try {
    smartSituations_ = function () { return [{ id: 'ist_due', max_attempts: '3', frequency: 'weekly' }]; };
    stWithIstConfig_(floor, 'sheet', function () {
      stEq_(out, 'ist notice: shipped, a repeating ist_due row still tells once — nothing changes on day one',
            istNoticeRepeats_(), false);
    });
    stWithIstConfig_({ ist_notice_repeats: 'yes' }, 'sheet', function () {
      stEq_(out, 'ist notice: ist_notice_repeats yes hands a repeating row its own pacing', istNoticeRepeats_(), true);
      smartSituations_ = function () { return [{ id: 'ist_due', max_attempts: '', frequency: 'once' }]; };
      stEq_(out, 'ist notice: an ist_due row paced once keeps the told-once law', istNoticeRepeats_(), false);
      smartSituations_ = function () { throw new Error('unreadable'); };
      stEq_(out, 'ist notice: an unreadable row keeps the told-once law', istNoticeRepeats_(), false);
    });
  } finally { smartSituations_ = heldSits; }

  /* ---- ist_valid_days: one lapse rule, and the notice chases a lapsed IST once ---- */
  stWithIstConfig_({ ist_valid_days: '30' }, 'sheet', function () {
    stAssert_(out, 'ist lapse: still current on day 30, lapsed on day 31 (the gate\'s and the board\'s rule)',
              istLapsed_('2026-01-01', '2026-01-31') === false && istLapsed_('2026-01-01', '2026-02-01') === true &&
              istLapsed_('', '2030-01-01') === false);
    var heldRows = listRows_;
    try {
      listRows_ = function (t) {
        return t === 'istRecords' ? [
          { id: 'r1', status: 'done', trainedAt: '2020-01-01', notifyCount: '2', staffName: 'Ana Lopez' },
          { id: 'r2', status: 'done', trainedAt: istOhioToday_(), notifyCount: '0', staffName: 'Bo Diaz' },
          { id: 'r3', status: 'owed', notifyCount: '1', staffName: 'Cy Odd' }] : [];
      };
      var subjects = istSmartSubjects_();
      stAssert_(out, 'ist notice: a lapsed IST is chased once, as its own instance; a told owed row waits',
                subjects.length === 1 && subjects[0].id === 'r1' && subjects[0].instance === 'r1#lapsed-2020-01-01',
                JSON.stringify(subjects));
    } finally { listRows_ = heldRows; }
  });
  stWithIstConfig_(floor, 'sheet', function () {
    stEq_(out, 'ist lapse: 0 days never lapses', istLapsed_('2000-01-01', '2030-01-01'), false);
  });

  /* ---- the tracker join compares labels ignoring case ---- */
  stWithIstConfig_({ ist_cert_training_keys: 'DODD 8-Hour Exp=dodd' }, 'sheet', function () {
    stEq_(out, 'ist certs: a tracker label typed as it looks still joins', certTrainingKeys_()['dodd 8-hour exp'], 'dodd');
  });
}

