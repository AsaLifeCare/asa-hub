            stCode_(hubHiredAlert_).indexOf('hiringNoticeEmail_') !== -1 &&
            stCode_(hubBecomingStaffSweep_).indexOf('hiringNoticeEmail_') !== -1 &&
            stCode_(hubTeamNotify_).indexOf('mailHtml') !== -1,
            'a migrated e-mail without its layout is a plain-text survivor');
  // The migration: once, marker-stamped, copy only over the shipped default, and it arms exactly the five that were…
  stAssert_(out, 'hiring messages: the migration exists and runs once',
            typeof smartMigrateHiringMessages_ === 'function' &&
            String(smartMigrateHiringMessages_).indexOf('SMART_HIRING_MIGRATED_KEY') !== -1 &&
            stCode_(smartSheet_).indexOf('smartMigrateHiringMessages_') !== -1,
            'the standing texts would never arrive, or would arrive twice');
  stAssert_(out, 'hiring messages: the migration never overwrites a hand edit',
            String(smartMigrateHiringMessages_).indexOf("!== String(seed[cell] || '')) continue") !== -1,
            'a later edit in the tab would be clobbered by a re-run');
  stAssert_(out, 'hiring messages: the migration arms exactly the five live situations',
            typeof SMART_HIRING_MIGRATION !== 'undefined' &&
            SMART_HIRING_MIGRATION.map(function (m) { return m.id; }).sort().join(',') ===
              HM_IDS.slice().sort().join(','),
            'a situation that never sent would be switched on, or a live one left dark');

  // 6.
  var sweep = String(smartCommsSweep_);
  stAssert_(out, 'smart comms: only a real send reaches the ledger',
            sweep.indexOf('if (reached && !redirected)') !== -1,
            'the ledger is written for calls that sent nothing');
 // AND NOT WHEN IT WENT TO A TESTER.
  stAssert_(out, 'smart comms: a message to the testers never becomes a ledger row',
            sweep.indexOf('redirected = true') !== -1 &&
            sweep.indexOf('smart_test_only') !== -1,
            'a rehearsal would silently mark real people as reminded');
  stAssert_(out, 'smart comms: the ledger records the channels that DELIVERED',
            sweep.indexOf("delivered.join('+')") !== -1 &&
            sweep.indexOf("d.channels.join('+')") === -1,
            'a configured channel that hard-failed is recorded as though it landed');
  // The fourth truth, and the reason it exists.
  stAssert_(out, 'rpc: the transport says when it diverted a message to a tester',
            String(rpcSend_).indexOf('redirected = true') !== -1 ||
            String(rpcSend_).indexOf('redirected: !!redir') !== -1,
            'a caller cannot tell a delivery from a rehearsal, so records lie');
  stAssert_(out, 'smart comms: a rehearsal never reaches the person on the card',
            sweep.indexOf('d.rehearsal ?') !== -1 && sweep.indexOf('packetRehearsalNumber_') !== -1,
            'a test card would be messaged at its own number');
  // 7.
  stEq_(out, 'smart comms: the status comes from the row that carries the date',
        smartStatusOf_({ status: 'Yes' }, { status: 'active' }), 'yes');
  stEq_(out, 'smart comms: the Hub value is the fallback, not the source',
        smartStatusOf_(null, { status: 'Active' }), 'active');
  stAssert_(out, 'smart comms: neither sweep reads people.status directly',
            String(smartDue_).indexOf("String(p.status") === -1 &&
            String(smartDigestRows_).indexOf("String(p.status") === -1,
            'a sweep is filtering the estate vocabulary against the Hub one again');

  // 8.
  stAssert_(out, 'smart comms: a digest is never swept as a per-person reminder',
            String(smartDue_).indexOf("!== 'digest'") !== -1,
            'a weekly report would be sent once per person');
  // A MINUTE OF SLACK, and it is not cosmetic: smartWindowDays_ calls Date.now() itself, so `Date.now() + 10 days`…
  var tenDays = 10 * 86400000, slack = 60000;
  stEq_(out, 'smart comms: elapsed counts days SINCE, expiring counts days UNTIL',
        String(smartWindowDays_(Date.now() + tenDays + slack, 'expiring')) + '/' +
        String(smartWindowDays_(Date.now() - tenDays + slack, 'elapsed')), '10/10');
  var digestIds = [];
  smartDefaults_().forEach(function (d) {
    if (String(d.kind || '') === 'digest') digestIds.push(d.id + ':' + d.direction + ':' + d.enabled);
  });
  stAssert_(out, 'smart comms: both weekly reports exist, and both ship OFF',
            digestIds.indexOf('weekly_expirations:expiring:no') !== -1 &&
            digestIds.indexOf('weekly_referrals_unpaid:elapsed:no') !== -1,
            digestIds.join(', '));
  // ONE NAMED EXCEPTION, and it is the mailbox lane.
  var ADDRESSED_BY_DESIGN = ['staff_late_show', 'staff_no_call', 'hotline_incident'];
  stAssert_(out, 'smart comms: no recipient is hardcoded in a digest',
            (function () {
              var bad = [];
              smartDefaults_().forEach(function (d) {
                if (/@/.test(String(d.to || '')) === false) return;
                if (ADDRESSED_BY_DESIGN.indexOf(String(d.id)) !== -1) return;
                bad.push(d.id);
              });
              return bad.length === 0;
            })(),
            'an address is baked into a default — the report stops arriving the day somebody leaves');
  var dg = String(smartDigestSweep_);
  stAssert_(out, 'smart comms: a digest with nobody in `to` sends nothing',
            dg.indexOf('nobody in `to`') !== -1, '');
  stAssert_(out, 'smart comms: an empty report is not sent',
            dg.indexOf('nothing due') !== -1,
            'an empty weekly e-mail teaches people to stop opening it');
  stAssert_(out, 'smart comms: a digest sends once per week however often it runs',
            dg.indexOf('smartDigestStamp_()') !== -1,
            'a manual run would duplicate the report');
  stAssert_(out, 'smart comms: the exclusion column really excludes',
            String(smartDigestRows_).indexOf('excludeVals.indexOf(got) !== -1') !== -1,
            'referrals already paid would still be reported as unpaid');

  stAssert_(out, 'smart comms: the cc column really sends',
            sweep.indexOf('ccPhones.forEach') !== -1 && sweep.indexOf('ccEmails.forEach') !== -1,
            'cc is configuration that does nothing — the CPR defect, preserved');
  stAssert_(out, 'smart comms: a rehearsal never copies real people',
            sweep.indexOf('d.rehearsal ? [] : smartList_(d.config.cc)') !== -1,
            'a test run would page the trainer');
  stAssert_(out, 'smart comms: each copy carries its own key',
            sweep.indexOf("'smart_cc' + i + '_' + d.key") !== -1,
            'one key for several messages — a retry would text the trainer twice');
  var cpr = null;
  smartDefaults_().forEach(function (d) { if (d.id === 'cpr_expiring') cpr = d; });
  stAssert_(out, 'smart comms: CPR ships OFF', cpr && !smartOn_(cpr.enabled), '');

  stAssert_(out, 'smart comms: every send goes through the declared contract',
            sweep.indexOf('rpcCall_') !== -1 && sweep.indexOf('UrlFetchApp') === -1,
            'something sends outside HUB_RPC — the gate would not hold it');

  // ── THE TWO BOOKS ABOUT ONE MOMENT ─────────────────────────────────── MEASURED, from the houses and not from…
  stAssert_(out, 'rehearsal: the row asks the mock parser when the lane shape does not match',
            stCode_(hubRehearsalRow_).indexOf('commMockSituationFrom_') !== -1 &&
            stCode_(hubRehearsalRow_).indexOf('commMockPersonFrom_') !== -1,
            'a rehearsal row that cannot name its situation cannot be read message by message');
  stEq_(out, 'rehearsal: a plain smart comms reason still names its situation',
        commMockSituationFrom_('smart comms: ist_due'), 'ist_due');
  stEq_(out, 'rehearsal: the lane shape keeps working',
        commMockSituationFrom_('comms: cpr_expiring'), 'cpr_expiring');
  stAssert_(out, 'mock: the test_mode column knows the sheet position',
            stCode_(commMockNote_).indexOf('hubRehearsalToSheet_') !== -1,
            'every row written while nothing could be sent claimed a redirect to the testers');
  stSmartTell_(out);
}

/** smartTell_: another app names the situation, number, values and key; Smart Comms says it or says why not. */
function stSmartTell_(out) {
  var P = 'smart tell: ';
  var G = (typeof globalThis !== 'undefined') ? globalThis : this;
  var NAMES = ['smartSituationOn_', 'hubSituationRead_', 'rpcCall_', 'smartRecord_'];
  var keep = {};
  NAMES.forEach(function (n) { keep[n] = G[n]; });
  var keepTold = SMART_TELL_LEDGERED, keepR = HUB_REHEARSAL_CTX, keepM = COMM_MOCK_CTX;
  var DAY = Date.parse('2026-10-19T16:00:00Z'), NIGHT = Date.parse('2026-10-20T03:00:00Z');
  var sit = null, read = null, answer = {}, calls = [], rows = [];
  var SENTINEL_R = { mark: 'outer-r' }, SENTINEL_M = { mark: 'outer-m' };
  try {
    SMART_TELL_LEDGERED = {};
    HUB_REHEARSAL_CTX = SENTINEL_R;
    COMM_MOCK_CTX = SENTINEL_M;
    G.smartSituationOn_ = function () { return sit; };
    G.hubSituationRead_ = function () { return read; };
    G.rpcCall_ = function (method, params, opts) {
      calls.push({ method: method, to: params.to, body: params.body, reason: params.reason,
                   key: opts && opts.idempotency_key, r: HUB_REHEARSAL_CTX, m: COMM_MOCK_CTX });
      return answer;
    };
    G.smartRecord_ = function (key, situation, person, expires, channel) {
      rows.push({ key: key, situation: situation, person: person, expires: expires, channel: channel });
      return true;
    };
    var tell = function (o) {
      var w = { situation: 'st_tell', to: '+13305550001', vars: { first: 'Ana' }, key: 'K1', person: 'Ana Smith',
                person_key: 'ana.smith', occasion: '2026-10-19', lane: 'testlane', at_ms: DAY, prune: true };
      for (var k in (o || {})) if (Object.prototype.hasOwnProperty.call(o, k)) w[k] = o[k];
      return smartTell_(w);
    };
    var WORDED = { id: 'st_tell', enabled: 'yes', channels: 'sms', sms_text: 'Hi {first}. Bring {missing}.\nThanks - {sender}' };

    read = { row: null, on: false, unreadable: '' };
    var off = tell({});
    stAssert_(out, P + 'an off or absent situation is off, nothing sent', off.state === 'off' && !off.unreadable &&
              calls.length === 0, JSON.stringify(off));
    read = { row: null, on: false, unreadable: 'the situations tab could not be read (boom)' };
    var unr = tell({});
    stAssert_(out, P + 'an unreadable situations tab is off AND unreadable, never a quiet off',
              unr.state === 'off' && unr.unreadable === true && calls.length === 0, JSON.stringify(unr));

    sit = { id: 'st_tell', enabled: 'yes', channels: 'email', sms_text: 'Hi' };
    var noSms = tell({});
    sit = { id: 'st_tell', enabled: 'yes', channels: 'sms', sms_text: '' };
    var noWords = tell({});
    stAssert_(out, P + 'a situation with no SMS channel or no SMS words is off',
              noSms.state === 'off' && noWords.state === 'off' && calls.length === 0,
              JSON.stringify([noSms, noWords]));

    sit = WORDED;
    var noPhone = tell({ to: '' }), ours = tell({ to: '+13309195558' });
    stAssert_(out, P + 'no number, or one of our own lines, is no_phone',
              noPhone.state === 'no_phone' && ours.state === 'no_phone' && calls.length === 0,
              JSON.stringify([noPhone, ours]));

    var quiet = tell({ at_ms: NIGHT });
    stAssert_(out, P + 'inside the quiet window it is held quiet and the door is never knocked',
              quiet.state === 'held' && quiet.held === 'quiet' && calls.length === 0, JSON.stringify(quiet));

    answer = { ok: true, rehearsed: true };
    var reh = tell({});
    var c0 = calls[0] || {};
    stAssert_(out, P + 'test mode is held test_mode, with the rehearsal and mock contexts set during the call and ' +
                   'restored after, and no ledger row',
              reh.state === 'held' && reh.held === 'test_mode' && calls.length === 1 && c0.method === 'smsSend' &&
              c0.key === 'K1' && c0.reason === 'testlane: st_tell' &&
              c0.r && c0.r.situation === 'st_tell' && c0.r.intent_key === 'K1' && c0.r.pass_by === 'asa-hub:testlane' &&
              c0.r.person_key === 'ana.smith' && c0.m && c0.m.ledger_key === 'K1' && c0.m.situation === 'st_tell' &&
              HUB_REHEARSAL_CTX === SENTINEL_R && COMM_MOCK_CTX === SENTINEL_M && rows.length === 0,
              JSON.stringify(reh));
    stEq_(out, P + 'the Desk words are rendered, an unfilled sentence pruned, the sender defaulted',
          c0.body, 'Hi Ana.\nThanks - ' + SMART_SENDER_DEFAULT);

    answer = { ok: true, sent: true, receipt: 'R1' };
    var s1 = tell({ key: 'K2', ledger_key: 'LK' }), s2 = tell({ key: 'K3', ledger_key: 'LK' });
    stAssert_(out, P + 'sent writes one Sendings row per ledger key, however many texts share it',
              s1.state === 'sent' && s1.receipt === 'R1' && s2.state === 'sent' && rows.length === 1 &&
              rows[0].key === 'LK' && rows[0].situation === 'st_tell' && rows[0].person === 'Ana Smith' &&
              rows[0].channel === 'sms', JSON.stringify(rows));

    answer = { ok: true, redirected: true, detail: 'sent to the testers' };
    var red = tell({ key: 'K4', ledger_key: 'LK2' });
    stAssert_(out, P + 'redirected is held redirected and ledgered under the REHEARSAL| key',
              red.state === 'held' && red.held === 'redirected' && rows.length === 2 &&
              rows[1].key === smartRehearsalKey_('LK2') && rows[1].channel === 'rehearsal', JSON.stringify(rows));
  } finally {
    NAMES.forEach(function (n) { G[n] = keep[n]; });
    SMART_TELL_LEDGERED = keepTold;
    HUB_REHEARSAL_CTX = keepR;
    COMM_MOCK_CTX = keepM;
  }
}

// ------------------------------------------------------------------ The whole thing…
function stAppBuilder_(out) {
  // ---- the tab-name guard -------------------------------------------------
  var fakeSs = { getSheetByName: function (n) { return n === 'users' ? { fake: true } : null; } };
  stAssert_(out, 'appbuilder: a live system tab is refused',
            String(appBuilderResourceState_(fakeSs, 'users', {})).indexOf('already uses') !== -1,
            'a page resource naming `users` makes every salt and pass_hash listable');
  stEq_(out, 'appbuilder: a coded resource is a binding',
        appBuilderResourceState_(fakeSs, 'people', {}), 'coded');
  stAssert_(out, 'appbuilder: a coded resource\'s sheet alias is refused',
            String(appBuilderResourceState_(fakeSs, 'finance_transactions', {})).indexOf('behind the coded resource') !== -1,
            'a second, ungated route onto the finance ledger');
  stEq_(out, 'appbuilder: a builder-owned tab stays writable',
        appBuilderResourceState_(fakeSs, 'pgFleet', { pgFleet: true }), 'builder');
  stEq_(out, 'appbuilder: a fresh name is created',
        appBuilderResourceState_(fakeSs, 'pgBrandNew', {}), 'create');

  // ---- action sanitizing --------------------------------------------------
  var w1 = [];
  var opts1 = { rowActions: [
    { id: 'a1', label: 'Bad', kind: 'explode' },
    { id: 'a2', label: 'Ghost', kind: 'call', call: 'noSuchActionExists' },
    { id: 'a3', label: 'Real', kind: 'call', call: 'appBuilderUpsert' },
    { id: 'edit', label: 'Edit' }              // engine vocabulary, no kind
  ] };
  appBuilderSanitizeActions_(opts1, w1, 'main');
  stEq_(out, 'appbuilder: unknown kinds and ghost calls are stripped',
        opts1.rowActions.length, 2);
  stEq_(out, 'appbuilder: both removals are said out loud', w1.length, 2);
  stAssert_(out, 'appbuilder: a declared call survives',
            opts1.rowActions.some(function (a) { return a.id === 'a3'; }), '');
  stAssert_(out, 'appbuilder: engine entries pass untouched',
            opts1.rowActions.some(function (a) { return a.id === 'edit'; }), '');
  var w2 = [];
  var opts2 = { footer: [{ id: 'f1', label: 'X', kind: 'nope' }] };          // legacy array shape
  var opts3 = { footer: { buttons: [{ id: 'f2', label: 'Y', kind: 'nope' }] } }; // studio shape
  appBuilderSanitizeActions_(opts2, w2, 'p');
  appBuilderSanitizeActions_(opts3, w2, 'p');
  stEq_(out, 'appbuilder: both footer shapes are walked', w2.length, 2);
  stEq_(out, 'appbuilder: array footer stripped', opts2.footer.length, 0);
  stEq_(out, 'appbuilder: object footer stripped', opts3.footer.buttons.length, 0);

  // ---- the columns DSL -----------------------------------------------------
  stEq_(out, 'appbuilder: the DSL defaults label and kind',
        appBuilderColumnsDsl_([{ key: 'item' }]), 'item:item:text');
  stEq_(out, 'appbuilder: pipes and colons in a label are sanitized',
        appBuilderColumnsDsl_([{ key: 'qty', label: 'Qty: per|week', kind: 'number' }]), 'qty:Qty per week:number');
  stEq_(out, 'appbuilder: a key with a pipe never reaches the DSL',
        appBuilderColumnsDsl_([{ key: 'a|b' }, { key: 'ok' }]), 'ok:ok:text');

  // ---- page validation ------------------------------------------------------
  stAssert_(out, 'appbuilder: an unmountable page type is refused by name',
            String(appBuilderValidPage_({ type: 'hologram', resource: 'pgX' }, 0)).indexOf('hologram') !== -1, '');
  stAssert_(out, 'appbuilder: a hyphenated resource is refused (tab name)',
            String(appBuilderValidPage_({ type: 'sheet', resource: 'pg-x' }, 0)).indexOf('pg-x') !== -1, '');
  stEq_(out, 'appbuilder: a good page passes',
        appBuilderValidPage_({ type: 'sheet', resource: 'pgX', id: 'main' }, 0), '');

  // ---- the AI draft coercion -------------------------------------------------
  var w3 = [];
  var coerced = playgroundGenPage_({ type: 'hologram', config: {}, rows: [{ name: 'x' }] }, 0, w3);
  stEq_(out, 'appbuilder: an unknown AI type becomes sheet', coerced.type, 'sheet');
  stAssert_(out, 'appbuilder: the coercion is announced', w3.length >= 1, '');
  stEq_(out, 'appbuilder: a row without id gets one', coerced.rows[0].id, 'row-1');
  var w4 = [];
  var many = { type: 'sheet', config: {}, rows: [] };
  for (var r = 0; r < 30; r++) many.rows.push({ id: 'r' + r });
  many.rows.push(['not', 'an', 'object']);
  var capped = playgroundGenPage_(many, 0, w4);
  stEq_(out, 'appbuilder: rows cap at 25', capped.rows.length, 25);
  stAssert_(out, 'appbuilder: the cap is announced',
            w4.some(function (w) { return w.indexOf('kept 25') !== -1; }), '');
  var w5 = [];
  stEq_(out, 'appbuilder: a non-object page is dropped with a warning',
        playgroundGenPage_(null, 0, w5), null);
  stEq_(out, 'appbuilder: the drop is announced', w5.length, 1);
}

// ------------------------------------------------------------------ 17.
function stRecon_(out) {
  if (typeof reconDetectAll_ !== 'function') {
    stAssert_(out, 'recon: the module is loaded', false, 'Recon.gs did not load');
    return;
  }

  // ---- the calendar cell grammar -------------------------------------
  var c1 = reconClassifyCell_('8A-8P');
  stAssert_(out, 'recon: a plain day shift parses',
            c1 && c1.kind === 'hours' && c1.startMin === 480 && c1.endMin === 1200,
            JSON.stringify(c1));
  var c2 = reconClassifyCell_('230-10p');
  stAssert_(out, 'recon: the first half borrows the second\'s meridiem',
            c2 && c2.startMin === 870 && c2.endMin === 1320, JSON.stringify(c2));
  var c3 = reconClassifyCell_('10P-8:30A');
  stAssert_(out, 'recon: overnight runs past midnight',
            c3 && c3.startMin === 1320 && c3.endMin === 1950, JSON.stringify(c3));
  stEq_(out, 'recon: OFF is not a shift', (reconClassifyCell_('OFF') || {}).kind, 'off');
  stEq_(out, 'recon: R/O is not a shift', (reconClassifyCell_('R/O') || {}).kind, 'ro');
  var c4 = reconClassifyCell_('47TH');
  stAssert_(out, 'recon: a bare token means working at another house',
            c4 && c4.kind === 'alias' && c4.token === '47TH', JSON.stringify(c4));
  var c5 = reconClassifyCell_('BM > 8P-8A');
  stAssert_(out, 'recon: a transfer carries both the hours and the other house',
            c5 && c5.kind === 'hours' && c5.token === 'BM' && c5.startMin === 1200 && c5.endMin === 1920,
            JSON.stringify(c5));
  stEq_(out, 'recon: a blank cell rosters nobody', reconClassifyCell_('  '), null);

  // ---- time plumbing ---------------------------------------------------
  stEq_(out, 'recon: the overnight fix adds a day', reconOvernight_(1200, 480), 1920);
  stEq_(out, 'recon: minutes format back to a wall clock', reconMinToTime_(480), '8:00 AM');
  stEq_(out, 'recon: overnight minutes wrap on display', reconMinToTime_(1560), '2:00 AM');
  stEq_(out, 'recon: report time strings parse', reconParseTimeMin_('08:30:00 AM'), 510);
  stEq_(out, 'recon: noon is AM/PM-correct', reconParseTimeMin_('12:00 PM'), 720);

  var D = '2026-08-03';
  function mkP(name, key, loc, s, e, consumers) {
    return { date: D, matchKey: key, employeeId: key, employeeName: name,
             location: loc, startMin: s, endMin: e,
             startTime: reconMinToTime_(s), endTime: reconMinToTime_(e),
             consumers: consumers || '', hours: ((e || s) - s) / 60 };
  }
  function mkS(name, key, loc, s, e) {
    return { date: D, matchKey: key, employeeId: key, employeeName: name,
             location: loc, startMin: s, endMin: e,
             startTime: reconMinToTime_(s), endTime: reconMinToTime_(e) };
  }

  // ---- dupe -------------------------------------------------------------
  var dupeRun = reconDetectDupes_([
    mkP('Ana', 'p1', 'H1', 480, 720, 'SM'),
    mkP('Ana', 'p1', 'H1', 600, 900, 'SM'),
    mkP('Bob', 'p2', 'H1', 480, 720, 'SM')
  ]);
  stEq_(out, 'recon: overlapping punches of one person are a dupe', dupeRun.length, 1);
  stEq_(out, 'recon: the dupe keeps the person\'s key', dupeRun[0].employeeId, 'p1');

  // ---- noEnd -------------------------------------------------------------
  stEq_(out, 'recon: a punch without clock-out is flagged',
        reconDetectNoEnd_([mkP('Ana', 'p1', 'H1', 480, null, 'SM')]).length, 1);

  // ---- missing, with its scope ------------------------------------------
  var cfg = { gapMin: 5, overlapMin: 45, missingCoveragePct: 15, smartRunDays: 2 };
  var covered = reconDetectMissing_(
    [mkP('Ana', 'p1', 'H1', 480, 720, 'SM')],
    [mkS('Ana', 'p1', 'H1', 480, 720)], cfg);
  stEq_(out, 'recon: a fully covered shift is not missing', covered.length, 0);
  var thin = reconDetectMissing_(
    [mkP('Ana', 'p1', 'H1', 480, 495, 'SM')],          // 15 of 240 minutes
    [mkS('Ana', 'p1', 'H1', 480, 720)], cfg);
  stEq_(out, 'recon: under 15% coverage is a missing shift', thin.length, 1);
  var elsewhere = reconDetectMissing_(
    [mkP('Ana', 'p1', 'H1', 480, 720, 'SM')],
    [mkS('Bob', 'p2', 'H2', 480, 720)], cfg);          // H2 is not in the report
  stEq_(out, 'recon: missing stays inside the report\'s locations', elsewhere.length, 0);

  // ---- the gap a missing shift already explains --------------------------
  var gapPunches = [
    mkP('Ana', 'p1', 'H1', 480, 600, 'SM'),
    mkP('Bob', 'p2', 'H1', 720, 840, 'SM')
  ];
  var gapShifts = [mkS('Cara', 'p3', 'H1', 480, 960)];  // never punched → missing
  var gapMissing = reconDetectMissing_(gapPunches, gapShifts, cfg);
  stEq_(out, 'recon: the absent third person is the missing shift', gapMissing.length, 1);
  var g = reconDetectGaps_(gapPunches, gapShifts, gapMissing, cfg);
  stEq_(out, 'recon: the gap it explains is folded, not double-reported', g.gaps.length, 0);
  stEq_(out, 'recon: the fold is counted', g.folded.length, 1);
  stAssert_(out, 'recon: the missing shift carries the gap\'s context',
            gapMissing[0].detail.indexOf('consumer gaps') !== -1, gapMissing[0].detail);
  var gFree = reconDetectGaps_(gapPunches, [], [], cfg);
  stEq_(out, 'recon: an unexplained gap stands on its own', gFree.gaps.length, 1);

  // ---- overlap: the short handoff is not one ------------------------------
  var shortHandoff = reconDetectOverlaps_([
    mkP('Ana', 'p1', 'H1', 480, 750, 'SM'),
    mkP('Bob', 'p2', 'H1', 720, 960, 'SM')               // 30 minutes together
  ], cfg);
  stEq_(out, 'recon: a 30-minute handoff is not an overlap', shortHandoff.overlaps.length, 0);
  stEq_(out, 'recon: the suppressed handoff is counted', shortHandoff.suppressed, 1);
  var longOverlap = reconDetectOverlaps_([
    mkP('Ana', 'p1', 'H1', 480, 840, 'SM'),
    mkP('Bob', 'p2', 'H1', 720, 960, 'SM')               // two hours together
  ], cfg);
  stEq_(out, 'recon: two hours on one consumer is an overlap', longOverlap.overlaps.length, 1);

  // ---- identity by key, refused when ambiguous ----------------------------
  var roster = [{ id: 'p10', name: 'José Garcia' }, { id: 'p20', name: 'Alexander' },
                { id: 'p21', name: 'Aleksander' }];
  var ok1 = reconResolveName_('Jose Garcia', roster);
  stAssert_(out, 'recon: accents do not change who a person is',
            ok1.ok && ok1.id === 'p10', JSON.stringify(ok1));
  // 'Alexsander' sits one letter from TWO different people — the matcher must refuse, because picking either would…
  var amb = reconResolveName_('Alexsander', roster);
  stAssert_(out, 'recon: an ambiguous name is refused, never guessed',
            !amb.ok && amb.reason === 'ambiguous', JSON.stringify(amb));
  var none = reconResolveName_('Zzyzx Qqq', roster);
  stAssert_(out, 'recon: a stranger is unmapped with a stable key',
            !none.ok && none.reason === 'no match' && none.key === 'name:zzyzx qqq',
            JSON.stringify(none));
  stAssert_(out, 'recon: an unmapped name still recognises itself across the sides',
            none.key === reconResolveName_('Zzyzx Qqq', roster).key, '');

  // ---- import idempotency: a source file already stored is an answer ------
  var importRows = [
    { sourceFile: 'fileA', date: '2026-08-01' },
    { sourceFile: 'fileA', date: '2026-08-03' },
    { sourceFile: 'fileB', date: '2026-08-02' }
  ];
  var seen = reconFindImport_(importRows, 'fileA');
  stAssert_(out, 'recon: an already-imported file is recognised before a re-write',
            seen.found && seen.entries === 2 &&
            seen.period.from === '2026-08-01' && seen.period.to === '2026-08-03',
            JSON.stringify(seen));
  var fresh = reconFindImport_(importRows, 'fileZ');
  stAssert_(out, 'recon: a file nobody stored imports cleanly',
            !fresh.found && fresh.entries === 0, JSON.stringify(fresh));

  // ---- master sheet mode -------------------------------------------------- Date normalization + header mapping +…
  var grid = [
    ['Date of Service', 'Employee', 'Staff Initials', 'Work Code', 'Start Time',
     'End Time', 'Total Hours', 'Consumers', 'Location'],
    ['8/2/2026', 'Passion Pleasan', 'PPle', 'HPC - Routine Care', '12:00:00 AM',
     '08:00:00 AM', 8, 'TFC', 'ABD1305'],
    ['8/3/2026', 'Joan Cheruiyot', 'JChe', 'HPC - Routine Care', '08:00:00 AM',
     '04:00:00 PM', 8, 'XYZ', '']
  ];
  var masterClean = reconMasterRows_(grid, { xyz: 'BM4060' });
  stAssert_(out, 'recon: master rows normalize the date to ISO and keep the row key',
            masterClean.length === 2 && masterClean[0].date === '2026-08-02' &&
            masterClean[0].sourceKey === '2' && masterClean[0].location === 'ABD1305',
            JSON.stringify(masterClean[0] || null));
  stAssert_(out, 'recon: an empty Location falls back to the consumer map',
            masterClean[1].location === 'BM4060', JSON.stringify(masterClean[1]));

  // The Staff Mapping translates BOTH directions before the roster match.
  var smap = reconStaffMap_(reconStaffMapPairs_([
    ['EMPLOYEE CALENDAR', 'EMPLOYEE SYSTEM', 'EMPLOYEE CALENDAR', 'EMPLOYEE SYSTEM'],
    ['PASSION PLEASAN', 'Pleasan, Passion', 'JOAN', 'Cheruiyot, Joan']
  ]));
  stEq_(out, 'recon: a calendar name becomes the system name',
        reconTranslateName_('Passion Pleasan', smap), 'Pleasan, Passion');
  stEq_(out, 'recon: a system name becomes the calendar name',
        reconTranslateName_('Cheruiyot, Joan', smap), 'JOAN');
  stEq_(out, 'recon: a name the map does not know passes through',
        reconTranslateName_('Nobody Here', smap), 'Nobody Here');

  // Idempotency by sourceKey: a stored row is skipped, a new row imports — even one inserted in the middle of the…
  var splitTest = reconFilterNew_(masterClean, { '2': true });
  stAssert_(out, 'recon: an imported row is skipped and a new one enters',
            splitTest.fresh.length === 1 && splitTest.skipped === 1 &&
            splitTest.fresh[0].sourceKey === '3', JSON.stringify(splitTest.fresh.length));

  // 'None' in Client to Location names no house — skipped, never mapped.
  var mcm = reconMasterClientMap_([
    ['Consumers', 'Location'],
    ['TFC', 'None'],
    ['ABC', 'ABD1305']
  ]);
  stAssert_(out, 'recon: a None location is ignored, a real one maps',
            !mcm['tfc'] && mcm['abc'] === 'ABD1305', JSON.stringify(mcm));

  // ---- punch reminders ----------------------------------------------------
  stEq_(out, 'recon: a phone is masked to its last four',
        reconMaskPhone_('+13309195558'), '(***) ***-5558');
  stEq_(out, 'recon: a phone too short to mask leaks nothing',
        reconMaskPhone_('58'), '(***) ***-****');
  // Only the types a person can fix go to the person.
  stEq_(out, 'recon: an overlap is refused for the person',
        reconReminderRefusal_({ type: 'overlap', employeeId: 'p1' }, '+13309195558'), 'type');
  stEq_(out, 'recon: a gap is refused for the person',
        reconReminderRefusal_({ type: 'gap', employeeId: 'p1' }, '+13309195558'), 'type');
  // Nobody is texted without a resolved identity carrying a phone.
  stEq_(out, 'recon: an unmapped employee is refused',
        reconReminderRefusal_({ type: 'missing', employeeId: '' }, ''), 'no phone');
  stEq_(out, 'recon: a resolved employee without a phone is refused',
        reconReminderRefusal_({ type: 'missing', employeeId: 'p1' }, ''), 'no phone');
  stEq_(out, 'recon: a missing punch with a phone is remindable',
        reconReminderRefusal_({ type: 'missing', employeeId: 'p1' }, '+13309195558'), '');
  stEq_(out, 'recon: a noEnd with a phone is remindable',
        reconReminderRefusal_({ type: 'noEnd', employeeId: 'p1' }, '+13309195558'), '');
  stEq_(out, 'recon: a missing row is a 404, not a reminder',
        reconReminderRefusal_(null, '+13309195558'), 'not found');
}

// The Sheets epoch.
function stCellText_(out) {
  stEq_(out, 'cell: a time-only cell is a wall clock, not 1899',
        cellText_(new Date(Date.UTC(1899, 11, 30, 21, 30, 0))), '9:30:00 PM');
  stEq_(out, 'cell: midnight on the epoch is 12, not 0',
        cellText_(new Date(Date.UTC(1899, 11, 30, 0, 0, 0))), '12:00:00 AM');
  stEq_(out, 'cell: a date-only cell keeps its own day',
        cellText_(new Date(Date.UTC(2026, 7, 4, 0, 0, 0))), '2026-08-04');
  stEq_(out, 'cell: a real instant stays a full stamp',
        cellText_(new Date(Date.UTC(2026, 7, 4, 18, 16, 4, 845))), '2026-08-04T18:16:04.845Z');
  stAssert_(out, 'cell: anything that is not a Date is not this function\'s business',
            cellText_('7:00:00 AM') === null && cellText_(null) === null, 'expected null');
  // The round trip is the invariant that matters: what a screen reads must be what the detector wrote, or the two…
  stEq_(out, 'cell: the punch survives the round trip',
        cellText_(new Date(Date.UTC(1899, 11, 30, 7, 0, 0))), '7:00:00 AM');

  // Rows written BEFORE cellText_ existed carry the poisoned string on disk; reconErrors heals them on the way out…
  stEq_(out, 'recon: a stored 1899 stamp reads as a wall clock',
        reconStoredTime_('1899-12-30T21:30:00.000Z'), '9:30:00 PM');
  stEq_(out, 'recon: a stored day loses its fake midnight',
        reconStoredDay_('2026-08-04T00:00:00.000Z'), '2026-08-04');
  stEq_(out, 'recon: a time already written properly is left alone',
        reconStoredTime_('7:00:00 AM'), '7:00:00 AM');
  stEq_(out, 'recon: a plain day is left alone',
        reconStoredDay_('2026-08-04'), '2026-08-04');
}

// Approving a document must actually write the date.
function stDocApproval_(out) {
  var write = stCode_(complianceWriteMasterDate_);
  stAssert_(out, 'approval: the writer resolves the name before writing',
            /complianceMasterTarget_\s*\(/.test(write),
            'complianceWriteMasterDate_ must resolve through complianceMasterTarget_');
  stAssert_(out, 'approval: a NAME is never passed as an employeeId',
            !/employeeId\s*:\s*personName/.test(write),
            'a name in employeeId matches only the employee_id column — it 404s');
  stAssert_(out, 'approval: the confirmed date carries the witness through',
            /expected\s*:/.test(write), 'expected must reach emp360WriteCell_');

  var pol = HUB_POLICY.complianceReviewResolve || {};
  var params = pol.params || {};
  // Resolver.gs validates DECLARED params and does not strip undeclared ones, so a parameter the handler reads and…
  stAssert_(out, 'approval: date and expected are declared params',
            !!params.date && !!params.expected,
            'the handler reads payload.date / payload.expected');
  stAssert_(out, 'approval: writing an expiry stales the certification slices',
            (pol.invalidates || []).indexOf('certMatrix') !== -1 &&
            (pol.invalidates || []).indexOf('staffCerts') !== -1,
            'must match emp360EditField — the two writers touch one cell');

  // The queue must hand the reviewer the witness, or every approval 409s.
  stAssert_(out, 'approval: the queue carries what the Master holds today',
            /masterNow\s*:/.test(stCode_(complianceQueueItem_)),
            'complianceQueueItem_ must expose masterNow');

  // A name on several Master rows settles on its one Active row; the Master itself is stood in for.
  var keepRows = emp360MasterRows_;
  try {
    var master = [
      { id: 'r2', employee: 'Rae Twice', status: 'No', employee_id: 'E1' },
      { id: 'r3', employee: 'rae  TWICE', status: ' active ', employee_id: 'E2' },
      { id: 'r4', employee: 'Sol Both', status: 'Yes', employee_id: 'E3' },
      { id: 'r5', employee: 'Sol Both', status: 'Active', employee_id: 'E4' },
      { id: 'r6', employee: 'Nia None', status: 'No', employee_id: 'E5' },
      { id: 'r7', employee: 'Nia None', status: '', employee_id: 'E6' },
      { id: 'r8', employee: 'Ona One', status: 'No', employee_id: 'E7' },
      { id: 'r9', employee: 'Id Twin', status: 'Active', employee_id: 'E9' },
      { id: 'r10', employee: 'Id Twin Other', status: 'No', employee_id: 'E9' }
    ];
    emp360MasterRows_ = function () { return master; };
    var rae = emp360FindMasterRow_('Rae Twice', '');
    stEq_(out, 'master row: a name on two rows takes the one whose Status is Active, however it is cased or spaced',
          [rae.row && rae.row.id, rae.by, rae.conflict || 0].join(' '), 'r3 name (Active) 0');
    stEq_(out, 'master row: two Active rows under one name stay a conflict',
          emp360FindMasterRow_('Sol Both', '').conflict, 2);
    stEq_(out, 'master row: no Active row under a shared name stays a conflict',
          emp360FindMasterRow_('Nia None', '').conflict, 2);
    var one = emp360FindMasterRow_('Ona One', '');
    stEq_(out, 'master row: a name on one row is that row, whatever its Status',
          [one.row && one.row.id, one.by].join(' '), 'r8 name');
    stEq_(out, 'master row: an employee id is matched as before — two rows carrying it conflict, Active or not',
          emp360FindMasterRow_('', 'E9').conflict, 2);
    var target = complianceMasterTarget_('Rae Twice');
    stEq_(out, 'master row: a confirmation writes to the Active row\'s employee id',
          [target.ok, target.employeeId].join(' '), 'true E2');
    stAssert_(out, 'master row: the conflict still refuses the write, in words',
              complianceMasterTarget_('Nia None').ok === false &&
              /2 Master rows match "Nia None"/.test(complianceMasterTarget_('Nia None').why), '');
    // the Employee ID the roster row gives the person is matched first, over the name's Active row
    var byRoster = complianceMasterTarget_('Rae Twice', 'E1');
    var notTheirs = complianceMasterTarget_('Ona One', 'E2');
    var gone = complianceMasterTarget_('Rae Twice', 'E404');
    var twin = complianceMasterTarget_('Id Twin', 'E9');
    stEq_(out, 'master row: a roster Employee ID finds its own row, and refuses a row naming someone else, a missing id ' +
          'and an id on two rows',
          [[byRoster.ok, byRoster.employeeId].join(':'), notTheirs.ok, /names someone other than "Ona One"/.test(notTheirs.why),
           gone.ok, /no Master row carries Employee ID "E404"/.test(gone.why), twin.ok,
           /2 Master rows match Employee ID "E9"/.test(twin.why)].join(' '),
          'true:E1 false true false true false true');
  } finally {
    emp360MasterRows_ = keepRows;
  }

  // The writer's row number comes from a cached read: the live row must still be the one that read resolved.
  var header = ['employee', 'status', 'employee_id', 'cpr_exp_date'];
  var byId = { master: { id: 'r3', employee: 'Rae Twice', status: 'Active', employee_id: 'E2' }, matchedBy: 'employee_id' };
  var byName = { master: { id: 'r8', employee: 'Ona One', status: 'No', employee_id: '' }, matchedBy: 'name' };
  var byActive = { master: { id: 'r3', employee: 'Rae Twice', status: 'Active', employee_id: 'E2' }, matchedBy: 'name (Active)' };
  stEq_(out, 'master write: a row inserted or sorted since the cached read, or one no longer Active, is refused',
        [emp360RowMoved_(header, ['Rae Twice', 'Active', 'E2', ''], byId, 'America/New_York'),
         emp360RowMoved_(header, ['Sol Both', 'Yes', 'E4', ''], byId, 'America/New_York'),
         emp360RowMoved_(header, ['Ona One', 'No', '', ''], byName, 'America/New_York'),
         emp360RowMoved_(header, ['Nia None', 'No', '', ''], byName, 'America/New_York'),
         emp360RowMoved_(header, ['Rae Twice', 'No', 'E2', ''], byActive, 'America/New_York'),
         emp360RowMoved_(header, ['Rae Twice', 'No', 'E2', ''], byId, 'America/New_York')].join(' | '),
        ' | it no longer carries Employee ID "E2" |  | it no longer names this person | its Status is no longer Active | ');
  var writeCode = stCode_(emp360WriteCell_);
  stAssert_(out, 'master write: the live row is checked before the witness, and a moved row retires the cached read',
            writeCode.indexOf('emp360RowMoved_(') !== -1 &&
            writeCode.indexOf('emp360RowMoved_(') < writeCode.indexOf('current !== expected') &&
            /if \(moved\) \{\s*cacheBump_\(/.test(writeCode), '');

  // The certifications read a name on several Master rows from its Active row, as the Staff index and the writer do.
  var keepTab = certReadTab_, keepClear = clearanceApply_;
  try {
    var masterTab = certSourceTab_('master');
    certReadTab_ = function (tab) {
      if (tab !== masterTab) return [];
      return [
        { employee: 'Tia Two', status: 'No', cpr_exp_date: '2020-01-01T05:00:00.000Z' },
        { employee: 'Tia Two', status: 'Active', cpr_exp_date: '', dodd_8_hour_exp: '2040-01-01T05:00:00.000Z' },
        { employee: 'Uma Old', status: 'No', cpr_exp_date: '2020-01-01T05:00:00.000Z' },
        { employee: 'Uma Old', status: 'Inactive', cpr_exp_date: '2040-01-01T05:00:00.000Z' },
        { employee: 'Val One', status: 'No', cpr_exp_date: '2040-01-01T05:00:00.000Z' }
      ];
    };
    clearanceApply_ = function (b) { return b; };
    var pic = certPicture_();
    var cell = function (k, c) { var p = pic[k] && pic[k].certs[c]; return p ? p.status : '-'; };
    stEq_(out, 'master row: the certifications take a shared name\'s dates from its Active row only; a name with no ' +
          'Active row, or on one row, reads as before',
          [cell('tiatwo', 'cpr'), cell('tiatwo', 'dodd'), cell('umaold', 'cpr'), cell('valone', 'cpr')].join(' '),
          '- valid valid valid');
  } finally {
    certReadTab_ = keepTab;
    clearanceApply_ = keepClear;
  }
}

// A shared seat must never stamp its own account onto somebody's packet.
function stSeatIdentity_(out) {
  var rel = stCode_(HUB_ACTIONS.seatRelease);
  stAssert_(out, 'seat: the durable stamp is the RESOLVED id',
            /durable_id,\s*info\.resolved\.id/.test(rel),
            'GradCandidateId must carry seatResolveCandidate_\'s answer');
  stAssert_(out, 'seat: the raw seat id is never stamped',
            !/durable_id,\s*info\.candidate_id/.test(rel),
            'info.candidate_id is the ACCOUNT on a shared seat');
  stAssert_(out, 'seat: identity is resolved once, before the stamp',
            rel.indexOf('info.resolved =') !== -1 &&
            rel.indexOf('info.resolved =') < rel.indexOf('durable_id, info.resolved.id'),
            'the stamp and the move must use one answer');
  stAssert_(out, 'seat: an unresolved visit stamps NOTHING',
            /info\.resolved = \{ id: ''/.test(rel),
            'falling back to the seat id is the bug wearing a different hat');

  // The resolver itself: the typed name outranks the binding, and a binding belonging to somebody else is refused…
  var res = stCode_(seatResolveCandidate_);
  stAssert_(out, 'seat: the typed name outranks the binding',
            res.indexOf('byName') < res.indexOf('return { id: bound'),
            'the name must be tried first');
  stAssert_(out, 'seat: a binding with the wrong name is refused',
            /nameScore_\(typed, boundName\) < NAME_MATCH_MIN/.test(res),
            'a mismatched binding must not move a card');
}

// The résumé rubric may score, and may never decide.
function stResumeRubric_(out) {
  // THE RELAY GIVES A TOOL 110 SECONDS, one try.
  var imp = stCode_(HUB_ACTIONS.resumeInboxImport);
  stAssert_(out, 'rubric: a pass stops on the clock, not on the count',
            imp.indexOf('RESUME_INBOX_BUDGET_MS') !== -1,
            'the relay hangs up at 110s and the press shows nothing');
  stAssert_(out, 'rubric: the budget fits inside the relay one try',
            RESUME_INBOX_BUDGET_MS < 110000,
            'a budget past the relay wait cannot report back');
  stAssert_(out, 'rubric: scoring is dropped before the import is',
            RESUME_INBOX_SCORE_UNTIL_MS < RESUME_INBOX_BUDGET_MS,
            'the optional half must give way first');
  stAssert_(out, 'rubric: what did not start is counted, never silent',
            imp.indexOf('outOfTime') !== -1 && imp.indexOf('ranOut') !== -1,
            'a press that stopped early would read as "that was all of them"');

  var w = stCode_(rubricWrite_), a = stCode_(rubricAnalyze_);
  stAssert_(out, 'rubric: decision_status is never written',
            !/decision_status\s*[:=]/.test(w) && !/decision_status\s*[:=]/.test(a),
            'that column is what lets somebody out of New');
  stAssert_(out, 'rubric: the model\'s verdict is still kept',
            /recommendation\s*=\s*str_\(obj\.DecisionStatus\)/.test(a),
            'shown to a person, not written to the gate');
  // NOT via stCode_: rubricPrompt_ builds a https:// URL and stCode_ strips from the first // as a line comment…
  stAssert_(out, 'rubric: the prompt comes from the DOC, not a constant',
            // NOT stCode_: it strips from the first // and this function builds an https:// URL, which decapitates…
            String(rubricPrompt_).indexOf("hubId_('RUBRIC_DOC_ID')") !== -1 &&
            /prompt_doc_id/.test(w),
            'editing the ladder must not need a deploy, and the row must say which doc');
  stAssert_(out, 'rubric: the row records which rubric scored it',
            /prompt_content_hash/.test(w) && /raw_prompt_output_json/.test(w),
            'a score whose rubric nobody can recover is a number, not a judgement');

  // The weighting is stated in the doc; these are its own worked bounds.
  stEq_(out, 'rubric: the maximum is 18',
        rubricComposite_({ SkillsRating: 4, ExperienceRating: 4, JobHistoryRating: 4, CertsRating: 4 }), 18);
  stEq_(out, 'rubric: all zeros is 0',
        rubricComposite_({ SkillsRating: 0, ExperienceRating: 0, JobHistoryRating: 0, CertsRating: 0 }), 0);
  stEq_(out, 'rubric: skills and experience outweigh certs',
        rubricComposite_({ SkillsRating: 3, ExperienceRating: 3, JobHistoryRating: 2, CertsRating: 1 }), 11.5);
  stAssert_(out, 'rubric: a missing rating computes nothing rather than a low score',
            rubricComposite_({ SkillsRating: 3, ExperienceRating: '', JobHistoryRating: 2, CertsRating: 1 }) === null,
            'an absent rating must not read as zero');
}

// The document archive may fill a blank and may never overwrite a date.
function stStaffDocs_(out) {
  var apply = stCode_(HUB_ACTIONS.staffDocsApplyDates);
  stAssert_(out, 'docs: the Master is only ever filled where it is blank',
            /expected:\s*''/.test(apply),
            "expected:'' is the fill-blank proof");
  stAssert_(out, 'docs: writing goes through the ONE Master writer',
            /emp360WriteCell_\(/.test(apply),
            'a second writer would carry its own copy of the guards');
  stAssert_(out, 'docs: the dates come from the FORM, not a filename',
            /staffDocsDated_\(/.test(apply),
            'generateFileName stamps the CERT date when there is one');

  // THE FILENAME MUST NOT DATE ANYTHING.
  var a = staffDocsParse_('Deanna Williams - CPR / 1st Aid Certificate - 20260429.pdf');
  stEq_(out, 'docs: the name comes off the front', a && a.name, 'Deanna Williams');
  stEq_(out, 'docs: a type containing a slash survives', a && a.type, 'CPR / 1st Aid Certificate');
  stAssert_(out, 'docs: the filename never yields a date',
            a && a.expires === undefined, 'the eight digits are ambiguous');
  stAssert_(out, 'docs: a filename that names nobody parses to nothing',
            staffDocsParse_('Admin ABD.jpg') === null, 'no separator, no record');

  // The form's two date shapes, reordered without constructing a Date.
  stEq_(out, 'docs: an ISO day passes through', staffDocsDay_('2026-04-29'), '2026-04-29');
  stEq_(out, 'docs: 4/29/2026 becomes 2026-04-29', staffDocsDay_('4/29/2026'), '2026-04-29');
  stEq_(out, 'docs: an unreadable date is empty, never today', staffDocsDay_('soon'), '');

  // Med Del is refused at the mapping, so it can never reach the writer.
  var med = staffDocType_('Med Del Cert');
  stAssert_(out, 'docs: Med Del dates are refused',
            !!(med && med.refuse) && !med.col, 'the delegation engine owns those cells');
  var cpr = staffDocType_('CPR / 1st Aid Certificate');
  stEq_(out, 'docs: CPR maps to its own expiry column', cpr && cpr.col, 'cpr_exp_date');
}

// ------------------------------------------------------------------ 24.
function stOptOut_(out) {
  if (typeof optOutKey_ !== 'function') {
    stAssert_(out, 'opt-out: the module is loaded', false, 'OptOut.gs missing');
    return;
  }

  // One key space for two formats: the same person reached two ways.
  stEq_(out, 'opt-out: a number keys on its last ten digits',
        optOutKey_('+1 (330) 919-5559'), '3309195559');
  stEq_(out, 'opt-out: the country code cannot make two of one person',
        optOutKey_('13309195559'), optOutKey_('3309195559'));
  stEq_(out, 'opt-out: an address keys lowercase', optOutKey_('Someone@Example.COM'), 'someone@example.com');
  stEq_(out, 'opt-out: a short number keys on nothing', optOutKey_('5559'), '');

  // THE WHOLE MESSAGE, NEVER A SUBSTRING.
  stEq_(out, 'opt-out: STOP alone is a stop', optOutIntent_('STOP'), 'opt-out');
  stEq_(out, 'opt-out: punctuation and case do not hide it', optOutIntent_('  Stop! '), 'opt-out');
  stEq_(out, 'opt-out: "pare" is a stop too', optOutIntent_('pare'), 'opt-out');
  stEq_(out, 'opt-out: a sentence CONTAINING stop is a reply',
        optOutIntent_('I had to stop working there in 2019'), 'reply');
  stEq_(out, 'opt-out: START asks to resume', optOutIntent_('start'), 'opt-in');
  stEq_(out, 'opt-out: an ordinary answer is a reply',
        optOutIntent_('I can only do evenings'), 'reply');
  stEq_(out, 'opt-out: an empty body claims nothing', optOutIntent_('   '), '');

  // The guard lives at the ONE door, and refuses rather than assumes.
  var call = stCode_(rpcCall_);
  stAssert_(out, 'opt-out: the brake is inside rpcCall_',
            call.indexOf('optOutBlocked_') !== -1,
            'a guard outside the single door is a guard the next module skips');
  stAssert_(out, 'opt-out: it is checked BEFORE dry_run answers',
            call.indexOf('optOutBlocked_') < call.indexOf('dry_run'),
            'a rehearsal that says "would send" to a suppressed number taught the wrong thing');
  stAssert_(out, 'opt-out: an unreadable list stops the send',
            call.indexOf('could not be checked') !== -1,
            '"we cannot tell" must never resolve to "go ahead, text them"');
  stAssert_(out, 'opt-out: the escalation team stays reachable',
            call.indexOf("name !== 'teamAlert'") !== -1,
            'an alert a staff member can silence from their handset goes missing when it counts');

  // The record survives a release: who asked to stop, and when, is history.
  var idx = stCode_(optOutIndex_);
  stAssert_(out, 'opt-out: a released row stops blocking',
            idx.indexOf('releasedat') !== -1, 'release is not honoured');
  stAssert_(out, 'opt-out: a failed read is never cached',
            idx.indexOf('NEVER cached') !== -1 || /return out;/.test(idx),
            'caching a failure would answer "nobody opted out" for 45 seconds');

  // The sweep cannot double-count: its source is rewritten every sync.
  var sweep = stCode_(commsInboundRun_);
  stAssert_(out, 'opt-out: the sweep skips messages already recorded',
            sweep.indexOf('seen.have[id]') !== -1,
            'the messages tab is a rolling window, not a queue');
  stAssert_(out, 'opt-out: an unreadable window sweeps nothing',
            sweep.indexOf('Nothing was swept') !== -1,
            '"0 new replies" would hide somebody asking us to stop');
  // THE COLUMN THAT LIES.
  stAssert_(out, 'opt-out: inbound is decided by Status, never by Direction',
            sweep.indexOf("'received'") !== -1 && sweep.indexOf('iStatus') !== -1,
            'the mirror Direction column says incoming on outgoing messages');
  stAssert_(out, 'opt-out: the broken Direction column is not consulted',
            sweep.indexOf('.direction') === -1,
            'Direction is the column that lies here');
  stAssert_(out, 'opt-out: our own lines are not read as candidates writing back',
            sweep.indexOf('inboundIsOurs_') !== -1,
            'staff-to-staff traffic would become replies and stops');
  stAssert_(out, 'opt-out: an empty window is reported as no FEED, not no replies',
            sweep.indexOf('noFeed') !== -1,
            'somebody would believe the brake is listening when nothing reaches it');
  stAssert_(out, 'opt-out: a pass is bounded and says what it left behind',
            sweep.indexOf('INBOUND_BATCH_RECORD') !== -1 && sweep.indexOf('remaining') !== -1,
            'a silent cap on a 19k backfill reads as "that was all of it"');

  // Our own lines can never be mistaken for somebody writing back.
  stAssert_(out, 'opt-out: the recruiter line is ours', inboundIsOurs_('3309195559'), 'not recognised');
  stAssert_(out, 'opt-out: the phone-screen line is ours', inboundIsOurs_('3307544040'), 'not recognised');
  stAssert_(out, 'opt-out: a stranger is not ours', inboundIsOurs_('3302091594') === false, 'wrongly ours');
  stAssert_(out, 'opt-out: an empty sender is treated as ours, never as a person',
            inboundIsOurs_(''), 'a blank number would open a card-less suppression');

  // THE SCOPE — a wrong number speaks for the conversation it happened in, and a stop speaks for all of them.
  (function () {
    var held = optOutIndex_;
    var heldAction = (typeof HUB_ACTION_NOW !== 'undefined') ? HUB_ACTION_NOW : '';
    var row = function (source, scope) {
      return { by: { '3303096270': { target: '+13303096270', kind: 'phone', name: '',
                                     candidate_id: '', source: source, phrase: 'Wrong person',
                                     at: '2026-08-11T18:25:21.907Z', scope: scope } },
               error: '' };
    };
    try {
      optOutIndex_ = function () { return row('wrong number', 'hiring'); };
      stAssert_(out, 'opt-out: a wrong number from hiring still blocks hiring',
                !!optOutBlocked_('+13303096270', 'hiring'), 'the conversation it was about went through');
      stAssert_(out, 'opt-out: ...and does not block the staff lane',
                optOutBlocked_('+13303096270', 'staff') === '',
                'a recruiting mistake is still silencing somebody’s shifts');
      stAssert_(out, 'opt-out: a caller that cannot name its conversation is blocked',
                !!optOutBlocked_('+13303096270', ''),
                'unknown started sending, which is the wrong direction to fail in');

      optOutIndex_ = function () { return row('sms reply', 'hiring'); };
      stAssert_(out, 'opt-out: a STOP is never narrowed, whatever a cell says',
                !!optOutBlocked_('+13303096270', 'staff'),
                'somebody who asked us to stop was written to by another lane');

      optOutIndex_ = function () { return row('wrong number', ''); };
      stAssert_(out, 'opt-out: a row with no scope blocks every conversation',
                !!optOutBlocked_('+13303096270', 'staff') && !!optOutBlocked_('+13303096270', 'hiring'),
                'every row written before the column existed just opened');
    } finally {
      optOutIndex_ = held;
      HUB_ACTION_NOW = heldAction;
    }
  })();

  // The line a reply arrived on is the evidence for its scope.
  stEq_(out, 'opt-out: the recruiter line names a hiring conversation',
        optOutScopeForLine_('+13309195559'), 'hiring');
  stEq_(out, 'opt-out: the phone-screen line does too',
        optOutScopeForLine_('+13307544040'), 'hiring');
  stEq_(out, 'opt-out: a line we do not know names nothing',
        optOutScopeForLine_('+13302091594'), '');

  // THE OTHER DOOR INTO THE SAME TAB.
  stAssert_(out, 'opt-out: the provider door asks whose line it is too',
            typeof quoInboundPull_ === 'function' &&
            stCode_(quoInboundPull_).indexOf('inboundIsOurs_') !== -1,
            'the second writer would keep filing our own sends as replies');

  // Wrong number is its own outcome: bad data of ours, not their decision.
  stEq_(out, 'opt-out: "wrong number" is its own intent', optOutIntent_('Wrong number'), 'wrong-number');
  stEq_(out, 'opt-out: a sentence about a wrong number is a reply',
        optOutIntent_('I called the wrong number earlier, sorry'), 'reply');

  // "YES" IS NOT AN OPT-IN, and this assertion is why.
  stEq_(out, 'opt-out: "yes" is an answer, never a request to be texted again',
        optOutIntent_('yes'), 'reply');
  stEq_(out, 'opt-out: START still resumes', optOutIntent_('START'), 'opt-in');

  // A DECISION IS ALWAYS FILED; the company's own traffic is not copied here.
  stAssert_(out, 'opt-out: a stop is recorded even when it belongs to nobody on the board',
            sweep.indexOf('decision || who || recent') !== -1,
            'an action without a record is one nobody can audit');
  stAssert_(out, 'opt-out: what was read and not filed is counted, never hidden',
            sweep.indexOf('passedOver') !== -1,
            'a silent pass-over reads as "that was everything"');
  stAssert_(out, 'opt-out: and the LOG carries that count too',
            /hubSysLog_[\s\S]{0,400}passedOver/.test(sweep),
            '"0 new" in the log reads as "there was nothing there"');

  // A BRAKE THAT WAITS FOR A CLICK IS NOT A BRAKE.
  stAssert_(out, 'opt-out: the sweep runs without anybody pressing anything',
            typeof commsInboundSweepMaybe_ === 'function',
            'a STOP arriving overnight would wait for somebody to open a screen');
  if (typeof hubHiredSweepMaybe_ === 'function') {
    var pass = stCode_(hubHiredSweepMaybe_);
    stAssert_(out, 'opt-out: the machine pass reads the replies',
              pass.indexOf('commsInboundSweepMaybe_') !== -1,
              'nothing calls the automatic inbound sweep');
    stAssert_(out, 'opt-out: the packet request no longer rides this pass (Python sends it, after its own read)',
              pass.indexOf('packetRequestSweep_()') === -1,
              'the platform would answer a person\'s "stop" with another message');
  }
  var auto = stCode_(commsInboundSweepMaybe_);
  stAssert_(out, 'opt-out: the automatic pass never rides a person\'s click',
            auto.indexOf('HUB_IS_SERVICE_REQ') !== -1,
            'seconds of sweeping would be charged to somebody opening a page');
}

// ------------------------------------------------------------------ 25.
function stDocChain_(out) {
  if (typeof ID_DOCS === 'undefined') {
    stAssert_(out, 'docs: the onboarding list exists', false, 'ID_DOCS missing');
    return;
  }

 // THE FORM COLLECTS SEVEN TYPES (measured over 1,729 submissions).
  var priors = {};
  ID_DOCS.forEach(function (d) { priors[d.prior] = true; });
  ['DODD Training Certificate', 'CPR / 1st Aid Certificate', 'Drivers License / OH ID',
   'Social Security Card / Birth Certificate', 'HS Diploma / Transcripts / GED',
   'Med Del Cert', 'Car Insurance Card'].forEach(function (label) {
    stAssert_(out, 'docs: onboarding credits "' + label + '" already on file',
              priors[label] === true, 'the person is asked for it a second time');
  });

  // THREE VOCABULARIES, ONE CHAIN.
  var cats = {};
  if (typeof DOC_CATALOG_DEFAULT !== 'undefined') {
    DOC_CATALOG_DEFAULT.forEach(function (c) { cats[c.doc_id] = true; });
  }
  ID_DOCS.forEach(function (d) {
    stAssert_(out, 'docs: ' + d.id + ' names a catalogue id',
              !!d.cat && cats[d.cat] === true,
              'cat "' + str_(d.cat) + '" is not in the document catalogue');
  });

  // The upload has to land in all three places, and none of them may block it.
  var up = stCode_(HUB_ACTIONS.obDocUpload);
  stAssert_(out, 'docs: a portal upload reaches the platform record',
            up.indexOf('obRecordCanonical_') !== -1,
            'employeeDbFill reads that tab and would see nothing');
  stAssert_(out, 'docs: a portal upload reaches the estate archive',
            up.indexOf('obArchiveCopy_') !== -1, 'the archive would miss what we collect');
  stAssert_(out, 'docs: a rehearsal never reaches the real archive',
            up.indexOf('target.live') !== -1, 'a test file would land in the estate folder');
  stAssert_(out, 'docs: bookkeeping never costs somebody their upload',
            stCode_(obRecordCanonical_).indexOf('catch') !== -1, 'a failed row would throw');

  // What the writer fills, now that the driver block is wired.
  var fill = stCode_(HUB_ACTIONS.employeeDbFill);
  ['DL #', 'Insurance Exp Date', 'Driver'].forEach(function (col) {
    stAssert_(out, 'docs: the Master column "' + col + '" is written',
              fill.indexOf(col) !== -1, 'the platform holds the answer and leaves it blank');
  });

  // The flag block is formulas — writing a number there replaces a rule.
  stAssert_(out, 'docs: no formula column is ever written',
            fill.indexOf("'All Completed'") === -1 && fill.indexOf("'Job App'") === -1,
            'a 1 written there replaces the sheet own rule with a constant');
}

// ------------------------------------------------------------------ 26.
function stCjis_(out) {
  if (typeof cjisNameFrom_ !== 'function') {
    stAssert_(out, 'cjis: the module is loaded', false, 'Cjis.gs missing');
    return;
  }

  // A NAME OR NOTHING.
  stEq_(out, 'cjis: the person comes out of the filename',
        cjisNameFrom_('CJIS_Report_Brytasia_Jones_20260429.pdf'), 'Brytasia Jones');
  stEq_(out, 'cjis: the words CJIS and BCI are not part of anybody name',
        cjisNameFrom_('BCI FBI - Marilyn Everett.pdf'), 'Marilyn Everett');
  stEq_(out, 'cjis: a file naming nobody yields nothing',
        cjisNameFrom_('background report 8829911.pdf'), '');
  stEq_(out, 'cjis: one word is not a person', cjisNameFrom_('CJIS_Jones.pdf'), '');
  // THE FOLDER'S OWN CONVENTION: `<Name> - <Type> - <YYYYMMDD>`, the same one StaffDocs.gs reads.
  stEq_(out, 'cjis: the name is what comes before the first dash',
        cjisNameFrom_('Tyrreah White - DODD Training Certificate - 20250817.jpg'), 'Tyrreah White');
  stEq_(out, 'cjis: a slashed document type is not part of the name',
        cjisNameFrom_('Trinity Griffiths - Drivers License / OH ID - 20250710.jpg'), 'Trinity Griffiths');
  stEq_(out, 'cjis: a first name alone is reported, never matched',
        cjisNameFrom_('Tyisha - Social Security Card / Birth Certificate.jpg'), '');
  // "Doe, Jane" is the one reorder this does, and it has to be exact: without it the key is doejane against janedoe…
  stEq_(out, 'cjis: "Last, First" is read as the person, not the order',
        cjisNameFrom_('Everett, Marilyn - CJIS.pdf'), 'Marilyn Everett');
  stEq_(out, 'cjis: a date in the name is not part of it',
        cjisNameFrom_('marilyn everett bci 04-29-2026.pdf'), 'marilyn everett');
  stEq_(out, 'cjis: the key ignores case and punctuation',
        cjisKey_("Mary O'Brien"), cjisKey_('mary obrien'));

  // THE LINE THIS FILE MUST NOT CROSS.
  var apply = stCode_(HUB_ACTIONS.cjisApply), attach = stCode_(cjisAttach_);
  stAssert_(out, 'cjis: the folder never writes Clear',
            attach.indexOf("'Clear'") === -1 && apply.indexOf("'Clear'") === -1,
            'a filename would be passing a background check');
  stAssert_(out, 'cjis: the folder never writes Verified',
            attach.indexOf("'Verified'") === -1 && apply.indexOf("'Verified'") === -1,
            'same gate, same objection');
  stAssert_(out, 'cjis: what it writes is "On file"',
            attach.indexOf("'On file'") !== -1, 'the status has to say what is true');
  stAssert_(out, 'cjis: a verdict a person recorded is never overwritten',
            attach.indexOf('st === ') !== -1,
            'an automatic pass would erase somebody decision');
  stAssert_(out, 'cjis: and "On file" does NOT open the gate',
            hubCjisCleared_({ cjisstatus: 'On file', cjisreporturl: 'https://x/y' }) === false,
            'the report being present would advance the candidate on its own');

  // Unreadable is not empty — the folder refusing must not read as "no report".
  var scan = stCode_(HUB_ACTIONS.cjisScan);
  stAssert_(out, 'cjis: an unreadable folder reads nothing rather than nobody',
            scan.indexOf('idx.error') !== -1, 'somebody would upload what is already there');
  stAssert_(out, 'cjis: files naming nobody are reported, not dropped',
            scan.indexOf('unparsed') !== -1, 'a silent drop hides a report from its owner');

  // INITIALS, NEVER AN ICON, on every card that names a person.
  var rec = stCode_(talentRecord_);
  stAssert_(out, 'cjis: a candidate card carries no stand-in icon',
            rec.indexOf("'icon:'") === -1 && rec.indexOf("icon:user-check") === -1,
            'a stethoscope standing in for a person reads as decoration');
  stAssert_(out, 'cjis: and no icon list survives to be picked from',
            typeof TALENT_AVATAR_ICONS === 'undefined',
            'the list is what a future edit would reach for');

  // TEST MODE.
  var who = stCode_(cjisCandidates_);
  stAssert_(out, 'cjis: a rehearsal card is recognised',
            who.indexOf('commsIsTestCandidate_') !== -1, 'test cards would be treated as people');
  stAssert_(out, 'cjis: a rehearsal is never attached to, even when named',
            apply.indexOf('c.isTest') !== -1,
            'passing its id would still write a real report onto a fake row');
  stAssert_(out, 'cjis: but the match is still SHOWN for a rehearsal',
            scan.indexOf('rehearsals') !== -1,
            'hiding it would look like the folder had nothing');
}

// ------------------------------------------------------------------ 27.
function stClientChart_(out) {
  if (typeof apptBucket_ !== 'function') {
    stAssert_(out, 'chart: the module is loaded', false, 'Clients.gs missing');
    return;
  }

 // A DAY IS CUT, NEVER PARSED.
  stEq_(out, 'chart: an ISO day is cut out whole', apptDay_('2026-08-04'), '2026-08-04');
  stEq_(out, 'chart: an ISO instant keeps its calendar day', apptDay_('2026-08-04T23:30:00.000Z'), '2026-08-04');
  stEq_(out, 'chart: M/D/YYYY is rebuilt by parts', apptDay_('8/4/2026'), '2026-08-04');
  stEq_(out, 'chart: a day nobody can read says so', apptDay_('next tuesday'), '');

  var today = '2026-08-12';
  var floor = '2026-06-13';   // today - 60

  stEq_(out, 'chart: today is still upcoming', apptBucket_('2026-08-12', 'scheduled', today, floor), 'upcoming');
  stEq_(out, 'chart: tomorrow is upcoming', apptBucket_('2026-08-13', 'scheduled', today, floor), 'upcoming');
  stEq_(out, 'chart: yesterday is history', apptBucket_('2026-08-11', 'completed', today, floor), 'recent');

  // The correction the legacy screen never made: a row still marked "scheduled" for a day that has passed is NOT…
  stEq_(out, 'chart: a past date marked scheduled is history, not upcoming',
        apptBucket_('2026-07-01', 'scheduled', today, floor), 'recent');

  // BOTH ENDS ARE BOUND.
  stEq_(out, 'chart: older than the window is in neither list',
        apptBucket_('2026-01-05', 'completed', today, floor), '');

  // A visit that did not happen is not history.
  stEq_(out, 'chart: a cancelled past visit is not history',
        apptBucket_('2026-08-01', 'cancelled', today, floor), '');

  // An unreadable date must not be filed away where nobody looks.
  stEq_(out, 'chart: an unreadable date stays upcoming',
        apptBucket_('', 'scheduled', today, floor), 'upcoming');

  // THREE OF THE LEGACY EIGHT CARE CATEGORIES HAVE NO SOURCE.
  var care = clientCareFromIsp_({
    communication: 'Uses short sentences.',
    safety_risks: 'Falls risk on stairs.',
    personal_care: 'Needs prompting to shave.',
    mobility: 'Walks with a cane.',
    behaviors: 'Escalates when rushed.',
    diet_nutrition: 'Mechanical soft.'
  });
  stAssert_(out, 'chart: routine is not invented', !('care_routine' in care), 'a category with no source appeared');
  stAssert_(out, 'chart: community involvement is not invented', !('care_community' in care), 'a category with no source appeared');
  stAssert_(out, 'chart: finances is not invented', !('care_finances' in care), 'a category with no source appeared');

  // Daily Living is TWO ISP columns in one pane — unlabelled, they read as one paragraph and nobody can tell which…
  stAssert_(out, 'chart: daily living labels both of its sources',
            care.care_daily_living.indexOf('Personal care') === 0 &&
            care.care_daily_living.indexOf('Mobility') > 0,
            'got: ' + care.care_daily_living);

  var oneSided = clientCareFromIsp_({ mobility: 'Walks with a cane.' });
  stAssert_(out, 'chart: a missing half leaves no empty heading behind',
            oneSided.care_daily_living.indexOf('Personal care') === -1 &&
            oneSided.care_daily_living.indexOf('Mobility') === 0,
            'got: ' + oneSided.care_daily_living);
  stEq_(out, 'chart: a client with no care text gets an empty string, not a label',
        clientCareFromIsp_({}).care_daily_living, '');

  /* -------- demographics, off the plan's own contact page -------- */

  // A real plan's page, shortened.
  var page = [
    'Contact Information', 'Name:', 'Andrea Currence', 'Preferred Name:',
    'Date of Birth:', 'August 4, 1961',
    'Address:', '3668 BOGOTA', 'DRIVE',
    'City, State, Zip:', 'WESTERVILLE,', 'OH 43081',
    'County:', 'FRAN', 'Email:', 'Phone:', '3304773134',
    'Status:', 'Single', 'Sex:', 'Female',
    'Medicaid #:', '763080892601',
    'Funding Sources:', 'HCBS - Individual Options', 'Waiver',
    'Best way to connect:', 'Phone Call', 'Additional Information:',
    'DODD #:', '8521433',
    'Important People:', 'Type:', 'Name/Relationship:', 'Address:', 'Phone:',
    'Case Manager', 'Deborah Riley- SSA', '2950 Whipple Ave NW', 'rileyd@starkdd.org', '330-479-3766',
    'Emergency Contact', 'Andrea Anderson- Sister in Law', '4955 Kilconnel Dr', '330-714-5883'
  ].join('\n');
  var d = ispDemographics_(page, 'Andrea Currence');

  stEq_(out, 'chart: the date of birth is cut into ISO, never parsed', d.dob, '1961-08-04');

  // THE BUG THIS EXISTS FOR: "Address:" and "Phone:" appear AGAIN as column headers of the Important People table.
  stEq_(out, 'chart: the address keeps its street and its city',
        d.home_address, '3668 BOGOTA DRIVE, WESTERVILLE, OH 43081');
  stEq_(out, 'chart: the phone is the PERSON\'s, not the contact table',
        d.client_phone, '(330) 477-3134');

  stEq_(out, 'chart: the S.S.A. comes off the Important People table', d.ssa_name, 'Deborah Riley- SSA');
  stEq_(out, 'chart: ...with their phone', d.ssa_phone, '(330) 479-3766');
  stEq_(out, 'chart: ...and their email', d.ssa_email, 'rileyd@starkdd.org');
  stEq_(out, 'chart: the emergency contact is a different person',
        d.emergency_name, 'Andrea Anderson- Sister in Law');
  stEq_(out, 'chart: the DODD number is digits only', d.dodd_id, '8521433');

  // "Person Supported/Family/Guardian: <the person themselves>" means they are their own guardian.
  stEq_(out, 'chart: a person who is their own guardian reads "Self"',
        ispGuardianFromConsent_('Person Supported/Family/Guardian: Andrea Currence', 'Andrea Currence'),
        'Self');
  stEq_(out, 'chart: somebody else\'s guardianship keeps their name',
        ispGuardianFromConsent_('Person Supported/Family/Guardian: Denise Hollenbach', 'Barbara Mayle'),
        'Denise Hollenbach');

  // A plan with no contact page must not produce invented blanks that look like fields — the caller spreads this…
  stAssert_(out, 'chart: no contact page yields no demographic keys at all',
            Object.keys(ispDemographics_('', 'Nobody')).length === 0, 'keys appeared from nothing');

  // AN ID THAT IS NOT ID-SHAPED IS REFUSED.
  stEq_(out, 'chart: a real DODD number passes', ispIdDigits_('8521433', 9), '8521433');
  stEq_(out, 'chart: page scraps wearing the DODD label are refused',
        ispIdDigits_('94496183120263020271202624741202630202712026', 9), '');
  stEq_(out, 'chart: a real Medicaid number passes', ispIdDigits_('763080892601', 12), '763080892601');
  var multiline = ['Contact Information', 'DODD #:', '8521433',
                   '1/2026', '3/2027', '4/2026'].join('\n');
  stEq_(out, 'chart: the DODD value is ONE line, never the rest of the page',
        ispDemographics_(multiline, 'X').dodd_id, '8521433');

  // THE TOOLBAR IS GOVERNED PER ITEM, and Views is never among them — it is how people reach the views at all.
  stEq_(out, 'toolbar: blank means everything', clientToolbarItems_('').join(','), 'share,export,add');
  stEq_(out, 'toolbar: legacy yes means everything', clientToolbarItems_('yes').join(','), 'share,export,add');
  stEq_(out, 'toolbar: legacy no means nothing but Views', clientToolbarItems_('no').join(','), '');
  stEq_(out, 'toolbar: a pick is exactly the pick', clientToolbarItems_('export').join(','), 'export');
  stEq_(out, 'toolbar: order is the platform\'s, not the cell\'s',
        clientToolbarItems_('add, share').join(','), 'share,add');
  stEq_(out, 'toolbar: an unknown word buys nothing', clientToolbarItems_('views, export').join(','), 'export');
}

function stQuestionnaire_(out) {
  if (typeof questionnaireScore_ !== 'function') {
    stAssert_(out, 'quiz: the module is loaded', false, 'Questionnaire.gs missing');
    return;
  }
  var scale = { kind: 'scale', metric: 'X', weight: 0.25 };
  stEq_(out, 'quiz: a 1-5 answer scores itself', questionnaireScore_(scale, '4'), 4);
  stEq_(out, 'quiz: an unanswered question scores nothing', questionnaireScore_(scale, ''), null);

  // THE DIRECTION IS THE WHOLE POINT.
  var good = { kind: 'yesno', metric: 'X', weight: 0.25, yes_is: 'yes' };
  var bad  = { kind: 'yesno', metric: 'X', weight: 0.25, yes_is: 'no' };
  stEq_(out, 'quiz: "did you complete it" — Yes is the good answer', questionnaireScore_(good, 'Yes'), 5);
  stEq_(out, 'quiz: ...and No is the poor one', questionnaireScore_(good, 'No'), 1);
  stEq_(out, 'quiz: "have you ever expired" — NO is the good answer', questionnaireScore_(bad, 'No'), 5);
  stEq_(out, 'quiz: ...and Yes is the poor one', questionnaireScore_(bad, 'Yes'), 1);

  // Open text is read by a person. Scoring it 0 would punish an honest answer.
  var open = { kind: 'text', metric: 'Diagnostic Only', weight: 0 };
  stEq_(out, 'quiz: open text is diagnostic, never scored',
        questionnaireScore_(open, 'I feel least confident in med del'), null);

  // The weighted result: two questions of unequal weight cannot average flat.
  var qs = [{ id: 'a', kind: 'scale', metric: 'M1', weight: 1.0 },
            { id: 'b', kind: 'scale', metric: 'M2', weight: 0.2 }];
  var r = questionnaireResult_(qs, { a: '5', b: '1' });
  stAssert_(out, 'quiz: the heavier question moves the score more',
            r.score > 4, 'got ' + r.score + ' — the weights are being ignored');
  stEq_(out, 'quiz: a full sheet of fives is five',
        questionnaireResult_(qs, { a: '5', b: '5' }).score, 5);
  stEq_(out, 'quiz: nothing answered scores nothing, never zero',
        questionnaireResult_(qs, {}).score, null);

  // Scoring happens on the SERVER, beside the weights.
  var sub = stCode_(HUB_ACTIONS.questionnaireSubmit);
  stAssert_(out, 'quiz: the submission is scored where the weights live',
            sub.indexOf('questionnaireResult_') !== -1,
            'a score computed in the browser is one anybody can edit in a console');
  stAssert_(out, 'quiz: the answers are kept, not just the total',
            sub.indexOf('answers_json') !== -1, 'a score with no answers cannot be checked');
}

// THE FLOW VIEW (HiringFlow.gs) — the views law parser, the schedule validator, the calendar merge and the…
function stHiringFlow_(out) {
  if (typeof hiringViewsFromRaw_ !== 'function' || typeof hiringEventValid_ !== 'function') {
    stAssert_(out, 'flow: HiringFlow.gs is loaded', false, 'HiringFlow.gs missing');
    return;
  }

  // The views law reads like the Clients one — same words, same meanings.
  var ALL_VIEWS = 'pipeline,table,calendar,actions,documents,reports,analysis,scores,archive';
  var FLOW_RAIL = 'table,calendar,actions,documents,reports';
  stEq_(out, 'flow: a blank law means every view', hiringViewsFromRaw_('').join(','), ALL_VIEWS);
  stEq_(out, 'flow: legacy yes means every view', hiringViewsFromRaw_('yes').join(','), ALL_VIEWS);
  stEq_(out, 'flow: legacy no means none', hiringViewsFromRaw_('no').join(','), '');
  stEq_(out, 'flow: the word flow still means the views of the old rail', hiringViewsFromRaw_('flow').join(','), FLOW_RAIL);
  stEq_(out, 'flow: the shipped cell survives the merge', hiringViewsFromRaw_('pipeline, flow').join(','), 'pipeline,' + FLOW_RAIL);
  stEq_(out, 'flow: a single word keeps that view alone', hiringViewsFromRaw_('actions').join(','), 'actions');
  stEq_(out, 'flow: the Talent screens are views like any other', hiringViewsFromRaw_('analysis, scores').join(','), 'analysis,scores');
  stEq_(out, 'flow: the order is the vocabulary’s, not the cell’s', hiringViewsFromRaw_('reports, pipeline').join(','), 'pipeline,reports');
  stEq_(out, 'flow: junk words are not views', hiringViewsFromRaw_('junk, nonsense').join(','), '');
  stEq_(out, 'flow: flow beside its own members says them once', hiringViewsFromRaw_('flow, table').join(','), FLOW_RAIL);
  // The removed Board must not come back through a cell nobody edited: it is now exactly as meaningless as any…
  stEq_(out, 'flow: the retired Board is not a view any more', hiringViewsFromRaw_('board').join(','), '');
  stEq_(out, 'flow: a cell that still names the Board keeps the rest', hiringViewsFromRaw_('pipeline, board, flow').join(','), 'pipeline,' + FLOW_RAIL);

  // The schedule validator refuses by SHAPE and never parses a date.
  var good = { candidate_id: 'CAN_ABC123', event_type: 'doc_help', date: '2026-08-14', time: '14:30' };
  stAssert_(out, 'flow: a well-formed schedule passes', hiringEventValid_(good).ok, JSON.stringify(hiringEventValid_(good)));
  stAssert_(out, 'flow: time is optional', hiringEventValid_({ candidate_id: 'CAN_ABC123', event_type: 'orientation', date: '2026-08-14' }).ok, 'a date-only event must be schedulable');
  stAssert_(out, 'flow: a stray candidate id is refused', !hiringEventValid_({ candidate_id: 'nope', event_type: 'doc_help', date: '2026-08-14' }).ok, '');
  stAssert_(out, 'flow: an unknown event type is refused', !hiringEventValid_({ candidate_id: 'CAN_ABC123', event_type: 'party', date: '2026-08-14' }).ok, '');
  stAssert_(out, 'flow: a loose date shape is refused', !hiringEventValid_({ candidate_id: 'CAN_ABC123', event_type: 'doc_help', date: '2026-8-4' }).ok, 'YYYY-M-D would parse somewhere and cut wrong');
  stAssert_(out, 'flow: a 25th hour is refused', !hiringEventValid_({ candidate_id: 'CAN_ABC123', event_type: 'doc_help', date: '2026-08-14', time: '25:00' }).ok, '');
  var validSrc = String(hiringEventValid_) + String(HUB_ACTIONS.hiringScheduleCreate);
  stAssert_(out, 'flow: the schedule path never parses a date',
            validSrc.indexOf('new Date(str_(p.date)') === -1 && validSrc.indexOf('new Date(date') === -1,
            'a parsed YYYY-MM-DD is midnight UTC — the previous evening in Ohio');

  // Cell readback is judged by SHAPE: a coerced time comes back UTC-shifted and hours-wrong, so it is refused…
  stEq_(out, 'flow: a clean date cell reads as its day', hiringDateText_('2026-08-14'), '2026-08-14');
  stEq_(out, 'flow: a coerced date cell still reads as its day', hiringDateText_('2026-08-14T04:00:00.000Z'), '2026-08-14');
  stEq_(out, 'flow: a word is not a date', hiringDateText_('Wed Aug 14'), '');
  stEq_(out, 'flow: a clean time cell reads padded', hiringTimeText_('9:30'), '09:30');
  stEq_(out, 'flow: a coerced time cell is refused, not repaired', hiringTimeText_('6:30:00 PM'), '');

  // The merge: an interviews-tab row shows ONLY while the calendar has no in-person event for that candidate — one…
  var calEv = { id: 'HEV_1', candidate_id: 'CAN_A', name: 'A', type: 'in_person_interview',
                type_label: 'In-person interview', date: '2026-08-20', time: '10:00',
                location: '', with_name: '', notes: '', status: 'scheduled', source: 'calendar' };
  var ivRow = { interviewid: 'INT_1', candidateid: 'CAN_A', candidatename: 'A',
                scheduledfor: '2026-08-21T09:30:00', status: 'Scheduled', interviewername: 'Sam' };
  var merged = hiringCalendarMerge_([calEv], [ivRow]);
  stEq_(out, 'flow: a calendar interview silences the interviews-tab twin', merged.length, 1);
  var merged2 = hiringCalendarMerge_([], [ivRow]);
  stEq_(out, 'flow: with no calendar event the interviews tab speaks', merged2.length, 1);
  stEq_(out, 'flow: the interviews tab contributes its time of day', merged2[0].time, '09:30');
  stEq_(out, 'flow: the interviews tab row knows what it is', merged2[0].source, 'interview');
  var mergedSort = hiringCalendarMerge_(
    [{ id: 'b', candidate_id: 'CAN_B', name: 'B', type: 'doc_help', type_label: 'Document Q&A',
       date: '2026-08-25', time: '', location: '', with_name: '', notes: '', status: 'scheduled', source: 'calendar' }],
    [ivRow]);
  stEq_(out, 'flow: the merge comes back in day order', mergedSort[0].date, '2026-08-21');
  // scheduled_for is stamped RAW from the phone screen's free-text field — "Friday 2pm" is not a date, lands on no…
  var loose = hiringCalendarMerge_([], [{ interviewid: 'INT_2', candidateid: 'CAN_C',
    candidatename: 'C', scheduledfor: 'Friday 2pm', status: 'Scheduled', interviewername: '' }]);
  stEq_(out, 'flow: a free-text interview date is not a chip', loose.length, 0);

  // The cut: the calendar shows the interview and the first day; phone screens and onboarding are workflow, not…
  var kept = hiringCalendarKeep_([
    { type: 'in_person_interview', source: 'interview' },
    { type: 'start_date', source: 'calendar' },
    { type: 'phone_screen', source: 'calendar' },
    { type: 'orientation', source: 'calendar' },
    { type: 'doc_help', source: 'calendar' }
  ]);
  stEq_(out, 'flow: the cut keeps the interview and the first day, nothing else', kept.length, 2);
  stEq_(out, 'flow: the interview survives the cut', kept[0].type, 'in_person_interview');
  stEq_(out, 'flow: the first day survives the cut', kept[1].type, 'start_date');
  stEq_(out, 'flow: the cut is by type, never source — the interviews tab speaks', kept[0].source, 'interview');
  var calListSrc = String(HUB_ACTIONS.hiringCalendarList);
  stAssert_(out, 'flow: the calendar answer passes through the cut',
            calListSrc.indexOf('hiringCalendarKeep_') !== -1,
            'an unfiltered answer puts phone screens back on BOTH calendars');

 // The ledger records what really went out (the rule): a redirected send remembers the REHEARSAL key, never the…
  var notifySrc = String(hiringEventNotify_);
  stAssert_(out, 'flow: a rehearsal is remembered as a rehearsal',
            notifySrc.indexOf('res.redirected ? smartRehearsalKey_(key) : key') !== -1,
            'a redirected send writing the real key silences the real e-mail forever');
  stAssert_(out, 'flow: a moved hour is a new telling',
            notifySrc.indexOf("(ev.time ? ':' + ev.time : '')") !== -1,
            'a dedupe key without the time never announces a same-day time change');
  stAssert_(out, 'flow: the AI answer is parsed as JSON, never mailed raw',
            notifySrc.indexOf('JSON.parse(str_(chat && chat.content))') !== -1,
            'screenAiChat_ forces JSON output — chat.content raw would e-mail an object');

  // Rescheduling after a finished interview appends a NEW row — a scored scorecard is history and history is not…
  var restampSrc = String(hiringInterviewRestamp_);
  stAssert_(out, 'flow: a scored interview row is never restamped',
            restampSrc.indexOf('scored') !== -1 && restampSrc.indexOf('appendRow') !== -1,
            'a reschedule must not rewrite a completed row back to Scheduled');

 // THE LIVE DOOR IS GATED LIKE THE SLICE (review ): the candidates join and the onboarding rows refuse the portal…
  stAssert_(out, 'gate: a client portal cannot read the candidates join live',
            talentRoute_('list', {}, { role: 'client' }).status === 403, '');
  stAssert_(out, 'gate: a trainee portal cannot read the candidates join live',
            talentRoute_('list', {}, { role: 'onboarding' }).status === 403, '');
  stAssert_(out, 'gate: staff cannot read the candidates join live (the slice never allowed it)',
            talentRoute_('list', {}, { role: 'staff' }).status === 403, '');
  stAssert_(out, 'gate: an anonymous session cannot read the candidates join live',
            talentRoute_('list', {}, null).status === 403, '');
  stAssert_(out, 'gate: the hiring team may',
            talentLiveAllowed_({ role: 'interviewer' }) && talentLiveAllowed_({ role: 'admin' }) &&
            talentLiveAllowed_({ role: 'manager' }) && talentLiveAllowed_({ role: 'director' }), '');
  stAssert_(out, 'gate: the service identity that builds the slice may',
            talentLiveAllowed_({ is_service: true }), 'refusing the builder kills the slice');
  stAssert_(out, 'gate: an older Main calling with two arguments changes nothing',
            String(talentRoute_).indexOf('user !== undefined') !== -1,
            'refusing undefined would brick the board if Talent publishes before the Main paste');
  stAssert_(out, 'gate: a client portal cannot read the onboarding rows live',
            onboardingRoute_('list', {}, { role: 'client' }).status === 403, '');
  stAssert_(out, 'gate: a trainee portal cannot read the onboarding rows live',
            onboardingRoute_('list', {}, { role: 'onboarding' }).status === 403, '');
  stAssert_(out, 'gate: staff may read onboarding, as the slice declares',
            onboardingLiveAllowed_({ role: 'staff' }) && onboardingLiveAllowed_({ is_service: true }), '');

  // The e-mail's composed lines: absence prints NOTHING, not a bare label.
  var vars = hiringEventMailVars_({ candidatename: 'Jordan Lee' },
    { candidate_id: 'CAN_A', event_type: 'in_person_interview', date: '2026-08-20',
      time: '10:00', location: 'Main office', with_name: 'Sam', notes: '' });
  stEq_(out, 'flow: first_name is the first word', vars.first_name, 'Jordan');
  stEq_(out, 'flow: a time makes a time_line', vars.time_line, ' at 10:00');
  stAssert_(out, 'flow: a location makes a where_line', vars.where_line.indexOf('Main office') !== -1, vars.where_line);
  var bare = hiringEventMailVars_({ candidatename: 'Jordan Lee' },
    { candidate_id: 'CAN_A', event_type: 'doc_help', date: '2026-08-20', time: '', location: '', with_name: '', notes: '' });
  stEq_(out, 'flow: no location, no where_line', bare.where_line, '');
  // The regression this holds: an event with NO notes must not read "{notes}" — hiringRenderMail_ substitutes every…
  var rendered = hiringRenderMail_(HIRING_EVENT_MAIL_FALLBACK.email_text, bare);
  stAssert_(out, 'flow: an absent detail vanishes instead of printing its placeholder',
            !/\{\w+\}/.test(rendered.replace(/\n/g, ' ')), rendered);
  stAssert_(out, 'flow: a typo\'d placeholder stays visible',
            hiringRenderMail_('Hi {frist_name}', vars) === 'Hi {frist_name}',
            'a silent blank hides the typo forever');

  // The declarations that make this a resolution, not a shortcut.
  stAssert_(out, 'flow: the schedule write declares its e-mail',
            HUB_POLICY.hiringScheduleCreate.emits.indexOf('emailSend') !== -1,
            'an undeclared send is invisible to check:emits');
  stEq_(out, 'flow: scheduling is a recruiter\'s hand', HUB_POLICY.hiringScheduleCreate.roles.join(','), 'admin,manager');
  stAssert_(out, 'flow: every role may read the views law',
            HUB_POLICY.hiringViewsPolicy.roles.indexOf('client') !== -1,
            'the sidebar draws for everyone, so everyone may ask');
  stAssert_(out, 'flow: the interviewer may read the calendar',
            HUB_POLICY.hiringCalendarList.roles.indexOf('interviewer') !== -1, '');
  stAssert_(out, 'flow: flow control is a writer\'s screen',
            HUB_POLICY.hiringFlowControl.roles.join(',') === 'admin,manager', '');

  // The Smart Comms row is the context; the sweep must never fire it.
  var seed = null;
  SMART_HIRING_EVENTS.forEach(function (e) { if (e.id === 'hiring_event_scheduled') seed = e; });
  stAssert_(out, 'flow: the scheduling e-mail is seeded', !!seed, 'hiring_event_scheduled missing from SMART_HIRING_EVENTS');
  var evDef = SMART_EVENTS.hiring_event_scheduled;
  stAssert_(out, 'flow: the sweep holds its predicate and it never fires',
            !!evDef && typeof evDef.applies === 'function' && evDef.applies({ id: 'X' }).fires === false,
            'the clock must never re-send what the action already sent');
  stAssert_(out, 'flow: its switch ships OFF — no publish starts a conversation nobody chose',
            !!seed && !smartOn_(seed.enabled),
            'arming it is one click in Smart Comms');
  stAssert_(out, 'flow: with no row at all, the notify fails CLOSED',
            String(hiringEventNotify_).indexOf('!sit || !smartOn_(sit.enabled)') !== -1,
            'an absent row must read as OFF, not as fallback-and-send');
}

/** THE TYPE BADGES + THE HM PEN. */
function stUserTypes_(out) {
  if (typeof userTypesFromRaw_ !== 'function') {
    stAssert_(out, 'types: Profile.gs is loaded', false, 'userTypesFromRaw_ missing');
    return;
  }
  stEq_(out, 'types: a comma list parses uppercase and deduped',
        userTypesFromRaw_('hm, interviewer, HM').types.join(','), 'HM,INTERVIEWER');
  stEq_(out, 'types: an unknown word is reported, never silently dropped',
        userTypesFromRaw_('HM, WIZARD').bad.join(','), 'WIZARD');
  stAssert_(out, 'types: MASTER is not assignable',
            HUB_USER_TYPES.indexOf('MASTER') === -1,
            'MASTER derives from HUB_MASTER_EMAIL, never from a cell');
  stAssert_(out, 'types: TEAMLEAD is a word a cell may be written with',
            HUB_USER_TYPES.indexOf('TEAMLEAD') !== -1 &&
            userTypesFromRaw_('teamlead').types.join(',') === 'TEAMLEAD' &&
            userTypesFromRaw_('TEAMLEAD').bad.length === 0,
            'a badge the validator rejects is a badge nobody can be granted');
  stAssert_(out, 'types: HM and INTERVIEWER carry the scorecard pen',
            userTypesCanInterview_(['HM']) && userTypesCanInterview_(['INTERVIEWER']) &&
            !userTypesCanInterview_(['GUARDIAN']), '');
  stAssert_(out, 'types: an HM on a NORMAL login may sign a scorecard',
            interviewCanRecord_({ role: 'staff', email: 'x@y.z', types: ['HM'] }),
            'the type is the pen — no special account, no entry link');
  stAssert_(out, 'types: the interviewer lane law is gone',
            typeof ROLE_LANE !== 'undefined' && ROLE_LANE.interviewer === undefined,
            'a lane-bound interviewer role locks the account out of the normal form');
  stAssert_(out, 'types: the login answer carries the badges',
            String(userPublic_).indexOf('userTypesFromRaw_(u.types)') !== -1,
            'a type the session never receives is a badge nobody wears');
  stAssert_(out, 'types: granting HM/INTERVIEWER also writes the hiring.interview grant',
            String(HUB_ACTIONS.userUpdate).indexOf("ovNow['hiring.interview'] = true") !== -1,
            'the door (policy gate) and the room must agree');

  // THE ONBOARDING DOOR IS PERSONAL NOW: entering the stage creates the person's own account; the shared lane is…
  stAssert_(out, 'onboard: the lane law is fully retired',
            typeof ROLE_LANE !== 'undefined' && ROLE_LANE.onboarding === undefined,
            'a lane-bound onboarding role locks the personal accounts out of the normal form');
  stAssert_(out, 'onboard: every stage write passes the account hook',
            String(hubSetStatus_).indexOf('onboardingEnsureUser_') !== -1,
            'a path into onboarding that skips the hook leaves a hire with no door');

  // THE BADGES DEFINE THE ORDER: entering onboarding stamps ONBOARDING, finishing swaps it for STAFF, and every…
  stAssert_(out, 'badges: the types cell is only ever written validated',
            String(hubUserTypesSet_).indexOf('userTypesFromRaw_') !== -1,
            'an off-vocabulary word in the cell is a badge no screen can rank');
  stAssert_(out, 'badges: entering onboarding stamps the ONBOARDING badge',
            String(onboardingEnsureUser_).indexOf("hubUserTypesSet_(uid, ['ONBOARDING'])") !== -1,
            'a person in the step with no badge is invisible to the order');
  stAssert_(out, 'badges: finishing onboarding swaps ONBOARDING for STAFF',
            String(hubHiredGraduate_).indexOf("t !== 'ONBOARDING'") !== -1 &&
            String(hubHiredGraduate_).indexOf("gradTypes.push('STAFF')") !== -1,
            'graduation must retire the stage badge, not stack STAFF on top of it');
  stAssert_(out, 'badges: an account born at graduation is born STAFF',
            String(hubHiredGraduate_).indexOf("['STAFF']") !== -1, '');
  var ouSrc = String(onboardingEnsureUser_);
  stAssert_(out, 'onboard: the password comes from the property, never the code',
            ouSrc.indexOf('ONBOARDING_USER_PASSWORD') !== -1 && ouSrc.indexOf("'onboarding'") !== -1,
            'a password typed in code is one that cannot be rotated');
  stAssert_(out, 'onboard: creating twice is refused by e-mail',
            ouSrc.indexOf('userByEmail_') !== -1,
            'a second entry into onboarding must not mint a second account');
  // The e-mail finder: shape-valid, deduped, and the AI may only pick from what the sources actually held.
  stAssert_(out, 'onboard: a word without @ is not an address',
            !onboardingEmailValid_('smith') && onboardingEmailValid_('a@b.co'), '');
  stEq_(out, 'onboard: sources dedupe case-insensitively, first source wins',
        JSON.stringify(onboardingEmailDedupe_([
          { email: 'A@b.co', source: 'card' }, { email: 'a@b.co', source: 'roster' },
          { email: 'bad', source: 'x' }, { email: 'c@d.co', source: 'roster' }])),
        JSON.stringify([{ email: 'a@b.co', source: 'card' }, { email: 'c@d.co', source: 'roster' }]));
  var findSrc = String(onboardingFindEmail_);
  stAssert_(out, 'onboard: the AI answer must be one of the FOUND addresses',
            findSrc.indexOf('distinct[i].email === pick') !== -1,
            'an invented address would become somebody\'s login');
  stAssert_(out, 'onboard: a found e-mail fills only a BLANK card',
            String(onboardingEnsureUser_).indexOf("!str_(ev.cand.email)") !== -1,
            'a guess must never overwrite what a person typed');
  // The LIFECYCLE closes: finishing onboarding PROMOTES the onboarding account to staff — one person, one login…
  var gradSrc = String(hubHiredGraduate_);
  stAssert_(out, 'onboard: graduation promotes the onboarding account, never holds on it',
            gradSrc.indexOf("=== 'onboarding'") !== -1 &&
            gradSrc.indexOf('onboarding_user_promoted') !== -1,
            'the account made at entry would hold the graduation as "already a user"');
}

// THE TEAM LEAD BADGE — a badge of its own that stands in for nobody (the operator's rule, 2026-10-29).
function stTeamLead_(out) {
  if (typeof userBadgesWorn_ !== 'function' || typeof HUB_BADGE_FOLLOWS === 'undefined') {
    stAssert_(out, 'teamlead: Profile.gs declares the badge fold', false,
              'userBadgesWorn_ / HUB_BADGE_FOLLOWS missing');
    return;
  }

  /* ── the equivalence, parted ─────────────────────────────────────────── */
  stAssert_(out, 'teamlead: the table stands TEAMLEAD in for nobody',
            !Object.prototype.hasOwnProperty.call(HUB_BADGE_FOLLOWS, 'TEAMLEAD'),
            JSON.stringify(HUB_BADGE_FOLLOWS));
  stEq_(out, 'teamlead: worn TEAMLEAD is matched as itself alone',
        userBadgesWorn_('TEAMLEAD', '').join(','), 'TEAMLEAD');
  stAssert_(out, 'teamlead: … and a director is never a team lead either',
            userBadgesWorn_('DIRECTOR', '').indexOf('TEAMLEAD') === -1,
            'a two-way fold cannot be narrowed later without moving the director too');
  stEq_(out, 'teamlead: the role is folded in beside the badges, and nothing else',
        userBadgesWorn_('TEAMLEAD', 'staff').join(','), 'TEAMLEAD,STAFF');
  stAssert_(out, 'teamlead: an off-vocabulary word is still dropped by the fold',
            userBadgesWorn_('WIZARD', '').join(',') === '',
            'the fold must not become a second, looser validator');

  // ── THE WRITE PATH NEVER LEARNS IT.
  stAssert_(out, 'teamlead: the types cell is written through the VALIDATOR, never the fold',
            String(hubUserTypesSet_).indexOf('userBadgesWorn_') === -1 &&
            String(hubUserTypesSet_).indexOf('userTypesFromRaw_') !== -1,
            'a write that folds persists the equivalence and makes it permanent');
  stAssert_(out, 'teamlead: the session carries the badges a person really wears',
            String(userPublic_).indexOf('userBadgesWorn_') === -1,
            'the login answer must say the badges worn, never what they stand in for');

  /* A current ** manager wears HM by code (Profile.gs hubCalendarBadges_). */
  (function () {
    var heldOpen = ssOpen_, heldUsers = usersAll_, heldMemo = HUB_CALENDAR_BADGES_MEMO,
        heldToday = hotlineManagerToday_, heldCache = CacheService;
    var cal = [['Location', 'Employee', 'Designation', 'Phone', 'Date'],
               ['CAN - 38TH - ABD2005', 'Old Manager', '**', '', '01/05/2025'],
               ['CAN - 38TH - ABD2005', 'Ashley Davenport', '**', '', '09/20/2026'],
               ['CAN - NW - NW100', 'Wanda McCollum-Dotson', '**', '', '09/21/2026'],
               ['CAN - NW - NW100', 'Jordyn Walker', '**', '', '09/22/2026'],
               ['CAN - NW - NW100', 'Ann Roe', 'STAFF', '', '09/22/2026']];
    var users = [{ userid: 'U1', displayname: 'Ashley Davenport', active: 'true' },
                 { userid: 'U2', displayname: 'Jordyn Walker', active: 'true' },
                 { userid: 'U3', displayname: 'Wanda McCollum-Dotson', active: 'true' },
                 { userid: 'U4', displayname: 'wanda mccollum dotson', active: 'true' },
                 { userid: 'U5', displayname: 'Old Manager', active: 'true' },
                 { userid: 'U6', displayname: 'Ann Roe', active: 'true' },
                 { userid: 'U7', displayname: 'Jordyn Walker', active: 'false' }];
    var got = {};
    try {
      CacheService = { getScriptCache: function () { return { get: function () { return null; },
                                                               put: function () {} }; } };
      hotlineManagerToday_ = function () { return '2026-09-23'; };
      usersAll_ = function () { return users; };
      ssOpen_ = function () { return { getSheetByName: function () {
        return { getDataRange: function () { return { getValues: function () { return cal; } }; } }; } }; };
      HUB_CALENDAR_BADGES_MEMO = null;
      got.ashley = hubCalendarBadges_({ id: 'U1', display_name: 'Ashley Davenport' });
      got.jordyn = hubCalendarBadges_({ userid: 'U2', displayname: 'Jordyn Walker' });
      got.wanda = hubCalendarBadges_({ id: 'U3', display_name: 'Wanda McCollum-Dotson' });
      got.old = hubCalendarBadges_({ id: 'U5', display_name: 'Old Manager' });
      got.staff = hubCalendarBadges_({ id: 'U6', display_name: 'Ann Roe' });
      got.svc = hubCalendarBadges_({ is_service: true, display_name: 'Ashley Davenport' });
      got.worn = userBadgesWornBy_({ id: 'U1', display_name: 'Ashley Davenport', types: ['STAFF'], role: 'staff' });
      got.plain = userBadgesWorn_(['STAFF'], 'staff');
      got.carried = userBadgesWornBy_({ id: 'U6', display_name: 'Ann Roe', types: [], role: 'staff',
                                        derived_types: ['HM'] });
      ssOpen_ = function () { throw new Error('the calendar would not open'); };
      HUB_CALENDAR_BADGES_MEMO = null;
      got.unread = hubCalendarBadges_({ id: 'U1', display_name: 'Ashley Davenport' });
    } finally {
      ssOpen_ = heldOpen; usersAll_ = heldUsers; HUB_CALENDAR_BADGES_MEMO = heldMemo;
      hotlineManagerToday_ = heldToday; CacheService = heldCache;
    }
    stAssert_(out, 'calendar badge: the current ** managers wear HM (the most recent row, and a co-manager ' +
                   'inside the fortnight); a manager who left, a caregiver and a service wear nothing extra',
              got.ashley.join(',') === 'HM' && got.jordyn.join(',') === 'HM' && got.old.length === 0 &&
              got.staff.length === 0 && got.svc.length === 0, JSON.stringify(got));
    stAssert_(out, 'calendar badge: a display name another LIVE account shares names nobody (an inactive ' +
                   'namesake does not count), and a calendar that cannot be read wears nothing extra',
              got.wanda.length === 0 && got.jordyn.join(',') === 'HM' && got.unread.length === 0,
              JSON.stringify(got));
    stAssert_(out, 'calendar badge: a session is matched as HM beside what it wears, the carried answer is used as ' +
                   'given, and userBadgesWorn_ — the fold of what was written — never grows it',
              got.worn.indexOf('HM') !== -1 && got.worn.indexOf('STAFF') !== -1 &&
              got.plain.indexOf('HM') === -1 && got.carried.indexOf('HM') !== -1, JSON.stringify(got));
  })();
  /* The display name is the roster identity, so a self-chosen one may not take somebody else's. */
  (function () {
    var heldUsers = usersAll_, heldPeople = commBroadcastPeopleRows_, heldCal = commBroadcastCalendar_;
    var users = [{ userid: 'U1', displayname: 'Ann Roe', active: 'true', peopleid: 'people:P1' },
                 { userid: 'U2', displayname: 'Ben Left', active: 'true' },
                 { userid: 'U3', displayname: 'Old Name', active: 'false' },
                 { userid: 'U4', displayname: 'Cy Far', active: 'true', peopleid: 'people:P3',
                   contactsources: '{"people_id":"email"}' },
                 { userid: 'U5', displayname: 'Ol Link', active: 'true', peopleid: 'people:P4', email: 'ol@x.org' },
                 { userid: 'U6', displayname: 'Ma Link', active: 'true', peopleid: 'P5', email: 'ma@x.org' }];
    var people = [{ id: 'P1', name: 'Ann Roe' }, { id: 'P2', name: 'Kamari Kidd' }, { id: 'P3', name: 'Cyrus Far' },
                  { id: 'P4', name: 'Olga Link' }, { id: 'P5', name: 'Mara Link', email: 'MA@x.org' }];
    var cal = { readable: true, houses: { 'CAN - 47TH - X47': { people: [{ key: 'deeway', name: 'Dee Way' }] } } };
    var got = {};
    try {
      usersAll_ = function () { return users; };
      commBroadcastPeopleRows_ = function () { return people; };
      commBroadcastCalendar_ = function () { return cal; };
      got.same = hubSelfNameRefused_('U1', 'ann  ROE');
      got.free = hubSelfNameRefused_('U1', 'Annie Roe-Smith');
      got.other = hubSelfNameRefused_('U1', 'Ben Left');
      got.inactive = hubSelfNameRefused_('U1', 'Old Name');
      got.manager = hubSelfNameRefused_('U2', 'Kamari Kidd');
      got.calendar = hubSelfNameRefused_('U2', 'Dee Way');
      got.linked = hubSelfNameRefused_('U4', 'Cyrus Far');
      got.unproved = hubSelfNameRefused_('U5', 'Olga Link');
      got.rowMail = hubSelfNameRefused_('U6', 'Mara Link');
      got.invite = hubSelfNameRefused_('', 'Kamari Kidd');
      commBroadcastCalendar_ = function () { return { readable: false, houses: {} }; };
      got.unread = hubSelfNameRefused_('U2', 'Annie Roe-Smith');
    } finally {
      usersAll_ = heldUsers; commBroadcastPeopleRows_ = heldPeople; commBroadcastCalendar_ = heldCal;
    }
    stAssert_(out, 'self-chosen name: keeping one\'s own or taking a free one passes; another live account\'s, a ' +
                   'roster name the account is not linked to, and an unreadable roster are refused',
              got.same === '' && got.free === '' && got.inactive === '' && got.linked === '' &&
              /another account/.test(got.other) && /staff roster/.test(got.manager) &&
              /staff roster/.test(got.calendar) && /staff roster/.test(got.invite) &&
              /could not be checked/.test(got.unread), JSON.stringify(got));
    stAssert_(out, 'self-chosen name: a linked row\'s name is the account\'s only where the link proves itself — a ' +
                   'recorded proof or the sign-in e-mail on the row; a link with neither takes nothing',
              got.linked === '' && got.rowMail === '' && /staff roster/.test(got.unproved), JSON.stringify(got));
  })();
  stAssert_(out, 'self-chosen name: the profile door and the invitation ask it before anything is written',
            stCode_(HUB_ACTIONS.profileUpdate).indexOf('hubSelfNameRefused_(user.id, fields.display_name)') !== -1 &&
            stCode_(HUB_ACTIONS.profileUpdate).indexOf('hubSelfNameRefused_(') <
              stCode_(HUB_ACTIONS.profileUpdate).indexOf('userSetFields_(') &&
            stCode_(inviteRegisterPub_).indexOf('hubSelfNameRefused_(\'\', name)') !== -1 &&
            stCode_(inviteRegisterPub_).indexOf('hubSelfNameRefused_(') <
              stCode_(inviteRegisterPub_).indexOf('appendRow('), '');
  stAssert_(out, 'calendar badge: it rides the boot answers as derived_types, never the types cell, and the ' +
                 'broadcast gate reads it',
            stCode_(authRoute_).indexOf('me.derived_types = hubCalendarBadges_(me)') !== -1 &&
            stCode_(authRoute_).indexOf('freshUser.derived_types = hubCalendarBadges_(freshUser)') !== -1 &&
            String(userPublic_).indexOf('derived_types') === -1 &&
            String(hubUserTypesSet_).indexOf('hubCalendarBadges_') === -1 &&
            stCode_(commBroadcastWho_).indexOf('userBadgesWornBy_(user)') !== -1, '');

  /* ── the shell / feature gates, over a NAMED config ─────────────────── */
  if (typeof hubShellFeatureOn_ === 'function' && typeof hubGrantedFeatureOn_ === 'function') {
    stWithSettings_({ smartcomms_widget_badges: 'DIRECTOR' }, function () {
      stAssert_(out, 'teamlead: a shell feature naming DIRECTOR is off for a team lead',
                hubShellFeatureOn_('smartcomms_widget_badges', 'TEAMLEAD', 'x@y.z', 'staff') === false &&
                hubShellFeatureOn_('smartcomms_widget_badges', 'DIRECTOR', 'x@y.z', 'staff') === true &&
                hubShellFeatureOn_('smartcomms_widget_badges', 'HM', 'x@y.z', 'staff') === false,
                'a team lead reaches only the configs that name TEAMLEAD');
    });
    stWithSettings_({ smartcomms_widget_badges: 'TEAMLEAD' }, function () {
      stAssert_(out, 'teamlead: a config naming only TEAMLEAD leaves the DIRECTOR out',
                hubShellFeatureOn_('smartcomms_widget_badges', 'TEAMLEAD', 'x@y.z', 'staff') === true &&
                hubShellFeatureOn_('smartcomms_widget_badges', 'DIRECTOR', 'x@y.z', 'staff') === false,
                'this is how the new badge is narrowed later without touching the old one');
    });
    stWithSettings_({ behavior_all_badges: 'DIRECTOR' }, function () {
      stAssert_(out, 'teamlead: a fail-closed grant naming DIRECTOR stays shut for a team lead',
                hubGrantedFeatureOn_('behavior_all_badges', 'TEAMLEAD', 'x@y.z', 'staff') === false &&
                hubGrantedFeatureOn_('behavior_all_badges', 'DIRECTOR', 'x@y.z', 'staff') === true &&
                hubGrantedFeatureOn_('behavior_all_badges', 'HM', 'x@y.z', 'staff') === false,
                'Behavior Support reads everybody for the badges the config names, and only those');
    });
    stWithSettings_({ behavior_all_badges: '' }, function () {
      stAssert_(out, 'teamlead: an EMPTY fail-closed grant is still the master alone',
                hubGrantedFeatureOn_('behavior_all_badges', 'TEAMLEAD', 'x@y.z', 'staff') === false,
                'the fold must never turn a blank cell into a grant');
    });
  } else {
    stAssert_(out, 'teamlead: Auth.gs declares the feature gates', false, 'missing');
  }

  /* ── the platform mailbox ───────────────────────────────────────────── */
  if (typeof platformMailCanRead_ === 'function') {
    stWithSettings_({ platform_mail_badges: 'DIRECTOR' }, function () {
      PLATFORM_MAIL_BADGES_CACHE = null;
      stAssert_(out, 'teamlead: the platform mailbox, written DIRECTOR, stays shut to a team lead',
                platformMailCanRead_({ email: 'x@y.z', types: 'TEAMLEAD', is_service: false }) === false &&
                platformMailCanRead_({ email: 'x@y.z', types: 'DIRECTOR', is_service: false }) === true &&
                platformMailCanRead_({ email: 'x@y.z', types: 'HM', is_service: false }) === false,
                'the mailbox config names DIRECTOR by default');
      stAssert_(out, 'teamlead: a SERVICE session still never reads the mailbox',
                platformMailCanRead_({ email: 'svc@x', types: 'TEAMLEAD', is_service: true }) === false,
                'a machine read must not carry the company inbox, badge or no badge');
      PLATFORM_MAIL_BADGES_CACHE = null;
    });
  }

  /* ── Render Sheet's write half ──────────────────────────────────────── */
  if (typeof renderSheetCanEdit_ === 'function') {
    stWithSettings_({ render_sheet_edit_badges: 'DIRECTOR' }, function () {
      stAssert_(out, 'teamlead: Render Sheet editing written DIRECTOR no longer follows to a team lead',
                renderSheetCanEdit_({ role: 'manager', email: 'm@x', types: 'TEAMLEAD' }) === false &&
                renderSheetCanEdit_({ role: 'manager', email: 'm@x', types: 'DIRECTOR' }) === true &&
                renderSheetCanEdit_({ role: 'manager', email: 'm@x', types: 'HM' }) === false,
                '');
    });
    stWithSettings_({ render_sheet_edit_badges: '' }, function () {
      stAssert_(out, 'teamlead: an empty write gate is still admins only',
                renderSheetCanEdit_({ role: 'manager', email: 'm@x', types: 'TEAMLEAD' }) === false,
                'a write gate fails closed and the fold must not open it');
    });
  }

  /* ── the welcome sequence's franchise step ──────────────────────────── */
  stAssert_(out, 'teamlead: the release status reads the FOLD, never a second badge word',
            String(HUB_ACTIONS.releaseUserStatus).indexOf('userBadgesWorn_') !== -1 &&
            String(HUB_ACTIONS.releaseUserStatus).indexOf("indexOf('TEAMLEAD')") === -1,
            'a spelled word here outlives HUB_BADGE_FOLLOWS being emptied, and the two ' +
            'badges never part company');
  stAssert_(out, 'teamlead: … so a team lead no longer hears the director\'s step',
            userBadgesWorn_('TEAMLEAD', '').indexOf('DIRECTOR') === -1,
            'the preview would walk a sequence the person will not be shown');
  stAssert_(out, 'teamlead: an app released to DIRECTOR is announced through the fold, never a spelled word',
            String(releaseAnnounceTokens_).indexOf('userBadgesWorn_') !== -1,
            'an app they can open whose release they never hear about');

  // ── THE SHIPPED DEFAULTS STAY AT ONE WORD.
  if (typeof HIRING_ALERTS_DEFAULTS !== 'undefined') {
    var stTlSpelled = [];
    for (var stTlI = 0; stTlI < HIRING_ALERTS_DEFAULTS.length; stTlI++) {
      var stTlRow = HIRING_ALERTS_DEFAULTS[stTlI];
      var stTlBody = String(stTlRow.value || '') + ' ' + String(stTlRow.note || '');
      for (var stTlWord in HUB_BADGE_FOLLOWS) {
        if (stTlBody.toUpperCase().indexOf(stTlWord) !== -1) stTlSpelled.push(stTlRow.key);
      }
    }
    stAssert_(out, 'teamlead: no shipped default spells a badge that currently follows another',
              stTlSpelled.length === 0, stTlSpelled.join(', '));
  }

  /* ── the digest's rank: its own seniority table, held to BADGE_ORDER's place ── */
  if (typeof DIGEST_BADGE_RANK !== 'undefined') {
    stAssert_(out, 'teamlead: is ABOVE a house manager in the digest\'s rank',
              DIGEST_BADGE_RANK.teamlead > DIGEST_BADGE_RANK.hm,
              'the digest reads this table alone; the server\'s "X or above" ladder is BADGE_ORDER ' +
              '(app/scope.py wears_from and the editions), which draws TEAMLEAD directly over HM');
    stAssert_(out, 'teamlead: … and BELOW a manager, where BADGE_ORDER draws it',
              DIGEST_BADGE_RANK.teamlead < DIGEST_BADGE_RANK.manager, JSON.stringify(DIGEST_BADGE_RANK));
  }

  // ── THE AUDIENCES DELIBERATELY LEFT ALONE.
  if (typeof SMART_TO_KEYWORDS !== 'undefined') {
    stAssert_(out, 'teamlead: the comms keywords are lines, not badges — none was invented',
              SMART_TO_KEYWORDS.teamleads === undefined &&
              SMART_TO_KEYWORDS.directors !== undefined,
              'a recipient keyword with no resolver behind it is an audience of nobody');
  }
}

// THE PLATFORM LEAD BADGE — under the master, over the director.
function stPlatformLead_(out) {
  var P = 'platform lead: ';
  if (typeof userBadgesWorn_ !== 'function' || typeof HUB_BADGE_FOLLOWS === 'undefined' ||
      typeof hubBadgeGrantRefused_ !== 'function') {
    stAssert_(out, P + 'Profile.gs declares the badge, the fold and the grant guard', false, 'missing');
    return;
  }

  /* ── the word, the fold and the rank ────────────────────────────────── */
  stAssert_(out, P + 'PLATFORMLEAD is a word a cell may be written with, listed over DIRECTOR',
            HUB_USER_TYPES.indexOf('PLATFORMLEAD') !== -1 &&
            HUB_USER_TYPES.indexOf('PLATFORMLEAD') < HUB_USER_TYPES.indexOf('DIRECTOR') &&
            userTypesFromRaw_('platformlead').types.join(',') === 'PLATFORMLEAD' &&
            userTypesFromRaw_('PLATFORMLEAD').bad.length === 0, JSON.stringify(HUB_USER_TYPES));
  stEq_(out, P + 'the table says PLATFORMLEAD is answered as DIRECTOR', HUB_BADGE_FOLLOWS.PLATFORMLEAD, 'DIRECTOR');
  stEq_(out, P + 'worn PLATFORMLEAD is matched as both words',
        userBadgesWorn_('PLATFORMLEAD', '').join(','), 'PLATFORMLEAD,DIRECTOR');
  stAssert_(out, P + 'the fold goes ONE way — a director is never a platform lead',
            userBadgesWorn_('DIRECTOR', 'admin').indexOf('PLATFORMLEAD') === -1, '');
  stAssert_(out, P + 'it is not the master: the vocabulary still has no MASTER and the badge makes no real master',
            HUB_USER_TYPES.indexOf('MASTER') === -1 &&
            hubIsRealMaster_({ email: 'pl9@asa.test', role: 'admin', types: ['PLATFORMLEAD'] }) === false, '');
  if (typeof DIGEST_BADGE_RANK !== 'undefined') {
    stAssert_(out, P + 'ranks over the director and under admin, the master\'s own role word',
              DIGEST_BADGE_RANK.platformlead > DIGEST_BADGE_RANK.director &&
              DIGEST_BADGE_RANK.platformlead < DIGEST_BADGE_RANK.admin, JSON.stringify(DIGEST_BADGE_RANK));
  }

  /* ── App Control: the director's rows reach it, its own rows stop at it ── */
  var keep = { rules: hubProfileAppRules_, cut: hubMyWorkAppsCutFor_, memo: HUB_VIEWER_MEMO,
               member: HUB_MEMBER_CTX, masterCache: HUB_MASTER_EMAIL_CACHE };
  var lead = { id: 'u-pl9', email: 'pl9@asa.test', role: 'staff', types: ['PLATFORMLEAD'], display_name: 'Pl9 Lead' };
  var dir = { id: 'u-dr9', email: 'dr9@asa.test', role: 'staff', types: ['DIRECTOR'], display_name: 'Dr9 Dir' };
  var hm = { id: 'u-hm9', email: 'hm9@asa.test', role: 'staff', types: ['HM'], display_name: 'Hm9 House' };
  var master = { id: 'u-m9', email: HUB_MASTER_ACCOUNT, role: 'admin', types: [], display_name: 'The Master' };
  var RULES = { rules: {}, tenants: {} };
  var got = {};
  try {
    HUB_MASTER_EMAIL_CACHE = null;
    HUB_MEMBER_CTX = null;
    hubProfileAppRules_ = function () { return RULES; };
    hubMyWorkAppsCutFor_ = function () { return []; };
    var gate = function (app, u) { HUB_VIEWER_MEMO = null; return hubProfileAppGate_(app, u); };
    RULES = { rules: { leadership: ['DIRECTOR'] }, tenants: {} };
    got.dirRow = { lead: gate('leadership', lead), dir: gate('leadership', dir), hm: gate('leadership', hm) };
    RULES = { rules: { leadership: ['PLATFORMLEAD'] }, tenants: {} };
    got.ownRow = { lead: gate('leadership', lead), dir: gate('leadership', dir) };
    RULES = { rules: {}, tenants: {} };
    got.noRow = { lead: gate('brandnew', lead), master: gate('brandnew', master),
                  appControl: gate('app-control', lead) };
  } finally {
    hubProfileAppRules_ = keep.rules; hubMyWorkAppsCutFor_ = keep.cut; HUB_VIEWER_MEMO = keep.memo;
    HUB_MEMBER_CTX = keep.member; HUB_MASTER_EMAIL_CACHE = keep.masterCache;
  }
  stAssert_(out, P + 'an app released to DIRECTOR in App Control opens for a platform lead, on everything',
            got.dirRow.lead.open === true && got.dirRow.lead.scope.kind === 'all' &&
            got.dirRow.dir.open === true && got.dirRow.hm.open === false, JSON.stringify(got.dirRow));
  stAssert_(out, P + 'a PLATFORMLEAD row in App Control opens for a platform lead and NOT for a director',
            got.ownRow.lead.open === true && got.ownRow.dir.open === false, JSON.stringify(got.ownRow));
  stAssert_(out, P + 'an app with no row stays the master\'s alone, App Control included',
            got.noRow.lead.open === false && got.noRow.appControl.open === false && got.noRow.master.open === true,
            JSON.stringify(got.noRow));
  stAssert_(out, P + 'App Control\'s pen stays the master\'s: a platform lead admin may not edit it',
            appAccessMayEdit_({ email: 'pl9@asa.test', role: 'admin', types: ['PLATFORMLEAD'] }) === false &&
            appAccessMayEdit_({ email: HUB_MASTER_ACCOUNT, role: 'admin', types: [] }) === true, '');

  /* ── the badge-CSV gates the director is named in ───────────────────── */
  if (typeof hubShellFeatureOn_ === 'function' && typeof hubGrantedFeatureOn_ === 'function') {
    stWithSettings_({ smartcomms_widget_badges: 'DIRECTOR', behavior_all_badges: 'DIRECTOR' }, function () {
      stAssert_(out, P + 'a shell feature and a fail-closed grant naming DIRECTOR open for a platform lead',
                hubShellFeatureOn_('smartcomms_widget_badges', 'PLATFORMLEAD', 'x@y.z', 'staff') === true &&
                hubGrantedFeatureOn_('behavior_all_badges', 'PLATFORMLEAD', 'x@y.z', 'staff') === true &&
                hubGrantedFeatureOn_('behavior_all_badges', 'HM', 'x@y.z', 'staff') === false, '');
    });
    stWithSettings_({ behavior_all_badges: '' }, function () {
      stAssert_(out, P + 'an EMPTY fail-closed grant is still the master alone',
                hubGrantedFeatureOn_('behavior_all_badges', 'PLATFORMLEAD', 'x@y.z', 'admin') === false &&
                hubGrantedFeatureOn_('behavior_all_badges', '', HUB_MASTER_ACCOUNT, 'admin') === true, '');
    });
  }
  if (typeof platformMailCanRead_ === 'function') {
    stWithSettings_({ platform_mail_badges: 'DIRECTOR' }, function () {
      PLATFORM_MAIL_BADGES_CACHE = null;
      stAssert_(out, P + 'the platform mailbox opens for a platform lead where it names DIRECTOR',
                platformMailCanRead_({ email: 'x@y.z', types: 'PLATFORMLEAD', is_service: false }) === true, '');
      PLATFORM_MAIL_BADGES_CACHE = null;
    });
  }
  if (typeof renderSheetCanEdit_ === 'function') {
    stWithSettings_({ render_sheet_edit_badges: 'DIRECTOR' }, function () {
      stAssert_(out, P + 'Render Sheet editing follows the director',
                renderSheetCanEdit_({ role: 'manager', email: 'm@x', types: 'PLATFORMLEAD' }) === true, '');
    });
  }
  if (typeof sdWatches_ === 'function') {
    stAssert_(out, P + 'Support Requests: a platform lead watches the whole queue as a director does; the role alone ' +
                   'still watches nothing',
              sdWatches_({ types: 'PLATFORMLEAD' }) === true && sdWatches_({ types: 'DIRECTOR' }) === true &&
              sdWatches_({ types: 'HM' }) === false && sdWatches_({ types: '', role: 'admin' }) === false, '');
  }

  /* ── the grant of the badge is the master's alone ───────────────────── */
  var admin = { email: 'ad9@asa.test', role: 'admin', types: ['DIRECTOR'] };
  var real = { email: HUB_MASTER_ACCOUNT, role: 'admin', types: [] };
  var add = hubBadgeGrantRefused_(admin, 'DIRECTOR', 'DIRECTOR, PLATFORMLEAD');
  var drop = hubBadgeGrantRefused_(admin, 'PLATFORMLEAD, STAFF', 'STAFF');
  stAssert_(out, P + 'an administrator may neither grant nor remove it; the master may',
            add && add.status === 403 && drop && drop.status === 403 &&
            hubBadgeGrantRefused_(real, 'DIRECTOR', 'PLATFORMLEAD') === null &&
            hubBadgeGrantRefused_(real, 'PLATFORMLEAD', '') === null, JSON.stringify([add, drop]));
  stAssert_(out, P + 'an administrator\'s save that keeps it, or moves other badges only, passes',
            hubBadgeGrantRefused_(admin, 'PLATFORMLEAD, STAFF', 'PLATFORMLEAD, HM') === null &&
            hubBadgeGrantRefused_(admin, 'STAFF', 'STAFF, DIRECTOR') === null, '');
  stAssert_(out, P + 'a visit never lends the master\'s grant',
            hubBadgeGrantRefused_({ email: HUB_MASTER_ACCOUNT, role: 'admin', visiting_member: 'u-x' },
                                  '', 'PLATFORMLEAD') !== null, '');
  var upd = stCode_(HUB_ACTIONS.userUpdate), mrg = stCode_(HUB_ACTIONS.userMergeManual);
  stAssert_(out, P + 'the account write and the manual merge ask the guard before anything is written',
            upd.indexOf('hubBadgeGrantRefused_(') !== -1 &&
            upd.indexOf('hubBadgeGrantRefused_(') < upd.indexOf("set('displayname'") &&
            mrg.indexOf('hubBadgeGrantRefused_(') !== -1 &&
            mrg.indexOf('hubBadgeGrantRefused_(') < mrg.indexOf("setCell(keepRow, 'emails'"), '');
}

/** THE SUGGESTION BOX. */
function stSuggestions_(out) {
  if (typeof HUB_ACTIONS.suggestionCreate !== 'function') {
    stAssert_(out, 'suggest: Suggestions.gs is loaded', false, 'missing');
    return;
  }
  stAssert_(out, 'suggest: everyone signed in may write one',
            HUB_POLICY.suggestionCreate.roles.indexOf('client') !== -1 &&
            HUB_POLICY.suggestionCreate.roles.indexOf('onboarding') !== -1, '');
  stAssert_(out, 'suggest: an empty suggestion is refused',
            HUB_ACTIONS.suggestionCreate({ text: '  ' }, { email: 'x@y.z' }).status === 400, '');
  stAssert_(out, 'suggest: the list is the master\'s alone, and answers 404, not 403',
            String(HUB_ACTIONS.suggestionsList).indexOf('hubIsMaster_') !== -1 &&
            String(HUB_ACTIONS.suggestionsList).indexOf('404') !== -1,
            'a 403 tells the asker the box exists');

  // THE PROFILE STORE — profiles must not be volatile.
  var deepSrc = String(HUB_ACTIONS.userProfileDeep);
  stAssert_(out, 'profile: the sheet answers before anything is re-assembled',
            deepSrc.indexOf('profileStoreGet_') !== -1 &&
            deepSrc.indexOf('PROFILE_STALE_HOURS') !== -1,
            'a volatile profile is exactly what was ruled out');
  stAssert_(out, 'profile: a fresh assembly goes STRAIGHT to the sheet',
            deepSrc.indexOf('profileStorePut_') !== -1,
            'an assembly built on demand must go straight to the sheet');
  stAssert_(out, 'profile: the stored row never carries the raw document text',
            String(profileStorePut_).indexOf("!== 'snippets'") !== -1,
            'four 3k snippets would blow the 50k cell and copy documents into a second home');
  stAssert_(out, 'profile: an unsaved assembly says so instead of pretending',
            deepSrc.indexOf('assembled but NOT saved') !== -1,
            'a store failure that stays quiet is a profile that silently resets');

  // ONLY SYSTEM USERS LOG IN: System = active + a password — exactly the two conditions the login enforces.
  var authSrc = String(authRoute_);
  stAssert_(out, 'login: a deactivated row never mints a session — it answers BLOCKED',
            authSrc.indexOf('account_blocked') !== -1 && authSrc.indexOf('423') !== -1,
            'a deactivated account that still signs in makes Inactive Users a lie');
  stAssert_(out, 'login: the blocked answer speaks only AFTER the password matched',
            authSrc.indexOf("ok && str_(u.active).toLowerCase() === 'false'") !== -1,
            'a blocked answer on e-mail alone tells a stranger which accounts exist');
  stAssert_(out, 'login: the blocked answer names the support address',
            authSrc.indexOf('asa-hub@asaop.org') !== -1,
            'a dead end with no door is a support ticket by phone');

  // ANY OF THE PERSON'S E-MAILS OPENS THE ONE ACCOUNT.
  var ubSrc = String(userByEmail_);
  stAssert_(out, 'login: the extra e-mails answer for the same account',
            ubSrc.indexOf('emails') !== -1,
            'a person with three e-mails must sign in with any of them');
  stAssert_(out, 'login: an extra e-mail two accounts claim opens neither',
            ubSrc.indexOf('hits === 1') !== -1,
            'guessing between two accounts hands one person the other\'s session');
  stAssert_(out, 'login: a merge-folded row never answers for an e-mail',
            ubSrc.indexOf('mergedinto') !== -1,
            'the folded row\'s e-mails live on the keeper now');
  stAssert_(out, 'login: a live session dies when the account is deactivated',
            String(sessionUser_).indexOf("str_(u.active).toLowerCase() === 'false'") !== -1,
            'flipping active off must end the session, not only future logins');

  // ONE-CLICK ACTIVATION: the default password does the arming — nobody types one, and nobody's OWN password is…
  var actSrc = String(HUB_ACTIONS.userActivate);
  stAssert_(out, 'activate: the default comes from the property, either name',
            actSrc.indexOf('FIRST_USER_PASSWORD') !== -1 &&
            actSrc.indexOf('ONBOARDING_USER_PASSWORD') !== -1,
            'a password typed in code cannot be rotated');
  stAssert_(out, 'activate: an armed account keeps its own password',
            actSrc.indexOf('if (!armed)') !== -1,
            'reactivation must never stamp the default over a password somebody chose');
  stAssert_(out, 'activate: a missing property refuses loudly, never silently',
            actSrc.indexOf('Set the FIRST_USER_PASSWORD') !== -1, '');

  // ARM IN BATCH, SAME LAW — with the system's default password.
  var armSrc = String(HUB_ACTIONS.usersArm);
  stAssert_(out, 'arm: the batch uses the property default, either name',
            armSrc.indexOf('FIRST_USER_PASSWORD') !== -1 &&
            armSrc.indexOf('ONBOARDING_USER_PASSWORD') !== -1,
            'a typed batch password came back — it was deliberately removed');
  stAssert_(out, 'arm: an armed account keeps its own password',
            armSrc.indexOf('if (!armed)') !== -1,
            'a batch that stamps the default over set passwords locks people out');
  stAssert_(out, 'arm: a missing property refuses loudly, never silently',
            armSrc.indexOf('Set the FIRST_USER_PASSWORD') !== -1, '');

  // NO TYPED PASSWORD AT CREATION EITHER — the property default is always the one used: Add user / Promote arm the…
  var creSrc = String(HUB_ACTIONS.userCreate);
  stAssert_(out, 'create: no password in the payload means the property default',
            creSrc.indexOf('FIRST_USER_PASSWORD') !== -1 &&
            creSrc.indexOf('ONBOARDING_USER_PASSWORD') !== -1,
            'the promote flow must never ask the admin to type one');
  stAssert_(out, 'create: a missing property refuses loudly, never silently',
            creSrc.indexOf('Set the FIRST_USER_PASSWORD') !== -1,
            'an account minted with an empty password would be a locked door');

