  stAssert_(out, 'trail: every COMPLETED step announces itself, separately',
            (function () {
              var d = stCode_(digestOne_) + stCode_(digestSettle_);
              return d.indexOf("'asset_extracted'") !== -1 &&
                     d.indexOf("'asset_qualified'") !== -1 &&
                     d.indexOf("'asset_settled'") !== -1 &&
                     stCode_(formFileStoreCore_).indexOf("'asset_captured'") !== -1;
            })(),
