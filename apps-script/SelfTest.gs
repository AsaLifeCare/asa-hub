            stSrcBetween_(sheets, "'users'", '}').indexOf('HUB_DB_ID') !== -1 &&
            stSrcBetween_(sheets, "'hub_sessions'", '}').indexOf('HUB_DB_ID') !== -1,
            'users and hub_sessions belong to HUB_DB_ID');
  stAssert_(out, 'guardian: the status payload carries an engines block',
            stCode_(HUB_ACTIONS.guardianStatus).indexOf('engines: guardianEngines_()') !== -1,
            'three engines move three cursors, and nothing else reports them');
  var engines = stCode_(guardianEngines_);
  stAssert_(out, 'guardian: the engines block names all three engines',
            engines.indexOf("'hiring'") !== -1 && engines.indexOf("'flow'") !== -1 &&
            engines.indexOf("'runtime'") !== -1,
            'hiring, flow and runtime — a fourth engine must be added here too');
  stAssert_(out, 'guardian: each engine is asked for its own cursor',
            engines.indexOf('HIRING_JUDGE_CURSOR') !== -1 &&
            engines.indexOf('FLOW_JUDGE_CURSOR') !== -1 &&
            engines.indexOf('RUNTIME_JUDGE_CURSOR') !== -1,
            'the cursors are HIRING_JUDGE_CURSOR, FLOW_JUDGE_CURSOR, RUNTIME_JUDGE_CURSOR');
  stAssert_(out, 'guardian: an engine that never said is unknown, never green',
            engines.indexOf("ageMs === null ? 'unknown'") !== -1,
            'the platform\'s law: a check that cannot run says unknown');
  // The callerless list is computed, not written — this runs the real comparison against the real…
  stEq_(out, 'guardian: the sweeps no clock calls are named, not assumed',
        JSON.stringify(guardianCallerlessSweeps_().sort()),
        JSON.stringify(['flowSweepNow', 'ispIntakeSweep',
                        'runtimeSweepNow', 'snapshotBundleSweep']));
  /* The list sizes the ServiceIdentity.gs and Guardian.gs paragraphs state, pinned. */
  stEq_(out, 'guardian: SERVICE_READ_ACTIONS is the size its own paragraph claims',
        SERVICE_READ_ACTIONS.length, 24);
  stEq_(out, 'guardian: SERVICE_SWEEP_ACTIONS is the size its own paragraph claims',
        SERVICE_SWEEP_ACTIONS.length, 35);
  stEq_(out, 'guardian: the CLOCK mirror is the size the roll above it claims',
        GUARDIAN_RELAY_CLOCK_ACTIONS.length, 18);
  stEq_(out, 'guardian: the DAILY mirror is the size the roll above it claims',
        GUARDIAN_RELAY_DAILY_ACTIONS.length, 1);
  stEq_(out, 'guardian: the EVENT mirror is the size the roll above it claims',
        GUARDIAN_RELAY_EVENT_ACTIONS.length, 11);
  // AND THE DORMANT ROLL, which was empty until the punch door needed a word for what it is.
  stEq_(out, 'guardian: the DORMANT mirror is the size the roll above it claims',
        GUARDIAN_RELAY_DORMANT_ACTIONS.length, 1);
  // A CHECK THAT COULD NOT LOOK MUST NOT ANSWER "NONE" — the two places in this file where a header column that…
  stAssert_(out, 'guardian: a ledger with no status column is unknown, not an empty queue',
            stCode_(guardianLedger_).indexOf("iStatus === -1") !== -1 &&
            stSrcBetween_(stCode_(guardianLedger_), 'iStatus === -1', '}').indexOf("'unknown'") !== -1,
            'MISSING IS NOT ZERO');
  stAssert_(out, 'guardian: a log with no ok column is unknown, not zero failures',
            stCode_(guardianLogScan_).indexOf('iOk === -1') !== -1 &&
            stCode_(guardianLogScan_).indexOf('known: false') !== -1,
            'MISSING IS NOT ZERO');
  // THE LOG IS READ ONCE AND ASKED TWICE.
  stAssert_(out, 'guardian: the status pass reads the log once and asks it both questions',
            stCode_(HUB_ACTIONS.guardianStatus).indexOf('guardianLogScan_(20, [GUARDIAN_CALL_LANE_ACTION, GUARDIAN_CALL_LANE_MOVED])') !== -1 &&
            stCode_(HUB_ACTIONS.guardianStatus).indexOf('guardianCallLane_(failures)') !== -1,
            'a second getDataRange over the log would double the most expensive read on the screen');
  stAssert_(out, 'guardian: and a silent lane is bounded by the window it was looked for in',
            stCode_(guardianCallLane_).indexOf('windowSaid') !== -1 &&
            stCode_(guardianLogScan_).indexOf('since: since') !== -1,
            '"never" is a claim about a window somebody can read, never about eternity');
  // AND THE WALK SAYS WHETHER IT REACHED THE END, because the first draft blamed a short log window in the one case…
  stAssert_(out, 'guardian: the log walk reports whether it reached the first row',
            stCode_(guardianLogScan_).indexOf('complete: r < 1') !== -1 &&
            stCode_(guardianCallLane_).indexOf('reachSaid') !== -1,
            'a walk that read everything must not blame the window it did not run out of');
  // A FOUND ROW WITH NO PARSEABLE DATE READS DOWNSTREAM AS NO ROW.
  stAssert_(out, 'guardian: a log with no timestamp column is unknown, not a lane that never ran',
            stCode_(guardianLogScan_).indexOf('iAt === -1') !== -1 &&
            stCode_(guardianLogScan_).indexOf("iOk === -1 || iAction === -1 || iAt === -1") !== -1,
            'MISSING IS NOT ZERO');
}

