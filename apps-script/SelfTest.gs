  stEq_(out, 'comm calls: a category is matched on its flattened spelling',
        commWorkItemClean_({ call_id: 'C8', item_no: '1', work_type: 'Request',
                             category: 'schedule-call off' }, at).category,
        'Schedule - Call Off');
  stEq_(out, 'comm calls: a call off is High whatever urgency arrived',
        commWorkItemClean_({ call_id: 'C9', item_no: '1', work_type: 'Request',
                             category: 'Schedule - Call Off', urgency: 'wrong' }, at).urgency,
        'High');
  stEq_(out, 'comm calls: a work type outside the contract is refused',
        commWorkItemClean_({ call_id: 'CA', item_no: '1', work_type: 'JobInterview' }, at),
        null);
  stEq_(out, 'comm calls: the contract has FOUR types — Screening joined on 2026-09-15',
        COMM_WORK_TYPES.length, 4);
  stEq_(out, 'comm calls: a screening outcome the platform does not know is coerced, never stored',
        commWorkItemClean_({ call_id: 'CD', item_no: '1', work_type: 'Screening',
                             category: 'she sounded great' }, at).category,
        'incomplete');
  stAssert_(out, 'comm calls: the incident vocabulary carries categories, not narratives',
            (function () {
              for (var i = 0; i < COMM_CAT_INCIDENT.length; i++) {
                if (COMM_CAT_INCIDENT[i].length > 45) return false;
              }
              return COMM_CAT_INCIDENT.length === 10;
            })(), 'a one-line narrative about a client is a summary, and summaries are sealed');
  stEq_(out, 'comm calls: a matter about somebody the number could not name concerns nobody',
        commWorkItemClean_({ call_id: 'CB', item_no: '1', work_type: 'DailyNote',
                             category: 'medical', concerns_name: 'Heard Name',
                             name_from: 'person' }, at).concerns_name, '');
  stEq_(out, 'comm calls: a day that is not a day is emptied, never guessed as today',
        commWorkItemClean_({ call_id: 'CC', item_no: '1', work_type: 'DailyNote',
                             category: 'meals', occurred_on: 'yesterday' }, at).occurred_on, '');

  /* THE KEY IS THE CALL, so a replayed batch patches rather than doubles. */
  stEq_(out, 'comm calls: the call row is keyed by the call', sole.id, 'CC_C2');
  stEq_(out, 'comm calls: the matter is keyed by the call and its number',
        loose.id, 'CW_C7_1');

  /* THE DOORS. */
  stAssert_(out, 'comm calls: the machine write is named in every list',
            SERVICE_SWEEP_ACTIONS.indexOf('commCallsIngest') !== -1 &&
            SERVICE_READ_ACTIONS.indexOf('commCallsWho') !== -1 &&
            !!HUB_POLICY.commCallsIngest && !!HUB_POLICY.commCallsWho, '');
  // A LANE THAT IS QUIET BY DECISION AND A LANE THAT BROKE LOOK THE SAME IN A LOG, and this platform has already…
  stAssert_(out, 'comm calls: the hand-over has a caller, so it is not reported as dead',
            guardianCallerlessSweeps_().indexOf('commCallsIngest') === -1, '');
  stAssert_(out, 'comm calls: it rides the hourly tick, and is named where that is recorded',
            GUARDIAN_RELAY_CLOCK_ACTIONS.indexOf('commCallsIngest') !== -1, '');
  // IT SHIPPED INERT AND IT NO LONGER IS.
  stAssert_(out, 'comm calls: its silence is no longer excused by a list',
            GUARDIAN_RELAY_DORMANT_ACTIONS.indexOf('commCallsIngest') === -1 &&
            GUARDIAN_RELAY_DAILY_ACTIONS.indexOf('commCallsIngest') === -1, '');
  // AND THE CHECK DOES NOT CLAIM MORE THAN ITS WITNESSES CAN CARRY.
  stAssert_(out, 'comm calls: the Guardian never calls a silence "never run"',
            typeof guardianCallLane_ === 'function' &&
            stCode_(guardianCallLane_).indexOf('NEVER RUN') === -1, '');
  stAssert_(out, 'comm calls: a silence is unknown, and names both of its readings',
            stCode_(guardianCallLane_).indexOf('bothWays') !== -1 &&
            stCode_(guardianCallLane_).indexOf('healthy idle lane looks like AND what a dead relay') !== -1 &&
            stCode_(guardianCallLane_).indexOf("parked count") !== -1, '');
  // A 200 IS NOT A LANDING.
  stAssert_(out, 'comm calls: the Guardian asks whether the door TOOK anything, not just whether it answered',
            typeof GUARDIAN_CALL_LANE_MOVED === 'string' &&
            GUARDIAN_CALL_LANE_MOVED === 'comm_calls_ingested' &&
            stCode_(guardianCallLane_).indexOf('movedAgeMs') !== -1 &&
            stCode_(guardianCallLane_).indexOf('A 200 is not a landing') !== -1, '');
  // BOTH HOUSES, because the door refuses 503 unless BOTH are declared and a one-house probe prints an explanation…
  stAssert_(out, 'comm calls: the Guardian probes both houses the door requires',
            stCode_(guardianCallLane_).indexOf('COMM_WORK_ITEMS_TAB') !== -1 &&
            stCode_(HUB_ACTIONS.commCallsIngest).indexOf('commCallsDeclared_(COMM_WORK_ITEMS_TAB)') !== -1, '');
  // AND IT ASKS A WITNESS THAT CANNOT BE WRITTEN BY ASKING.
  stAssert_(out, 'comm calls: the Guardian counts the house without being able to create it',
            stCode_(guardianCallLane_).indexOf('hubTabEnsure_') === -1 &&
            stCode_(guardianCallLane_).indexOf('commCallsSheet_') === -1 &&
            stCode_(guardianCallLane_).indexOf('houseIdFor_(') !== -1, '');
  /* MISSING IS NOT ZERO, at the one place it would have cost most. */
  stAssert_(out, 'comm calls: a log the Guardian could not read is unknown, never "never ran"',
            stCode_(guardianCallLane_).indexOf("state = 'unknown'") !== -1 &&
            stCode_(guardianLogScan_).indexOf("iOk === -1 || iAction === -1 || iAt === -1") !== -1, '');
  stAssert_(out, 'comm calls: neither door sends anything',
            (HUB_POLICY.commCallsIngest.emits || []).length === 0 &&
            (HUB_POLICY.commCallsWho.emits || []).length === 0, '');
  stEq_(out, 'comm calls: the resolver door writes nothing', HUB_POLICY.commCallsWho.lane, 'read');
  stAssert_(out, 'comm calls: the lane asks the ONE resolver and carries no matcher of its own',
            stCode_(HUB_ACTIONS.commCallsWho).indexOf('contactPhoneWho_(') !== -1 &&
            stCode_(HUB_ACTIONS.commCallsWho).indexOf('staffContactIndex_') === -1, '');
  stAssert_(out, 'comm calls: a resolver that is not loaded is SAID, never read as "nobody matched"',
            stCode_(HUB_ACTIONS.commCallsWho).indexOf('503') !== -1, '');
  stAssert_(out, 'comm calls: the ingest touches these two houses and no book anybody else fills',
            stCode_(HUB_ACTIONS.commCallsIngest).indexOf('hotlineEstateAppend_') === -1 &&
            stCode_(HUB_ACTIONS.commCallsIngest).indexOf("createRow_('callOffs'") === -1 &&
            stCode_(HUB_ACTIONS.commCallsIngest).indexOf('commCallsSheet_()') !== -1 &&
            stCode_(HUB_ACTIONS.commCallsIngest).indexOf('commWorkItemsSheet_()') !== -1, '');
  stAssert_(out, 'comm calls: the houses are opened through the ONE door and only when declared',
            stCode_(commCallsSheet_).indexOf('hubTabEnsure_(') !== -1 &&
            stCode_(commWorkItemsSheet_).indexOf('hubTabEnsure_(') !== -1, '');
  // AN UNDECLARED HOUSE IS AN OUTAGE, NOT A NEW TAB IN HUB_DB.
  stAssert_(out, 'comm calls: no pointer, no write — the door refuses before it opens anything',
            stCode_(HUB_ACTIONS.commCallsIngest).indexOf('commCallsDeclared_(') !== -1 &&
            stCode_(HUB_ACTIONS.commCallsIngest).indexOf('503') !== -1, '');
  stEq_(out, 'comm calls: and an unreadable depot is not a licence either',
        commCallsDeclared_('a_tab_nothing_declares'), false);
  stAssert_(out, 'comm calls: nothing is ever deleted — these rows are the record a call happened',
            stCode_(commCallsUpsert_).indexOf('deleteRow') === -1 &&
            stCode_(commCallsUpsert_).indexOf('clearContent') === -1, '');
}

// ------------------------------------------------------------------ PSI ANYWHERE — the decision, the proof and the…
function stPsiAnywhere_(out) {
  /* ---- 1. the words, against the corpus ------------------------------- */
  var cases = [
    // ---- the decisive row, measured on the queue -------------------------
    { type: 'PSI - Reset Password',
      text: 'User reports that their PSI Anywhere account is not working and cannot log in, and requests a password reset',
      want: 'reset',
      why: 'the outage sentence and the reset ask arrived together with nothing said about the system' },
    // ---- the rest of the real PSI rows, all of them account matters -------
    { type: 'PSI - Reset Password', text: 'Requesting a password reset for PSI', want: 'reset' },
    { type: 'PSI - Reset Password', text: 'She forgot her password and cannot get into PSI Anywhere', want: 'reset',
      why: '"cannot get in" plus a forgotten password is one account' },
    { type: 'PSI - Request Access to PSI', text: 'New employee needs access to PSI Anywhere', want: 'reset' },
    { type: 'PSI - Time Entries', text: 'Missing time entries in PSI for last week', want: 'unknown',
      why: 'a PSI matter that reports neither an outage nor an account problem' },
    { type: 'PSI - Troubleshooting', text: 'EVV visits are not syncing from Sandata into PSI', want: 'unknown' },
    // ---- the outages the rule exists for ---------------------------------
    { type: 'PSI - Troubleshooting', text: 'PSI Anywhere is down, nobody can log in', want: 'outage' },
    { type: 'Other - General Requests', text: 'The PSI site will not load at all this morning', want: 'outage' },
    { type: 'PSI - Reset Password', text: 'PSI is down for everyone and I also need my password reset', want: 'outage',
      why: 'the reset rides along, but "is down" and "everyone" are about the system' },
    { type: 'PSI - Troubleshooting', text: 'It keeps kicking me out of PSI Anywhere and I get an error message', want: 'outage' },
    { type: 'PSI - Troubleshooting', text: 'Nobody can log in to PSI this morning', want: 'outage',
      why: '"I cannot log in" is one person; "nobody can log in" is the company, and the singular phrase does not contain the plural one' },
    { type: 'PSI - Reset Password', text: 'PSI will not accept my password, please reset it', want: 'reset',
      why: 'one account refusing one password, whoever else is fine' },
    // ---- and the sentence that must never become an outage ---------------
    { type: 'Schedule - Call Off', text: 'Staff informed that will not work today', want: '',
      why: 'a call off is not a PSI matter, and "will not work" must never read as "not working"' },
    { type: 'Schedule - Call Off', text: 'Caller says she is at the hospital and will not work her shift', want: '' },
    { type: 'Admin - Employee Details', text: 'Cannot log in to ADP', want: '',
      why: 'an outage sentence about a different system is not a PSI matter' }
  ];
  var wrong = [];
  cases.forEach(function (c) {
    var got = psiRead_(c.type, c.text);
    if (String(got.verdict) !== c.want) {
      wrong.push('"' + c.text.slice(0, 48) + '" → ' + (got.verdict || '(not psi)') +
                 ', wanted ' + (c.want || '(not psi)'));
    }
  });
  stAssert_(out, 'psi: the decision table holds on every measured sentence — ' + cases.length + ' of them',
            wrong.length === 0, wrong.join(' · '));

  stAssert_(out, 'psi: "will not work today" is the call off and never an outage — the one collision the words have',
            psiRead_('Schedule - Call Off', 'will not work today').verdict === '' &&
            PSI_OUTAGE_WORDS.indexOf('not work') === -1,
            'a bare "not work" on the outage list would page three people about somebody\'s morning');
  stAssert_(out, 'psi: the type is not the trigger — the same words decide whatever the model typed',
            psiRead_('PSI - Reset Password', 'PSI is down for everyone').verdict === 'outage' &&
            psiRead_('PSI - Troubleshooting', 'I forgot my password').verdict === 'reset', '');
  stAssert_(out, 'psi: "locked out" alone settles nothing — it is on neither list',
            PSI_RESET_WORDS.indexOf('locked out') === -1 &&
            PSI_OUTAGE_WORDS.indexOf('locked out') === -1,
            'the queue uses it both ways, so a word that means both may not decide');
  stAssert_(out, 'psi: a bare "anywhere" is not a PSI matter — people say it about everything',
            psiIsPsiMatter_('I cannot find it anywhere', 'Other - General Requests') === false,
            PSI_MATTER_WORDS.join(','));
  stAssert_(out, 'psi: the reader is pure — no clock, no network, no sheet',
            stCode_(psiRead_).indexOf('UrlFetchApp') === -1 &&
            stCode_(psiRead_).indexOf('Date.now') === -1 &&
            stCode_(psiRead_).indexOf('SpreadsheetApp') === -1, '');

  // ---- 2.
  var psiSrc = stCode_(psiVerdictFrom_) + stCode_(psiRelayVerdict_) + stCode_(psiProofNote_) +
               stCode_(psiTeamLead_) + stCode_(psiCallerLine_) + stCode_(psiRead_);
  stAssert_(out, 'psi: this script never touches PsiAnywhere — no host, no port, no credential, no UrlFetchApp anywhere in the lane',
            psiSrc.indexOf('UrlFetchApp') === -1 && psiSrc.indexOf('psianywhere') === -1 &&
            psiSrc.indexOf('abrighterdawn') === -1 && psiSrc.indexOf('8443') === -1 &&
            psiSrc.indexOf('PSI_USER') === -1 && psiSrc.indexOf('PSI_PASS') === -1 &&
            psiSrc.indexOf('PropertiesService') === -1 &&
            typeof psiProbeNow_ === 'undefined' && typeof psiFetch_ === 'undefined',
            'the quota that killed the old project, and a ceiling UrlFetchApp cannot enforce');
  stAssert_(out, 'psi: the door is the relay\'s own, asked with the service secret through the one existing path',
            PSI_RELAY_PATH === '/psi/health' &&
            stCode_(psiRelayVerdict_).indexOf('staffRelayPost_(PSI_RELAY_PATH') !== -1 &&
            stCode_(staffRelayPost_).indexOf('HUB_SERVICE_SECRET') !== -1, PSI_RELAY_PATH);
  // A VERDICT IS A STATE THIS LANE KNOWS, AND NOTHING ELSE IS ONE.
  var vUp = psiVerdictFrom_({ state: 'up', checked_at: '2020-01-01T09:41:07Z', ms: 780,
                              note: 'PsiAnywhere checked 09:41Z: up (page 200 in 0.58s).',
                              decided_by: 'page', held: true }, 'the call');
  stAssert_(out, 'psi: the relay\'s verdict is read in the relay\'s own field names — checked_at is the time, and the note is the line',
            vUp.state === 'up' && vUp.at === '2020-01-01T09:41:07Z' && vUp.held === true &&
            vUp.decided_by === 'page' && vUp.from === 'the call' &&
            vUp.note.indexOf('09:41Z') !== -1, JSON.stringify(vUp).slice(0, 160));
  stAssert_(out, 'psi: anything that is not one of the three states is NO VERDICT — an unfamiliar word may never become an outage',
            psiVerdictFrom_(null) === null && psiVerdictFrom_({}) === null &&
            psiVerdictFrom_({ state: 'degraded' }) === null &&
            psiVerdictFrom_({ state: 'DOWN' }).state === 'down' &&
            psiVerdictFrom_({ state: 'unknown' }).state === 'unknown', '');
  // THE FAIL-SAFE, PROVED RATHER THAN ASSERTED.
  psiRelayForget_();
  var blind = psiRelayVerdict_();
  stAssert_(out, 'psi: a door that does not answer is NO VERDICT, never an outage',
            blind === null && PSI_RELAY_ASKED !== null &&
            String(PSI_RELAY_ASKED.why).length > 0,
            JSON.stringify(PSI_RELAY_ASKED).slice(0, 160));
  // AND THE ONE CEILING A SCRIPT CAN ACTUALLY KEEP: the door is opened once per execution however many calls the…
  var asksBefore = PSI_RELAY_ASKED;
  psiRelayVerdict_(); psiRelayVerdict_();
  stAssert_(out, 'psi: the relay door is asked AT MOST ONCE per execution — a pass with forty calls in it asks once',
            PSI_RELAY_ASKED === asksBefore &&
            stCode_(psiRelayVerdict_).indexOf('if (PSI_RELAY_ASKED) return PSI_RELAY_ASKED.verdict;') !== -1,
            'the memo is the ceiling, because no per-request one exists');
  stAssert_(out, 'psi: an unknown is never spoken to a caller — the lane refuses before it picks a situation',
            stCode_(commPsiReported_).indexOf("state !== 'up' && state !== 'down'") !== -1 &&
            stCode_(commPsiReported_).indexOf('nothing is claimed to a caller about an unknown') !== -1 &&
            commPsiReported_({ requestor: 'A' }, 'i', { state: 'unknown' }).state === 'not_owed' &&
            commPsiReported_({ requestor: 'A' }, 'i', null).state === 'not_owed', '');
  stAssert_(out, 'psi: the note says what was checked, what came back and when — an assertion nobody can argue with is not a proof',
            psiProofNote_({ state: 'up', at: '2020-01-01T09:41:00Z', why: 'login page 200 in 550 ms' })
              .indexOf('09:41Z') !== -1 &&
            psiProofNote_({ state: 'up', at: '', why: 'x' }).indexOf('working normally') !== -1 &&
            psiProofNote_({ state: 'down', at: '', why: 'x' }).indexOf('NOT answering') !== -1 &&
            psiProofNote_({ state: 'unknown', at: '', why: 'x' }).indexOf('nothing was claimed') !== -1 &&
            psiProofNote_(null) === '', '');
  stAssert_(out, 'psi: the relay\'s own line is what the row carries when it sent one, and an unknown still says nothing was claimed',
            psiProofNote_({ state: 'down', at: '2020-01-01T09:41:00Z',
                            note: 'PsiAnywhere checked 09:41Z: down (service 503).' }) ===
              'PsiAnywhere checked 09:41Z: down (service 503).' &&
            psiProofNote_({ state: 'unknown', note: 'PsiAnywhere: the check did not decide.' })
              .indexOf('Nothing was claimed to the caller.') !== -1, '');
  stAssert_(out, 'psi: the proof rides the row the hotline already files — never a second row, and never a newline in a queue cell',
            hotlineCallStamp_('Requestor as stated on the call. ' +
                              psiProofNote_({ state: 'down', at: '2020-01-01T09:41:00Z', why: 'a\nb' }),
                              'AC1').indexOf('\n') === -1 &&
            psiProofNote_({ state: 'down', note: 'a\n\nb   c' }) === 'a b c' &&
            stCode_(psiProofNote_).indexOf('appendRow') === -1, '');

  /* ---- 3. the two answers ---------------------------------------- */
  var byId = {};
  smartDefaults_().forEach(function (d) { byId[String(d.id)] = d; });
  var upSit = byId[COMM_PSI_UP_SITUATION] || {};
  var downSit = byId[COMM_PSI_DOWN_SITUATION] || {};
  stAssert_(out, 'psi: both situations exist as rows, kind event, each naming a condition the catalogue holds',
            String(upSit.kind) === 'event' && String(downSit.kind) === 'event' &&
            !!SMART_EVENTS[String(upSit.event)] && !!SMART_EVENTS[String(downSit.event)],
            JSON.stringify({ up: upSit.kind, down: downSit.kind }));
  stAssert_(out, 'psi: the sweep walks PAST them — the subject resolves to no rows, so a clock can never fire a message about a call that is over',
            SMART_EVENTS[String(upSit.event)].applies({ id: 'x', employee: 'y' }).fires === false &&
            SMART_EVENTS[String(downSit.event)].applies({ id: 'x' }).fires === false &&
            String(SMART_EVENTS[String(downSit.event)].subject) === 'psi' &&
            stCode_(smartEventSweep_).indexOf("=== 'psi') return []") !== -1, '');
  stAssert_(out, 'psi: they ship ON with words on every channel they name — an enabled row with a blank template is a lane that says nothing and looks alive',
            smartOn_(upSit.enabled) && smartOn_(downSit.enabled) &&
            String(upSit.sms_text || '').length > 0 && String(upSit.email_subject || '').length > 0 &&
            String(downSit.sms_text || '').length > 0 && String(downSit.email_subject || '').length > 0, '');
  stAssert_(out, 'psi: the caller\'s message carries the minute the check was made, and {status_at} is a placeholder that really resolves',
            String(upSit.sms_text).indexOf('{status_at}') !== -1 &&
            String(downSit.sms_text).indexOf('{status_at}') !== -1 &&
            stCode_(commDispatchBaseVars_).indexOf('status_at:') !== -1 &&
            smartRender_('at {status_at}', { status_at: '09:41Z' }) === 'at 09:41Z', '');
  // AND THE MINUTE IS THEIRS.
  stAssert_(out, 'psi: the stamp is the minute the RELAY took the proof, and an unreadable one says nothing at all',
            psiStampAt_({ at: '2020-01-01T09:41:07Z' }) === '09:41Z' &&
            psiStampAt_({ checked_at: '2020-01-01T09:41:07Z' }) === '09:41Z' &&
            psiStampAt_({ at: '' }) === '' && psiStampAt_(null) === '' &&
            stCode_(commPsiItem_).indexOf('psiStampAt_(verdict)') !== -1 &&
            stCode_(commPsiTellTeam_).indexOf('psiStampAt_(verdict)') !== -1, '');
  // PLAIN ASCII IN THE TEXT LEG.
  stAssert_(out, 'psi: the text leg is plain ASCII — a single em dash would double the number of parts it arrives in',
            !/[^\x00-\x7F]/.test(String(upSit.sms_text || '')) &&
            !/[^\x00-\x7F]/.test(String(downSit.sms_text || '')), '');
  // ── WHAT IS TRUE AT THE MOMENT IT IS SAID ──────────────────────────── The caller's leg runs BEFORE the…
  stAssert_(out, 'psi: the caller is told what is TRUE when it is said — the report is filed and the team is being told, never that a fix is under way',
            String(downSit.sms_text).indexOf('the fix is under way') === -1 &&
            String(downSit.email_text || '').indexOf('fix is under way') === -1 &&
            String(downSit.email_subject || '').indexOf('fix is under way') === -1 &&
            String(downSit.sms_text).indexOf('support queue') !== -1 &&
            String(downSit.sms_text).indexOf('telling the team now') !== -1 &&
            stCode_(commPsiReported_).indexOf('commPsiSpeakOne_') <
              stCode_(commPsiReported_).indexOf('commPsiTellTeam_'),
            String(downSit.sms_text).slice(0, 120));
  // ── AND THE MOST SURPRISING THING THE LANE DOES IS ON THE CARD ─────── The escalation is claimed for the OUTAGE…
  stAssert_(out, 'psi: the note says the escalation pages once per OUTAGE HOUR rather than once per caller, which is the lane\'s most surprising behaviour',
            String(downSit.note).indexOf('CLAIMED FOR THE OUTAGE') !== -1 &&
            String(downSit.note).indexOf('one page an hour') !== -1 &&
            String(downSit.note).indexOf('a proved recovery closes the hour') !== -1 &&
            COMM_PSI_TEAM_WINDOW_SECONDS === 3600, String(downSit.note).slice(0, 160));
  stAssert_(out, 'psi: only the DOWN row names an escalation — nobody is paged to be told it is working',
            !String(upSit.to || '').trim() && !String(upSit.cc || '').trim() &&
            smartList_(downSit.to).length === 3 && smartList_(downSit.cc).length === 2,
            JSON.stringify({ up_to: upSit.to, down_to: downSit.to }));
  // THE SHARED-LINE LAW MUST NOT BLOCK THESE THREE, and this is the exact trap that emptied the amber copy list…
  var downNums = smartList_(downSit.to);
  var refusedByOutsider = downNums.filter(function (n) { return !packetSendableNumber_(n); });
  var refusedByCopy = downNums.filter(function (n) { return !packetTeamCopyNumber_(n); });
  stAssert_(out, 'psi: the escalation numbers reach all three — the copy predicate answers the internal question, the outsider one would drop two of them',
            refusedByCopy.length === 0 && refusedByOutsider.length === 2 &&
            stCode_(commPsiTellTeam_).indexOf('packetTeamCopyNumber_') !== -1 &&
            stCode_(commPsiTellTeam_).indexOf('packetSendableNumber_') === -1,
            'copy refuses: ' + refusedByCopy.join(',') + ' · outsider refuses: ' + refusedByOutsider.join(','));
  // THE ESCALATION IS GUARDED BY THE VERDICT AND BY NOTHING ELSE.
  var psiDoorSrc = stCode_(commPsiReported_);
  stAssert_(out, 'psi: the escalation goes even when the caller could not be reached — an outage is an outage either way',
            /if \(state === 'down' && runTeam\) \{\s*var team = commPsiTellTeam_\(situation, verdict, facts, inst, said\);/
              .test(psiDoorSrc) &&
            psiDoorSrc.indexOf('var runTeam = !morning || !!morning.team;') !== -1 &&
            psiDoorSrc.indexOf('commPsiSpeakOne_(') < psiDoorSrc.indexOf('commPsiTellTeam_('),
            'the only guard on the escalation must be the verdict');
  stAssert_(out, 'psi: one situation or the other, never both — the verdict picks and there is no path that sends two',
            stCode_(commPsiReported_).indexOf(
              "var id = state === 'down' ? COMM_PSI_DOWN_SITUATION : COMM_PSI_UP_SITUATION;") !== -1, '');

  /* ---- 4. the caller, and the number that must not travel ------------- */
  stAssert_(out, 'psi: everything reaches a person through the one door — no provider, no number, no second way out',
            (stCode_(commPsiSpeakOne_) + stCode_(commPsiTellTeam_)).indexOf('openphone') === -1 &&
            (stCode_(commPsiSpeakOne_) + stCode_(commPsiTellTeam_)).indexOf('UrlFetchApp') === -1 &&
            (stCode_(commPsiSpeakOne_) + stCode_(commPsiTellTeam_)).indexOf('MailApp') === -1 &&
            stCode_(commPsiSpeakOne_).indexOf('commRecordSend_') !== -1 &&
            stCode_(commPsiTellTeam_).indexOf('rpcCall_') !== -1, '');
