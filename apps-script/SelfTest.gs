  stEq_(out, 'comm calls: a call with no id can never be matched, so it is refused',
        commCallsClean_({ read_state: 'read' }, at), null);

  /* THE WORDS, BY EVERY NAME THEY TRAVEL UNDER. */
  var crossed = commCallsCrossed_([{ call_id: 'C6', full_transcript: '…', summary: '…',
                                     incident_location: '…', requestor_phone: '…' }]);
  stEq_(out, 'comm calls: a transcript arriving at the door is seen and named',
