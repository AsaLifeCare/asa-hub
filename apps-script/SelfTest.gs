  // A 403 IS NOT A REASON (review).
  stAssert_(out, 'rendersheet: an admin cannot type into a ledger through either write door — and it is the LEDGER guard that refuses, not the badge gate wearing the same status',
            RENDER_SHEET_LEDGER_TABS.every(function (t) {
              var c = HUB_ACTIONS.renderSheetCellSet({ tab: t, row: 1, col: 'key', value: 'x', prev: '' },
                                                     { role: 'admin', email: 'e' });
