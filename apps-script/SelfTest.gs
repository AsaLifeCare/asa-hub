            'a book that will not answer means the compiled table answers and the log ' +
            'says so — it can never mean nobody has a role and nothing is institutional');
  stAssert_(out, 'book: an empty cell is not an erasure',
            stCode_(hubBookMerge_).indexOf("=== ''") !== -1 &&
            stCode_(hubBookMerge_).indexOf('continue') !== -1,
            'a book row names what it CHANGES; everything it leaves blank keeps what ' +
            'the code shipped, or editing one word would silently blank thirteen');
  stAssert_(out, 'book: the smart header may be APPENDED to and nothing else',
            (function () {
              var c = stCode_(smartHeader_);
              return c.indexOf('want[n] !== SMART_HEADER[n]') !== -1 &&
                     c.indexOf('smart_header_refused') !== -1 &&
                     c.indexOf('return SMART_HEADER') !== -1;
