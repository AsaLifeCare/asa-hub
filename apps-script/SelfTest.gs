  stEq_(out, 'rendersheet: a handle with no workbook behind it is never convicted on a missing id',
        renderSheetLedgerHit_('comm_attempts', ''), '');
  stEq_(out, 'rendersheet: and a workbook with no tab name is never convicted either',
        renderSheetLedgerHit_('', 'SS_NOT_OURS_SELFTEST'), '');
  // These two need the platform's own id to mean anything.
