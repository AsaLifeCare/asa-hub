  stAssert_(out, 'quo enrich: reads Quo, never messages it',
            src.indexOf('v1/contacts') !== -1 && src.indexOf('v1/messages') === -1 &&
            HUB_POLICY.usersQuoEnrich.emits.length === 0,
            'an enrich lane that can send is a sender in disguise');
  // THE CONTACT CLOCK runs automatically — one trigger, both lanes, and the installer can never stack a second…
  stAssert_(out, 'quo enrich: the clock runs both lanes by itself',
            String(contactAutoSweep).indexOf('usersPhoneFill_') !== -1 &&
            String(contactAutoSweep).indexOf('usersQuoEnrichCore_') !== -1,
            'the lane is meant to be automatic, not two more buttons');
  stAssert_(out, 'quo enrich: the installer replaces, never duplicates',
            String(installContactSweepTrigger).indexOf('deleteTrigger') !== -1,
            'a re-run that stacks triggers walks the book twice an hour');
  stAssert_(out, 'quo enrich: every write passes the profile cleaners',
            src.indexOf('profileCleanPhones_') !== -1 &&
            src.indexOf('profileCleanEmails_') !== -1,
            'the cell formats are Profile.gs law, not this lane\'s');
  stAssert_(out, 'quo enrich: the phone column fills blanks only',
            src.indexOf('if (!str_(row.phone)') !== -1,
            'a typed number is never overwritten — the identity law');
  stAssert_(out, 'quo enrich: the sign-in e-mail is identity, never contact info',
            src.indexOf('k === signIn') !== -1,
            'writing the sign-in column from a phone book moves the door');
  stAssert_(out, 'quo enrich: a folded row is never enriched',
            src.indexOf('mergedinto') !== -1, '');
  stAssert_(out, 'quo enrich: a number fragment never matches strangers',
            src.indexOf('d.length < 7') !== -1,
            'the comms law: fewer than 7 digits is a fragment, not a phone');
}

// CLIENT ACCOUNTS: a client or their guardian becomes a user — default password, digits-for-email stand-in, and the…
function stClientAccounts_(out) {
  if (typeof HUB_ACTIONS.clientUserCreate !== 'function') {
    stAssert_(out, 'client accounts: Clients.gs declares the create', false, 'missing');
    return;
  }
  var src = String(HUB_ACTIONS.clientUserCreate);
  stAssert_(out, 'client accounts: the door is the admin\'s',
            HUB_POLICY.clientUserCreate.roles.length === 1 &&
            HUB_POLICY.clientUserCreate.roles[0] === 'admin', '');
  stAssert_(out, 'client accounts: the default comes from the property, either name',
            src.indexOf('FIRST_USER_PASSWORD') !== -1 &&
            src.indexOf('ONBOARDING_USER_PASSWORD') !== -1 &&
            src.indexOf('Set the FIRST_USER_PASSWORD') !== -1,
            'a client account must be born with the system default, loudly or not at all');
  stAssert_(out, 'client accounts: no e-mail means the phone\'s pure digits',
            src.indexOf('\\D+') !== -1,
            'no quotes, no +, just the bare number standing in for the login');
  stAssert_(out, 'client accounts: a login another account owns is refused, never reassigned',
            src.indexOf('already belongs to another account') !== -1 &&
            src.indexOf('clientkey') !== -1,
            'a stolen login hands one person another\'s world');
  stAssert_(out, 'client accounts: the account is born role client with the badge',
            src.indexOf("= 'client'") !== -1 &&
            src.indexOf("'GUARDIAN' : 'CLIENT'") !== -1,
            'access levels stay the current default until they are defined');
  stAssert_(out, 'client accounts: a self-guardian plan makes no guardian account',
            src.indexOf("'self'") !== -1,
            'the plan naming the client as their own guardian is not a second person');
  stAssert_(out, 'client accounts: the client_key link rides the same row',
            src.indexOf("ensureHeader_(usersSheet, ['client_key', 'must_change'])") !== -1,
            'without the key the login sees nobody\'s world — or everybody\'s');

 // THE SHARED DEFAULT IS A KEY FOR ONE USE ( review): the login a client with no e-mail is their phone digits, and…
  stAssert_(out, 'client accounts: the account demands a password of its own',
            src.indexOf("line[uCol.mustchange] = 'true'") !== -1,
            'a shared default that never expires is a standing key to somebody else\'s PHI');
  stAssert_(out, 'client accounts: the session carries the demand',
            String(userPublic_).indexOf('must_change_password') !== -1,
            'a flag the session never sees is a gate that never closes');
  stAssert_(out, 'client accounts: setting a password retires the demand',
            String(HUB_ACTIONS.profileUpdate).indexOf("fields.must_change = ''") !== -1 &&
            String(HUB_ACTIONS.userUpdate).indexOf("set('mustchange', '')") !== -1,
            'a gate that never opens locks the person out of their own platform');
  stAssert_(out, 'client accounts: the self-service password has a floor',
            String(HUB_ACTIONS.profileUpdate).indexOf('at least 8 characters') !== -1, '');

 // The rule outgrew the client desk — it is every account's now.
  stFirstPassword_(out);

  // The account has to be MADE OF somebody: without the roster lift there would never be a guardian for an account…
  stGuardianRoster_(out);
}

// GUARDIANS INTO THE GENERAL ROSTER — guardians have to be lifted into the general roster, or there is never a…
function stGuardianRoster_(out) {
  if (typeof HUB_ACTIONS.guardiansToRoster !== 'function' ||
      typeof guardiansFromClients_ !== 'function') {
    stAssert_(out, 'guardians to roster: Clients.gs declares the pass', false, 'missing');
    return;
  }
  stAssert_(out, 'guardians to roster: the door is the admin\'s',
            HUB_POLICY.guardiansToRoster.roles.length === 1 &&
            HUB_POLICY.guardiansToRoster.roles[0] === 'admin' &&
            stCode_(HUB_ACTIONS.guardiansToRoster).indexOf("str_(user.role) !== 'admin'") !== -1,
            'a pass that writes the staff roster is not a thing every session may run');

  // Two plans naming the SAME guardian (loosely spelled), one that names the client as their own, one that names…
  var plans = [
    { name: 'Ada Client', guardianName: 'Denise Hollenbach',
      guardian_email: 'denise@example.org', guardian_phone: '(330) 477-3134' },
    { name: 'Bo Client', guardianName: 'denise  hollenbach' },
    { name: 'Cy Client', guardianName: 'Self' },
    { name: 'Di Client', guardianName: '' }
  ];
  var got = guardiansFromClients_(plans);
  stEq_(out, 'guardians to roster: one guardian serving two clients is ONE row',
        got.guardians.length, 1);
  stEq_(out, 'guardians to roster: the row says whose guardian they are',
        got.guardians[0].guardian_for, 'Ada Client, Bo Client');
  stEq_(out, 'guardians to roster: a "Self" plan names no second person',
        got.skipped, 2);
  stEq_(out, 'guardians to roster: the contact the plan printed rides along',
        got.guardians[0].email + ' / ' + got.guardians[0].phone,
        'denise@example.org / (330) 477-3134');

  // THE KEY IS THE NAME, NOT THE CLIENT.
  stEq_(out, 'guardians to roster: the id is keyed so a second run finds the same row',
        got.guardians[0].id, 'PPL_guardian_' + clientNameKey_('Denise Hollenbach'));
  stEq_(out, 'guardians to roster: guardian_for gathers, it never replaces',
        guardianForMerge_('Ada Client', 'Ada Client, Bo Client'), 'Ada Client, Bo Client');

  // The write itself needs a spreadsheet, so these two read the code.
  var wcode = stCode_(guardianRosterWrite_);
  stAssert_(out, 'guardians to roster: a typed cell is never overwritten',
            wcode.indexOf(".trim() !== '') continue") !== -1 &&
            wcode.indexOf('sheet.getRange(at + 1, fi + 1).setValue') !== -1,
            'the roster is where humans type — anything but fill-blank is data loss');
  stAssert_(out, 'guardians to roster: the fill-blank law is written down',
            String(guardianRosterWrite_).indexOf('fill-blank') !== -1,
            'the next editor must find the rule beside the line it governs');
  stAssert_(out, 'guardians to roster: an existing row is found before a new one is appended',
            wcode.indexOf('rowAt[w.id]') !== -1 && wcode.indexOf('at === undefined') !== -1,
            'without the lookup every run appends the same person again');
  stAssert_(out, 'guardians to roster: the run is capped',
            stCode_(HUB_ACTIONS.guardiansToRoster).indexOf('guardianRosterWrite_(found.guardians, 200)') !== -1,
            'an uncapped write pass is how one click times out mid-tab');
  stAssert_(out, 'guardians to roster: the write is serialised',
            stCode_(HUB_ACTIONS.guardiansToRoster).indexOf('lock.waitLock(') !== -1 &&
            stCode_(HUB_ACTIONS.guardiansToRoster).indexOf('lock.releaseLock()') !== -1,
            'two admins reading the roster at once each miss the other\'s row — that is the duplicate');
  // THE PLAN'S TEXT IS NOT A DIRECTORY (found on the first real run): "No legal guardian" became a person, and one…
  stAssert_(out, 'guardians: absence is not a person',
            !guardianIsPerson_('No legal guardian') && !guardianIsPerson_('None') &&
            !guardianIsPerson_('n/a') && !guardianIsPerson_('Self'),
            'a directory of names must never carry a sentence');
  stAssert_(out, 'guardians: an agency IS a real answer',
            guardianIsPerson_('Coleman Professional Services'),
            'an organisation can hold guardianship — that is not absence');
  stEq_(out, 'guardians: one woman, one row',
        guardianDisplayName_("Denise Hollenbach (Guardianship of Person), Coleman"),
        'Denise Hollenbach');
  stEq_(out, 'guardians: the nickname stays in the plan, not in the name',
        guardianDisplayName_("Susan Toles (called 'Sue')"), 'Susan Toles');
  // The Important People table repeats the role word before the name, and the PDF wraps long e-mails onto a second…
  var ipBlock = 'Important People:\nType:\nName/Relationship:\nAddress:\nPhone:\n' +
    'Guardian & Type\nGuardianship of Person\nTheresa Sibert\n' +
    'theresa.sibert@colemanservices.or\ng\n400 Tuscarawas St W\n330-639-0456\n';
  var ipRows = ispPeople_(ipBlock);
  stEq_(out, 'guardians: the role word does not steal the name',
        ipRows.length ? str_(ipRows[0].name) : '(none)', 'Theresa Sibert');
  stEq_(out, 'guardians: a wrapped e-mail is glued back together',
        ipRows.length ? str_(ipRows[0].email) : '(none)',
        'theresa.sibert@colemanservices.org');

 // THE COLUMN ORDER ABOVE IS THE FRIENDLY ONE (second run).
  var ipReal = 'Important People:\nType:\nName/Relationship:\nAddress:\nPhone:\n' +
    'Guardian & Type\nGuardianship of Person\nDenise Hollenbach\n' +
    '400 Tuscarawas Street West\nCanton, OH 44702\n' +
    'denise.hollenbach@colemanservice\ns.org\nDirect Line: 330-438-3002\n';
  var ipRealRows = ispPeople_(ipReal);
  stEq_(out, 'guardians: the wrap is glued when the address is printed FIRST',
        ipRealRows.length ? str_(ipRealRows[0].email) : '(none)',
        'denise.hollenbach@colemanservices.org');
  stEq_(out, 'guardians: the fragment does not stay in the address either',
        ipRealRows.length ? str_(ipRealRows[0].address).indexOf('s.org') : 0, -1);
  // The plans label some cells and print others bare.
  stEq_(out, 'guardians: the label is not the value',
        str_(ispCellValue_('Email: andichumley@yahoo.com')), 'andichumley@yahoo.com');
  stEq_(out, 'guardians: a labelled number is still a number',
        ipRealRows.length ? str_(ipRealRows[0].phone) : '(none)', '330-438-3002');
  stEq_(out, 'guardians: a name that ends in a colon is a name',
        str_(ispCellValue_('A Brighter Dawn:')), 'A Brighter Dawn:');
  // A REAL `.co` FOLLOWED BY A STREET IS NOT A WRAP.
  stEq_(out, 'guardians: a whole address is left alone',
        str_(ispEmailGlue_('someone@agency.co', 'Main St')), '');
 // THE TYPE COLUMN'S CATCH-ALL CLOSES A PERSON: unrecognised, it let the NEXT person's e-mail and phone land on the…
  var ipOther = 'Important People:\nType:\nName/Relationship:\nAddress:\nPhone:\n' +
    'Guardian & Type\nGuardianship of Person\nDenise Hollenbach\n' +
    '800 30th St NW, Canton, OH 44709\n330-438-3002\n' +
    'Other - State Plan Nursing\nHeart O Gold Home Care LLC\n' +
    'hnussbaum@heartogoldhomecare.c\nom\n(330) 546-7107\n';
  var ipOtherRows = ispPeople_(ipOther);
  stEq_(out, 'guardians: an "Other -" type opens the next person',
        ipOtherRows.length, 2);
  stEq_(out, 'guardians: nobody inherits a stranger\'s e-mail',
        ipOtherRows.length ? str_(ipOtherRows[0].email) : '(none)', '');
  stEq_(out, 'guardians: the stranger keeps their own, whole',
        ipOtherRows.length > 1 ? str_(ipOtherRows[1].email) : '(none)',
        'hnussbaum@heartogoldhomecare.com');

  // THE PROSE FILLS WHAT THE TABLE LACKS — AND STOPS AT THE NEXT PERSON (after the first real sweep: eleven of…
  var kirby = 'Guardian: Karen Kirby (Parent/Guardian), 1109 19th St NW, Canton, OH 44709, ' +
    '330-324-7499. Father: Brian Kirby (Family/parent), same address, 330-324-7257.';
  stEq_(out, 'guardians: the prose gives the guardian their own number',
        str_(guardianPhoneFromContacts_(kirby)), '(330) 324-7499');
  stAssert_(out, 'guardians: the NEXT person\'s number is not the guardian\'s',
            guardianPhoneFromContacts_(kirby).indexOf('7257') === -1,
            'taking "the first number in the contacts column" is how a father\'s phone becomes a guardian\'s login');
  var toles = "Guardian: Susan Toles (called 'Sue'), his cousin and court-appointed guardian. " +
    'Listed contact: stoles0326@gmail.com / 330-833-4885 (best way to connect: Text). ' +
    'Case Manager: Kamara Shaw, SSA, shawk@starkdd.org, 330-479-3700.';
  stEq_(out, 'guardians: the prose gives the guardian their own address',
        str_(guardianEmailFromContacts_(toles)), 'stoles0326@gmail.com');
  stAssert_(out, 'guardians: the case manager\'s address is not the guardian\'s',
            guardianEmailFromContacts_(toles).indexOf('starkdd') === -1,
            'the same mistake as the nursing agency this morning, one column over');
  // READING A PLAN NOBODY WROTE FOR US — it has to be SUPER generic.
  var planText = 'Guardian/Advocate — Ada Ward (aunt), reach her at ada.ward@example.org ' +
    'or 330-555-0142. Case Manager: Bo Stone, bo.stone@starkdd.org, 330-555-9999.';
  stAssert_(out, 'extraction: a value the plan does not contain is refused',
            !ispTextHas_(planText, 'ada.ward@invented.org', 'email') &&
            !ispTextHas_(planText, 'Ada Winters', 'name'),
            'a model that may invent a contact is a model that mints a login on a stranger');
  stAssert_(out, 'extraction: a wrapped address is still IN the text',
            ispTextHas_('write to ada.ward@exa\nmple.org today', 'ada.ward@example.org', 'email'),
            'whitespace-blind matching repairs the PDF wrap without knowing a single TLD');
  stAssert_(out, 'extraction: the phone is checked as digits, not as punctuation',
            ispTextHas_(planText, '(330) 555-0142', 'phone'),
            '330-555-0142 and (330) 555-0142 are the same number and must both pass');
  stAssert_(out, 'extraction: a number that is not in the plan is refused',
            !ispTextHas_(planText, '(330) 555-0000', 'phone'),
            'the gate is the whole safety of this lane');
  stAssert_(out, 'extraction: the rules remain the floor',
            typeof parseGuardianFromContacts_ === 'function' &&
            stCode_(HUB_ACTIONS.ispContactsSweep).indexOf('ispGuardianExtract_') !== -1,
            'no key, no quota, no answer — the deterministic parse still has to work');

  stEq_(out, 'guardians: a ZIP is not a phone number',
        str_(guardianPhoneFromContacts_('Guardian: Ada Ward, 1109 19th St NW, Canton, OH 44709.')), '');
}

// THE WORKSPACE SHELF — the intermediate categories, such as WORKSPACE STAFF, have to be creatable, and they belong…
function stWorkspaceShelf_(out) {
  if (typeof HUB_ACTIONS.appShelfGet !== 'function' || typeof HUB_ACTIONS.appShelfSet !== 'function') {
    stAssert_(out, 'shelf: Prefs.gs declares the pair', false, 'missing');
    return;
  }
  var setSrc = stCode_(HUB_ACTIONS.appShelfSet);
  stAssert_(out, 'shelf: the pen is the master\'s, and the door is unadvertised',
            setSrc.indexOf('hubIsMaster_') !== -1 && setSrc.indexOf('404') !== -1,
            'an admin who is not the master must meet the same 404 as a stranger');
  stAssert_(out, 'shelf: both halves or neither',
            setSrc.indexOf('!sections || !placement') !== -1,
            'sections saved without placement is a shelf whose apps have nowhere to stand');
  stAssert_(out, 'shelf: the rewrite is serialised',
            setSrc.indexOf('lock.waitLock(') !== -1 && setSrc.indexOf('lock.releaseLock()') !== -1,
            'two clears racing each other is how a whole arrangement disappears');
  stAssert_(out, 'shelf: reading it needs only a session',
            HUB_POLICY.appShelfGet.roles.length === 0 && HUB_POLICY.appShelfGet.lane === 'read',
            'every session draws the sidebar — the shape is not a secret, only the pen is');
  stAssert_(out, 'shelf: a section without a name is refused',
            setSrc.indexOf('Every section needs an id and a name') !== -1,
            'a nameless heading in the sidebar is a section nobody can point at');
  stAssert_(out, 'shelf: two sections may not share an id',
            setSrc.indexOf('Two sections share the id') !== -1,
            'the second row would silently own the first one\'s apps');
  // The verb has a sentence in the feed rather than a raw key.
  stAssert_(out, 'shelf: the system log knows the word',
            logVocab_('app_shelf_set').area === 'Settings' &&
            logVocab_('app_shelf_set').verb.indexOf('section') !== -1,
            'an unnamed verb files under "Other" and reads like a stack trace');

  // THE ONE SYSTEM LOGS APP — the two System Logs apps were merged into one: the audit trail keeps its manager…
  stAssert_(out, 'system logs: the audit trail is admin+manager only',
            HUB_POLICY.logsList && HUB_POLICY.logsList.roles.join(',') === 'admin,manager',
            'every action on the platform is in that tab — it must not widen');
  stAssert_(out, 'system logs: the retired import stays behind the same gate',
            stCode_(route).indexOf("x_system_logs") !== -1 &&
            stCode_(route).indexOf('System logs are for admins and managers.') !== -1,
            'the mapping may return one day; the denial must already be waiting');

  // SMART SHOPPER'S TWO TRUTHS — it has to work for real: a model's estimate and a person's receipt live in…
  if (typeof HUB_ACTIONS.shopPurchases === 'function') {
    stAssert_(out, 'shopper: the paid fact has its own columns',
              stCode_(HUB_ACTIONS.shopSave).indexOf('paidPrice') !== -1 &&
              stCode_(HUB_ACTIONS.shopSave).indexOf('boughtAt') !== -1, '');
    stAssert_(out, 'shopper: the model can never write the paid columns',
              stCode_(HUB_ACTIONS.shopEstimate).indexOf('paidPrice') === -1,
              'the two truths must never share a pen');
    stAssert_(out, 'shopper: real receipts ride the relay, managers only',
              stCode_(HUB_ACTIONS.shopPurchases).indexOf('staffRelayPost_') !== -1 &&
              HUB_POLICY.shopPurchases.roles.join(',') === 'admin,manager',
              'company invoices are not personal wishlist data');
  }

  // BUSINESS TRAVEL, FOR REAL: declined is a status, the decision note has its own column, booked is reachable, and…
  if (typeof HUB_ACTIONS.travelDecide === 'function') {
    var tdSrc = stCode_(HUB_ACTIONS.travelDecide);
    stAssert_(out, 'travel: declined is declined, never silently cancelled',
              tdSrc.indexOf("=== 'declined' ? 'cancelled'") === -1 &&
              TRIP_STATUSES.indexOf('declined') !== -1,
              '"we said no" and "it fell apart" are different histories');
    stAssert_(out, 'travel: the decision note never overwrites the outcome',
              tdSrc.indexOf('decisionNote') !== -1 &&
              tdSrc.indexOf('outcome:') === -1,
              'a decline reason destroying the trip report was the old bug');
    stAssert_(out, 'travel: booked is reachable, from approved only',
              tdSrc.indexOf("'booked'") !== -1 &&
              tdSrc.indexOf('Only an approved trip can be marked booked.') !== -1, '');
    stAssert_(out, 'travel: the outcome nudge carries an address',
              stCode_(travelSmartSubjects_).indexOf('email') !== -1 &&
              stCode_(travelSmartSubjects_).indexOf('usersAll_') !== -1,
              'to_subject without an address is a promise the row cannot keep');
    stAssert_(out, 'travel: the evidence is read, never written',
              stCode_(travelEvidence_).indexOf('appendRow') === -1 &&
              stCode_(travelEvidence_).indexOf('setValue') === -1,
              'the Requests app owns those rows; travel only looks');
  }

  // MEDICATIONS, FROM THE SOURCE — round two: reads AND writes go to the eMAR workbook itself.
  if (typeof HUB_ACTIONS.clientMedsIsp === 'function') {
    // THE CLIENT ROLE READS ITS OWN CHART — medications open for them too.
    stAssert_(out, 'medications: a client reads their own chart and nobody else\'s',
              stCode_(HUB_ACTIONS.clientMedsIsp).indexOf('hubClientIdentity_') !== -1 &&
              stCode_(HUB_ACTIONS.clientMedsIsp).indexOf('id.names[clientNameKey_') !== -1,
              'the audience is open to clients now, so the narrowing IS the protection');
    stAssert_(out, 'medications: an account naming nobody is answered with nothing',
              stCode_(HUB_ACTIONS.clientMedsIsp).indexOf('if (!ck) return') !== -1,
              'no key, no rows — the declared rule');
    stAssert_(out, 'medications: the door and the room agree on who may read',
              HUB_POLICY.clientMedsIsp.roles.join(',') === 'admin,manager,staff,client' &&
              stCode_(medsMayRead_).indexOf("'client'") !== -1,
              'hubPolicyGate_ runs BEFORE the handler; widening one alone changes nothing');
    stAssert_(out, 'medications: reading your chart is not a step towards writing it',
              stCode_(medsMayWrite_).indexOf("'client'") === -1 &&
              HUB_POLICY.emarMedAdd.roles.join(',') === 'admin,manager,staff' &&
              stCode_(medsClientDoor_).indexOf('CP_EDITION_MEDS') !== -1 &&
              stCode_(HUB_ACTIONS.emarMedAdd).indexOf('medsClientDoor_') !== -1,
              'add and discontinue are clinical acts, whatever the screen draws: a staff account only through clients.medication');
    // IT READS THE CHART, AND THE CHART IS OURS NOW.
    stAssert_(out, 'medications: it reads the one chart, in the Hub, never a copy',
              stCode_(HUB_ACTIONS.clientMedsIsp).indexOf("MEDS_TAB") !== -1 &&
              stRoutes_(HUB_ACTIONS.clientMedsIsp) &&
              stCode_(HUB_ACTIONS.clientMedsIsp).indexOf('EMAR_SHEET_ID') === -1 &&
              stCode_(HUB_ACTIONS.clientMedsIsp).indexOf('staffRelayPost_') === -1,
              'the chart is a Hub tab now — reading the intranet book again would be two truths');
    stAssert_(out, 'medications: an add is header-bound to the source chart',
              stCode_(HUB_ACTIONS.emarMedAdd).indexOf('hdr.map') !== -1 &&
              stCode_(HUB_ACTIONS.emarMedAdd).indexOf('appendRow') !== -1,
              'a positional write to a chart is a corruption engine');
    stAssert_(out, 'medications: a delete finds its row by Id - Auto, never by position',
              stCode_(HUB_ACTIONS.emarMedDelete).indexOf("'Id - Auto'") !== -1 &&
              stCode_(HUB_ACTIONS.emarMedDelete).indexOf('medsClientDoor_') !== -1 &&
              HUB_POLICY.emarMedDelete.roles.join(',') === 'admin,manager,staff', '');
  }

  // CONFIG ACCESS BY BADGE — the app matrix's twin, over the settings sections.
  if (typeof HUB_ACTIONS.configBadgeAccessSet !== 'function') {
    stAssert_(out, 'config badges: Prefs.gs declares the write', false, 'missing');
    return;
  }
  var cfgSrc = stCode_(HUB_ACTIONS.configBadgeAccessSet);
  stAssert_(out, 'config badges: the pen follows the master\'s access rule, and the door is unadvertised',
            cfgSrc.indexOf('accessMatrixMayEdit_') !== -1 && cfgSrc.indexOf('404') !== -1,
            'who may see a configuration is the master\'s own matrix, never any admin');
  stAssert_(out, 'config badges: an empty list DELETES the rule',
            cfgSrc.indexOf('if (!badges.length)') !== -1 && cfgSrc.indexOf('deleteRow') !== -1,
            'no row must mean "the section\'s own gate", or clearing a rule would lock a screen');
  stAssert_(out, 'config badges: the two matrices ride ONE read',
            stCode_(HUB_ACTIONS.appBadgeAccessGet).indexOf('configRules') !== -1,
            'a second round-trip per sign-in for a second small matrix is an execution spent for nothing');
  stAssert_(out, 'config badges: the write is serialised',
            cfgSrc.indexOf('lock.waitLock(') !== -1 && cfgSrc.indexOf('lock.releaseLock()') !== -1,
            'two edits at once, and one of them is lost');

  // APP ACCESS BY TENANT — the second tenant.
  if (typeof HUB_ACTIONS.appTenantAccessSet !== 'function') {
    stAssert_(out, 'tenant access: Prefs.gs declares the write', false, 'missing');
    return;
  }
  var tenSrc = stCode_(HUB_ACTIONS.appTenantAccessSet);
  stAssert_(out, 'tenant access: the pen is the master\'s alone',
            tenSrc.indexOf('appAccessMayEdit_') !== -1 && tenSrc.indexOf('404') !== -1,
            'which company an app belongs to is the master\'s own matrix, not a per-admin opinion');
  stAssert_(out, 'tenant access: an empty list means EVERY tenant',
            tenSrc.indexOf('if (!tenants.length)') !== -1 && tenSrc.indexOf('deleteRow') !== -1,
            'no row must mean every tenant, or a new app would be born belonging to nobody');
  stAssert_(out, 'tenant access: the third matrix rides the same read',
            stCode_(HUB_ACTIONS.appBadgeAccessGet).indexOf('tenantRules') !== -1,
            'three small matrices, one execution');
  stAssert_(out, 'tenant access: duplicates collapse',
            tenSrc.indexOf('seen[id]') !== -1,
            'the same tenant twice in one cell is a rule that reads as two');

  // THE NINETY-SECONDS LAW — the screen read "Applied, but not confirmed": the write landed TRUE every time while…
  var bulkSrc = stCode_(HUB_ACTIONS.appAccessSetBulk);
  stAssert_(out, 'bulk: an empty badges lane skips its rewrite',
            bulkSrc.indexOf('ruleKeys.length') !== -1,
            'a sections-only push must not pay for the badge tab');
  stAssert_(out, 'bulk: an empty tenants lane skips its rewrite',
            bulkSrc.indexOf('tenantKeys.length') !== -1,
            'a badges-only Apply must not pay for the tenant tab');
  stAssert_(out, 'bulk: an empty sections lane skips its rewrite',
            bulkSrc.indexOf('sectionKeys.length') !== -1,
            'an Apply with no section drafts must not pay for the sections tab');

  // THE PEN IS THE MATRIX'S RULE — the ACCESS BADGE matrix decides, and it names who was granted access.
  var penSrc = String(accessMatrixMayEdit_);
  stAssert_(out, 'matrix pen: the master always passes',
            penSrc.indexOf('hubIsMaster_') !== -1, '');
  stAssert_(out, 'matrix pen: the access row of the matrix decides',
            penSrc.indexOf("str_(rows[i].sectionid) !== 'access'") !== -1,
            'the rule row is named exactly — another section\'s rule must not open this door');
  stAssert_(out, 'matrix pen: no rule means closed',
            penSrc.indexOf('return false;     // no rule written: the master alone') !== -1,
            'a matrix with no access row must keep the old master-only default');
  stAssert_(out, 'matrix pen: a badge cannot lift a plain account',
            penSrc.indexOf("str_(user.role) !== 'admin'") !== -1,
            'the role check runs first, so a DIRECTOR badge on a staff login grants nothing');

  // APP CONTROL IS THE MASTER'S — only refusals are driven through the doors, and they answer before any cell
  var keepMaster = HUB_MASTER_EMAIL_CACHE;
  HUB_MASTER_EMAIL_CACHE = 'boss@example.org';
  try {
    var bossU = { role: 'admin', email: 'boss@example.org' };
    var adminU = { role: 'admin', email: 'director@example.org', types: 'DIRECTOR' };
    stEq_(out, 'app control: the master may write app access', appAccessMayEdit_(bossU), true);
    stEq_(out, 'app control: a non-master admin may not, whatever badge they wear',
          appAccessMayEdit_(adminU), false);
    stEq_(out, 'app control: the master address on a non-admin role may not',
          appAccessMayEdit_({ role: 'staff', email: 'boss@example.org' }), false);
    stEq_(out, 'app control: a service session may not',
          appAccessMayEdit_({ is_service: true, role: 'admin', email: 'boss@example.org' }), false);
    stEq_(out, 'app control: no session may not', appAccessMayEdit_(null), false);
    stEq_(out, 'app control: appBadgeAccessSet refuses a non-master admin',
          HUB_ACTIONS.appBadgeAccessSet({ app_id: 'app-control', badges: ['ADMIN'] }, adminU).status, 404);
    stEq_(out, 'app control: appTenantAccessSet refuses a non-master admin',
          HUB_ACTIONS.appTenantAccessSet({ app_id: 'app-control', tenants: ['t1'] }, adminU).status, 404);
    stEq_(out, 'app control: the bulk Apply refuses a badge lane from a non-master admin',
          HUB_ACTIONS.appAccessSetBulk({ rules: { 'app-control': ['ADMIN'] } }, adminU).status, 404);
    stEq_(out, 'app control: the bulk Apply refuses a tenant lane from a non-master admin',
          HUB_ACTIONS.appAccessSetBulk({ tenants: { 'app-control': ['t1'] } }, adminU).status, 404);
    // a visit rewrites `user` to the visited account, so a visit to the master wears his e-mail
    var visitU = { role: 'admin', email: 'boss@example.org', visiting_member: 'mem_selftest', acting_for: 'u-boss' };
    stEq_(out, 'app control: a visit to the master is not the master', appAccessMayEdit_(visitU), false);
    stEq_(out, 'app control: nor does it hold the settings-sections pen', accessMatrixMayEdit_(visitU), false);
    stEq_(out, 'app control: appBadgeAccessSet refuses a visit to the master',
          HUB_ACTIONS.appBadgeAccessSet({ app_id: 'chat', badges: [] }, visitU).status, 404);
    stEq_(out, 'app control: the bulk Apply refuses a visit to the master',
          HUB_ACTIONS.appAccessSetBulk({ rules: { chat: [] } }, visitU).status, 404);
    var heldCtx = HUB_MEMBER_CTX;
    try {
      HUB_MEMBER_CTX = { memberId: 'mem_selftest', userId: 'u-boss', email: 'boss@example.org' };
      stEq_(out, 'app control: an open visit refuses even a session that still reads as the master',
            appAccessMayEdit_(bossU), false);
    } finally { HUB_MEMBER_CTX = heldCtx || null; }
    stEq_(out, 'app control: no badge rule is written on the master-only app, even by the master',
          HUB_ACTIONS.appBadgeAccessSet({ app_id: 'app-control', badges: ['DIRECTOR'] }, bossU).status, 400);
    stEq_(out, 'app control: no tenant rule is written on the master-only app, even by the master',
          HUB_ACTIONS.appTenantAccessSet({ app_id: 'app-control', tenants: ['t1'] }, bossU).status, 400);
    stEq_(out, 'app control: a non-master admin cannot switch the master-only app off',
          HUB_ACTIONS.appUpsert({ id: 'app-control', enabled: false }, adminU).status, 403);
    stEq_(out, 'app control: nor can a visit to the master',
          HUB_ACTIONS.appUpsert({ id: 'app-control', enabled: false }, visitU).status, 403);
  } finally {
    HUB_MASTER_EMAIL_CACHE = keepMaster;
  }
  var cleared = appAccessMasterOnlyCleared_({ 'app-control': ['DIRECTOR'], chat: ['STAFF'] });
  stAssert_(out, 'app control: the bulk lanes empty the master-only app and keep every other',
            cleared['app-control'].length === 0 && cleared.chat[0] === 'STAFF', JSON.stringify(cleared));
  stAssert_(out, 'app control: a resent denial list is no change, in any order',
            appDenialsSame_(['time-recon', 'chat'], '["chat","time-recon"]') === true &&
            appDenialsSame_([], '') === true && appDenialsSame_(undefined, '[]') === true, '');
  stAssert_(out, 'app control: adding or lifting a denial is a change',
            appDenialsSame_(['chat'], '[]') === false && appDenialsSame_([], '["chat"]') === false &&
            appDenialsSame_(['chat'], '["chat","users"]') === false, '');
  var updSrc = stCode_(HUB_ACTIONS.userUpdate);
  stAssert_(out, 'app control: a changed denial list from a non-master is refused before any cell is written',
            updSrc.indexOf('appDenialsSame_(payload.app_denials') !== -1 &&
            updSrc.indexOf('appDenialsSame_(payload.app_denials') < updSrc.indexOf("set('displayname'") &&
            updSrc.indexOf('!appAccessMayEdit_(user)') !== -1,
            'a non-master admin still saves capability overrides; only the denials themselves are the master\'s');
  stAssert_(out, 'app control: a sections-only Apply is not an app write',
            appAccessBulkTouchesApps_({ sections: { access: ['DIRECTOR'] } }) === false &&
            appAccessBulkTouchesApps_({ rules: {}, tenants: {}, sections: {} }) === false,
            'the settings-sections matrix keeps its delegation; only the app half is the master\'s');
  stAssert_(out, 'app control: a badge or tenant lane is an app write',
            appAccessBulkTouchesApps_({ rules: { a: [] } }) === true &&
            appAccessBulkTouchesApps_({ tenants: { a: [] } }) === true, '');
  stAssert_(out, 'app control: the app doors ask the master pen before anything else',
            stCode_(HUB_ACTIONS.appBadgeAccessSet).indexOf('appAccessMayEdit_') !== -1 &&
            stCode_(HUB_ACTIONS.appAccessSetBulk).indexOf('appAccessBulkTouchesApps_(payload) && !appAccessMayEdit_(user)') !== -1,
            'a door that asked the access rule would hand App Control to any admin that rule names');
  stAssert_(out, 'app control: the matrix READ stays every session\'s — each launcher is drawn from it',
            (HUB_POLICY.appBadgeAccessGet.roles || []).length === 0 &&
            stCode_(HUB_ACTIONS.appBadgeAccessGet).indexOf('appAccessMayEdit_') === -1 &&
            stCode_(HUB_ACTIONS.appBadgeAccessGet).indexOf('hubIsMaster_') === -1,
            'a master-only read empties every other account\'s launcher');

  // THE LETTERS — the company's e-mail gets a configuration with a proper layout.
  if (typeof inviteEmail_ !== 'function' || typeof HUB_ACTIONS.userInvite !== 'function') {
    stAssert_(out, 'invitation: the template and the door exist', false, 'missing');
    return;
  }
  var letter = inviteEmail_({ name: 'Maria', login: 'maria@example.org', password: 'Sample123' });
  stAssert_(out, 'invitation: both halves are written',
            !!letter.text && !!letter.html && letter.text.indexOf('maria@example.org') !== -1 &&
            letter.html.indexOf('maria@example.org') !== -1,
            'a plain part that omits what the html says is a message half the world cannot read');
  stAssert_(out, 'invitation: it says the password is not theirs and will be taken',
            letter.text.toLowerCase().indexOf('not private') !== -1 &&
            letter.text.toLowerCase().indexOf('choose your own') !== -1,
            'a shared default printed without that sentence reads as a secret, and people keep it');
  stAssert_(out, 'invitation: no password, no password block',
            inviteEmail_({ login: 'x@example.org', password: '' }).text.indexOf('First-time password') === -1,
            'printing a default that no longer opens the door sends somebody to a screen that refuses them');
  stAssert_(out, 'invitation: a name is escaped, not trusted',
            inviteEmail_({ name: '<b>x</b>', login: 'x@example.org', password: 'p' })
              .html.indexOf('<b>x</b>') === -1,
            'a display name is untrusted text like any other');
  var invSrc = stCode_(HUB_ACTIONS.userInvite);
  stAssert_(out, 'invitation: a digits login is skipped, not counted as sent',
            invSrc.indexOf("email.indexOf('@') === -1") !== -1 && invSrc.indexOf('skipped.push') !== -1,
            'a client signing in with phone digits has no mailbox to write to');
  stAssert_(out, 'invitation: it leaves through the one send lane',
            invSrc.indexOf("rpcCall_('emailSend'") !== -1,
            'a direct MailApp call would skip test mode, the opt-out list and the receipt');
  stAssert_(out, 'invitation: a service session does not invite people',
            invSrc.indexOf('user.is_service') !== -1,
            'the platform must never introduce itself to somebody on its own initiative');

  // THE SERVICE PLAN AS A PDF.
  if (typeof ispPdfHtml_ !== 'function' || typeof HUB_ACTIONS.ispPlanPdf !== 'function') {
    stAssert_(out, 'plan pdf: Clients.gs declares the door', false, 'missing');
    return;
  }
  var planHtml = ispPdfHtml_(
    { client_name: 'Ada Client', isp_year: '2026', allergies: '', safety_risks: 'Falls risk on stairs.',
      medications: 'None' },
    { dob: '1961-08-04', guardian_name: 'Denise Hollenbach' });
  stAssert_(out, 'plan pdf: the outline links to the sections',
            planHtml.indexOf('href="#sec-safety_risks"') !== -1 &&
            planHtml.indexOf('id="sec-safety_risks"') !== -1,
            'the quick-access icons must WORK in the pdf — an outline that does not jump is a list');
  stAssert_(out, 'plan pdf: an empty ALLERGIES pane still prints',
            planHtml.indexOf('id="sec-allergies"') !== -1 &&
            planHtml.indexOf('None recorded in the plan.') !== -1,
            '"no allergies recorded" is a fact a house manager needs; a missing heading reads as "not checked"');
  stAssert_(out, 'plan pdf: an absent pane does not print a heading over nothing',
            planHtml.indexOf('id="sec-mobility"') === -1,
            'a heading over an empty pane invites somebody to read it as "no mobility needs"');
  stAssert_(out, 'plan pdf: it says whose reading this is',
            planHtml.indexOf("platform's reading of the Individual Service Plan") !== -1,
            'a PDF outlives the screen that made it and will be held beside the county\'s own document');
  var pdfSrc = stCode_(HUB_ACTIONS.ispPlanPdf);
  stAssert_(out, 'plan pdf: the clinical audience is the same one the slice has',
            pdfSrc.indexOf("['admin', 'manager', 'staff']") !== -1,
            'the onboarding and interviewer accounts must never reach a service plan');
  stAssert_(out, 'plan pdf: today\'s copy replaces itself, yesterday\'s is kept',
            pdfSrc.indexOf('getFilesByName(fileName)') !== -1 && pdfSrc.indexOf('setTrashed(true)') !== -1,
            'two documents whose only difference is the minute they were made is a folder nobody trusts');
}

// THE CHAT — a chat inside the platform, tied to the notifications, and when the other side is offline the chat…
function stChat_(out) {
  if (typeof HUB_ACTIONS.chatSend !== 'function' || typeof chatThreadKey_ !== 'function') {
    stAssert_(out, 'chat: Chat.gs declares the lane', false, 'missing');
    return;
  }
  stEq_(out, 'chat: one conversation, whichever way round',
        chatThreadKey_('u_bo', 'u_ada'), chatThreadKey_('u_ada', 'u_bo'));
  stEq_(out, 'chat: the other person is the one who is not you',
        chatOtherId_(chatThreadKey_('u_ada', 'u_bo'), 'u_ada'), 'u_bo');
  stEq_(out, 'chat: a half-named pair is no conversation',
        chatThreadKey_('u_ada', ''), '');

  var sendSrc = stCode_(HUB_ACTIONS.chatSend);
  var iAppend = sendSrc.indexOf('appendRow'), iMail = sendSrc.indexOf('chatMaybeMail_');
  stAssert_(out, 'chat: the message is safe BEFORE anything that can fail',
            iAppend !== -1 && iMail !== -1 && iAppend < iMail,
            'a message written and then lost because a mailbox was down is the one failure a chat may not have');
  stAssert_(out, 'chat: the mail attempt cannot take the send down with it',
            sendSrc.indexOf('try { mailed = chatMaybeMail_') !== -1,
            'the letter is best-effort; the message is not');
  stAssert_(out, 'chat: a service session does not chat',
            sendSrc.indexOf('user.is_service') !== -1,
            'the platform must not appear in somebody\'s conversations');
  stAssert_(out, 'chat: nobody writes to themselves',
            sendSrc.indexOf('to === me') !== -1,
            'a self-thread has no other side to read it');

  // WRITTEN BEHIND.
  if (typeof chatSendId_ === 'function' && typeof chatSendAt_ === 'function') {
    stEq_(out, 'chat: a send the relay kept is named by its write id and account, as the relay names it',
          chatSendId_('Lwid-0001', 'acc-1'), 'msg_2a0e2e494be84e2b1e1b973f');
    stAssert_(out, 'chat: no write id, or no account, names nothing (a random id, as before)',
              chatSendId_('', 'acc-1') === '' && chatSendId_('Lwid-0001', '') === '', '');
    var atNow = Date.now();
    var atTaken = new Date(atNow - 30000).toISOString();
    stEq_(out, 'chat: the relay\'s moment is the row\'s', chatSendAt_(atTaken), atTaken);
    var atFar = Date.parse(chatSendAt_(new Date(atNow + 3600000).toISOString()));
    var atOld = Date.parse(chatSendAt_(new Date(atNow - 2 * 86400000).toISOString()));
    var atJunk = Date.parse(chatSendAt_('not a time'));
    stAssert_(out, 'chat: a moment an hour ahead, two days old or unreadable is now',
              Math.abs(atFar - atNow) < 60000 && Math.abs(atOld - atNow) < 60000 && Math.abs(atJunk - atNow) < 60000,
              [atFar, atOld, atJunk].join(','));
    var keepSend = { sheet: chatSheet_, mail: chatMaybeMail_, users: usersAll_, people: CHAT_PEOPLE_INDEX,
                     wid: HUB_WRITE_ID };
    var rows = [];
    try {
      CHAT_PEOPLE_INDEX = null;
      usersAll_ = function () { return []; };
      chatSheet_ = function () { return { appendRow: function (r) { rows.push(r); } }; };
      chatMaybeMail_ = function () { return false; };
      HUB_WRITE_ID = 'Lwid-0001';
      var sent = HUB_ACTIONS.chatSend({ to_user: 'acc-2', body: 'hello', at: atTaken },
                                      { id: 'acc-1', role: 'staff', display_name: 'Ann Roe' });
      stAssert_(out, 'chat: a relay-kept send files the row under the relay\'s id and moment, and says so',
                sent.status === 200 && sent.data.id === 'msg_2a0e2e494be84e2b1e1b973f' &&
                sent.data.created_at === atTaken && rows.length === 1 &&
                rows[0][0] === 'msg_2a0e2e494be84e2b1e1b973f' && rows[0][6] === atTaken,
                JSON.stringify(sent) + ' ' + JSON.stringify(rows));
      HUB_WRITE_ID = '';
      var plain = HUB_ACTIONS.chatSend({ to_user: 'acc-2', body: 'hello' },
                                       { id: 'acc-1', role: 'staff', display_name: 'Ann Roe' });
      stAssert_(out, 'chat: a send with no write id keeps a random id',
                plain.status === 200 && /^msg_[0-9a-f]{12}$/.test(plain.data.id), JSON.stringify(plain));
    } finally {
      chatSheet_ = keepSend.sheet; chatMaybeMail_ = keepSend.mail; usersAll_ = keepSend.users;
      CHAT_PEOPLE_INDEX = keepSend.people; HUB_WRITE_ID = keepSend.wid;
    }
    stAssert_(out, 'chat: doPost hands the write id to the action, and clears it for the next execution',
              stCode_(doPost).indexOf('HUB_WRITE_ID = writeId') !== -1 &&
              stCode_(doPost).indexOf("HUB_WRITE_ID = '';") !== -1,
              'a warm start would otherwise name a new send after the last one');
  }
  var logSrc = stCode_(hubSysLog_);
  stAssert_(out, 'chat: the reads every beat runs write no audit rows; the sends, reactions and marks do',
            logSrc.indexOf("action === 'chatPing' || action === 'chatOverview' || action === 'chatMessages'") !== -1 &&
            logSrc.indexOf("'chatSend'") === -1 && logSrc.indexOf("'chatMarkRead'") === -1,
            'two sheet appends in every chat read are seconds the reader waits for');

  var mailSrc = stCode_(chatMaybeMail_);
  stAssert_(out, 'chat: only somebody who is really AWAY is written to',
            mailSrc.indexOf('CHAT_AWAY_MS') !== -1,
            'the online dot blinks between polls — five minutes of silence, not two, decides a letter');
  stAssert_(out, 'chat: one letter per conversation per half hour',
            mailSrc.indexOf('CHAT_NOTICE_EVERY_MS') !== -1,
            'a letter per line turns a colleague into a mailing list');
  stAssert_(out, 'chat: the letter carries the messages themselves',
            mailSrc.indexOf('chatUnreadEmail_') !== -1 && mailSrc.indexOf('unread.push') !== -1,
            '"you have messages" makes a person sign in to find out whether it mattered');
  stAssert_(out, 'chat: a digits login is not written to',
            mailSrc.indexOf("to.email.indexOf('@') === -1") !== -1,
            'a client signing in with phone digits has no mailbox');
  stAssert_(out, 'chat: the letter leaves through the one send lane',
            mailSrc.indexOf("rpcCall_('emailSend'") !== -1,
            'test mode, opt-outs and receipts apply to a chat notice like any other message');

  // REACTIONS.
  if (typeof HUB_ACTIONS.chatReact === 'function') {
    var reactSrc = stCode_(HUB_ACTIONS.chatReact);
    stAssert_(out, 'chat: a reaction is a TOGGLE of your own mark',
              reactSrc.indexOf('ids.indexOf(me)') !== -1 &&
              reactSrc.indexOf('ids.push(me)') !== -1 && reactSrc.indexOf('ids.splice(at, 1)') !== -1,
              'writing the map the browser sent would erase whoever reacted in between');
    stAssert_(out, 'chat: the cell is read inside the lock',
              reactSrc.indexOf('waitLock') !== -1 &&
              reactSrc.indexOf('waitLock') < reactSrc.indexOf('getDataRange'),
              'a read before the lock is the same lost update with extra steps');
    stAssert_(out, 'chat: only the two people on the row may react',
              reactSrc.indexOf("chatPersonId_(values[r][iFrom]) !== me && chatPersonId_(values[r][iTo]) !== me") !== -1,
              'a message id is not an authorisation to touch it — and the pair is asked by PERSON, so ' +
              'somebody\'s second account is still one of the two');
    stAssert_(out, 'chat: an empty emoji is not a reaction',
              reactSrc.indexOf('emoji: which reaction.') !== -1,
              'the column would become a second message body under another name');
    stAssert_(out, 'chat: the reaction says who else is in the conversation',
              reactSrc.indexOf('to_user: other') !== -1,
              'the relay wakes the other screen without ever reading the sheet');
    stAssert_(out, 'chat: the header carries the reactions column',
              CHAT_MESSAGES_HEADER[CHAT_MESSAGES_HEADER.length - 1] === 'reactions',
              'appended, never inserted — every row written before today keeps its meaning');
    var msgsSrc = stCode_(HUB_ACTIONS.chatMessages);
    stAssert_(out, 'chat: reactions travel whole, not behind the cursor',
              msgsSrc.indexOf('reactions[str_(msgs[k].messageid)]') !== -1,
              'a reaction lands on a message hours old, which an incremental read would never carry');
  }

  // A REHEARSAL SHOWS THE DESIGN — the [TEST] invite used to arrive as bare text.
  var rpcSrc = stCode_(rpcSend_);
  stAssert_(out, 'mail: the rehearsal keeps the html',
            rpcSrc.indexOf("var mailHtml = str_(params.html)") !== -1 &&
            rpcSrc.indexOf("redir ? ''") === -1,
            'seeing the design is the entire point of a test send');
  stAssert_(out, 'mail: the redirected html wears the TEST strip',
            rpcSrc.indexOf('hubTestBannerHtml_') !== -1,
            'a rehearsal without a marker reads as a real letter when forwarded');
  var stripSrc = stCode_(hubTestBannerHtml_);
  stAssert_(out, 'mail: the strip names the real recipient, escaped',
            stripSrc.indexOf('&lt;') !== -1,
            'an address with an angle bracket must not break the layout it warns about');

  var overSrc = stCode_(HUB_ACTIONS.chatOverview);
  stAssert_(out, 'chat: a thread is claimed by its two ids, not by "contains"',
            overSrc.indexOf("pair[0] !== me && pair[1] !== me") !== -1,
            'one account id being a prefix of another would show a stranger\'s conversation');
  stAssert_(out, 'chat: the overview stamps that you are here',
            overSrc.indexOf('chatTouchPresence_') !== -1,
            'presence is what the sender\'s side reads to choose between a notification and a letter');
  if (typeof stChatCircle_ === 'function') stChatCircle_(out);
  else stAssert_(out, 'chat circle: the section is in this build', false, 'SelfTestChatCircle.gs was not pushed with SelfTest.gs');
}

// NOTHING IS INVENTED — every MOCK dies and the real functionality takes its place.
function stNoMockLeft_(out) {
 // clientFiles joined the clinical gate (the decoder writes OCR text into it); the pairing law below says both…
  var owed = ['incidents', 'marEntries', 'medications', 'medDeliveries', 'careDocs',
              'billingClaims', 'clientFiles'];
  for (var i = 0; i < owed.length; i++) {
    stAssert_(out, 'no invented data: "' + owed[i] + '" is a real tab',
              !!(RESOURCES[owed[i]] && RESOURCES[owed[i]].sheet),
              'without a tab the screen falls back to whatever the browser can invent');
  }
  var routeSrc = stCode_(route);
  stAssert_(out, 'no invented data: the clinical tabs are employees-only',
            routeSrc.indexOf('HUB_CLINICAL_TABS') !== -1,
            'the manifest gates the screen; only the router gates the data');
  stAssert_(out, 'no invented data: a client portal cannot read them',
            routeSrc.indexOf("HUB_CLINICAL_TABS.indexOf(resource) !== -1") !== -1 &&
            routeSrc.indexOf("user.role === 'client' || user.role === 'onboarding'") !== -1,
            'an incident report is not a document a client or a trainee reads');
  for (var j = 0; j < HUB_CLINICAL_TABS.length; j++) {
    stAssert_(out, 'no invented data: "' + HUB_CLINICAL_TABS[j] + '" is one of the gated tabs',
              owed.indexOf(HUB_CLINICAL_TABS[j]) !== -1,
              'the gate list and the tab list must name the same things');
  }
  // THE PALETTE'S MEANING LEG.
  if (typeof HUB_ACTIONS.paletteResolve === 'function') {
    var palSrc = stCode_(HUB_ACTIONS.paletteResolve);
    stAssert_(out, 'palette: the answer is checked against what was offered',
              palSrc.indexOf('byId[pick]') !== -1,
              'an id nobody offered is a door that does not exist, or one this account may not open');
    stAssert_(out, 'palette: no key, no guess',
              palSrc.indexOf("typeof screenAiChat_ !== 'function'") !== -1 &&
              palSrc.indexOf('matches: []') !== -1,
              'with no provider the palette shows nothing extra — it does not improvise');
    stAssert_(out, 'palette: the prompt cannot be made unbounded by a browser',
              palSrc.indexOf('PALETTE_MAX_CHOICES') !== -1,
              'the caller decides the list, so the server decides how long it may be');
    stAssert_(out, 'palette: a service identity does not search',
              palSrc.indexOf('user.is_service') !== -1,
              'the platform has no palette');
  }
  // THE TEAM BOARD is a SECOND table on purpose.
  stAssert_(out, 'team board: it is its own table',
