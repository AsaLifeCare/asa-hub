  // THE TALENT AUTHORIZATION LOOP.
  if (typeof HUB_ACTIONS.talentAuthorizationSend === 'function') {
    var tpRkSrc = stCode_(tpNota_) + stCode_(tpRankEligible_) + stCode_(tpRankScore_) + stCode_(tpRank_);
    stAssert_(out, 'talent auth: the ranking helper is PURE',
              tpRkSrc.indexOf('SpreadsheetApp') === -1 && tpRkSrc.indexOf('UrlFetchApp') === -1 &&
              tpRkSrc.indexOf('CacheService') === -1 && tpRkSrc.indexOf('PropertiesService') === -1,
