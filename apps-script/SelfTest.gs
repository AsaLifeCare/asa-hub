            pmGate.indexOf('platform_mail_badges') !== -1 &&
            pmGate.indexOf("'DIRECTOR'") !== -1,
            'the master edits who reads the box without a deploy');
  stAssert_(out, 'platform mail: a service session never reads the mailbox',
            pmGate.indexOf('is_service') !== -1,
            'machine reads must not carry the company inbox');
  stAssert_(out, 'platform mail: the inbox handler asks the one gate',
            String(HUB_ACTIONS.platformMailInbox).indexOf('platformMailCanRead_') !== -1,
            'two gates drift; one gate rules');
}

// QUO ENRICH: the phone system's book fills the central tab — read-only toward Quo, validated and blank-filling…
function stQuoEnrich_(out) {
