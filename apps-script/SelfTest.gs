              return sweep.indexOf('assetEvent_') === -1 &&
                     stCode_(digestSettle_).indexOf('late: facts.late') !== -1;
            })(),
            'the sweep and the settlement both announced the same receipt and the trail ' +
            'counted it twice — a trail that double-counts is worse than no trail');
  stAssert_(out, 'digest: a card that IS a date, read without the date, is not read',
            (function () {
              var base = { doc_kind: 'cpr_first_aid', category: 'certification_training',
                           category_source: 'doc_kind', who: 'people:PPL_x',
                           person_source: 'roster', dates: ['2026-07-29'],
                           pairs: [1, 2, 3], numbers: [1], kind_score: 26,
                           chars: 1400, issuer: 'HSI' };
              var withDate = {};
              for (var k in base) withDate[k] = base[k];
              withDate.expires_on = '2028-07-29';
              var ssn = {};
              for (var k2 in base) ssn[k2] = base[k2];
