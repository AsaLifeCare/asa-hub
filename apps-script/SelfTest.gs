  stEq_(out, 'comm calls: so is a summary', crossed.indexOf('summary') !== -1, true);
  stEq_(out, 'comm calls: so is a house code, which IS a client address',
        crossed.indexOf('incident_location') !== -1, true);
  stEq_(out, 'comm calls: and so is a second contact list',
        crossed.indexOf('requestor_phone') !== -1, true);
  stAssert_(out, 'comm calls: none of the refused names is in either header',
            (function () {
              var all = COMM_CALLS_HEADER.concat(COMM_WORK_ITEMS_HEADER);
              for (var i = 0; i < COMM_CALLS_REFUSED.length; i++) {
                if (all.indexOf(COMM_CALLS_REFUSED[i]) !== -1) return false;
              }
              return true;
            })(), 'a refused name is declared as a column');
  stAssert_(out, 'comm calls: the cleaners name every column they carry — nothing is copied wholesale',
            stCode_(commCallsClean_).indexOf('Object.keys(row)') === -1 &&
            stCode_(commWorkItemClean_).indexOf('Object.keys(row)') === -1, '');

  /* THE CATEGORY IS CLOSED BECAUSE FREE TEXT OUT OF A TRANSCRIPT IS THE WORDS. */
  var loose = commWorkItemClean_({ call_id: 'C7', item_no: '1', work_type: 'Incident',
                                   category: 'client refused meal and became agitated' }, at);
  stEq_(out, 'comm calls: a category the platform does not know is coerced, never stored',
