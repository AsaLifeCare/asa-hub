/** The master account is never a row in a list of users; lookups still find it. */
function stMasterUnlisted_(out) {
  var master = hubMasterEmail_();
  var rows = [{ userid: 'U-M', email: master.toUpperCase(), displayname: 'Master', role: 'admin', active: 'true' },
              { userid: 'U-A', email: 'ann@example.org', displayname: 'Ann Roe', role: 'staff', active: 'true' }];
  var keep = { users: usersAll_, pub: userPublic_, vis: tenantUserVisible_ };
  var got = {};
  try {
    usersAll_ = function () { return rows; };
    tenantUserVisible_ = function () { return true; };
    userPublic_ = function (u) { return { id: str_(u.userid), email: str_(u.email), display_name: str_(u.displayname) }; };
    var res = HUB_ACTIONS.usersList({}, { id: 'U-A', role: 'admin', email: 'ann@example.org' });
    got.list = (res && res.data || []).map(function (u) { return u.id; });
    got.picker = sdPickersFor_('U-X').list.map(function (p) { return p.uid; });
  } finally {
    usersAll_ = keep.users; userPublic_ = keep.pub; tenantUserVisible_ = keep.vis;
  }
  stAssert_(out, 'master unlisted: usersList never carries the master account',
            got.list.join(',') === 'U-A', JSON.stringify(got.list));
  stAssert_(out, 'master unlisted: the Redirect picker never offers the master account',
            got.picker.join(',') === 'U-A', JSON.stringify(got.picker));
  stAssert_(out, 'master unlisted: the row filter reads the account fixed in Auth.gs, any case',
            hubIsMasterRow_({ email: ' ' + master.toUpperCase() }) && !hubIsMasterRow_({ email: 'ann@example.org' }) &&
            !hubIsMasterRow_(null), master);
}

