              return stCode_(updateRowById_).indexOf('return { error:') !== -1 &&
                     stCode_(digestSettleSweep_).indexOf('wrote && wrote.error') !== -1 &&
                     stCode_(digestSweepMaybe_).indexOf('landed && landed.error') !== -1;
            })(),
            'the first live settlement handed its receipt in, this write answered 404, ' +
            'the catch caught nothing and the pass counted it as done — a failure and a ' +
