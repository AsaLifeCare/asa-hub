function stGuardian_(out) {
  var sheets = stCode_(guardianSheets_);
  stAssert_(out, 'guardian: the log book is asked for the log tab',
            stSrcBetween_(sheets, "'system_logs'", '}').indexOf('HUB_LOGS_ID') !== -1,
            'system_logs lives in HUB_LOGS_ID — checked in HUB_DB_ID it can never go green');
