  stAssert_(out, 'form files: a claimed file must live in OUR folder',
            (function () {
              var c = stCode_(formFileAnswer_);
              // it must CLIMB, not count floors: a decoded document sits a category deep inside the intake folder…
              return c.indexOf('getParents') !== -1 &&
                     c.indexOf('hops < 8') !== -1 &&
                     c.indexOf('climb = par.getParents()') !== -1;
            })(),
            'a submit cannot launder an arbitrary Drive id into the ledger — the parent ' +
            'check is the wall; but it walked two floors of a cabinet that has three, so ' +
            'the retry the upload key exists for was refused');
 /* THE DECODER SERVES MANY LEDGERS, AND ONLY OWNS ONE. */
  stAssert_(out, 'digest: the client corpus is READ-ONLY to the decoder',
            (function () {
              for (var i = 0; i < DIGEST_LEDGERS.length; i++) {
                if (DIGEST_LEDGERS[i].res === 'clientFiles') return DIGEST_LEDGERS[i].route === false;
              }
