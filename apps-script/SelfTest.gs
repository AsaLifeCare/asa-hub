              'the whole reason this lane exists is 128 duplicates; a door that mints one on ' +
              'every repeat is making tomorrow\'s');
    stAssert_(out, 'pipeline add: a row born here carries NO legacy status',
              addSrc.indexOf("status: ''") !== -1,
              'Ready, Hired and Not Hiring are the legacy\'s verdicts about people it worked — ' +
              'blank is the true answer for somebody just typed in');

    // THE DUPLICATES LEAVE EVERY READER AT ONCE — removing the duplicates cuts the pool down a great deal.
    stAssert_(out, 'duplicates: the join drops them and SAYS how many',
              stCode_(tpJoinedRows_).indexOf('tpIsDuplicate_') !== -1 &&
              stCode_(tpJoinedRows_).indexOf('duplicates: duplicates') !== -1,
              'tpRankEligible_ never looked at status — four duplicate rows sat in a 36-person ' +
              'ranking pool and one stood THIRD on a duplicate of himself');
    stAssert_(out, 'duplicates: the rows themselves are never touched',
              stCode_(tpJoinedRows_).indexOf('deleteRow') === -1,
              'they are the legacy record and they carry different notas — hidden from readers, ' +
              'never removed from the sheet');

    // THE CROSSING CARRIES THE BACKGROUND CHECK INTO A COLUMN SOMEBODY READS.
    stAssert_(out, 'talent carry: the CJIS report lands where the readers look',
              TP_CARRY_MAP.cjis_report === 'cjis_report_url',
              'a name only this map believes in is a background check nobody can see');
    var tpMvSrc = stCode_(tpAuthMove_);
    stAssert_(out, 'talent auth: the mover keeps the duplicate and staff-conflict doors',
              tpMvSrc.indexOf('hubFindDuplicate_') !== -1 &&
              tpMvSrc.indexOf('contactGuard_') !== -1,
              'an authorized move is still a move — the intake\'s own gates travel with it');
    stAssert_(out, 'talent auth: a row with no contact is skipped with a NAMED reason',
              tpMvSrc.indexOf('neither a phone nor an e-mail') !== -1,
              'a silent skip is a candidate the leaders approved and nobody moved');
    stAssert_(out, 'talent auth: the sweep rides talentPipelineSync inside a try',
              stCode_(HUB_ACTIONS.talentPipelineSync).indexOf('tpAuthSweepRun_') !== -1 &&
              stCode_(HUB_ACTIONS.talentPipelineSync).indexOf('catch') !== -1,
              'a sweep fault must never break the hourly sync it rides');
    stAssert_(out, 'talent auth: the letter is an ask, not an alarm, and asks to REPLY',
              String(talentAuthorizationEmail_).indexOf('MAIL_DANGER') === -1 &&
              String(talentAuthorizationEmail_).indexOf('barColor') === -1 &&
              String(talentAuthorizationEmail_).indexOf('Reply to this e-mail') !== -1,
              'mint bar on purpose; the reply IS the door — there is nothing to sign into');
  }

  stAssert_(out, 'no invented data: claims are admin+manager',
            routeSrc.indexOf("resource === 'billingClaims'") !== -1 &&
            routeSrc.indexOf('Billing claims are for admins and managers.') !== -1,
            'a claim is money, and money follows the ledger\'s line');
}

// FIRST LOGIN CHANGES THE PASSWORD — FOR EVERY ACCOUNT.
function stFirstPassword_(out) {
  // ARMED WITH THE SHARED DEFAULT = STAMPED.
  var creSrc = String(HUB_ACTIONS.userCreate);
  stAssert_(out, 'first password: a created account armed with the default is stamped',
            creSrc.indexOf("must_change: 'true'") !== -1 &&
            creSrc.indexOf('if (defaulted)') !== -1,
            'an account born on the workspace password would walk in on a key everybody holds');

  var actSrc = String(HUB_ACTIONS.userActivate);
  var actArmed = actSrc.indexOf('if (!armed)'), actStamp = actSrc.indexOf('iMust + 1');
  stAssert_(out, 'first password: one-click activation stamps only the default branch',
            actArmed !== -1 && actStamp !== -1 && actStamp > actArmed,
            'reactivating somebody who kept their own password must not demand a change they do not owe');

  var armSrc = String(HUB_ACTIONS.usersArm);
  var armStamp = armSrc.indexOf('iMust + 1'), armElse = armSrc.indexOf('} else {');
  stAssert_(out, 'first password: the batch stamps the rows that RECEIVE the default only',
            armStamp !== -1 && armElse !== -1 && armStamp < armElse,
            'stamping the accounts that kept their own password turns the gate into a lie');

  stAssert_(out, 'first password: the onboarding account is stamped at birth',
            String(onboardingEnsureUser_).indexOf("must_change: 'true'") !== -1,
            'the staff case: every hire enters on the same property password');

  // NEVER ENTERED = STILL WEARING THE DEFAULT.
  var loginSrc = String(authRoute_);
  stAssert_(out, 'first password: a never-entered account is stamped on its first sign-in',
            loginSrc.indexOf('!str_(values[r][iLast])') !== -1 &&
            loginSrc.indexOf("u.mustchange = 'true'") !== -1,
            'accounts armed before this shipped would never meet the gate');
  // The literal it watches moved when the login answer started minting the world before assembling itself — the…
  stAssert_(out, 'first password: the stamp precedes the answer, never trails it',
            loginSrc.indexOf("u.mustchange = 'true'") !== -1 &&
            loginSrc.indexOf('freshUser = userPublic_(u)') !== -1 &&
            loginSrc.indexOf("u.mustchange = 'true'") < loginSrc.indexOf('freshUser = userPublic_(u)'),
            'stamping after the session is built hands out one free pass through the platform');
  stAssert_(out, 'first password: an account that HAS entered is never re-stamped',
            loginSrc.indexOf('!str_(values[r][iMust])') !== -1,
            'a second demand on somebody who already chose a password is a loop');
  stAssert_(out, 'first password: the login row is found by user_id',
            loginSrc.indexOf('str_(values[r][iId]) !== str_(u.userid)') !== -1,
            'matching the typed address misses the people who sign in with a second e-mail');
}

/** THE INTERVIEW SCHEDULER (item 4). */
function stInterviewFlow_(out) {
  if (typeof interviewSlotShapeOk_ !== 'function' || typeof HUB_ACTIONS.interviewInviteSend !== 'function') {
    stAssert_(out, 'interview: InterviewFlow.gs is loaded', false, 'InterviewFlow.gs missing');
    return;
  }

  // ---- slots: shape first, never parsed --------------------------------
  stAssert_(out, 'interview: the three company hours pass',
            interviewSlotShapeOk_('2026-09-01', '10:00') &&
            interviewSlotShapeOk_('2026-09-01', '14:00') &&
            interviewSlotShapeOk_('2026-09-01', '17:00'), '');
  stAssert_(out, 'interview: any other hour is refused',
            !interviewSlotShapeOk_('2026-09-01', '11:00') &&
            !interviewSlotShapeOk_('2026-09-01', ''), '');
  stAssert_(out, 'interview: a loose date shape is refused',
            !interviewSlotShapeOk_('2026-9-1', '10:00') &&
            !interviewSlotShapeOk_('Friday', '10:00'), '');
  // labels are built from parts, never a parsed date
  stEq_(out, 'interview: the slot label names the weekday',
        interviewSlotLabel_('2026-09-01', '14:00'), 'Tuesday, Sep 1 at 2:00 PM');

  // ---- the deterministic ear: whole-message match, the opt-out law -----
  stEq_(out, 'interview: YES is heard without a model', interviewReplyVerdict_('Yes!'), 'yes');
  stEq_(out, 'interview: NO is heard without a model', interviewReplyVerdict_('no'), 'no');
  stEq_(out, 'interview: prose goes to the model, never to a guess',
        interviewReplyVerdict_('yes but only if tuesday works'), '');

  // ---- AI proposes, CODE validates: 3 real future weekdays -------------
  var okSlots = [{ date: '2026-09-01', time: '10:00' }, { date: '2026-09-02', time: '14:00' },
                 { date: '2026-09-03', time: '17:00' }];
  stEq_(out, 'interview: three clean future weekday slots pass',
        interviewSlotsValid_(okSlots, '2026-08-17').length, 3);
  stEq_(out, 'interview: a Saturday sinks the whole set',
        interviewSlotsValid_([{ date: '2026-09-05', time: '10:00' }].concat(okSlots.slice(1)), '2026-08-17').length, 0);
  stEq_(out, 'interview: a past date sinks the whole set',
        interviewSlotsValid_([{ date: '2026-08-01', time: '10:00' }].concat(okSlots.slice(1)), '2026-08-17').length, 0);
  stEq_(out, 'interview: an off-hour sinks the whole set',
        interviewSlotsValid_([{ date: '2026-09-01', time: '11:00' }].concat(okSlots.slice(1)), '2026-08-17').length, 0);
 // ONE TO SIX since the dictation: "her agenda rules; candidate adapts" — one slot is a whole offer.
  stEq_(out, 'interview: two slots ARE an offer now',
        interviewSlotsValid_(okSlots.slice(0, 2), '2026-08-17').length, 2);
  stEq_(out, 'interview: one slot is enough',
        interviewSlotsValid_(okSlots.slice(0, 1), '2026-08-17').length, 1);
  stEq_(out, 'interview: an empty set is still nothing',
        interviewSlotsValid_([], '2026-08-17').length, 0);
  stEq_(out, 'interview: an invented Feb 31 is refused',
        interviewSlotsValid_([{ date: '2027-02-31', time: '10:00' }].concat(okSlots.slice(1)), '2026-08-17').length, 0);

  // ---- the token door: HMAC before ANY read ----------------------------
  stEq_(out, 'interview: a malformed token dies at the shape, costing no read',
        interviewAskByToken_('garbage'), null);
  stEq_(out, 'interview: a short signature dies at the shape too',
        interviewAskByToken_('ASK_ABC123.short'), null);
  var tokSrc = stCode_(interviewAskByToken_);
  stAssert_(out, 'interview: the token door judges SHAPE before it reads',
            tokSrc.indexOf('.match(') !== -1 &&
            tokSrc.indexOf('.match(') < tokSrc.indexOf('interviewAskRows_'),
            'a malformed token must never cost a sheet read');
  stAssert_(out, 'interview: an unset INTERVIEW_LINK_SECRET closes the door before the read',
            tokSrc.indexOf('interviewLinkSecret_') !== -1 &&
            tokSrc.indexOf('interviewLinkSecret_') < tokSrc.indexOf('interviewAskRows_'), '');
  stAssert_(out, 'interview: the signature is HMAC over ask + candidate',
            stCode_(interviewTokenSig_).indexOf('computeHmacSha256Signature') !== -1, '');
  stAssert_(out, 'interview: the compare is constant-time, the service-secret pattern',
            stCode_(interviewSigEqual_).indexOf('charCodeAt') !== -1 &&
            stCode_(interviewSigEqual_).indexOf('|=') !== -1, '');
  stAssert_(out, 'interview: both public doors open with the token and nothing else',
            stCode_(interviewSlotContextPub_).indexOf('interviewAskByToken_') !== -1 &&
            stCode_(interviewSlotSubmitPub_).indexOf('interviewAskByToken_') !== -1, '');
  stAssert_(out, 'interview: the submit validates the slot by regex shape',
            stCode_(interviewSlotSubmitPub_).indexOf('interviewSlotShapeOk_') !== -1 &&
            stCode_(interviewSlotShapeOk_).indexOf('\\d{4}-\\d{2}-\\d{2}') !== -1, '');

  // ---- senders: the declared door, and no typed recipient --------------
  var sendSrc = stCode_(HUB_ACTIONS.interviewInviteSend) + stCode_(interviewAskSweepRun_) +
                stCode_(interviewSupervisorAsk_) + stCode_(interviewSupervisorTell_) +
                stCode_(interviewSlotsRequest_) + stCode_(interviewSlotsOffer_);
  stAssert_(out, 'interview: every send goes through rpcCall_',
            stCode_(HUB_ACTIONS.interviewInviteSend).indexOf('rpcCall_') !== -1 &&
            stCode_(interviewSupervisorAsk_).indexOf('rpcCall_') !== -1 &&
            stCode_(interviewSlotsOffer_).indexOf('rpcCall_') !== -1, '');
  stAssert_(out, 'interview: no typed address or number anywhere in the lane',
            !/[\w.+-]+@[\w-]+\.[A-Za-z]{2,}/.test(sendSrc) && sendSrc.indexOf('+1330') === -1,
            'a recipient typed in code goes stale the week somebody leaves');
  // THE BADGE DECIDES, THE CONFIG ONLY NARROWS (card step 12).
  stAssert_(out, 'interview: the interviewer resolves BY BADGE at runtime',
            sendSrc.indexOf('interviewSupervisor_') !== -1 &&
            stCode_(interviewSupervisor_).indexOf('hiringInterviewerPick_') !== -1, '');
  stAssert_(out, 'interview: the badge picker reads the badge, and the config only chooses inside it',
            stCode_(hiringInterviewersByBadge_).indexOf('INTERVIEWER') !== -1 &&
            stCode_(hiringInterviewerPick_).indexOf('interview_supervisor_name') !== -1 &&
            stCode_(hiringInterviewerPick_).indexOf('hiringInterviewersByBadge_') !== -1,
            'a name in a config cell must never be able to grant the right to interview');

  // ---- one AI call per message, remembered ------------------------------
  stEq_(out, 'interview: the AI memo tab is named', INTERVIEW_ASK_AI_TAB, 'interview_ask_ai');
  var sweepSrc = stCode_(interviewAskSweepRun_);
  stAssert_(out, 'interview: a judged message is never judged again',
            sweepSrc.indexOf('judged[mid] !== undefined') !== -1, '');
  stAssert_(out, 'interview: the deterministic ear listens before the model',
            sweepSrc.indexOf('interviewReplyVerdict_') !== -1 &&
            sweepSrc.indexOf('interviewReplyVerdict_') < sweepSrc.indexOf('interviewAskClassifyAi_'), '');
  stAssert_(out, 'interview: Status is the inbound discriminator — Direction lies',
            sweepSrc.indexOf("'received'") !== -1, '');

  // ---- the confirm path rides the ONE scheduling writer ----------------
  stAssert_(out, 'interview: confirming rides hiringScheduleCreate, never a second writer',
            stCode_(interviewAskConfirm_).indexOf('hiringScheduleCreate') !== -1,
            'two writers is two truths about one meeting');

  // ---- the machine pass rider + throttle -------------------------------
  stAssert_(out, 'interview: the sweep left the machine pass (the relay rings Python\'s on its clock)',
            stCode_(interviewAskSweepMaybe_).indexOf('HUB_IS_SERVICE_REQ') !== -1 &&
            stCode_(hubHiredSweepMaybe_).indexOf('interviewAskSweepMaybe_(') === -1, '');

  // ---- the seeds: five rows, seed law throughout -----------------------
  var ivIds = ['interview_invite', 'interview_supervisor_ask',
               'interview_supervisor_slots_request', 'interview_slots_offer',
               'interview_confirmed'];
  var ivRows = {};
  SMART_HIRING_EVENTS.forEach(function (e) {
    if (ivIds.indexOf(String(e.id)) !== -1) ivRows[e.id] = e;
  });
  stAssert_(out, 'interview: all five situations are seeded',
            ivIds.every(function (id) { return !!ivRows[id]; }),
            'missing: ' + ivIds.filter(function (id) { return !ivRows[id]; }).join(', '));
  // Same law, same amputation: the word `team` no longer resolves to anything, so what is pinned is that the row…
  stAssert_(out, 'interview: every one ships OFF — the seed law',
            ivIds.every(function (id) {
              return ivRows[id] && !smartOn_(ivRows[id].enabled);
            }), 'a seed that arrives on messages real people on publish day');
  stAssert_(out, 'interview: every one names a predicate that exists and never fires',
            ivIds.every(function (id) {
              return SMART_EVENTS[id] && SMART_EVENTS[id].applies({ id: 'X' }).fires === false;
            }), 'the clock must never send what the actions send');

  // ---- the declarations -------------------------------------------------
  stAssert_(out, 'interview: the invite declares both channels',
            HUB_POLICY.interviewInviteSend.emits.indexOf('emailSend') !== -1 &&
            HUB_POLICY.interviewInviteSend.emits.indexOf('smsSend') !== -1,
            'an undeclared send is invisible to check:emits');
  stEq_(out, 'interview: inviting is a recruiter\'s hand',
        HUB_POLICY.interviewInviteSend.roles.join(','), 'admin,manager');
  stAssert_(out, 'interview: the public doors are NOT actions — the referral precedent',
            !HUB_ACTIONS.interviewSlotContext && !HUB_ACTIONS.interviewSlotSubmit &&
            !HUB_POLICY.interviewSlotContext && !HUB_POLICY.interviewSlotSubmit,
            'a public door in HUB_ACTIONS would ride the session gate it must not need');

 // ---- the shareable candidate form (CandidateForm.gs) ------
  stAssert_(out, 'candidate form: the public doors are NOT actions — the referral precedent',
            !HUB_ACTIONS.candFormContext && !HUB_ACTIONS.candFormSubmit &&
            !HUB_POLICY.candFormContext && !HUB_POLICY.candFormSubmit,
            'a public door in HUB_ACTIONS would ride the session gate it must not need');
  stEq_(out, 'candidate form: minting the share link is a recruiter\'s hand',
        HUB_POLICY.candShareLink.roles.join(','), 'admin,manager');
  stEq_(out, 'candidate form: a non-writer cannot mint a link',
        HUB_ACTIONS.candShareLink({ candidate_id: 'CAN_ABC123' }, { role: 'staff' }).status, 403);
  stAssert_(out, 'candidate form: a garbage token gets the one quiet answer, never a throw',
            candFormContextPub_({ t: 'zzz.zzz' }).status === 404 &&
            candFormSubmitPub_({ t: 'zzz.zzz' }).status === 404,
            'a probe that can tell tokens apart maps the id space');
  // hubSetDecision_ IS the board's decision writer — HUB_ACTIONS.setDecision is its signed-in door and adds only…
  stAssert_(out, 'candidate form: the submit rides the board\'s own writers',
            stCode_(candFormSubmitPub_).indexOf('hubSetDecision_(') !== -1 &&
            stCode_(candFormSubmitPub_).indexOf('HUB_ACTIONS.moveStage') !== -1 &&
            stCode_(HUB_ACTIONS.setDecision).indexOf('hubSetDecision_(') !== -1,
            'a second decision writer is how two truths start');
  stAssert_(out, 'candidate form: neither the link nor the simulator signs a phone screen for anybody',
            stCode_(candFormSubmitPub_).indexOf('attest') === -1 &&
            stCode_(simAutoDecisionAdvance_).indexOf('hubSetDecision_(') !== -1 &&
            stCode_(simAutoDecisionAdvance_).indexOf('attest: true') === -1 &&
            stCode_(simAutoDecisionAdvance_).indexOf('HUB_ACTIONS.setDecision') === -1,
            'MANUAL PHONE SCREEN attested by shared-form-link is a legal record nobody signed');

  // ---- the handler refuses before it spends ----------------------------
  stEq_(out, 'interview: a non-writer is refused',
        HUB_ACTIONS.interviewInviteSend({ candidate_id: 'CAN_ABC123' }, { role: 'staff' }).status, 403);
  stEq_(out, 'interview: a stray candidate id is refused',
        HUB_ACTIONS.interviewInviteSend({ candidate_id: 'nope' }, { role: 'admin', email: 'e' }).status, 400);
}

// ------------------------------------------------------------------ Render Sheet — the whitelist, the prev-check…
function stRenderSheet_(out) {
  if (typeof RENDER_SHEET_TABS === 'undefined' || typeof HUB_ACTIONS.renderSheetCellSet !== 'function') {
    stAssert_(out, 'rendersheet: RenderSheet.gs is loaded', false, 'RenderSheet.gs missing');
