    // THE CJIS COLUMN IS NOT A VERDICT FIELD, measured on 333 legacy rows: it also holds 28 ISO timestamps, 26 rows…
    stEq_(out, 'crossing: a timestamp is not a background check',
          tpCjisVerdict_('2026-05-11T15:14:29.244Z'), 'unreadable');
