              'two truths about one envelope');
    var noEnvelope = talentChecklist_({ candidateid: 'CAN_TEST9' }, {}, null, 'new', null);
    stAssert_(out, 'application: no envelope, no step',
              !noEnvelope.some(function (i) { return i.id === 'application'; }),
