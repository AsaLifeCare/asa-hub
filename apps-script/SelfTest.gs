  stAssert_(out, 'dispatch: the bundle situation ships as a seed, OFF, kind bundle — the words book turns it on; the engine plants it wherever the tab lives',
            !!bundleSeed && bundleSeed.kind === 'bundle' && bundleSeed.enabled === 'no' &&
