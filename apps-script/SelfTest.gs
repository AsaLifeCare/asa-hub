            got[9].type === 'scale' && got[10].type === 'scale' &&
            got[9].required === true && got[10].required === true &&
            JSON.stringify(got[9].options) === '["Low","Mid","High"]' &&
            JSON.stringify(got[10].options) === '["Low","Mid","High"]',
            JSON.stringify([got[9], got[10]]));
  stAssert_(out, 'forms mapper: grid help rides the FIRST row only',
            got[9].help === 'one per row' && got[10].help === '',
            JSON.stringify([got[9].help, got[10].help]));
  stAssert_(out, 'forms mapper: grid rows do not share one options array',
            got[9].options !== got[10].options,
            'a shared array means editing one row\'s options edits them all');
