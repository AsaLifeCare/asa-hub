            'the ceiling is a number somebody can raise in the words book; a green square ' +
            'on a credential with no end date is worse than a missing one, because a ' +
            'missing one is chased');
  stAssert_(out, 'digest: confidence measures evidence, not length',
            (function () {
              var c = stCode_(digestConfidence_);
              // a firm kind and an ANCHORED person are worth points; a long page that yielded neither is not.
              return c.indexOf('kind_score || 0) >= 20') !== -1 &&
                     c.indexOf('f.who && (f.person_source') !== -1 &&
                     /* the same card, once with an id and once without */
                     digestConfidence_({ chars: 293, doc_kind: 'ssn_card',
