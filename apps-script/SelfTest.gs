            !mgr.error && !!mgr.all && mgr.all.readable === true && mgr.all.rows === mgrGrid.length - 1 &&
            mgrNames.indexOf('Old Manager') === -1 && mgrNames.indexOf('Gone Long') === -1 &&
            mgrNames.indexOf('Next Manager') === -1 && mgrNames.indexOf('Staff Person') === -1 &&
            mgrNames.indexOf('New Manager') !== -1 && mgrNames.indexOf('Jordyn Alt') !== -1 &&
            mgrNames.indexOf('Wanda Alt') !== -1 && mgrNames.indexOf('Later One') !== -1 &&
            mgrNames.indexOf('Later Two') === -1 &&
            mgrNames.indexOf('Jordyn Alt') < mgrNames.indexOf('Wanda Alt'),
            JSON.stringify(mgrNames));
}

// ------------------------------------------------------------------ THE PHONE AS A NAME — pinned at the two rules…
function stPhoneNames_(out) {
  // ── THE VERDICT IS PURE, so the design is asserted and not described.
  stAssert_(out, 'phone-name: an empty line names nobody',
            contactWhoDecide_([]).state === 'unknown' &&
            contactWhoDecide_(null).name === '', '');
  stAssert_(out, 'phone-name: ONE person on the line is the one thing that may be used as a name',
            contactWhoDecide_([{ name: 'Lisa B Bright', active: true, src: 'people' }]).state === 'sole' &&
            contactWhoDecide_([{ name: 'Lisa B Bright', active: true, src: 'people' }]).name === 'Lisa B Bright', '');
  stAssert_(out, 'phone-name: A SHARED LINE CAN NEVER BECOME A NAME — two people on one number answer shared and the name comes back EMPTY',
            contactWhoDecide_([{ name: 'Ty Bond', active: true }, { name: 'Tyler Bond', active: false }]).state === 'shared' &&
            contactWhoDecide_([{ name: 'Ty Bond', active: true }, { name: 'Tyler Bond', active: false }]).name === '', '');
  stAssert_(out, 'phone-name: the second name does not have to be ACTIVE to cost the first one its claim — ambiguity is counted in people',
            contactWhoDecide_([{ name: 'A One', active: false }, { name: 'B Two', active: false }]).state === 'shared' &&
            contactWhoDecide_([{ name: 'A One', active: false }, { name: 'B Two', active: false }]).people.length === 2, '');
  stAssert_(out, 'phone-name: the SAME person reached through both houses is one person, not a shared line',
            contactWhoDecide_([{ name: 'Cassy Majors', src: 'people', active: true },
                               { name: 'cassy  majors', src: 'users', active: false }]).state === 'sole', '');
  stAssert_(out, 'phone-name: a roster row with no name adds nothing — a blank cannot make a line shared',
            contactWhoDecide_([{ name: 'Regina Bowman', active: true }, { name: '   ', active: true }]).state === 'sole', '');

  // ── WHAT COUNTS AS "NO NAME" — the real cells this queue writes.
  stAssert_(out, 'phone-name: the placeholders a transcript leaves behind are read as missing, full stop and all',
            contactNameMissing_('') && contactNameMissing_('   ') &&
            contactNameMissing_('Undetermined') && contactNameMissing_('undetermined') &&
            contactNameMissing_('Not specified in transcript') &&
            contactNameMissing_('Not specified in transcript.'), '');
  stAssert_(out, 'phone-name: a real name is never mistaken for a placeholder',
            !contactNameMissing_('Ty Bond') && !contactNameMissing_('Luis') &&
            !contactNameMissing_('Wanda McCollum-Dotson'), '');

  // ── A STATED NAME IS NEVER OVERWRITTEN, proved by the short-circuit itself: this runs in the pure harness, which…
  var stated = contactNameFill_('Shylah Walker', '+13309197779');
  stAssert_(out, 'phone-name: A STATED NAME IS NEVER OVERWRITTEN — the caller ID is not even asked when somebody said who they were',
            stated.name === 'Shylah Walker' && stated.from === 'person' && stated.who === null,
            JSON.stringify(stated));
  stAssert_(out, 'phone-name: the fill only ever promotes a SOLE answer — shared and unknown have no branch that sets a name',
            stCode_(contactNameFill_).indexOf("who.state === 'sole'") !== -1 &&
            stCode_(contactNameFill_).indexOf("who.state === 'shared'") === -1, '');
  stAssert_(out, 'phone-name: nothing was learned means the cell comes back UNCHANGED with an empty provenance, never a guess',
            contactNameFill_('Undetermined', '').name === 'Undetermined' &&
            contactNameFill_('Undetermined', '').from === '' &&
            contactNameFill_('', '').from === '', '');

  // ── THE COMPANY AND TEST LINES ANSWER unknown.
  stAssert_(out, 'phone-name: a company or test line names NOBODY — it is the number many people call from',
            contactPhoneWho_('+13309195559').state === 'unknown' &&
            contactPhoneWho_('+13309195559').name === '' &&
            contactPhoneWho_('330-754-4040').state === 'unknown' &&
            contactPhoneWho_('+13309195558').state === 'unknown', '');
  stAssert_(out, 'phone-name: and it says WHY, so a reader is never left with a bare unknown',
            contactPhoneWho_('+13309195559').why.indexOf('company or test line') !== -1 &&
            contactPhoneWho_('').why.indexOf('no ten-digit number') !== -1, '');
  stAssert_(out, 'phone-name: the ESTATE\'S key is used, never a second normaliser — the guard and the naming must agree on what a number is',
            stCode_(contactPhoneWho_).indexOf('contactPhoneKey_(') !== -1 &&
            stCode_(contactPhoneWho_).indexOf('staffContactIndex_(') !== -1 &&
            stCode_(contactPhoneWho_).indexOf('SHARED_LINE_DIGITS') !== -1 &&
            stCode_(contactPhoneWho_).indexOf('replace(/\\D') === -1, '');
  stAssert_(out, 'phone-name: a roster that could not be read names nobody AND is not remembered as an empty one',
            stCode_(contactPhoneWho_).indexOf('if (!idx.ok)') !== -1 &&
            stCode_(contactPhoneWho_).indexOf('CG_WHO_INDEX_ = idx') >
            stCode_(contactPhoneWho_).indexOf('if (!idx.ok)'), '');
  stAssert_(out, 'phone-name: the sentence a human reads never asserts identity on a shared line',
            contactWhoText_({ state: 'shared', name: '', people: [{ name: 'Ty Bond' }, { name: 'Tyler Bond' }] })
              .indexOf('A shared line names nobody') !== -1 &&
            contactWhoText_({ state: 'shared', name: '', people: [{ name: 'Ty Bond' }, { name: 'Tyler Bond' }] })
              .indexOf('Not named') === 0, '');

  // ── WHERE IT IS WIRED — the three places the name was missing, and no other.
  stAssert_(out, 'phone-name: the hotline asks the number for a request whose requestor the transcript could not hear',
            stCode_(HUB_ACTIONS.hotlineSweep).indexOf('contactNameFill_(') !== -1 &&
            stCode_(hotlineNameNote_).indexOf('contactWhoText_(') !== -1, '');
  stAssert_(out, 'phone-name: every request row records HOW it learned the name — the person, the number, or nothing',
            hotlineNameNote_({ name: 'Ty Bond', from: 'person', who: null }) === 'Requestor as stated on the call.' &&
            hotlineNameNote_({ name: 'Lisa B Bright', from: 'phone',
                               who: { state: 'sole', name: 'Lisa B Bright', people: [] } })
              .indexOf('Named from the caller ID') === 0, '');
  stAssert_(out, 'phone-name: the inbound ear asks the roster before filing a reply as a stranger, and files it as a stranger anyway',
            stCode_(commInboundCapture_).indexOf('contactPhoneWho_(') !== -1 &&
            stCode_(commInboundCapture_).indexOf("candidate_from: (roster && roster.state === 'sole') ? 'phone' : ''") !== -1, '');
  stAssert_(out, 'phone-name: the call-off lane keys a caller it can name, and the NUMBER never reaches the facts',
            (function () {
              var f = commCallOffFacts_({ employee_name: '', caller_phone: '+13309195559',
                                          type: 'Call Off', date: '3/7/2026' });
              return f.name === '' && f.name_from === '' && f.person_key === '' &&
                     JSON.stringify(f).indexOf('9195559') === -1 &&
                     commCallOffProseIn_(f).length === 0;
            })(), '');
  stAssert_(out, 'phone-name: a name the caller gave survives the call-off facts untouched, with its provenance beside it',
            (function () {
              var f = commCallOffFacts_({ employee_name: 'Shylah Walker', caller_phone: '+13309195559',
                                          type: 'Call Off', date: '3/7/2026' });
              return f.name === 'Shylah Walker' && f.name_from === 'person' &&
                     f.person_key === 'shylahwalker' && JSON.stringify(f).indexOf('9195559') === -1;
            })(), '');
  stAssert_(out, 'phone-name: A CANDIDATE IS NOT WHO TO TEXT — the call-off lane records a phone-named row and refuses to speak to it',
            stCode_(commCallOffSpeakOne_).indexOf("String(facts.name_from || '') === 'phone'") !== -1 &&
            stCode_(commCallOffSpeakOne_).indexOf("String(facts.name_from || '') === 'phone'") <
            stCode_(commCallOffSpeakOne_).indexOf('commCallOffReachable_('), '');
  stAssert_(out, 'phone-name: the provenance is a COLUMN of the call-off house, so the answer outlives the execution that found it',
            COMM_CALLOFF_HEADER.indexOf('name_from') !== -1 &&
            stCode_(commCallOffRecorded_).indexOf('name_from: facts.name_from') !== -1, '');
}

// The requirement states matrix — materialized, delta-only (stage 3)…
function stRequirementStates_(out) {
  // a "Yes" or a date in a requirement cell is an answer, never owed
  stAssert_(out, 'states: a human writing "Yes" has answered the question',
            reqStateFromFlag_('Yes').state === 'ok' &&
            reqStateFromFlag_('y').state === 'ok' &&
            reqStateFromFlag_('1').state === 'ok', '');
  stAssert_(out, 'states: "No" is an answer, and an empty cell is not — only the second is chased',
            reqStateFromFlag_('No').state === 'missing' &&
            reqStateFromFlag_('').state === 'missing', '');
  stAssert_(out, 'states: a flag column holding a DATE is handed to the date lane, not called missing',
            reqStateFromFlag_('8/6/2026').state === 'date' &&
            reqStateFromFlag_('2026-08-06').state === 'date' &&
            reqStateFromFlag_('45758').state === 'date', '');
  stAssert_(out, 'states: a number that cannot be a date stays a flag — a count is not an expiry',
            reqStateFromFlag_('7').state === 'missing' &&
            reqStateFromFlag_('900000').state === 'missing', '');
  stAssert_(out, 'states: the three date shapes agree on the same day',
            reqFlagDateMs_('8/6/2026') === Date.UTC(2026, 7, 6) &&
            reqFlagDateMs_('2026-08-06') === Date.UTC(2026, 7, 6), '');
  stAssert_(out, 'states: the Sheets serial is counted from 1899-12-30, not from 1970',
            reqFlagDateMs_('45758') === Date.UTC(2025, 3, 11), '');
  stAssert_(out, 'states: n/a stays its own verdict, never a gap',
            reqStateFromFlag_('N/A').state === 'na', '');

  // THE READER THAT WAS RIGHT BY COINCIDENCE.
  var oldOrder = ['person_key', 'person_name', 'req_id', 'state', 'expires',
                  'days_left', 'prev_state', 'since', 'computed_at', 'tenant', 'login'];
  var newOrder = ['login', 'person_key', 'person_name', 'req_id', 'state',
                  'expires', 'days_left', 'prev_state', 'since', 'computed_at', 'tenant'];
  var oldRow = ['ana', 'Ana', 'cpr', 'ok', '2026-10-01', '42', 'expiring', '2026-08-01', 'x', '', ''];
  var newRow = ['', 'ana', 'Ana', 'cpr', 'ok', '2026-10-01', '42', 'expiring', '2026-08-01', 'x', ''];
  var asOld = reqStatesIndex_(oldOrder, [oldRow]);
  var asNew = reqStatesIndex_(newOrder, [newRow]);
  stAssert_(out, 'states: the same row under two column orders reads the same — the reader follows names, not positions',
            JSON.stringify(asOld) === JSON.stringify(asNew), JSON.stringify([asOld, asNew]));
  stAssert_(out, 'states: and it reads the RIGHT things — key is person+requirement, not login+name',
            !!asNew['ana|cpr'] && asNew['ana|cpr'].state === 'ok' &&
            asNew['ana|cpr'].since === '2026-08-01', JSON.stringify(asNew));
  stAssert_(out, 'states: a column the tab does not carry is blank, never its neighbour',
            reqStatesIndex_(['person_key', 'req_id'], [['ana', 'cpr']])['ana|cpr'].since === '', '');

  // THE DIFF IS THE WHOLE DISCIPLINE, and it is pure: given two maps, what would the rebuild write?
  var computed = {
    'ana|cpr': { person_key: 'ana', person_name: 'Ana', req_id: 'cpr', state: 'ok', expires: '2026-10-01', days_left: 42 },
    'ana|dodd': { person_key: 'ana', person_name: 'Ana', req_id: 'dodd', state: 'expiring', expires: '2026-09-01', days_left: 12 },
    'bob|cpr': { person_key: 'bob', person_name: 'Bob', req_id: 'cpr', state: 'missing', expires: '', days_left: '' }
  };
  var existing = {
    'ana|cpr': { row: 2, state: 'ok', expires: '2026-10-01', since: '2026-08-01' },
    'ana|dodd': { row: 3, state: 'ok', expires: '2026-09-01', since: '2026-08-01' }
  };
  var diff = reqStatesDiff_(computed, existing);
  stAssert_(out, 'states: an unchanged row is not rewritten',
            diff.updates.length === 1 && diff.updates[0].row === 3,
            'a quiet platform must touch nothing — got ' + diff.updates.length + ' update(s)');
  stAssert_(out, 'states: a new pair inserts once, and both transitions fire events',
            diff.inserts.length === 1 && diff.changes.length === 2,
            'the first sight of a person and a state move must both be recorded — got ' +
            diff.inserts.length + ' insert(s), ' + diff.changes.length + ' change(s)');
  stAssert_(out, 'states: an expiry move without a state move updates but fires no event',
            (function () {
              var d2 = reqStatesDiff_(
                { 'ana|cpr': { person_key: 'ana', person_name: 'Ana', req_id: 'cpr', state: 'ok', expires: '2026-11-01', days_left: 72 } },
                { 'ana|cpr': { row: 2, state: 'ok', expires: '2026-10-01', since: '2026-08-01' } });
              return d2.updates.length === 1 && d2.changes.length === 0;
            })(),
            'a renewed certificate is a fact, not a transition');
  stAssert_(out, 'states: the update keeps `since` for a quiet change and moves it for a transition',
            (function () {
              var d3 = reqStatesDiff_(
                { 'ana|cpr': { person_key: 'ana', person_name: 'Ana', req_id: 'cpr', state: 'ok', expires: '2026-11-01', days_left: 72 },
                  'ana|dodd': { person_key: 'ana', person_name: 'Ana', req_id: 'dodd', state: 'expired', expires: '2026-09-01', days_left: -3 } },
                { 'ana|cpr': { row: 2, state: 'ok', expires: '2026-10-01', since: '2026-08-01' },
                  'ana|dodd': { row: 3, state: 'ok', expires: '2026-09-01', since: '2026-08-01' } });
              return d3.updates[0].since === '2026-08-01' &&
                     d3.changes.length === 1 && d3.changes[0].next === 'expired';
            })(),
            'the day a fact changed and the day it was re-read are different facts');

  // The compute reads the same sources the sweeps read — never a parallel truth.
  var compute = stCode_(reqStatesCompute_);
  stAssert_(out, 'states: the compute rides certPicture_ and the Master, like the sweeps',
            compute.indexOf('certPicture_()') !== -1 &&
            // THE ONE DOOR ONTO THE MASTER TAB.
            compute.indexOf("certSourceTab_('master')") !== -1 &&
            compute.indexOf('smartRawColumn_') !== -1,
            'a second state-derivation lane is a second copy of the rule');
  stAssert_(out, 'states: the expiring window is the requirement\'s own warn_days',
            compute.indexOf('reqWarnDays_(req') !== -1 &&
            stCode_(reqWarnDays_).indexOf('req.warn_days') !== -1,
            'a global constant would overrule the tab people edit');

  // THE OUTCOME DOOR: one place turns transitions into effects.
  stAssert_(out, 'states: outcomes fire through the one dispatcher',
            stCode_(requirementStatesRebuild_).indexOf('requirementOutcomeDispatch_') !== -1 &&
            stCode_(requirementOutcomeDispatch_).indexOf('consequence') !== -1,
            'a second lane deciding consequences is a second copy of the rule');
  var dispatch = requirementOutcomeDispatch_(
    { next: 'expired' }, { consequence: 'cpr_expiring' });
  stAssert_(out, 'states: an expiring/expired transition with a consequence fires the situation',
            dispatch.length === 1 && dispatch[0].type === 'smart_situation' &&
            dispatch[0].id === 'cpr_expiring',
            'the consequence on the row must drive the outcome');
  stAssert_(out, 'states: a transition to ok fires nothing',
            requirementOutcomeDispatch_({ next: 'ok' }, { consequence: 'cpr_expiring' }).length === 0 &&
            requirementOutcomeDispatch_({ next: 'expired' }, {}).length === 0,
            'renewals stay quiet and unconsequenced rows stay quiet');

  // THE LOOP: the rebuild runs on the relay's clock in Python (app/compliance_engine_writes.py), never here as well.
  stAssert_(out, 'states: the machine sweep no longer rebuilds them',
            stCode_(smartCommsSweep_).indexOf('requirementStatesSweepMaybe_') === -1,
            'two rebuilds of one matrix would write every change twice');
  stAssert_(out, 'states: every state change lands in the events trail',
            stCode_(requirementStatesRebuild_).indexOf("eventAppend_('requirement_state_changed'") !== -1,
            'the matrix answers now; the events answer how it got here');

  // The actions exist with policies — the resolver's own law.
  stAssert_(out, 'states: list and run are declared with policies',
            !!HUB_POLICY.requirementStatesList && !!HUB_POLICY.requirementStatesRun &&
            typeof HUB_ACTIONS.requirementStatesList === 'function' &&
            typeof HUB_ACTIONS.requirementStatesRun === 'function',
            'an action without a policy falls through to the write lane');

 // THE BASELINE LAW (measured live 12,780 inserts landed, 1,387 events — the per-pair loop outran the budget).
  var rebuild = stCode_(requirementStatesRebuild_);
  stAssert_(out, 'states: the baseline writes ONE summary event, not thousands',
            rebuild.indexOf('isBaseline') !== -1 &&
            rebuild.indexOf("'requirement_states_baseline'") !== -1,
            'the first rebuild would die writing 12,780 individual events again');
  stAssert_(out, 'states: a change wave is capped, with an overflow summary',
            rebuild.indexOf('REQ_STATES_EVENT_CAP') !== -1 &&
            rebuild.indexOf("'requirement_state_changes_overflow'") !== -1,
            'a mass expiry would eat the execution budget before finishing');

  // THE GUARDIAN SPEAKS — the feedback has to come back proactively.
  stAssert_(out, 'guardian: the alert situation ships OFF with an empty `to`',
            (function () {
              var g = null;
              smartDefaults_().forEach(function (d) { if (d.id === 'guardian_alert') g = d; });
              return g && !smartOn_(g.enabled) && String(g.to) === '';
            })(),
            'the owner writes their own address in and flips the switch — never before');
  stAssert_(out, 'guardian: the event lane knows the subject, and the sweep reaches it',
            !!SMART_EVENTS.guardian_alert &&
            stCode_(smartEventSweep_).indexOf("'guardian'") !== -1 &&
            typeof guardianSmartSubjects_ === 'function',
            'a situation naming no resolver fires never, and says nothing');
  stAssert_(out, 'guardian: red for a week tells once a day, not once a sweep',
            stCode_(guardianSmartSubjects_).indexOf("slice(0, 10)") !== -1,
            'the instance must be the day — anything finer pages hourly');
}

function stHubOwnedSheets_(out) {
  // REVERSED BY DECISION: the data comes INSIDE the hub.
  stAssert_(out, 'marketing: treated rows live on a HUB_DB tab, like every other tab',
            stRoutes_(marketingTreatSheet_) && stRoutes_(marketingReadTab_),
