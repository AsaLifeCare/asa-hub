  var tv = commPlanVerdict_(reh, { attempts: 9, lastAskedMs: 0, nowMs: 1e12, localHour: 2, localDay: 0, test: true });
  stAssert_(out, 'policy: in test mode the attempt cap and the quiet hours are recorded and not enforced',
