            })(),
            'those 4,500 documents were filed by hand — a decoder that renamed ' +
            'or moved one of them would be vandalism with good manners');
  stAssert_(out, 'digest: every ledger names the columns it keeps its file in',
            (function () {
              for (var i = 0; i < DIGEST_LEDGERS.length; i++) {
                var L = DIGEST_LEDGERS[i];
                if (!L.res || !L.fileId || !L.name || !L.mime) return false;
              }
              return DIGEST_LEDGERS.length >= 2;
            })(),
            'one decoder, two intakes — bending one ledger into the other is how both rot');
  stAssert_(out, 'digest: the drawer outranks the lexicon on a filed corpus',
            stCode_(digestOne_).indexOf('digestDrawerCategory_') !== -1 &&
            typeof digestDrawerCategory_ === 'function',
            'a file inside MARS is a MARS whatever the words say — and digest_json records the disagreement');
  stAssert_(out, 'client files: the corpus reads at the CLINICAL bar',
            HUB_CLINICAL_TABS.indexOf('clientFiles') !== -1,
            'digest_text carries the OCR of ISPs, MARS and identity documents');

  // THE ANSWERS MEET THE PAPER.
  stAssert_(out, 'answers: a question may declare the fact it feeds',
            typeof FORM_FIELD_FACTS === 'object' &&
            !!FORM_FIELD_FACTS.expires_on && !!FORM_FIELD_FACTS.doc_kind &&
            !!FORM_FIELD_FACTS.person && !!FORM_FIELD_FACTS.date,
            'text, choice and any date — the three named facts, plus the file');
  stAssert_(out, 'answers: a fact nobody carries is refused at save',
            stCode_(formCheckFields_).indexOf('FORM_FIELD_FACTS') !== -1,
            'a question promising to feed something the platform has no column for ' +
            'is a promise nothing can keep — better refused than silently ignored');
  stAssert_(out, 'answers: a reimport cannot erase a declaration',
            stCode_(formKeepPlatformFields_).indexOf('wasFact') !== -1,
            'Google has no idea what a question feeds — the fact was declared here ' +
            'and rides along by key, or Reimport turns the cross-check off in silence');
  stAssert_(out, 'answers: the words book decides what a question is about',
            DIGEST_VOCAB_TABS.answers === 'Digest Answer Facts' &&
            typeof digestAnswerFacts_ === 'function',
            'a form authored in Google declares nothing — the words it uses must be enough');
  stAssert_(out, 'answers: any date is a date, and it is asked LAST',
            (function () {
              var t = DIGEST_ANSWER_FACTS;
              return t[t.length - 1][0] === 'date' &&
                     digestAnswerFactOf_('q1', 'Expiration date', '') === 'expires_on' &&
                     digestAnswerFactOf_('q2', 'Date of the visit', '') === 'date';
            })(),
            'here "expiry date" means ANY date — but ' +
            '"expiration date" must reach expires_on before the bare rule can claim it');
  stAssert_(out, 'answers: a declaration is never overruled by a word',
