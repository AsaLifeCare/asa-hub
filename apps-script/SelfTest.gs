  stAssert_(out, 'shim: grid-shape calls are honest no-ops, never writes',
            stCode_(runtimeSheetMake_).indexOf('setFrozenRows: function () { return api; }') !== -1 &&
            stCode_(runtimeSheetMake_).indexOf('insertRowsAfter: function () { return api; }') !== -1, '');
  stAssert_(out, 'shim: a delete is a fact, so the row stops being rebuilt',
