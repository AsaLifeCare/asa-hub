  stAssert_(out, 'rendersheet: the guard asks the POINTER, never the moved switch — a declared house is ours whether or not the flip is armed',
            stCode_(renderSheetLedgerHit_).indexOf('houseIdFor_(') !== -1 &&
            stCode_(renderSheetLedgerHit_).indexOf('houseMoved_(') === -1 &&
            stCode_(renderSheetLedgerHit_).indexOf("'HUB_DB_ID'") !== -1,
            'an unarmed flip does not make the depot\'s own house a stranger');

  // ---- THE LIST AND THE DOOR ASK ONE QUESTION --------------------------- Pinned as source because building a…
  var listSrc = stCode_(HUB_ACTIONS.renderSheetList);
  var setSrc0 = stCode_(HUB_ACTIONS.renderSheetCellSet);
  var addSrc0 = stCode_(HUB_ACTIONS.renderSheetRowAdd);
  stAssert_(out, 'rendersheet: the list computes read_only with the write door\'s own function, on the sheet the door will land on',
            listSrc.indexOf('renderSheetLedgerRefusal_') !== -1 &&
            listSrc.indexOf('RENDER_SHEET_LEDGER_TABS.indexOf(str_(r.tab_name))') === -1,
            'a chip that says editable in front of a door that says 403 teaches the reader the door is broken');
  stAssert_(out, 'rendersheet: both write doors ask the ledger question TWICE — once before the resolve, once on the tab and workbook they landed in',
            (setSrc0.split('renderSheetLedgerRefusal_').length - 1) >= 2 &&
            (addSrc0.split('renderSheetLedgerRefusal_').length - 1) >= 2,
            'the pre-resolve ask costs no read; the post-resolve ask is the only one that sees where the door really went');
  stAssert_(out, 'rendersheet: every row the list returns carries read_only — hub built-ins, estate and linked alike',
            listSrc.indexOf('read_only:') !== -1 &&
            stSrcBetween_(listSrc, 'RENDER_SHEET_TABS.map', 'RENDER_SHEET_ESTATE').indexOf('read_only:') !== -1 &&
            stSrcBetween_(listSrc, 'RENDER_SHEET_ESTATE.forEach', 'renderSheetsRegRows_').indexOf('read_only:') !== -1 &&
            stSrcBetween_(listSrc, 'regRows.forEach', 'return { status: 200').indexOf('read_only:') !== -1,
            'a row without the field is a row the screen cannot reason about once it starts honouring it');

  // ---- A SHEET THE LIST COULD NOT OPEN IS UNCOUNTED, NEVER A 0 ---------- The screen adds every row count it is…
  var rlHeld = { tab: hubTabSheet_, est: renderSheetEstateResolve_,
                 reg: renderSheetsRegRows_, res: renderSheetResolve_ };
  var rlSaid = {};
  try {
    hubTabSheet_ = function (t) {
      if (t === 'diseases') return null;
      if (t === 'projects') throw new Error('workbook unreachable');
      return { getLastRow: function () { return 5; }, getLastColumn: function () { return 3; } };
    };
    renderSheetEstateResolve_ = function () { return null; };
    renderSheetsRegRows_ = function () { return [{ id: 'gone', title: 'Gone', sheet_id: 'SS_GONE', tab_name: '' }]; };
    renderSheetResolve_ = function () { return { error: { status: 403, message: 'not shared' } }; };
    var rlOut = HUB_ACTIONS.renderSheetList({}, { role: 'admin', email: 'e' });
    var rlBy = {};
    ((rlOut && rlOut.data && rlOut.data.tabs) || []).forEach(function (t) { rlBy[t.key] = t; });
    rlSaid = { missing: rlBy.diseases, threw: rlBy.projects, open: rlBy.shifts,
               estate: rlBy.est_uimui, linked: rlBy.lnk_gone,
               unread: !!(rlOut && rlOut.data && rlOut.data.registry_unread) };
  } catch (eRl) { rlSaid = { err: String((eRl && eRl.message) || eRl) }; }
  finally {
    hubTabSheet_ = rlHeld.tab; renderSheetEstateResolve_ = rlHeld.est;
    renderSheetsRegRows_ = rlHeld.reg; renderSheetResolve_ = rlHeld.res;
  }
  var rlDead = function (t) {
    return !!t && t.alive === false && typeof t.rows === 'number' && typeof t.cols === 'number';
  };
  stAssert_(out, 'rendersheet: the list ran with its openers stubbed', !rlSaid.err, rlSaid.err || '');
  stAssert_(out, 'rendersheet: a hub tab that is not there is alive:false, its counts still numbers an older screen can draw',
            rlDead(rlSaid.missing), JSON.stringify(rlSaid.missing || null));
  stAssert_(out, 'rendersheet: a hub tab whose workbook threw is alive:false the same way',
            rlDead(rlSaid.threw), JSON.stringify(rlSaid.threw || null));
  stAssert_(out, 'rendersheet: an estate sheet that did not resolve is alive:false',
            rlDead(rlSaid.estate), JSON.stringify(rlSaid.estate || null));
  stAssert_(out, 'rendersheet: a linked spreadsheet the platform cannot open is alive:false',
            rlDead(rlSaid.linked), JSON.stringify(rlSaid.linked || null));
  stEq_(out, 'rendersheet: an opened tab still carries its real count',
        rlSaid.open ? [rlSaid.open.alive, rlSaid.open.rows, rlSaid.open.cols].join(',') : 'missing',
        'true,4,3');
  stAssert_(out, 'rendersheet: a registry that answered carries no registry_unread flag',
            rlSaid.unread === false, String(rlSaid.unread));

  // ---- AN UNREAD REGISTRY IS SAID, NEVER AN EMPTY LIST ------------------- The linked spreadsheets live in one…
  var rgHeld = { tab: hubTabSheet_, est: renderSheetEstateResolve_, sheet: renderSheetsRegSheet_ };
  var rgSaid = {};
  try {
    hubTabSheet_ = function () {
      return { getLastRow: function () { return 3; }, getLastColumn: function () { return 2; } };
    };
    renderSheetEstateResolve_ = function () { return null; };
    renderSheetsRegSheet_ = function () { throw new Error('registry unreachable'); };
    var rgList = HUB_ACTIONS.renderSheetList({}, { role: 'admin', email: 'e' });
    var rgRes = renderSheetResolve_('lnk_any');
    rgSaid = {
      unread: !!(rgList && rgList.data && rgList.data.registry_unread),
      builtins:((rgList && rgList.data && rgList.data.tabs) || []).filter(function (t) { return t.source === 'hub'; }).length,
      linkedStatus: rgRes && rgRes.error ? rgRes.error.status : 0,
    };
  } catch (eRg) { rgSaid = { err: String((eRg && eRg.message) || eRg) }; }
  finally {
    hubTabSheet_ = rgHeld.tab; renderSheetEstateResolve_ = rgHeld.est; renderSheetsRegSheet_ = rgHeld.sheet;
  }
  stAssert_(out, 'rendersheet: the list ran with the registry unreadable', !rgSaid.err, rgSaid.err || '');
  stAssert_(out, 'rendersheet: an unread registry is flagged on the list',
            rgSaid.unread === true, JSON.stringify(rgSaid));
  stEq_(out, 'rendersheet: the built-ins still come back when only the registry failed',
        rgSaid.builtins, RENDER_SHEET_TABS.length);
  stEq_(out, 'rendersheet: a linked key over an unread registry is a 503, never a 404',
        rgSaid.linkedStatus, 503);
  stAssert_(out, 'rendersheet: the add door refuses when the registry cannot be read, rather than skipping the duplicate check',
            stCode_(HUB_ACTIONS.renderSheetAdd).indexOf('RENDER_SHEETS_REG_UNREAD') !== -1,
            'an unread registry reads as "no duplicates" and appends a second row for the same sheet');

  // ---- the write path: badge gate, prev-check, text format, the log ----
  var setSrc = stCode_(HUB_ACTIONS.renderSheetCellSet);
  var addSrc = stCode_(HUB_ACTIONS.renderSheetRowAdd);
  stAssert_(out, 'rendersheet: both writes pass through the edit-badge gate',
            setSrc.indexOf('renderSheetCanEdit_') !== -1 &&
            addSrc.indexOf('renderSheetCanEdit_') !== -1,
            'an unguarded write path into HUB_DB');
  stAssert_(out, 'rendersheet: the cell write refuses when the cell changed under you',
            setSrc.indexOf('409') !== -1 && setSrc.indexOf('prev') !== -1, '');
  stAssert_(out, 'rendersheet: text format is set BEFORE the value — nothing coerces',
            setSrc.indexOf("setNumberFormat('@')") !== -1 &&
            setSrc.indexOf("setNumberFormat('@')") < setSrc.indexOf('.setValue(') &&
            addSrc.indexOf("setNumberFormat('@')") !== -1 &&
            addSrc.indexOf("setNumberFormat('@')") < addSrc.indexOf('.setValues('), '');
  stAssert_(out, 'rendersheet: both writes land in the system log',
            setSrc.indexOf('hubSysLog_') !== -1 && addSrc.indexOf('hubSysLog_') !== -1, '');

  // ---- the edit gate fails CLOSED: empty config = admins only ----------- The badge list is a Settings row, so…
  stWithSettings_({}, function () {
    stAssert_(out, 'rendersheet: with no badges configured a manager cannot edit, an admin can',
              renderSheetCanEdit_({ role: 'manager', email: 'm@x', types: 'HM' }) === false &&
              renderSheetCanEdit_({ role: 'admin', email: 'a@x', types: '' }) === true,
              'the empty default must be NOBODY beyond admins, the inverse of the shell law');
  });
  stWithSettings_({ render_sheet_edit_badges: 'HM' }, function () {
    stAssert_(out, 'rendersheet: a configured badge opens the gate for THAT badge and for nobody else',
              renderSheetCanEdit_({ role: 'manager', email: 'm@x', types: 'HM' }) === true &&
              renderSheetCanEdit_({ role: 'manager', email: 'm@x', types: 'CG' }) === false,
              'a badge gate that widens past the badge it was given is an open write door');
  });
  stAssert_(out, 'rendersheet: a service identity never edits',
            renderSheetCanEdit_({ role: 'admin', is_service: true }) === false, '');

  // ---- refusals cost no read --------------------------------------------
  stEq_(out, 'rendersheet: a non-writer is refused before any read',
        HUB_ACTIONS.renderSheetGrid({ tab: 'entity_candidates' }, { role: 'staff' }).status, 403);
  stEq_(out, 'rendersheet: the grid refuses a tab off the whitelist',
        HUB_ACTIONS.renderSheetGrid({ tab: 'users' }, { role: 'admin', email: 'e' }).status, 400);
  stEq_(out, 'rendersheet: a write to an off-whitelist tab is refused',
        HUB_ACTIONS.renderSheetCellSet({ tab: 'users', row: 1, col: 'email', value: 'x', prev: '' },
                                       { role: 'admin', email: 'e' }).status, 400);
  stEq_(out, 'rendersheet: a manager without the badge is refused the write itself',
        HUB_ACTIONS.renderSheetCellSet({ tab: 'entity_candidates', row: 1, col: 'x', value: '', prev: '' },
                                       { role: 'manager', email: 'm@x', types: 'HM' }).status, 403);

  // ---- the declarations --------------------------------------------------
  stEq_(out, 'rendersheet: all four actions are admin/manager at the outer ring',
        [HUB_POLICY.renderSheetList.roles.join(','), HUB_POLICY.renderSheetGrid.roles.join(','),
         HUB_POLICY.renderSheetCellSet.roles.join(','), HUB_POLICY.renderSheetRowAdd.roles.join(',')].join('|'),
        'admin,manager|admin,manager|admin,manager|admin,manager');
  stEq_(out, 'rendersheet: reads ride the read lane, writes the write lane',
        [HUB_POLICY.renderSheetList.lane, HUB_POLICY.renderSheetGrid.lane,
         HUB_POLICY.renderSheetCellSet.lane, HUB_POLICY.renderSheetRowAdd.lane].join(','),
        'read,read,write,write');
}

// ------------------------------------------------------------------ User worlds — the personal workbook beside the…
function stWorld_(out) {
  if (typeof worldResolve_ !== 'function' || typeof HUB_ACTIONS.worldEnsure !== 'function') {
    stAssert_(out, 'world: World.gs is loaded', false, 'World.gs missing');
    return;
  }

  // ---- the resolver: owned, and 404 to everyone else --------------------
  var rows = [{ world_id: 'wld_a1', owner_user_id: 'U1', spreadsheet_id: 'SS_A1' }];
  var okCtx = worldResolve_(rows, 'wld_a1', { id: 'U1' });
  stEq_(out, 'world: the owner reaches their own workbook',
        okCtx.worldId + '|' + okCtx.ssId, 'wld_a1|SS_A1');
  stEq_(out, 'world: a service identity is refused — a service owns nothing',
        worldResolve_(rows, 'wld_a1', { id: 'U1', is_service: true }).error.status, 404);
  stEq_(out, 'world: somebody else answers 404, never 403',
        worldResolve_(rows, 'wld_a1', { id: 'U2' }).error.status, 404);
  stEq_(out, 'world: an unknown world answers 404',
        worldResolve_(rows, 'wld_zz', { id: 'U1' }).error.status, 404);
  stAssert_(out, 'world: no refusal in the resolver says 403',
            stCode_(worldResolve_).indexOf('403') === -1,
            'a 403 admits the world exists');
  var ctxSrc = stCode_(worldContext_);
  stAssert_(out, 'world: a refusal never reads the registry sheet',
            ctxSrc.indexOf('is_service') !== -1 &&
            ctxSrc.indexOf('is_service') < ctxSrc.indexOf('worldRows_'), '');

  // ---- the cache keys: the single most dangerous omission ---------------
  var held = HUB_WORLD_CTX;
  try {
    HUB_WORLD_CTX = { worldId: 'wld_t', ssId: 'SSIDABCDEFGH' };
    stEq_(out, 'world: an active world qualifies every cache scope',
          cacheScope_('tasks'), 'w_SSIDABCD_tasks');
    stEq_(out, 'world: in a world the resource IS the tab name',
          tabFor_('anything'), 'anything');
  } finally { HUB_WORLD_CTX = held || null; }
  stEq_(out, 'world: with no world the company key is EXACTLY the bare tab',
        cacheScope_('tasks'), 'tasks');
  stEq_(out, 'world: with no world the resource maps through RESOURCES',
        tabFor_('teamTasks'), 'team_tasks');
  stAssert_(out, 'world: every SheetDb read and bump travels through the scope',
            [listRows_, createRow_, updateRowById_, deleteRowById_, cacheBumpAfterWrite_]
              .every(function (f) { return stCode_(f).indexOf('cacheScope_') !== -1; }),
            'a bare tab-name key serves one person\'s rows to the company');
 // getSpreadsheet_ delegates to hubDb_ since the place seam (C3); the invariant is that the WORLD is still asked…
  stAssert_(out, 'world: getSpreadsheet_ honours the world context',
            stCode_(getSpreadsheet_).indexOf('hubDb_') !== -1 &&
            stCode_(hubDb_).indexOf('HUB_WORLD_CTX') !== -1 &&
            stCode_(hubDb_).indexOf('HUB_WORLD_CTX') < stCode_(hubDb_).indexOf('HUB_DB_ID'),
            'a world must outrank both the central list and the place');

  // ---- the router: the world branch comes FIRST -------------------------
  var routeSrc = stCode_(route);
  stAssert_(out, 'world: route() settles the world before any adapter or gate',
            routeSrc.indexOf('worldRoute_') !== -1 &&
            routeSrc.indexOf('worldRoute_') < routeSrc.indexOf('talentRoute_'),
            'an adapter that answers first leaks company data into a world call');
  var postSrc = stCode_(doPost);
  stAssert_(out, 'world: doPost resets the execution global before anything',
            postSrc.indexOf('HUB_WORLD_CTX = null') !== -1 &&
            postSrc.indexOf('HUB_WORLD_CTX = null') < postSrc.indexOf('sessionUser_'),
            'a warm start would aim a read at the previous caller\'s workbook');
  stAssert_(out, 'world: only the generic verbs follow the world',
            postSrc.indexOf('worldContext_') !== -1 &&
            postSrc.indexOf('!HUB_ACTIONS[action]') !== -1,
            'a named action following the world would write the wrong workbook');

  // ---- the verb family's pure refusals ----------------------------------
  stEq_(out, 'world: an unknown verb answers 400',
        worldRoute_('notes', 'poke', {}, { id: 'U1' }).status, 400);
  stEq_(out, 'world: a malformed tab name answers 404',
        worldRoute_('users!', 'list', {}, { id: 'U1' }).status, 404);

  // ---- the doors: internal humans only ---------------------------------- A CLIENT KEEPS A WORLD NOW.
  stEq_(out, 'world: an interviewer signs in for one screen and never gets a world',
        HUB_ACTIONS.worldGet({}, { role: 'interviewer', id: 'I1' }).status, 403);
  stEq_(out, 'world: an onboarding account never gets a world',
        HUB_ACTIONS.worldEnsure({}, { role: 'onboarding', id: 'T1' }).status, 403);
  stEq_(out, 'world: a service identity is refused at every world door',
        HUB_ACTIONS.worldAppsList({}, { role: 'admin', is_service: true, id: 'S' }).status, 403);

  // ---- worldEnsure: idempotent by lookup, locked against twins ----------
  var ensureSrc = stCode_(HUB_ACTIONS.worldEnsure);
  stAssert_(out, 'world: creation is locked, created and moved into User Worlds',
            ensureSrc.indexOf('LockService') !== -1 &&
            ensureSrc.indexOf('SpreadsheetApp.create') !== -1 &&
            ensureSrc.indexOf('moveTo') !== -1 &&
            ensureSrc.indexOf('filesChildByName_') !== -1 &&
            ensureSrc.indexOf('filesRoot_') !== -1, '');
  stAssert_(out, 'world: the owner lookup runs AGAIN under the lock — a retry cannot mint twins',
            ensureSrc.indexOf('worldRowFor_') !== -1 &&
            ensureSrc.indexOf('worldRowFor_') < ensureSrc.lastIndexOf('worldRowFor_'), '');

  // ---- data never touches the company DB --------------------------------
  stAssert_(out, 'world: no world source names HUB_DB_ID — the registry rides ensureTab_, data never does',
            [worldRoute_, HUB_ACTIONS.worldGet, HUB_ACTIONS.worldEnsure, HUB_ACTIONS.worldAppsList,
             HUB_ACTIONS.worldAppUpsert, HUB_ACTIONS.worldAppDelete]
              .every(function (f) { return stCode_(f).indexOf('HUB_DB_ID') === -1; }), '');

  // ---- the app lane keeps the builder's laws ----------------------------
  var upSrc = stCode_(HUB_ACTIONS.worldAppUpsert);
  stAssert_(out, 'world: the app swap runs under a lock',
            upSrc.indexOf('LockService') !== -1, '');
  stAssert_(out, 'world: sample rows are seeded only into a tab this call just created',
            upSrc.indexOf("'created'") !== -1, '');
  stAssert_(out, 'world: deleting an app never touches its data tabs',
            stCode_(HUB_ACTIONS.worldAppDelete).indexOf('worldEnsureDataTab_') === -1 &&
            stCode_(HUB_ACTIONS.worldAppDelete).indexOf('insertSheet') === -1 &&
            stCode_(HUB_ACTIONS.worldAppDelete).indexOf('deleteSheet') === -1, '');
  var staffU = { role: 'staff', id: 'U1', email: 'e' };
  // a fixture account, read as one the world is offered to whatever Settings > My Work holds (stMyWorld_ has that)
  var heldHidden = hubMyWorldHiddenFor_;
  try {
    hubMyWorldHiddenFor_ = function () { return false; };
    stEq_(out, 'world: an app with a bad id is refused before anything is read',
          HUB_ACTIONS.worldAppUpsert({ app: { id: 'Bad Id!', name: 'X',
            pages: [{ type: 'sheet', resource: 'stuff' }] } }, staffU).status, 400);
    stEq_(out, 'world: a page may not target the world_apps tab itself',
          HUB_ACTIONS.worldAppUpsert({ app: { id: 'my-app', name: 'X',
            pages: [{ type: 'sheet', resource: 'world_apps' }] } }, staffU).status, 400);
    stEq_(out, 'world: deleting without an app id is refused',
          HUB_ACTIONS.worldAppDelete({}, staffU).status, 400);
  } finally {
    hubMyWorldHiddenFor_ = heldHidden;
  }

  // ---- the declarations --------------------------------------------------
  stEq_(out, 'world: reads ride the read lane, writes the write lane',
        [HUB_POLICY.worldGet.lane, HUB_POLICY.worldEnsure.lane, HUB_POLICY.worldAppsList.lane,
         HUB_POLICY.worldAppUpsert.lane, HUB_POLICY.worldAppDelete.lane].join(','),
        'read,write,read,write,write');
  // THE DOOR AND THE ROOM MUST NAME THE SAME PEOPLE — a client loading My World hit an error: "This action is for…
  (function () {
    var doors = ['worldGet', 'worldEnsure', 'worldAppsList', 'worldAppUpsert', 'worldAppDelete',
                 'worldAppsSeedDefaults', 'worldAppInstallDefault',
                 'myWorldAccessList', 'myWorldAccessSet'];
    var drifted = [], leaked = [];
    for (var i = 0; i < doors.length; i++) {
      var pol = HUB_POLICY[doors[i]];
      if (!pol || !pol.roles) continue;
      for (var r = 0; r < WORLD_ROLES.length; r++) {
        if (pol.roles.indexOf(WORLD_ROLES[r]) === -1) { drifted.push(doors[i] + ' misses ' + WORLD_ROLES[r]); break; }
      }
      if (pol.roles.indexOf('onboarding') !== -1 || pol.roles.indexOf('interviewer') !== -1) leaked.push(doors[i]);
    }
    // A DUPLICATE KEY MADE EVERY SAVE INVISIBLE.
  stAssert_(out, 'config: a feature grant folds the ROLE in, not badges alone',
            stCode_(hubShellFeatureOn_).indexOf('roleRaw') !== -1 &&
            stCode_(hubGrantedFeatureOn_).indexOf('roleRaw') !== -1,
            'a client carries no badges: its client-ness lives in role, so a CLIENT row could never match');
  stAssert_(out, 'config: a save updates EVERY row carrying that key',
            stCode_(HUB_ACTIONS.hiringAlertsSet).indexOf('found = true;\n      }') !== -1 &&
            stSrcBetween_(stCode_(HUB_ACTIONS.hiringAlertsSet), 'for (var r = 1; r < data.length; r++)', 'if (!found)')
              .indexOf('break;') === -1,
            'writing the first match while the reader takes the last makes a duplicate key swallow every save');
  stAssert_(out, 'world: every world door admits everyone worldHuman_ does',
              drifted.length === 0,
              'the policy gate runs first, so a role the door omits never reaches the room: ' + drifted.join(', '));
    stAssert_(out, 'world: and no world door ever admits a one-screen role',
              leaked.length === 0,
              'a trainee or an interviewer has no workspace for a world to sit beside: ' + leaked.join(', '));
  })();
  stAssert_(out, 'world: worldEnsure declares itself idempotent — tool-lane retries re-POST',
            HUB_POLICY.worldEnsure.idempotent === true, '');
}

// THE PLACE — the two seams that had no section at all (audit: "the eleven checkers that run on every build never…
function stTenant_(out) {
  if (typeof tenantResolve_ !== 'function') {
    stAssert_(out, 'tenant: Tenant.gs is loaded', false, 'Tenant.gs missing');
    return;
  }
  var dir = [
    { tenantid: 'ten_hq', type: 'hq', status: 'active' },
    { tenantid: 'ten_akron', type: 'franchise', status: 'active' },
    { tenantid: 'ten_old', type: 'franchise', status: 'archived' }
  ];
  var hqUser  = { id: 'U1', email: 'a@x.com', hometenant: '', tenants: '' };
  var frUser  = { id: 'U2', email: 'b@x.com', hometenant: 'ten_akron', tenants: '' };
  var master  = { id: 'U0', email: 'm@x.com', is_master: true, hometenant: '', tenants: '' };

  // ---- THE PLACE IS DERIVED, NOT DECLARED -------------------------------
  stEq_(out, 'tenant: an empty envelope from a headquarters account is home',
        String(tenantResolve_(dir, '', hqUser)), 'null');
  stAssert_(out, 'tenant: an empty envelope from a FRANCHISE account is that franchise',
            tenantResolve_(dir, '', frUser).tenantId === 'ten_akron',
            'absent must never read as headquarters — a cold boot sends absent');
  stEq_(out, 'tenant: a franchise account may not simply declare headquarters',
        tenantResolve_(dir, 'ten_hq', frUser).error.status, 404);
  stEq_(out, 'tenant: naming your own place resolves it',
        tenantResolve_(dir, 'ten_akron', frUser).tenantId, 'ten_akron');
  stEq_(out, 'tenant: a place you do not belong to answers 404, never 403',
        tenantResolve_(dir, 'ten_akron', hqUser).error.status, 404);
  stAssert_(out, 'tenant: no refusal in the resolver says 403',
            stCode_(tenantResolve_).indexOf('403') === -1,
            'a 403 admits the place exists and that somebody else stands there');

  // ---- THE MASTER, DERIVED AND NEVER FROM A CELL ------------------------
  stEq_(out, 'tenant: the master reaches an active franchise',
        tenantResolve_(dir, 'ten_akron', master).tenantId, 'ten_akron');
  stEq_(out, 'tenant: an ARCHIVED place is refused even to the master',
        tenantResolve_(dir, 'ten_old', master).error.status, 404);
  stEq_(out, 'tenant: the master with an empty envelope is at home',
        String(tenantResolve_(dir, '', master)), 'null');

  // ---- THE ADDITIVE LAW: blank membership = headquarters ----------------
  stEq_(out, 'tenant: the extra list widens where an account may stand',
        tenantResolve_(dir, 'ten_akron',
          { id: 'U3', email: 'c@x.com', hometenant: '', tenants: 'ten_akron' }).tenantId, 'ten_akron');
  stEq_(out, 'tenant: home is the hq-typed row, adopted not invented',
        tenantHomeFrom_(dir), 'ten_hq');

  // ---- THE ZERO-COST HOME PATH ------------------------------------------
  var ctxSrc = stCode_(tenantContext_);
  stAssert_(out, 'tenant: a headquarters request never opens the directory',
            ctxSrc.indexOf('if (!wanted && !mine) return null') !== -1 &&
            ctxSrc.indexOf('if (!wanted && !mine) return null') < ctxSrc.indexOf('tenantsRows_'),
            'reading the tenants tab on every request is how the Users app timed out');
  stAssert_(out, 'tenant: the service identity stands nowhere',
            ctxSrc.indexOf('is_service') !== -1 &&
            ctxSrc.indexOf('is_service') < ctxSrc.indexOf('tenantsRows_'), '');

  // ---- ROW VISIBILITY: blank = headquarters ------------------------------
  var heldT = HUB_TENANT_CTX;
  try {
    HUB_TENANT_CTX = null;
    stAssert_(out, 'tenant: at home every row is visible, blank or stamped',
              tenantRowVisible_('') && tenantRowVisible_('ten_akron'), '');
    stEq_(out, 'tenant: at home nothing is stamped, so Ohio grows no column',
          tenantStamp_(), '');
    HUB_TENANT_CTX = { tenantId: 'ten_akron' };
    stAssert_(out, 'tenant: away, a blank row belongs to headquarters and is hidden',
              !tenantRowVisible_('') && tenantRowVisible_('ten_akron'),
              '30,000 existing rows carry a blank cell — that is what makes the filter additive');
    stEq_(out, 'tenant: away, a created row is stamped with the place',
          tenantStamp_(), 'ten_akron');

    // ---- THE COLUMN IS NEVER CLIENT INPUT --------------------------------
    var pc = { name: 'x', tenant: 'ten_hq' };
    hubPlaceGate_('teamTasks', 'create', pc);
    stEq_(out, 'tenant: a create cannot plant a row in another place', pc.tenant, 'ten_akron');
    var pu = { id: 'r1', tenant: '' };
    stAssert_(out, 'tenant: an update cannot send a row home to headquarters',
              (function () {
                var held = requireRow_;
                requireRow_ = function () { return { id: 'r1', tenant: 'ten_akron' }; };
                try { hubPlaceGate_('teamTasks', 'update', pu); } finally { requireRow_ = held; }
                return pu.tenant === 'ten_akron';
              })(),
              'a blank cell means headquarters, so a blank on an update is an emigration');

    // ---- THE ADAPTERS DO NOT ANSWER AWAY ---------------------------------
    stEq_(out, 'tenant: an adapter reading headquarters\' own workbook is refused away',
          hubAdapterPlaceGate_('candidates').status, 404);
    stAssert_(out, 'tenant: a generic resource is NOT refused by the adapter gate',
              hubAdapterPlaceGate_('teamTasks') === null,
              'the adapter gate must narrow the adapters and nothing else');
  } finally { HUB_TENANT_CTX = heldT || null; }
  stAssert_(out, 'tenant: at home the adapter gate refuses nothing',
            hubAdapterPlaceGate_('candidates') === null, '');

  // ---- WHERE AN ACCOUNT MAY BE PLACED ------------------------------------ The place became editable from the…
  var heldRows = HUB_TENANT_ROWS;
  try {
    HUB_TENANT_ROWS = dir;
    var master = { id: 'U0', email: 'm@x.com', is_master: true };
    var hqAdmin = { id: 'U1', email: 'a@x.com', home_tenant: '', tenants: [] };
    stAssert_(out, 'tenant: blank is always placeable — headquarters is where everybody may live',
              tenantPlaceableGate_([''], hqAdmin) === null, '');
    stEq_(out, 'tenant: a place that does not exist is refused, not written',
          tenantPlaceableGate_(['ten_nope'], master).status, 400,
          'the account would resolve into a place with no rows and meet a 404 everywhere');
    stEq_(out, 'tenant: an ARCHIVED place cannot be somebody\'s home',
          tenantPlaceableGate_(['ten_old'], master).status, 400);
    stEq_(out, 'tenant: you cannot place somebody where you cannot stand yourself',
          tenantPlaceableGate_(['ten_akron'], hqAdmin).status, 403);
    stAssert_(out, 'tenant: the master may place anybody anywhere active',
              tenantPlaceableGate_(['ten_akron'], master) === null, '');
    stAssert_(out, 'tenant: reach is ONE predicate — the master reaches everywhere',
              tenantReachIds_(master) === null, '');
    // THE DIRECTORY IS NOT NARROWED FOR THE PEOPLE WHO RUN THE PLATFORM (found live).
    stAssert_(out, 'tenant: an admin still sees the whole directory',
              tenantReachIds_({ id: 'U9', email: 'a@x.com', role: 'admin' }) === null,
              'hiding a place from an admin also hides the screen that grants it');
    stAssert_(out, 'tenant: everybody else is still narrowed to where they may stand',
              (tenantReachIds_({ id: 'U8', email: 's@x.com', role: 'staff' }) || []).indexOf('ten_akron') === -1,
              'the narrowing that mattered was never about admins');
    stAssert_(out, 'tenant: the place is settable through the platform, never only a cell',
              String(HUB_ACTIONS.userUpdate).indexOf('tenantPlaceableGate_') !== -1 &&
              String(HUB_ACTIONS.userUpdate).indexOf("set('hometenant'") !== -1,
              'a column nothing can write is a chore with a lockout at the end of it');
  } finally { HUB_TENANT_ROWS = heldRows; }

  // ---- THE JSON LANE (C5) ------------------------------------------------ A bundle is a MIRROR that gets copied…
  stAssert_(out, 'bundle: identity is excluded by construction, not by a deny-list',
            stCode_(bundleReadAll_).indexOf('RESOURCES') !== -1 &&
            stCode_(bundleReadAll_).indexOf('USERS_TAB') === -1 &&
            stCode_(bundleReadAll_).indexOf('SESSIONS_TAB') === -1,
            'salts and password hashes must not ride a file that gets copied around');
  stAssert_(out, 'bundle: the machine can build for a place it does not stand in',
            stCode_(HUB_ACTIONS.snapshotBundleBuild).indexOf('HUB_TENANT_CTX = { tenantId: wanted }') !== -1 &&
            stCode_(HUB_ACTIONS.snapshotBundleBuild).indexOf('tenantActiveIdsFrom_') !== -1 &&
            stCode_(HUB_ACTIONS.snapshotBundleBuild).indexOf('HUB_TENANT_CTX = held') !== -1,
            'a service identity stands nowhere, so without this the lane could only ever build headquarters');
  stAssert_(out, 'bundle: an unknown place is refused, never treated as home',
            stCode_(HUB_ACTIONS.snapshotBundleBuild).indexOf("status: 404, message: 'Not found.'") !== -1,
            'building "headquarters" for a typo is how a place gets somebody else\'s rows');
  stAssert_(out, 'bundle: the place is narrowed at BUILD time',
            stCode_(bundleReadAll_).indexOf('tenantRowVisible_') !== -1,
            "a franchise's bundle must not CONTAIN Ohio's rows — then there is no filter to forget");
  stAssert_(out, 'bundle: it reads through the same door the verbs use',
            stRoutes_(bundleReadAll_),
            'a tab repointed to a place workbook (C3) — or to a house — must be read from there');
  // AND WITH THE SAME READER (found live).
  stAssert_(out, 'bundle: every file says which reader made it',
            stCode_(bundleBuild_).indexOf('reader: BUNDLE_READER_VERSION') !== -1 &&
            BUNDLE_READER_VERSION >= 2,
            'a stale bundle on disk looks exactly as trustworthy as a fresh one');
  stAssert_(out, 'bundle: the rows keep the SHEET\'s own column names',
            stCode_(bundleReadAll_).indexOf('readAll_(') !== -1 &&
            stCode_(bundleReadAll_).indexOf('readTabNormalized_') === -1 &&
            stCode_(bundleReadWorld_).indexOf('readTabNormalized_') === -1 &&
            stCode_(bundleReadOwned_).indexOf('readTabNormalized_') === -1,
            'a bundle is served AS a slice, so a paraphrased header is a blank screen');
  stAssert_(out, 'bundle: a tab that cannot be read is REPORTED, never emptied',
            stCode_(bundleReadAll_).indexOf('unreadable') !== -1,
            'an empty array and a failure look identical downstream, and they mean opposite things');
  stAssert_(out, 'bundle: the new file is written whole BEFORE the old ones go',
            stCode_(bundleBuild_).indexOf('createFile') < stCode_(bundleBuild_).indexOf('bundleSweep_'),
            'a crashed build must leave the previous bundle standing, never a half file');
  stAssert_(out, 'bundle: the sweep only ever removes what is not newest',
            stCode_(bundleSweep_).indexOf('BUNDLE_KEEP_PER_PLACE') !== -1,
            'running it twice must do what running it once did');
  stEq_(out, 'bundle: a place id full of underscores survives the grouping',
        bundlePlaceOf_(bundleName_('ten_asapersonal_b045', '2026-08-19T00:00:00Z')),
        'ten_asapersonal_b045',
        'splitting on the separator this codebase uses everywhere would have read the place as "ten"');
  stEq_(out, 'bundle: headquarters files under a name of its own',
        bundlePlaceOf_(bundleName_('', '2026-08-19T00:00:00Z')), 'home');
  stAssert_(out, 'bundle: only the machine may read one back',
            stCode_(HUB_ACTIONS.snapshotBundleLatest).indexOf('is_service') !== -1,
            'a bundle is every routed row of a place in one answer');
  // AND THE MACHINE MUST ACTUALLY BE ABLE TO CALL IT (found live).
  stAssert_(out, 'bundle: every door the lane needs is reachable by the service identity',
            SERVICE_READ_ACTIONS.indexOf('snapshotBundleLatest') !== -1 &&
            SERVICE_READ_ACTIONS.indexOf('snapshotBundlePlaces') !== -1 &&
            SERVICE_SWEEP_ACTIONS.indexOf('snapshotBundleBuild') !== -1 &&
            SERVICE_SWEEP_ACTIONS.indexOf('snapshotBundleSweep') !== -1,
            'a lane that can build and cannot read is a lane that does nothing at all');

  // ---- NINE WORKBOOKS IN ONE ENVIRONMENT (C4) ---------------------------- Five invited people, their worlds, the…
  stAssert_(out, 'tenant: the users tab is read once per execution, not per caller',
            stCode_(usersAll_).indexOf('HUB_USERS_ROWS') !== -1,
            'twenty-four call sites ask for it and several fire on one request');
  stAssert_(out, 'tenant: the memo dies where the WRITES are, not where somebody remembers',
            stCode_(hubSheet_).indexOf('HUB_USERS_ROWS = null') !== -1,
            'twenty-two writers across nine files take that handle; one forgetting is a stale answer');
  stAssert_(out, 'tenant: an account is matched to a candidate through an INDEX',
            stCode_(candidateIdByEmail_).indexOf('candidateEmailIndex_') !== -1 &&
            stCode_(candidateIdByEmail_).indexOf('readTabNormalized_') === -1,
            'userPublic_ runs per row, and usersList maps it over 188 of them');
  stAssert_(out, 'tenant: worldEnsure still creates the workbook OUTSIDE the lock',
            stCode_(HUB_ACTIONS.worldEnsure).indexOf('SpreadsheetApp.create') <
            stCode_(HUB_ACTIONS.worldEnsure).indexOf('LockService.getScriptLock'),
            'five first sign-ins in one minute is exactly the case this has to survive');

  // ---- THE WORKBOOK OF A PLACE (C3) -------------------------------------- A filter is a line somebody can fail…
  stAssert_(out, 'tenant: the workbook seam is DORMANT until a place has one',
            stCode_(tenantSpreadsheetId_).indexOf('spreadsheetid') !== -1 &&
            stCode_(hubDb_).indexOf('if (sid) return ssOpen_(sid);') !== -1,
            'no spreadsheet_id must mean byte-identical to before the seam existed');
  var dbSrc = stCode_(hubDb_);
  stAssert_(out, 'tenant: hubDb_ asks world, then central, then the place',
            dbSrc.indexOf('HUB_WORLD_CTX') < dbSrc.indexOf('hubTabIsCentral_') &&
            dbSrc.indexOf('hubTabIsCentral_') < dbSrc.indexOf('tenantSpreadsheetId_'),
            'a place that outranks the central list takes sign-in down with it');
  stAssert_(out, 'tenant: accounts and sessions never move with a place',
            hubTabIsCentral_('users') && hubTabIsCentral_('hub_sessions') &&
            hubTabIsCentral_('tenants') && hubTabIsCentral_('app_tenant_access'),
            'point identity at a franchise book and nobody signs in anywhere, including you');
  stAssert_(out, 'tenant: ordinary data DOES move with a place',
            !hubTabIsCentral_('people') && !hubTabIsCentral_('events') &&
            !hubTabIsCentral_('helpful_contacts'), '');

  // ---- THE TABS THAT LEFT HOME ------------------------------------------- HUB_DB is drained one app at a time: a…
  var movedTabs = (typeof HUB_TAB_HOME === 'object' && HUB_TAB_HOME)
    ? Object.keys(HUB_TAB_HOME).sort() : [];
  // Eight MOVED or BORN there (wave 1 + `mail`), batch A's ten cold-ops tabs, batch B's ten team-and-personal tabs…
  stEq_(out, 'apps book: HUB_TAB_HOME lists exactly the tabs that live there',
        movedTabs.join(','),
        'audits,billing_claims,care_docs,client_files,client_notes,client_overrides,equipment,' +
        'expenseReports,family_notes,finance_balances,finance_config,fleetVehicles,' +
        'helpful_contacts,house_notes,incident_reviews,inventoryItems,isp_sections,ist_records,leads,learn_attempts,' +
        'learn_skills,mail,mar_errors,mealPlans,meal_log,meal_profile,' +
        'med_catalog,med_deliveries,mileageLogs,missing_medications,' +
        'notifications,policyAcks,project_work_items,reminders,routes,' +
        'sheet_tasks,shiftTimeline,shopper_items,shopper_prices,ssa_notes,staff_notes,staff_profile_visits,team_projects,' +
        'team_tasks,travel_trips,truelink_runs,visits,week_items');
  var CARE_TABS = ['mealPlans', 'shiftTimeline', 'visits', 'med_catalog',
                   'client_notes', 'mar_errors', 'missing_medications',
                   'client_files', 'med_deliveries', 'care_docs',
                   'billing_claims', 'ist_records', 'house_notes',
                   'isp_sections', 'incident_reviews', 'client_overrides'];
  stAssert_(out, 'apps book: every listed tab names ITS family workbook property',
            movedTabs.length === 48 && movedTabs.every(function (t) {
              var want = CARE_TABS.indexOf(t) !== -1 ? 'HUB_CARE_BOOK_ID' : 'HUB_APPS_BOOK_ID';
              return HUB_TAB_HOME[t] === want;
            }), '');
  stAssert_(out, 'apps book: hubDb_ asks the place BEFORE the moved-tab book',
            dbSrc.indexOf('if (sid) return ssOpen_(sid);') !== -1 &&
            dbSrc.indexOf('if (sid) return ssOpen_(sid);') < dbSrc.indexOf('hubTabHomeId_') &&
            dbSrc.indexOf('hubTabHomeId_') < dbSrc.indexOf("home || hubId_('HUB_DB_ID')"),
            'a place with its own book keeps every tab in it, moved or not');
  stAssert_(out, 'apps book: a tab that never moved still answers HUB_DB',
            hubTabHomeId_('people') === '' && hubTabHomeId_('') === '',
            'an absent map entry must reproduce the pre-migration behavior');
  stAssert_(out, 'apps book: both workbook properties are catalogued and not secret',
            scriptPropSpec_('HUB_APPS_BOOK_ID') !== null &&
            scriptPropSpec_('HUB_APPS_BOOK_ID').secret === false &&
            scriptPropSpec_('HUB_CARE_BOOK_ID') !== null &&
            scriptPropSpec_('HUB_CARE_BOOK_ID').secret === false, '');

  // ---- THE DYNAMIC DOORS ASK THE ROUTER ---------------------------------- hubDb_ only protects code that asks it.
  var revsSrc = stCode_(bulkTabsRevs_);
  var readSrc = stCode_(bulkTabsRead_);
  stAssert_(out, 'apps book: the bulk REVS lane resolves a bare tab through the router',
            revsSrc.indexOf('hubTabSheet_(tab)') !== -1 &&
            revsSrc.indexOf("hubId_('HUB_DB_ID')") === -1,
            'a fixed book would keep reporting the frozen copy as unchanged');
  stAssert_(out, 'apps book: the bulk READ lane asks hubDb_ per tab',
            readSrc.indexOf('hubTabWorkbook_(tab)') !== -1 &&
            readSrc.indexOf("hubId_('HUB_DB_ID')") === -1,
            'one fixed open serves the frozen copy of every moved tab at once');
  stAssert_(out, 'apps book: a cache hit notes the book the tab lives in NOW',
            stCode_(cacheRead_).indexOf('hubTabWorkbook_(scope)') !== -1 &&
            stCode_(cacheRead_).indexOf("hubId_('HUB_DB_ID')") === -1,
            'noted against the old book, a moved tab never invalidates again — ' +
            'and the book map alone does not know the houses');
  stAssert_(out, 'apps book: the studio tab-maker and the delete report resolve the home book',
            stRoutes_(ensureTab_) &&
            (stRoutes_(HUB_ACTIONS.appDelete) ||
             stCode_(HUB_ACTIONS.appDelete).indexOf('hubTabHomeId_') !== -1),
            'a fixed open would create a second copy back home, or count the frozen one');
  stAssert_(out, 'apps book: the builder refuses a moved tab even after the old copy is gone',
            stCode_(appBuilderResourceState_).indexOf('appBuilderHomeHas_') !== -1 &&
            stRoutes_(appBuilderEnsureTab_),
            'deleting the frozen copy would make a used name look creatable');
  stAssert_(out, 'apps book: UTC books read dates the way the Hub DB always did',
            stCode_(readTabRawKeys_).indexOf("getSpreadsheetTimeZone() === 'Etc/GMT'") !== -1,
            'a moved tab would render its dates through the estate formatter');
  stAssert_(out, 'tenant: the workbook id is a credential and never reaches the SPA',
            stCode_(HUB_ACTIONS.tenantsList).indexOf('spreadsheetid') === -1 &&
            stCode_(HUB_ACTIONS.tenantEnsure).indexOf('data: { tenant_id: id, created: true }') !== -1,
            'whoever holds a spreadsheet id can ask Drive directly, outside every gate here');
  stAssert_(out, 'tenant: only the master may give a place its own workbook',
            stCode_(HUB_ACTIONS.tenantEnsure).indexOf('hubIsMaster_') !== -1 &&
            stCode_(HUB_ACTIONS.tenantEnsure).indexOf('403') === -1,
            'it changes where every screen in that place reads from');
  stAssert_(out, 'tenant: the Drive work stays OFF the platform lock',
            stCode_(HUB_ACTIONS.tenantEnsure).indexOf('SpreadsheetApp.create') <
            stCode_(HUB_ACTIONS.tenantEnsure).indexOf('LockService.getScriptLock'),
            'worldEnsure already paid for this once');
  stEq_(out, 'tenant: headquarters cannot be given a second workbook — it IS the one',
        HUB_ACTIONS.tenantEnsure({ tenant_id: 'ten_hq' },
          { id: 'U0', email: 'nobody@example.com' }).status, 404,
        'and a non-master is refused before the id is even read');

  // ---- DEFAULT DENY: the polarity, and no phantom names ------------------
  stAssert_(out, 'tenant: an action absent from the allowlist is refused away',
            !tenantActionAllowed_('estateRowUpdate') && tenantActionAllowed_('usersList'),
            'the absence of a line must be a refusal, not a leak');
  var phantom = [];
  for (var a = 0; a < HUB_TENANT_SAFE_ACTIONS.length; a++) {
    var nm = HUB_TENANT_SAFE_ACTIONS[a];
    if (nm.indexOf('auth') === 0) continue;   // authRoute_ answers these, not HUB_ACTIONS
    if (typeof HUB_ACTIONS[nm] !== 'function') phantom.push(nm);
  }
  stAssert_(out, 'tenant: every allowlisted name is a handler that exists',
            phantom.length === 0,
            'a line for a name no file defines reads as a reviewed decision: ' + phantom.join(', '));

  // ---- THE ROUTER'S ORDER ------------------------------------------------
  var routeSrc = stCode_(route);
  stAssert_(out, 'tenant: the place is settled before any adapter returns',
            routeSrc.indexOf('hubAdapterPlaceGate_') !== -1 &&
            routeSrc.indexOf('hubAdapterPlaceGate_') < routeSrc.indexOf('talentRoute_'),
            'an adapter that answers first leaks headquarters into a franchise');
  stAssert_(out, 'tenant: the place gate runs before the verbs',
            routeSrc.indexOf('hubPlaceGate_') !== -1 &&
            routeSrc.indexOf('hubPlaceGate_') < routeSrc.indexOf("case 'list'"), '');
  stAssert_(out, 'tenant: the single-row door checks the place once, for all three sources',
            routeSrc.indexOf('if (!got) return missing') !== -1 &&
            routeSrc.indexOf('if (!got) return missing') <
              routeSrc.indexOf('if (!tenantRowVisible_(got && got.tenant)) return missing'),
            'a derived branch that returns first hands over what the list just hid');
  var postSrc = stCode_(doPost);
  stAssert_(out, 'tenant: doPost resolves tenant, then member, then world',
            postSrc.indexOf('tenantContext_') < postSrc.indexOf('memberContext_') &&
            postSrc.indexOf('memberContext_') < postSrc.indexOf('worldContext_'),
            'the tenant needs the caller\'s own row and the world needs the member context');
  stAssert_(out, 'tenant: the tenant is resolved on EVERY request, not only when named',
            postSrc.indexOf('var tctx = tenantContext_(body.tenant, user)') !== -1 &&
            postSrc.indexOf('str_(body.tenant) &&') === -1,
            'making the envelope the authority is what made a cold boot headquarters');
}

// THE BULK TEST CASE (C6) — the whole matrix, asserted in both directions.
function stBulk_(out) {
  if (typeof tenantResolve_ !== 'function' || typeof memberResolve_ !== 'function' ||
      typeof worldResolve_ !== 'function') {
    stAssert_(out, 'bulk: the three resolvers are loaded', false, 'a resolver is missing');
    return;
  }

  /* ---- the environment ------------------------------------------------- */
  var HQ = 'ten_hq', FR = 'ten_fr';
  var dir = [
    { tenantid: HQ, type: 'hq', status: 'active' },
    { tenantid: FR, type: 'franchise', status: 'active' }
  ];

  var owner   = { id: 'U_OWNER', email: 'owner@x.com', is_master: true, hometenant: '', tenants: '' };
  var hqStaff = { id: 'U_HQ', email: 'hq@x.com', hometenant: '', tenants: '' };
  var frStaff = { id: 'U_FR', email: 'fr@x.com', hometenant: FR, tenants: '' };
  var both    = { id: 'U_BOTH', email: 'both@x.com', hometenant: FR, tenants: HQ };

  // five invited people, each with a world of their own
  var invited = [], worldRows = [], memberRows = [], userRows = [];
  for (var i = 1; i <= 5; i++) {
    var u = { id: 'U_INV' + i, email: 'inv' + i + '@x.com', hometenant: (i % 2 ? FR : ''), tenants: '' };
    invited.push(u);
    userRows.push({ userid: u.id, email: u.email, displayname: 'Invited ' + i,
                    role: (i === 1 ? 'admin' : 'staff'), types: (i === 2 ? 'DIRECTOR' : ''),
                    hometenant: u.hometenant, tenants: '' });
    worldRows.push({ world_id: 'wld_' + i, owner_user_id: u.id, spreadsheet_id: 'SS_' + i });
    memberRows.push({ memberid: 'mem_' + i, owneruserid: owner.id, memberuserid: u.id,
                      status: (i === 5 ? 'pending' : 'active'),
                      scope: (i % 2 ? 'work_world' : 'work') });
  }
  userRows.push({ userid: owner.id, email: owner.email, displayname: 'Owner', role: 'admin', types: '' });
  worldRows.push({ world_id: 'wld_owner', owner_user_id: owner.id, spreadsheet_id: 'SS_OWNER' });

  var fail = function (group, why) { return { group: group, why: why }; };
  var problems = [];
  var cells = 0;

  /* ---- 1. WHERE EACH ACCOUNT LANDS, with and without an envelope -------- */
  var standing = [
    { who: owner,   asked: '',   expect: 'home',  note: 'the master with no envelope is at home' },
    { who: owner,   asked: FR,   expect: FR,      note: 'the master travels' },
    { who: hqStaff, asked: '',   expect: 'home',  note: 'a headquarters account is home by omission' },
    { who: hqStaff, asked: FR,   expect: 'deny',  note: 'and may not simply ask for a franchise' },
    { who: frStaff, asked: '',   expect: FR,      note: 'a franchise account is IN its franchise by omission' },
    { who: frStaff, asked: HQ,   expect: 'deny',  note: 'and may not declare headquarters' },
    { who: frStaff, asked: FR,   expect: FR,      note: 'naming its own place resolves it' },
    { who: both,    asked: HQ,   expect: 'home',  note: 'an extra membership reaches headquarters' },
    { who: both,    asked: '',   expect: FR,      note: 'but home is still where it lives' }
  ];
  for (var s1 = 0; s1 < standing.length; s1++) {
    var c = standing[s1], got = tenantResolve_(dir, c.asked, c.who);
    cells++;
    var verdict = (got === null) ? 'home' : (got.error ? 'deny' : got.tenantId);
    if (verdict !== c.expect) problems.push(fail('where an account lands', c.note + ' → ' + verdict));
  }

  /* ---- 2. EVERY VERB, IN BOTH DIRECTIONS, IN EVERY PLACE --------------- */
  var heldCtx = HUB_TENANT_CTX, heldRow = requireRow_, heldRows = HUB_TENANT_ROWS;
  var heldSession = HUB_SESSION_USER, heldSvc = HUB_IS_SERVICE_REQ;
  var RESOURCES_UNDER_TEST = ['teamTasks', 'events', 'documents', 'helpfulContacts', 'people'];
  var ADAPTERS = ['candidates', 'directors', 'onboarding', 'certMatrix', 'staffCerts'];
  try {
    HUB_TENANT_ROWS = dir;
    // the place is what is measured here, so the caller is a writer the roster gate lets through (Auth.gs)
    HUB_SESSION_USER = { id: 'U_WRITER', email: 'writer@example.org', role: 'admin' };
    HUB_IS_SERVICE_REQ = false;
    var places = [
      { id: '', label: 'headquarters', mine: '', theirs: FR },
      { id: FR, label: 'the franchise', mine: FR, theirs: '' }
    ];
    for (var p1 = 0; p1 < places.length; p1++) {
      var place = places[p1];
      HUB_TENANT_CTX = place.id ? { tenantId: place.id } : null;

      // --- list: the place sees its own, and (away) never the other's ---
      cells += 2;
      if (!tenantRowVisible_(place.mine)) problems.push(fail('list in ' + place.label, 'its own rows are hidden'));
      if (place.id && tenantRowVisible_(place.theirs)) {
        problems.push(fail('list in ' + place.label, "it can see the other place's rows"));
      }

      for (var r1 = 0; r1 < RESOURCES_UNDER_TEST.length; r1++) {
        var res = RESOURCES_UNDER_TEST[r1];

        // --- create: the column is stamped from the context, never the payload ---
        cells++;
        var payload = { name: 'x', tenant: 'ten_forged' };
        hubPlaceGate_(res, 'create', payload);
        var wantStamp = place.id ? place.id : undefined;
        if (str_(payload.tenant) !== str_(wantStamp || '')) {
          problems.push(fail('create in ' + place.label, res + ' kept a forged place: ' + payload.tenant));
        }

        // --- update: cannot emigrate, and cannot touch another place's row ---
        cells += 2;
        requireRow_ = function () { return { id: 'r1', tenant: place.mine }; };
        var mine = { id: 'r1', tenant: '' };
        var gateMine = hubPlaceGate_(res, 'update', mine);
        if (gateMine) problems.push(fail('update in ' + place.label, res + ' refused its OWN row'));
        if (place.id && str_(mine.tenant) !== place.id) {
          problems.push(fail('update in ' + place.label, res + ' let a row emigrate'));
        }
        requireRow_ = function () { return { id: 'r2', tenant: place.theirs }; };
        var gateTheirs = hubPlaceGate_(res, 'update', { id: 'r2' });
        if (place.id && (!gateTheirs || gateTheirs.status !== 404)) {
          problems.push(fail('update in ' + place.label, res + " reached the other place's row"));
        }

        // --- delete: the same boundary as read ---
        cells++;
        var gateDel = hubPlaceGate_(res, 'delete', { id: 'r2' });
        if (place.id && (!gateDel || gateDel.status !== 404)) {
          problems.push(fail('delete in ' + place.label, res + " deleted the other place's row"));
        }
      }

      // --- the adapters: headquarters' own external workbooks ---
      for (var a1 = 0; a1 < ADAPTERS.length; a1++) {
        cells++;
        var ad = hubAdapterPlaceGate_(ADAPTERS[a1]);
        if (place.id && (!ad || ad.status !== 404)) {
          problems.push(fail('adapters in ' + place.label, ADAPTERS[a1] + ' answered away from home'));
        }
        if (!place.id && ad) problems.push(fail('adapters in ' + place.label, ADAPTERS[a1] + ' was refused AT HOME'));
      }

      // --- the named actions: allowed by declaration, refused by omission ---
      cells += 2;
      if (!tenantActionAllowed_('usersList')) problems.push(fail('named actions', 'a declared action is refused'));
      if (tenantActionAllowed_('estateRowUpdate')) problems.push(fail('named actions', 'an undeclared action answers away'));
    }
  } finally {
    HUB_TENANT_CTX = heldCtx || null;
    requireRow_ = heldRow;
    HUB_TENANT_ROWS = heldRows;
    HUB_SESSION_USER = heldSession;
    HUB_IS_SERVICE_REQ = heldSvc;
  }

  /* ---- 3. FIVE INVITED PEOPLE, AND WHAT A VISIT REACHES ----------------- */
  var heldMember = HUB_MEMBER_CTX;
  try {
    for (var m1 = 0; m1 < memberRows.length; m1++) {
      var row = memberRows[m1];
      var res2 = memberResolve_(memberRows, userRows, row.memberid, owner);
      cells++;
      if (str_(row.status) === 'pending') {
        if (!res2 || !res2.error || res2.error.status !== 404) {
          problems.push(fail('the member axis', 'a PENDING request opened as a place'));
        }
        continue;
      }
      if (!res2 || res2.error) { problems.push(fail('the member axis', row.memberid + ' would not open')); continue; }

      // somebody else's owner may never stand in it
      cells++;
      var stranger = memberResolve_(memberRows, userRows, row.memberid, { id: 'U_HQ' });
      if (!stranger || !stranger.error) problems.push(fail('the member axis', "another owner reached somebody's member"));

      // the visit narrows and never widens — role and badges both
      cells += 2;
      if (memberRoleRank_(memberClampRole_('staff', res2.role)) > memberRoleRank_('staff')) {
        problems.push(fail('the member axis', 'visiting widened the visitor'));
      }
      if (memberClampTypes_('', res2.types).length !== 0) {
        problems.push(fail('the member axis', 'a visit handed out a badge the visitor does not hold'));
      }

      // work vs work_world: only BOTH opens the visited person's workbook
      cells += 2;
      HUB_MEMBER_CTX = res2;
      var theirWorld = 'wld_' + (m1 + 1);
      var opened = worldResolve_(worldRows, theirWorld, owner);
      if (res2.scope === 'work_world') {
        if (!opened || opened.error) problems.push(fail('work_world', 'BOTH did not open the visited world'));
      } else if (!opened || !opened.error) {
        problems.push(fail('work vs work_world', 'WORK alone opened somebody\'s world'));
      }
      HUB_MEMBER_CTX = null;
      // and with nobody visited, only the owner's own world opens
      var mineWorld = worldResolve_(worldRows, theirWorld, owner);
      if (!mineWorld || !mineWorld.error) {
        problems.push(fail('work vs work_world', "a world opened with no authorisation at all"));
      }
    }
  } finally { HUB_MEMBER_CTX = heldMember || null; }

  /* ---- the verdict ------------------------------------------------------ */
  var groups = {};
  for (var q = 0; q < problems.length; q++) {
    var g = problems[q].group;
    if (!groups[g]) groups[g] = [];
    groups[g].push(problems[q].why);
  }
  var names = [];
  for (var k in groups) if (groups.hasOwnProperty(k)) names.push(k);
  for (var n = 0; n < names.length; n++) {
    stAssert_(out, 'bulk: ' + names[n], false, groups[names[n]].slice(0, 4).join(' · '));
  }
  stAssert_(out, 'bulk: the whole matrix holds in both directions (' + cells + ' cells)',
            problems.length === 0,
            problems.length + ' cell(s) failed across ' + names.length + ' law(s)');
}

/** THE MEMBER AXIS — a visit narrows, and only their own word opens it. */
function stMember_(out) {
  if (typeof memberResolve_ !== 'function') {
    stAssert_(out, 'member: Members.gs is loaded', false, 'Members.gs missing');
    return;
  }
  var rows = [
    { memberid: 'mem_ok',   owneruserid: 'U1', memberuserid: 'U9', status: 'active',  scope: 'work_world' },
    { memberid: 'mem_wait', owneruserid: 'U1', memberuserid: 'U8', status: 'pending', scope: '' },
    { memberid: 'mem_them', owneruserid: 'U2', memberuserid: 'U7', status: 'active',  scope: 'work' }
  ];
  var users = [
    { userid: 'U9', email: 'nine@x.com', displayname: 'Nine', role: 'director', types: 'DIRECTOR' },
    { userid: 'U8', email: 'eight@x.com', displayname: 'Eight', role: 'staff', types: '' },
    { userid: 'U7', email: 'seven@x.com', displayname: 'Seven', role: 'admin', types: '' }
  ];
  var owner = { id: 'U1', email: 'one@x.com' };

  stEq_(out, 'member: an authorised row opens for its owner',
        memberResolve_(rows, users, 'mem_ok', owner).userId, 'U9');
  stEq_(out, 'member: a PENDING request is not a place — nothing of theirs is reachable',
        memberResolve_(rows, users, 'mem_wait', owner).error.status, 404);
  stEq_(out, 'member: somebody else\'s member answers 404, never 403',
        memberResolve_(rows, users, 'mem_them', owner).error.status, 404);
  stEq_(out, 'member: a service identity visits nobody',
        String(memberResolve_(rows, users, 'mem_ok', { id: 'U1', is_service: true })), 'null');
  // REVERSED: the button is born ENABLED, and the user can go and turn it OFF.
  stEq_(out, 'member: the door is born OPEN — a blank scope is not a refusal',
        memberScopeOf_({ scope: '' }), 'work_world');
  stEq_(out, 'member: closing is still closing',
        memberScopeOf_({ scope: 'work' }), 'work');
  stAssert_(out, 'member: only the PERSON can re-open what the person closed',
            memberWorldLockedByOwner_({ scope: 'work', scopeby: 'member' }) === true &&
            memberWorldLockedByOwner_({ scope: 'work', scopeby: 'owner' }) === false,
            'an owner able to undo their answer means they never really made it');
  stAssert_(out, 'member: the owner\'s door refuses to re-open a person\'s no',
            stCode_(HUB_ACTIONS.platformMemberAuthorize).indexOf('memberWorldLockedByOwner_') !== -1,
            '');
  stAssert_(out, 'member: the person has a door of their own, matched on their OWN id',
            typeof HUB_ACTIONS.myWorldAccessSet === 'function' &&
            stCode_(HUB_ACTIONS.myWorldAccessSet).indexOf('iMember') !== -1 &&
            stCode_(HUB_ACTIONS.myWorldAccessSet).indexOf("set('scopeby', 'member')") !== -1,
            'a decision nobody can reach is not a decision');
  stAssert_(out, 'member: My world is not a feature anybody grants',
            String(userPublic_).indexOf('my_world: true') !== -1,
            'a badge list able to hide it takes somebody\'s own ground away from them');
  stEq_(out, 'member: BOTH is carried through as answered',
        memberResolve_(rows, users, 'mem_ok', owner).scope, 'work_world');
  stAssert_(out, 'member: no refusal in the resolver says 403',
            stCode_(memberResolve_).indexOf('403') === -1, '');

  // ---- THE VISIT NARROWS, NEVER WIDENS ----------------------------------
  stEq_(out, 'member: visiting an admin does not make a manager one',
        memberClampRole_('manager', 'admin'), 'manager');
  stEq_(out, 'member: visiting staff narrows an admin to staff',
        memberClampRole_('admin', 'staff'), 'staff');
  stEq_(out, 'member: an unknown role is the floor — adopted, and it opens nothing',
        memberClampRole_('admin', 'whatever'), 'whatever');
  stEq_(out, 'member: a DIRECTOR badge is not gained by visiting one',
        memberClampTypes_('HM', 'DIRECTOR,HM').join(','), 'HM');
  stEq_(out, 'member: the badges a visit carries are the ones BOTH hold',
        memberClampTypes_('DIRECTOR,HM', 'HM,INTERVIEWER').join(','), 'HM');
  stAssert_(out, 'member: doPost clamps the badges, never adopts them',
            stCode_(doPost).indexOf('memberClampTypes_(user.types, mctx.types)') !== -1,
            'types decide who may sign a scorecard and who may read the mailbox');
  var postSrc = stCode_(doPost);
  stAssert_(out, 'member: doPost clamps rather than adopting the visited role',
            postSrc.indexOf('memberClampRole_(user.role, mctx.role)') !== -1,
            'lending the visited role is a privilege ladder in one direction');
  // A VISIT NARROWS WHAT MAY BE SEEN; IT DOES NOT CHANGE WHO IS ASKING (found live).
  stAssert_(out, 'member: the caller is kept whole, before the visit rewrites them',
            stCode_(doPost).indexOf('HUB_CALLER = user') !== -1 &&
            stCode_(doPost).indexOf('HUB_CALLER = user') <
              stCode_(doPost).indexOf('memberClampRole_(user.role, mctx.role)'),
            'kept after the rewrite it would remember the visited person');
  stAssert_(out, 'member: the GATE and the handler both see the caller for their own actions',
            stCode_(doPost).indexOf('hubPolicyGate_(action, payload, actor)') !== -1 &&
            stCode_(doPost).indexOf('HUB_ACTIONS[action](payload, actor') !== -1,
            'the door refused before the room got a say');
  stAssert_(out, 'member: the roster and the places stack are the caller\'s own',
            hubCallerOwnAction_('platformMembersList') &&
            hubCallerOwnAction_('tenantsList') &&
            hubCallerOwnAction_('myWorldAccessSet') &&
            !hubCallerOwnAction_('usersList'),
            'a visit that empties the stack takes the way out with the way in');
  // A VISIT CANNOT WRITE — the polarity that replaced "the id stays the caller's", after one account's data was…
  stAssert_(out, 'member: the visit wears the VISITED identity, so every read is theirs',
            postSrc.indexOf('id: mctx.userId') !== -1 &&
            postSrc.indexOf('id: user.id') === -1 &&
            postSrc.indexOf('acting_for: mctx.userId') !== -1,
            'keeping the caller id is what made one chat history appear under every name');
  // AND A WRITE LANDS IN THE ENVIRONMENT BEING STOOD IN — A VISIT WRITES INTO THAT VISITED ENVIRONMENT.
  stAssert_(out, 'member: a write during a visit lands in THAT environment, not the visitor\'s',
            stCode_(route).indexOf('hubVisitReadOnly_') === -1 &&
            postSrc.indexOf('hubVisitWriteGate_') === -1,
            'a visit that cannot write is a workspace you may only look at');
  stAssert_(out, 'member: and the owner stamp is seized from the context, never from the payload',
            typeof hubOwnedGate_ === 'function' &&
            stCode_(hubOwnedGate_).indexOf('user') !== -1,
            'a payload that may name its own owner is how one person files a row in another one\'s name');
  stAssert_(out, 'member: but presence is never stamped for the person being visited',
            stCode_(HUB_ACTIONS.chatOverview).indexOf('hubMemberId_()') !== -1,
            'the green dot would say they are at a keyboard because somebody opened their screen');
  stAssert_(out, 'member: chat answers the person whose work is on screen',
            stCode_(HUB_ACTIONS.chatOverview).indexOf('hubActingUserId_(user)') !== -1 &&
            stCode_(HUB_ACTIONS.chatMessages).indexOf('hubActingUserId_(user)') !== -1,
            'thread keys built from the caller id served one history under every name');
  stAssert_(out, 'member: the audit trail names the caller, not the person being looked at',
            stCode_(hubSysLog_).indexOf('HUB_CALLER') !== -1 &&
            stCode_(hubSysLog_).indexOf('visiting') !== -1,
            'the visit wears their identity, so an unresolved log would credit the wrong author');
  // AND SO IS YOUR OWN NAME, FACE AND PASSWORD.
  stAssert_(out, 'member: my own profile and password are never written to the person I am visiting',
            hubCallerOwnAction_('profileUpdate'),
            'a profile is who is signed in, not the environment being operated');
  stAssert_(out, 'member: "you cannot delete your own account" means the account at the keyboard',
            stCode_(HUB_ACTIONS.userDelete).indexOf('HUB_CALLER') !== -1,
            'read off the rewritten user this guard protects the visited person and deletes the caller');
  // A CONNECTION ONLY ONE SIDE CAN END IS NOT A CONNECTION — the connection has to be endable from both sides.
  stAssert_(out, 'world: a client keeps their own world, like every other account',
            worldHuman_({ role: 'client' }) === true &&
            worldHuman_({ role: 'staff' }) === true &&
            worldHuman_({ role: 'manager' }) === true &&
            worldHuman_({ role: 'admin' }) === true,
            'my_world is answered true for everybody; a role left out here is refused by the server that promised it');
  stAssert_(out, 'world: a service identity never has one, and neither do the one-screen roles',
            worldHuman_({ role: 'staff', is_service: true }) === false &&
            worldHuman_({ role: 'interviewer' }) === false &&
            worldHuman_({ role: 'onboarding' }) === false,
            'an interviewer signs in for one afternoon and a trainee is not an employee yet');
  stAssert_(out, 'member: the person brought in can end the link themselves',
            typeof HUB_ACTIONS.platformMemberLeave === 'function' &&
            stCode_(HUB_ACTIONS.platformMemberLeave).indexOf("!== 'admin'") === -1 &&
            stCode_(HUB_ACTIONS.platformMemberLeave).indexOf('memberuserid') !== -1,
            'admin-gating the exit leaves staff on a platform they cannot leave');
  stAssert_(out, 'member: and only their OWN link, refused as 404',
            stCode_(HUB_ACTIONS.platformMemberLeave).indexOf('iMember') !== -1 &&
            stCode_(HUB_ACTIONS.platformMemberLeave).indexOf('403') === -1,
            'a 403 admits the row exists and tells a stranger who is on that platform');
  stAssert_(out, 'member: and the way OFF a platform is reachable wherever you stand',
            HUB_TENANT_SAFE_ACTIONS.indexOf('platformMemberLeave') !== -1 &&
            HUB_TENANT_SAFE_ACTIONS.indexOf('platformMemberMine') !== -1,
            'the place law is default-deny: unlisted, the exit answers 404 in every franchise');
  stAssert_(out, 'member: both exits leave the SAME shape behind',
            stCode_(HUB_ACTIONS.platformMemberLeave).indexOf("'removed'") !== -1 &&
            stCode_(HUB_ACTIONS.platformMemberRemove).indexOf("'removed'") !== -1,
            'two doors writing two states is two truths about one link');
  stAssert_(out, 'member: the whole link lifecycle is legible in the system log',
            typeof logVocab_ === 'function' &&
            logVocab_('platformMemberAsk').area === 'Access' &&
            logVocab_('platformMemberAuthorize').verb.indexOf('let in') !== -1 &&
            logVocab_('platformMemberRemove').verb.indexOf('ended') !== -1 &&
            logVocab_('platformMemberLeave').verb.indexOf('left') !== -1,
            'recorded and unreadable is recorded for nobody');
  stAssert_(out, 'member: and a link id in the log names the two people it joins',
            typeof logMemberPair_ === 'function' &&
            stCode_(logFriendlyTarget_).indexOf('mem_') !== -1,
            'the most consequential row on this platform read like a checksum');
  stAssert_(out, 'member: the roster stays the caller\'s own, visit or no visit',
            hubCallerOwnAction_('platformMemberAuthorize') && hubCallerOwnAction_('tenantsList'),
            'authorising a member is how a visit begins — answering it as them closes the door from inside');

  // ---- ONLY THEIR OWN WORD OPENS IT -------------------------------------
  stAssert_(out, 'member: there is exactly ONE door in, and it starts PENDING',
            typeof HUB_ACTIONS.platformMemberAdd !== 'function' &&
            typeof HUB_ACTIONS.platformMemberAsk === 'function' &&
            stCode_(HUB_ACTIONS.platformMemberAsk).indexOf("status: 'pending'") !== -1,
            'a second door that writes active skips the letter, the reply and the scope');
  stEq_(out, 'member: the sweep reads the address a header actually carries',
        memberReplyAddress_('"maria@asa.com" <evil@x.com>'), 'evil@x.com');
  stEq_(out, 'member: a quoted display name may hold a comma',
        memberReplyAddress_('"Silva, Maria" <maria@asa.com>'), 'maria@asa.com');
  stAssert_(out, 'member: a lookalike address cannot answer for somebody',
            memberReplyAddress_('xmaria@asa.com') !== 'maria@asa.com',
            'indexOf said yes to anything the address was merely a part of');
  stAssert_(out, 'member: the sweep matches the sender whole, never by substring',
            stCode_(memberAuthSweepRun_).indexOf('from.indexOf(addr)') === -1 &&
            stCode_(memberAuthSweepRun_).indexOf('byEmail.hasOwnProperty(from)') !== -1, '');

  // ---- EVERY WORLD IS ITS OWNER'S ---------------------------------------
  stEq_(out, 'member: your world says OWNER wherever you open it',
        memberWorldRole_({ id: 'U9', email: 'nine@x.com' }), 'owner');
}

// ------------------------------------------------------------------ The requirements tab — the compliance catalog…
function stRequirements_(out) {
  // The code catalog (the fallback) is internally sound: unique ids, and every row that derives a reminder…
  var ids = {}, dups = [];
  for (var i = 0; i < REQUIREMENTS_CATALOG.length; i++) {
    var r = REQUIREMENTS_CATALOG[i];
    if (ids[r.req_id]) dups.push(r.req_id);
    ids[r.req_id] = true;
    if (str_(r.consequence)) {
      stAssert_(out, 'requirements: ' + r.req_id + ' — a consequence carries a credential',
                !!str_(r.credential), 'the sweep would resolve nothing');
      stAssert_(out, 'requirements: ' + r.req_id + ' — a consequence carries a window',
                !!str_(r.warn_days), 'the sweep would compare against nothing');
    }
  }
  stAssert_(out, 'requirements: no duplicate req_id in the catalog', dups.length === 0,
            dups.join(','));

  // The credential strings the raw-column situations resolve with are EXACTLY the Master's headers — one character…
  var byId = {};
  REQUIREMENTS_CATALOG.forEach(function (r) { byId[r.req_id] = r; });
  stEq_(out, "requirements: the licence resolves the Master's own column",
        byId.driver_license.credential, 'Driver License Exp Date');
  stEq_(out, 'requirements: the insurance resolves the Master\'s own column',
        byId.car_insurance.credential, 'Insurance Exp Date');
  stEq_(out, 'requirements: every cert key resolves a mapped credential',
        ['dodd', 'cpr', 'med1', 'med2', 'med3', 'mandt', 'mais', 'money']
          .map(function (k) { return byId[k].credential; }).join(','),
        'dodd,cpr,med1,med2,med3,mandt,mais,money');

  // The validator is the only gate a hand-edited row gets.
  stAssert_(out, 'requirements: a row needs an id and a label, nothing else',
            requirementRowValid_({ req_id: 'x', label: 'X' }) === true &&
            requirementRowValid_({ req_id: 'x' }) === false &&
            requirementRowValid_({ label: 'X' }) === false &&
            requirementRowValid_(null) === false,
            'a blank row would poison the catalog the screen derives from');

  // The seed writes only into an EMPTY tab — an edited one is never re-seeded, so hand edits can never be reverted…
  stAssert_(out, 'requirements: the seed refuses any tab that already has rows',
            stCode_(requirementsSeed_).indexOf('getLastRow() > 1') !== -1 &&
            stCode_(requirementsSeed_).indexOf('skipped: true') !== -1,
            'a re-seed would silently restore factory defaults over human edits');

  // THE FALLBACK LAW: an unreadable tab can never make an obligation vanish.
  stAssert_(out, 'requirements: requirementsAll_ falls back to the code catalog',
            stCode_(requirementsAll_).indexOf("source: 'fallback'") !== -1 &&
            stCode_(requirementsAll_).indexOf('REQUIREMENTS_CATALOG.slice()') !== -1,
            'a spreadsheet hiccup would otherwise blank the compliance matrix');

  // And the SmartComms reader prefers the tab — the whole point of the move.
  stAssert_(out, 'requirements: smartDefaults_ asks the requirements tab first',
            stCode_(smartDefaults_).indexOf('requirementsForSmart_()') !== -1 &&
            stCode_(smartDefaults_).indexOf('fromTab.length') !== -1,
            'the catalog moved to data; the reader must read data');

  // The SmartComms shaping preserves today's factory defaults exactly: dodd ships ON with its own wording…
  stAssert_(out, 'requirements: the tab path keeps the dodd exception verbatim',
            stCode_(smartDefaults_).indexOf("enabled: isDodd ? 'yes' : 'no'") !== -1 &&
            // the wording moved to the book — the STATE keeps moving its renewal link — so the law follows the…
            stCode_(smartDefaults_).indexOf('smartDoddSms_()') !== -1 &&
            typeof smartDoddSms_ === 'function' &&
            SMART_DODD_SMS_SEED.indexOf('mylearning.dodd.ohio.gov') !== -1 &&
            SMART_DODD_SMS_SEED.indexOf('all 8 hours') !== -1,
            'the one live reminder must stay live and worded as it is');

  // The actions exist with their policies — the resolver's own law.
  stAssert_(out, 'requirements: list/upsert/delete are declared with policies',
            !!HUB_POLICY.requirementsList && !!HUB_POLICY.requirementUpsert &&
            !!HUB_POLICY.requirementDelete &&
            typeof HUB_ACTIONS.requirementsList === 'function' &&
            typeof HUB_ACTIONS.requirementUpsert === 'function' &&
            typeof HUB_ACTIONS.requirementDelete === 'function',
            'an action without a policy falls through to the write lane by omission');
}

// ------------------------------------------------------------------ The events tab — the immutable trail (stage 2)…
function stEvents_(out) {
  // APPEND-ONLY IS THE LAW, and it is checkable: the writer appends and never touches a written row.
  var appender = stCode_(eventAppend_);
  stAssert_(out, 'events: the writer only appends — no edits, no deletes',
            appender.indexOf('appendRow') !== -1 &&
            appender.indexOf('setValues') === -1 &&
            appender.indexOf('deleteRow') === -1,
            'an event log you can edit is a diary, and an auditor can tell');
  // A payload is context, not a document — it is capped.
  stAssert_(out, 'events: the payload is capped',
            appender.indexOf('EVENTS_PAYLOAD_MAX') !== -1 &&
            appender.indexOf('.slice(0, EVENTS_PAYLOAD_MAX)') !== -1,
            'an unbounded payload becomes a document store nobody can read');
  // The read is BOUNDED — a tab that only grows must never be read whole.
  var reader = stCode_(eventList_);
  stAssert_(out, 'events: the read walks a window, never the whole tab',
            reader.indexOf('EVENTS_READ_WINDOW') !== -1 &&
            reader.indexOf('getRange(windowStart') !== -1,
            'a full-tab scan on a table that grows forever is an outage on a schedule');
  // The cursor pages below what was already seen — no event repeats, none skips.
  stAssert_(out, 'events: the cursor continues below the oldest seen',
            reader.indexOf('seenCursor') !== -1 &&
            reader.indexOf('next_cursor') !== -1,
            'a page that restarts re-reads the same events forever');
  // EVERY ACTION THE PLATFORM LOGS BECOMES AN EVENT — the hook in hubSysLog_, so the human feed and the machine…
  stAssert_(out, 'events: hubSysLog_ writes the same fact to the trail',
            stCode_(hubSysLog_).indexOf('eventAppend_') !== -1,
            'two unconnected trails is two truths for one auditor');
  stAssert_(out, 'events: the hook cannot break the lane it describes',
            stCode_(hubSysLog_).indexOf("typeof eventAppend_ === 'function'") !== -1 &&
            stCode_(hubSysLog_).indexOf('catch (err)') !== -1,
            'the trail writer is a hard dependency of every action now');
  // The action exists with its policy — the resolver's own law.
  stAssert_(out, 'events: eventsList is declared with a policy',
            !!HUB_POLICY.eventsList && typeof HUB_ACTIONS.eventsList === 'function',
            'an action without a policy falls through to the write lane');
}

// …
function stCommIntent_(out) {
  var rows = [
    { person_key: 'ana', req_id: 'cpr',    state: 'expiring', days_left: '12', expires: '2026-09-23' },
    { person_key: 'ana', req_id: 'dodd',   state: 'expired',  days_left: '-4', expires: '2026-09-07' },
    { person_key: 'ana', req_id: 'i9',     state: 'ok',       days_left: '300', expires: '2027-07-01' },
    { person_key: 'ana', req_id: 'money',  state: 'missing',  days_left: '',   expires: '' },
    { person_key: 'ana', req_id: 'mandt',  state: 'na',       days_left: '',   expires: '' }
  ];
  var b = commBindingsFor_(rows);
  stAssert_(out, 'intent: an answered obligation is not a question, and n/a is not a gap',
            b.length === 3 && b.every(function (x) { return x.req_id !== 'i9' && x.req_id !== 'mandt'; }),
            JSON.stringify(b.map(function (x) { return x.req_id; })));
  // ONE FACT WEARING THREE NAMES.
  var trio = [
    { person_key: 'ana', req_id: 'nurse_aide',   state: 'expired', expires: '2025-01-01', days_left: '-9' },
    { person_key: 'ana', req_id: 'offender',     state: 'expired', expires: '2025-01-01', days_left: '-9' },
    { person_key: 'ana', req_id: 'sex_offender', state: 'expired', expires: '2025-01-01', days_left: '-9' },
    { person_key: 'ana', req_id: 'cpr',          state: 'missing', expires: '',           days_left: '' }
  ];
  var folded = commBindingsFor_(trio);
  stAssert_(out, 'intent: one piece of paper is asked for ONCE, not once per column it was filed in',
            folded.length === 2, JSON.stringify(folded.map(function (b) { return b.req_id; })));
  stAssert_(out, 'intent: and the fold says what else it settles — answering it answers all three',
            (folded[0].also || []).length === 2 &&
            (folded[0].settles || []).length === 3, JSON.stringify(folded[0].also));
  stAssert_(out, 'intent: a DIFFERING date means somebody tracks them apart now — the fold stands down',
            commBindingsFor_([trio[0], trio[1],
              { person_key: 'ana', req_id: 'sex_offender', state: 'expired',
                expires: '2026-06-06', days_left: '-1' }]).length === 3, '');
  stAssert_(out, 'intent: a lone member of the group is left exactly as it was',
            commBindingsFor_([trio[0], trio[3]]).length === 2, '');

  stAssert_(out, 'intent: what already lapsed leads — a message that opens with the reason reads as one',
            b[0].req_id === 'dodd' && b[1].req_id === 'cpr' && b[2].req_id === 'money',
            JSON.stringify(b));

 // THE UNIT OF ASKING IS A PERSON.
  var roster = { ana: 1 };
  var intent = commIntentFor_('ana', 'Ana Silva', rows, { roster: roster });
  stAssert_(out, 'intent: one person, one intent, three demands riding inside it',
            intent && intent.bindings.length === 3 && intent.person_key === 'ana', '');
  stAssert_(out, 'intent: somebody who does not work here is never asked',
            commIntentFor_('bob', 'Bob', rows, { roster: roster }) === null, '');
  stAssert_(out, 'intent: a person owing nothing produces no intent, which is a real answer',
            commIntentFor_('ana', 'Ana', [rows[2]], { roster: roster }) === null, '');

  // THE KEY MAKES A REPEAT HARMLESS — a six-hourly sweep must not contact somebody four times a day.
  var again = commIntentFor_('ana', 'Ana Silva', rows, { roster: roster });
  stAssert_(out, 'intent: the same need asked twice is the same intent',
            again.intent_key === intent.intent_key, '');
  // THE KEY IS THE THREAD.
  stAssert_(out, 'intent: the key is who and why — a changed open set is the same conversation moving on',
            commIntentKey_('ana', 'p') === 'ana|p' &&
            commIntentFor_('ana', 'Ana Silva', rows.slice(0, 2), { roster: roster }).intent_key === intent.intent_key, '');
  var moved = commIntentSupersede_({ intent_key: 'k', demand_ids: ['a', 'b'] },
                                   { intent_key: 'k', demand_ids: ['a', 'c'] });
  stAssert_(out, 'intent: what moved is named — dropped demands settle or defer on their own rows, added ones rise',
            !!moved && moved.added.join() === 'c' && moved.dropped.join() === 'b' &&
            commIntentSupersede_({ intent_key: 'k', demand_ids: ['a', 'b'] },
                                 { intent_key: 'k', demand_ids: ['b', 'a'] }) === null, JSON.stringify(moved));

  // ANSWERING PART OF SOMETHING ADVANCES THAT PART ONLY — the rule a naive implementation always breaks.
  var part = commIntentQualify_(intent, intent.bindings[0].demand_id, 'satisfied');
  stAssert_(out, 'intent: a reply to one of three advances exactly one',
            part.state === 'asking' && part.open_count === 2, '');
  var b2 = commIntentQualify_(part, part.bindings[1].demand_id, 'satisfied');
  var b3 = commIntentQualify_(b2, b2.bindings[2].demand_id, 'satisfied');
  stAssert_(out, 'intent: the intent closes only when nothing is left open',
            b3.state === 'answered' && b3.open_count === 0, '');
  stAssert_(out, 'intent: qualifying something it never asked about is refused, not absorbed',
            !!commIntentQualify_(intent, 'ana|nothing', 'satisfied').error, '');

  // THE CAP IS SAFE ONLY BECAUSE IT SAYS WHAT IT HELD BACK.
  var many = [];
