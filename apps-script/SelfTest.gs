    var tpPerfect = { composite_score: '12', decision: 'Advance', flags: [], cjis: 'Pass',
                      screen_result: 'Pass', screen_qualification: 'Pass',
                      screen_checks_all: true, years: '5' };
    stEq_(out, 'talent auth: a perfect record scores nota 10 + 0.5 + 0.25', tpRankScore_(tpPerfect), 10.75);
    stEq_(out, 'talent auth: each red flag costs 0.75',
          tpRankScore_({ composite_score: '12', decision: 'Advance', flags: ['short tenure'] }), 9.25);
    stAssert_(out, 'talent auth: Review with zero flags is eligible, Review with a flag is not',
              tpRankEligible_({ decision: 'Review', flags: [] }) &&
              !tpRankEligible_({ decision: 'Review', flags: ['no certs'] }),
              'the borderline case somebody can still say yes to keeps its seat');
    stAssert_(out, 'talent auth: a failed CJIS or a rejected screen is never ranked',
              !tpRankEligible_({ decision: 'Advance', flags: [], cjis: 'Failed' }) &&
              !tpRankEligible_({ decision: 'Advance', flags: [], screen_result: 'Reject' }) &&
              !tpRankEligible_({ decision: 'Reject', flags: [] }),
              'a rank the send can act on must already honor the hard gates');
    // THE LETTER MUST NEVER NAME SOMEBODY ALREADY HIRED — found in the live ranking, with Mandy Radtka standing…
    stAssert_(out, 'talent auth: a legacy status that IS a step never reaches the ask',
              !tpRankEligible_({ decision: 'Advance', flags: [], status: 'Hired' }) &&
              !tpRankEligible_({ decision: 'Advance', flags: [], status: 'Ready' }) &&
              !tpRankEligible_({ decision: 'Advance', flags: [], status: 'Phone Screen' }),
              'the ranking names people to START on; somebody the legacy already walked ' +
              'through the process is work that happened, not a decision to take');
    stAssert_(out, 'talent auth: "Not Hiring" is a verdict, not a step — they stay rankable',
              tpRankEligible_({ decision: 'Advance', flags: [], status: 'Not Hiring' }),
              'since 2026-08-28 they may come in, and a ranking that hid them would ' +
              'contradict the door that accepts them');
    var tpTieA = { composite_score: '9', decision: 'Advance', flags: [], years: '8' };
    var tpTieB = { composite_score: '9', decision: 'Advance', flags: [], years: '2' };
    stAssert_(out, 'talent auth: ties break by years of caregiving',
              tpRank_([tpTieB, tpTieA])[0] === tpTieA,
              'the stated tie-breaker must be the real one');
    var tpSendSrc = stCode_(HUB_ACTIONS.talentAuthorizationSend);
    stAssert_(out, 'talent auth: the ask leaves ONLY through rpcCall_, to the configured leaders',
              tpSendSrc.indexOf('rpcCall_') !== -1 &&
              tpSendSrc.indexOf('hubAlertRecipients_') !== -1 &&
              tpSendSrc.indexOf('@asalifecare.com') === -1,
              'a typed address dodges Settings, test mode and the opt-out door all at once');
    stEq_(out, 'talent auth: the SMS keeps its exact words',
          TP_AUTH_SMS, 'asamylife need help in one decision. thanks and check your email');
    var tpSwSrc = stCode_(tpAuthSweepRun_);
    stAssert_(out, 'talent auth: the sender gate is deterministic and comes BEFORE any AI',
              tpSwSrc.indexOf('hubAlertRecipients_') !== -1 &&
              tpSwSrc.indexOf('hubAlertRecipients_') < tpSwSrc.indexOf('tpAuthReadReply_') &&
              stCode_(tpAuthReadReply_).indexOf('screenAiChat_') !== -1,
              'the model may read only what the three authorized leaders wrote');
    stAssert_(out, 'talent auth: one message costs one model call, ever',
              tpSwSrc.indexOf('aiSeen[mid] !== undefined') !== -1 &&
