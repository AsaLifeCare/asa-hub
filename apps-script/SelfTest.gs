  // ---- the whitelist is pinned ------------------------------------------ mar_entries joined: the eMAR history is…
  var want = ['entity_candidates', 'entity_phone_screens', 'staff_requests',
              'finance_transactions', 'travelTrips', 'mar_entries',
              'app_release_log',
              'projects', 'diseases', 'workOrders', 'drAppointments', 'shifts',
              // the comms lane's houses — the rehearsal and its evidence are read inside the platform
