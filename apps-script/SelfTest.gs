    stEq_(out, 'rendersheet: HUB_DB\'s own copy of a ledger IS a ledger',
          renderSheetLedgerHit_('comm_attempts', hubDbId), 'comm_attempts');
    stEq_(out, 'rendersheet: HUB_DB is judged STRICTLY by name — a "Data" tab inside it is some other tab\'s business',
