    { signal: 'site.verdict', value: 'strained', detail: '19% of the work lands between 10pm and 5am; 13 days in a row' },
    { signal: 'app.hiring', value: '400' }, { signal: 'app.chat', value: '140' },
    { signal: 'shift.count', value: '22' }, { signal: 'shift.days', value: '20' },
    { signal: 'shift.overnights', value: '12' }, { signal: 'shift.longest_run', value: '9' },
    { signal: 'shift.verdict', value: 'strained', detail: '9 days on in a row; 12 of 22 are overnights' },
    { signal: 'habit.forms', value: '17' },
    { signal: 'reach.verdict', value: 'headquarters', detail: 'headquarters only (the platform has 2 place(s))' }
  ];
  var facts = behaviorFactsBlock_(person, signals);
  stAssert_(out, 'behavior: the facts block carries the counted facts, in words',
            facts.indexOf('640 recorded actions') !== -1 && facts.indexOf('8 day(s)') !== -1 &&
            facts.indexOf('12 overnight(s)') !== -1 && facts.indexOf('hiring (400)') !== -1,
            facts.slice(0, 300));
  stAssert_(out, 'behavior: a habit the platform did not record is stated as absent, never as zero-shaped silence',
            behaviorFactsBlock_(person, [{ signal: 'site.actions', value: '5' }])
              .indexOf('Client images: none recorded') !== -1, '');
  stAssert_(out, 'behavior: an account with nothing recorded says exactly that',
            behaviorFactsBlock_(person, [{ signal: 'shift.count', value: '3' }])
              .indexOf('nothing was recorded for this account') !== -1, '');
  stAssert_(out, 'behavior: no id, no e-mail and no client name ever reaches the model',
            facts.indexOf('USR_1') === -1 && facts.indexOf('@') === -1, facts);

  // THE COURSES — the estate's training record, as an analysis parameter
  var trained = signals.concat([
    { signal: 'training.completed', value: '6',
      detail: 'CPR Certification, DODD 8-Hour Training, Medication Administration I' },
    { signal: 'training.valid', value: '4', detail: 'CPR Certification, DODD 8-Hour Training' },
    { signal: 'training.expired', value: '2', detail: 'Medication Administration I' },
    { signal: 'training.verdict', value: 'lapsed', detail: '2 of 6 course(s) past their date' },
    { signal: 'ist.done', value: '9', detail: '4 client plan(s)' },
    { signal: 'ist.owed', value: '3' },
    { signal: 'req.ok', value: '21' }, { signal: 'req.missing', value: '4' },
    { signal: 'req.expiring', value: '1' }, { signal: 'req.expired', value: '2' }
  ]);
  var tf = behaviorFactsBlock_(person, trained);
  stAssert_(out, 'behavior: the model is shown the courses BY NAME, not as a count',
            tf.indexOf('CPR Certification') !== -1 &&
            tf.indexOf('Medication Administration I') !== -1, tf.slice(0, 300));
  stAssert_(out, 'behavior: a lapsed course is stated as a date that passed, and the floor forbids reading it as neglect',
            tf.indexOf('Past its date: Medication Administration I') !== -1 &&
            BEHAVIOR_PROMPT_FLOOR.indexOf('never as neglect') !== -1, tf.slice(0, 400));
  stAssert_(out, 'behavior: the client-specific training travels as counts, never as a client name',
            tf.indexOf('4 client plan(s)') !== -1 && tf.indexOf('3 still owed') !== -1, tf);
  stAssert_(out, 'behavior: the obligation matrix reaches the model as its four counts',
            tf.indexOf('21 met, 4 not yet on file, 1 expiring, 2 expired') !== -1, tf);
  stAssert_(out, 'behavior: a person with no course on file is said to have no RECORD, never to be untrained',
            facts.indexOf('holds no course record') !== -1, facts);
  stAssert_(out, 'behavior: the courses move the hash, so a renewal earns a fresh reading',
            behaviorHash_(tf) !== behaviorHash_(facts), '');

  // THE HASH — a page view must never buy a completion
  var h1 = behaviorHash_(facts), h2 = behaviorHash_(facts);
  stEq_(out, 'behavior: the same facts fingerprint the same', h1, h2);
  stAssert_(out, 'behavior: a changed fact changes the fingerprint',
            behaviorHash_(facts + ' one more action') !== h1, '');

  // THE ANSWER — parsed, never trusted
  var good = behaviorParse_('{"reading":"Ana works late often.","highlights":["12 of 22 shifts are overnights"],"tags":["nights","steady"]}');
  stAssert_(out, 'behavior: a well-formed answer is taken apart',
            !!good && good.reading.indexOf('Ana works late') === 0 &&
            good.highlights.length === 1 && good.tags.length === 2, JSON.stringify(good));
  stEq_(out, 'behavior: prose that is not JSON is refused, never shown as a reading',
        behaviorParse_('Ana seems tired lately.'), null);
  stEq_(out, 'behavior: an answer with no reading is refused', behaviorParse_('{"tags":["x"]}'), null);
  var capped = behaviorParse_('{"reading":"ok","highlights":["a","b","c","d","e"],"tags":["1","2","3","4","5","6"]}');
  stAssert_(out, 'behavior: the lists are capped, so one answer cannot fill a screen',
            capped.highlights.length === 3 && capped.tags.length === 4, JSON.stringify(capped));

  // WHO SEES WHOM — the access law declared in Access control
  stAssert_(out, 'behavior: any signed-in person may read about themselves',
            behaviorMayRead_({ id: 'USR_9', role: 'staff' }) &&
            behaviorMayRead_({ id: 'USR_9', role: 'client' }), 'the app is never closed to a person about themselves');
  stAssert_(out, 'behavior: the machine reads nothing — it files signals and never looks',
            !behaviorMayRead_({ id: 'SVC', role: 'admin', is_service: true }), '');
  stAssert_(out, 'behavior: a session with no account behind it reads nothing',
            !behaviorMayRead_({ role: 'admin' }), '');
  // the scope narrows SILENTLY — a refusal would already have told the caller that the person they asked about…
  stEq_(out, 'behavior: a staff member asking about somebody else is narrowed to themselves',
        behaviorSubjectFor_({ id: 'USR_ME', role: 'staff', types: 'STAFF' }, 'USR_OTHER'), 'USR_ME');
  stEq_(out, 'behavior: and asking about nobody in particular is still themselves',
        behaviorSubjectFor_({ id: 'USR_ME', role: 'staff', types: 'STAFF' }, ''), 'USR_ME');
  stAssert_(out, 'behavior: the scope is CONFIGURATION, read from the access row, not a list in the code',
            stCode_(behaviorSeesAll_).indexOf("'behavior_all_badges'") !== -1 &&
            stCode_(behaviorSeesAll_).indexOf('hubGrantedFeatureOn_') !== -1,
            'Settings → Access control → Features');
  stAssert_(out, 'behavior: the access key ships with the House-Manager ladder and is declared for the screen',
            (function () {
              // Through the catalogue reader, so this asserts the row the Settings screen will really draw — sheet…
              var rows = hiringAlertsCatalogRows_();
              for (var i = 0; i < rows.length; i++) {
                var row = rows[i];
                if (row.key !== 'behavior_all_badges') continue;
                return row.group === 'access' && String(row.value).indexOf('HM') !== -1 &&
                       String(row.value).indexOf('MANAGER') !== -1;
              }
              return false;
            })(), 'the catalogue must carry behavior_all_badges in the access group');
  stAssert_(out, 'behavior: an empty access row means the master alone, never everybody',
            stCode_(hubGrantedFeatureOn_).indexOf('if (!cfg.trim()) return false') !== -1,
            'these rows are about named people — a blank cell may never widen a reach');
  // every door that names a person asks the scope first
  ['behaviorProfile', 'behaviorEvaluate', 'behaviorCortexNote'].forEach(function (name) {
    stAssert_(out, 'behavior: ' + name + ' narrows the subject to the caller when the badge is absent',
              stCode_(HUB_ACTIONS[name]).indexOf('behaviorSubjectFor_(user') !== -1, name);
  });
  ['behaviorBoard', 'behaviorReadings'].forEach(function (name) {
    var src = stCode_(HUB_ACTIONS[name]);
    stAssert_(out, 'behavior: ' + name + ' answers with one row for a person who may only see themselves',
              src.indexOf('behaviorSeesAll_(user)') !== -1 && src.indexOf('own') !== -1 &&
              src.indexOf('all ||') + src.indexOf('!all &&') > -2, name);
  });

  // BOTH ANSWERS ARE HELD until the person asks again
  var noteSrc = stCode_(HUB_ACTIONS.behaviorCortexNote);
  stAssert_(out, 'behavior: what the cortex said is written down, with the moment it was asked',
            noteSrc.indexOf('cortex_note: note') !== -1 && noteSrc.indexOf('cortex_at: now') !== -1, '');
  stAssert_(out, 'behavior: it is kept even when no reading has been composed yet',
            noteSrc.indexOf('if (!exists)') !== -1 && noteSrc.indexOf('404') === -1, '');
  stAssert_(out, 'behavior: a new reading never erases what the cortex said',
            stCode_(behaviorCompose_).indexOf('cortex_note: behaviorStr_(stored ? stored.cortex_note') !== -1, '');
  stAssert_(out, 'behavior: the readings house carries the cortex column',
            BEHAVIOR_READINGS_HEADER.indexOf('cortex_note') !== -1 &&
            BEHAVIOR_READINGS_HEADER.indexOf('cortex_at') !== -1, '');

  // THE DOORS, by their source
  var ing = stCode_(HUB_ACTIONS.behaviorSignalsIngest);
  stAssert_(out, 'behavior: the ingest door admits the machine and the admin, nobody else',
            ing.indexOf('user.is_service') !== -1 && ing.indexOf("!== 'admin'") !== -1, '');
  stAssert_(out, 'behavior: the ingest door refuses an empty list', ing.indexOf('!rows.length') !== -1, '');
  stAssert_(out, 'behavior: a signal without a subject and a name is not a signal',
            ing.indexOf('!id || !key || !sig') !== -1, '');
  var upsert = stCode_(behaviorUpsert_);
  stAssert_(out, 'behavior: the houses are never emptied — upsert and append, never delete',
            upsert.indexOf('deleteRow') === -1 && upsert.indexOf('.clear(') === -1 &&
            upsert.indexOf('clearContent') === -1, '');
  var compose = stCode_(behaviorCompose_);
  stAssert_(out, 'behavior: the reading is bought only when the facts moved',
            compose.indexOf('stored.signals_hash === hash') !== -1 && compose.indexOf('opts.refresh') !== -1, '');
  stAssert_(out, 'behavior: a dead model returns the LAST reading, never nothing and never an invention',
            compose.indexOf("stored.state = 'stale'") !== -1 && compose.indexOf('last reading') !== -1, '');
  // THE SECOND-DOOR RULE, for this feature
  var src = stCode_(behaviorCompose_) + stCode_(HUB_ACTIONS.behaviorEvaluate);
  stAssert_(out, 'behavior: it asks Groq through the ONE door and names no provider itself',
            src.indexOf('screenAiChat_') !== -1 && src.indexOf('api.openai.com') === -1 &&
            src.indexOf('api.groq.com') === -1 && src.indexOf('API_KEY') === -1,
            'groq goes through our own rotation');
  stAssert_(out, 'behavior: the prompt lives in the book, with a floor in code',
            compose.indexOf("bookText_('Prompts'") !== -1 && compose.indexOf('BEHAVIOR_PROMPT_FLOOR') !== -1, '');
  stAssert_(out, 'behavior: the shipped prompt forbids invention, ranking and a performance score',
            BEHAVIOR_PROMPT_FLOOR.indexOf('Never invent') !== -1 &&
            BEHAVIOR_PROMPT_FLOOR.indexOf('never rank them') !== -1 &&
            BEHAVIOR_PROMPT_FLOOR.indexOf('never a performance score') !== -1, '');
  stAssert_(out, 'behavior: the machine write is named in every list',
            SERVICE_SWEEP_ACTIONS.indexOf('behaviorSignalsIngest') !== -1 &&
            GUARDIAN_RELAY_CLOCK_ACTIONS.indexOf('behaviorSignalsIngest') !== -1,
            'ServiceIdentity.gs and Guardian.gs');
  stAssert_(out, 'behavior: the sweep stamp is a runtime key',
            scriptPropIsRuntime_('BEHAVIOR_SWEEP_AT'),
            'a stamp not on SCRIPT_PROP_RUNTIME freezes');
  stAssert_(out, 'behavior: the tabs are made through the one door, never by hand',
            stCode_(behaviorSignalsSheet_).indexOf('hubTabEnsure_') !== -1 &&
            stCode_(behaviorReadingsSheet_).indexOf('hubTabEnsure_') !== -1, '');
}

// A GRID THE UPSERT CAN BE RUN AGAINST, HERE, WITH NO SPREADSHEET.
function stCommProposalsGrid_() {
  return {
    writes: 0,
    rows: 1,
    getLastRow: function () { return this.rows; },
    getMaxRows: function () { return this.rows + 100; },
    insertRowsAfter: function () {},
    getRange: function () {
      var sheet = this;
      return {
        setNumberFormat: function () { return this; },
        setValues: function () { sheet.writes++; return this; }
      };
    }
  };
}

// One counted proposal as the relay shapes it.
function stCommProposalsRow_(over) {
  var row = {
    id: 'CP_quit_texting_me', created_at: '2020-01-01T00:00:00Z', status: 'proposed',
    vocabularies_allowed: 'opt_out_phrases, wrong_number_phrases, availability_phrases',
    phrase: 'quit texting me', tokens: '3', family: 'short:quit', shape: 'short',
    evidence_n: '7', people_n: '4', coverage: '0.86',
    leak_control: '0', leak_contains: '0', would_catch: '7', would_catch_wrongly: '0',
    verdict: 'clean', why: 'no message the machine read correctly carries it',
    merged_list: 'stop, cancel, quit texting me', shipped_intact: 'yes',
    example: '', example_ref: 'comm_contributions:m1,m2', example_withheld: '2 of 7 members not shown',
    corpus_n: '61', control_n: '210', notes: 'the release list is not offered'
  };
  Object.keys(over || {}).forEach(function (k) { row[k] = over[k]; });
  return row;
}

// COMM PROPOSALS (CommProposals.gs) — the third door, the machine's.
function stCommProposals_(out) {
  /* ── THE RELEASE LIST, AT ANY EVIDENCE LEVEL ─────────────────────────── */
  var release = stCommProposalsRow_({
    vocabularies_allowed: 'opt_out_phrases, opt_in_phrases',
    evidence_n: '99', people_n: '40', coverage: '1.0', leak_control: '0', leak_contains: '0'
  });
  stEq_(out, 'proposals: the release list is seen for what it is',
        commProposalsOffersRelease_(release), 'opt_in_phrases');
  stAssert_(out, 'proposals: a row offering the release list is refused however good its evidence',
            commProposalsFeedRefusal_(release) !== '' &&
            commProposalsIngestClean_(release) === null,
            'approving a way to say "start" un-silences somebody who asked to be left alone, and ' +
            'the mistake arrives as a message already sent — no count may buy it');

  /* ── A DECISION IS A PERSON'S ────────────────────────────────────────── */
  stAssert_(out, 'proposals: a machine may not file a decision',
            commProposalsFeedRefusal_(stCommProposalsRow_({ status: 'approved' })) !== '' &&
            commProposalsFeedRefusal_(stCommProposalsRow_({ status: 'rejected' })) !== '' &&
            commProposalsFeedRefusal_(stCommProposalsRow_({ status: 'proposed' })) === '' &&
            commProposalsFeedRefusal_(stCommProposalsRow_({ status: 'blocked' })) === '',
            'a counter that could write "approved" could approve its own proposal');
  stAssert_(out, 'proposals: a phrase the lane could never match is not filed',
            commProposalsFeedRefusal_(stCommProposalsRow_({ phrase: 'i am able to start on wednesday' })) !== '' &&
            commProposalsFeedRefusal_(stCommProposalsRow_({ phrase: '' })) !== '',
            'optOutIntent_ compares WHOLE bodies: a five-word entry could not fire, and filing ' +
            'it would look like teaching while teaching nothing');

  /* ── MISSING IS NOT ZERO ─────────────────────────────────────────────── */
  var thin = commProposalsIngestClean_(stCommProposalsRow_({ leak_control: '', would_catch_wrongly: null }));
  stEq_(out, 'proposals: an unmeasured leak stays empty, never 0', thin.leak_control, '');
  stEq_(out, 'proposals: an unmeasured catch stays empty, never 0', thin.would_catch_wrongly, '');
  stEq_(out, 'proposals: a measured zero survives as zero',
        commProposalsIngestClean_(stCommProposalsRow_()).leak_control, '0');

  /* ── THE WORDS TRAVEL ONLY WHERE THE COUNTER ALREADY ALLOWED THEM ────── */
  var pointed = commProposalsIngestClean_(stCommProposalsRow_());
  stEq_(out, 'proposals: an example the counter withheld is not rebuilt from its pointer',
        pointed.example, '');
  stAssert_(out, 'proposals: the pointer to where the words live still travels',
            pointed.example_ref.indexOf('comm_contributions') === 0 && !!pointed.example_withheld,
            'a person with the access reads the reply where it lives; the words do not move');

  /* ── IDEMPOTENT OR IT IS BROKEN — the real upsert, run twice ─────────── */
  var header = COMM_PROPOSALS_COLUMNS.slice();
  var values = [header.slice()];
  var first = stCommProposalsGrid_();
  var item = commProposalsIngestClean_(stCommProposalsRow_());
  var pass1 = commProposalsUpsert_(first, [item], header, values);
  stAssert_(out, 'proposals: a proposal nobody has filed is appended once',
            pass1.inserted === 1 && pass1.updated === 0 && pass1.writes === 1 && first.writes === 1,
            'got ' + JSON.stringify({ i: pass1.inserted, u: pass1.updated, w: pass1.writes }));

  // the grid as the house now holds it, which is what the next pass re-reads
  var landed = values.concat(pass1.appended);
  var second = stCommProposalsGrid_();
  // the counter re-mints created_at on EVERY run — the shape of the trap
  var again = commProposalsIngestClean_(stCommProposalsRow_({ created_at: '2020-06-06T06:06:06Z' }));
  var pass2 = commProposalsUpsert_(second, [again], header, landed);
  stAssert_(out, 'proposals: a second pass over the same material writes ZERO cells',
            pass2.unchanged === 1 && pass2.inserted === 0 && pass2.updated === 0 &&
            pass2.writes === 0 && second.writes === 0,
            'the counter re-mints the same id and a fresh created_at every day; a lane that ' +
            'patched it would rewrite the whole house every morning and call it an update');
  stEq_(out, 'proposals: the day a proposal was first raised is not rewritten',
        String(landed[1][header.indexOf('created_at')]), '2020-01-01T00:00:00Z');

  /* ── A PERSON'S ANSWER OUTRANKS THE COUNTER'S ────────────────────────── */
  var decided = values.concat(pass1.appended.map(function (line) { return line.slice(); }));
  decided[1][header.indexOf('status')] = 'approved';
  decided[1][header.indexOf('decided_by')] = 'somebody@asalifecare.com';
  var third = stCommProposalsGrid_();
  var pass3 = commProposalsUpsert_(third, [commProposalsIngestClean_(stCommProposalsRow_())], header, decided);
  stAssert_(out, 'proposals: the counter does not un-answer a person',
            pass3.kept_decision === 1 && pass3.updated === 0 && pass3.writes === 0 &&
            String(decided[1][header.indexOf('status')]) === 'approved' &&
            String(decided[1][header.indexOf('decided_by')]) === 'somebody@asalifecare.com',
            'the same id is re-minted from the same phrase every day — without this, yesterday\'s ' +
            'approval reads "proposed" again tomorrow');

  /* ── WHAT A MACHINE MAY NOT WRITE AT ALL ─────────────────────────────── */
  var forged = stCommProposalsRow_();
  forged.decided_by = 'the relay';
  forged.decided_at = '2020-01-01T00:00:00Z';
  var clean = commProposalsIngestClean_(forged);
  stAssert_(out, 'proposals: a person\'s columns are not even shaped by the machine\'s door',
            clean.decided_by === undefined && clean.decided_at === undefined, '');
  var fourth = stCommProposalsGrid_();
  var blank = [header.slice()];
  var pass4 = commProposalsUpsert_(fourth, [
    { id: 'CP_forged', status: 'proposed', decided_by: 'the relay', decided_at: 'now' }
  ], header, blank);
  stAssert_(out, 'proposals: even a payload that names them cannot write them',
            pass4.inserted === 1 &&
            String(pass4.appended[0][header.indexOf('decided_by')]) === '' &&
            String(pass4.appended[0][header.indexOf('decided_at')]) === '', '');

  /* ── THE LINE ───────────────────────────────────────────────────────── */
  stEq_(out, 'proposals: a reply\'s words are refused by name at the door',
        JSON.stringify(commProposalsCrossed_([{ id: 'CP_x', body: 'please stop', person_name: 'somebody' }])),
        JSON.stringify(['body', 'person_name']));
  stEq_(out, 'proposals: what the counter is allowed to show is not on that list',
        JSON.stringify(commProposalsCrossed_([stCommProposalsRow_()])), JSON.stringify([]));

  /* ── ONE DOOR, ONE TAB, AND NOTHING NEAR THE VOCABULARY ──────────────── */
  var ingestSrc = stCode_(HUB_ACTIONS.commProposalsIngest);
  stAssert_(out, 'proposals: the machine\'s door writes the proposals house and nothing else',
            ingestSrc.indexOf('COMM_PROPOSALS_TAB') !== -1 &&
            ingestSrc.indexOf('COMM_VOCAB_TAB') === -1 &&
            ingestSrc.indexOf('hubAppendRow_') === -1 &&
            ingestSrc.indexOf('hubPropSet_') === -1 &&
            stCode_(commProposalsUpsert_).indexOf('COMM_VOCAB_TAB') === -1,
            'the configured stop-word cell REPLACES the shipped list when it is non-empty — a ' +
            'machine that could reach it could delete "stop" from the platform in one write');
  stAssert_(out, 'proposals: a person\'s decision is still the only thing that reaches the vocabulary',
            stCode_(HUB_ACTIONS.commProposalsDecide).indexOf('hubAppendRow_(COMM_VOCAB_TAB') !== -1, '');
  stAssert_(out, 'proposals: the house is opened through the one door and only when declared',
            stRoutes_(commProposalsSheet_) && ingestSrc.indexOf('commProposalsHouseId_') !== -1,
            'a house nobody declared must refuse, never be re-created beside itself');

  /* ── NAMED WHERE NAMES ARE KEPT ──────────────────────────────────────── */
  stAssert_(out, 'proposals: the machine write is named in every list',
            SERVICE_SWEEP_ACTIONS.indexOf('commProposalsIngest') !== -1 &&
            GUARDIAN_RELAY_DAILY_ACTIONS.indexOf('commProposalsIngest') !== -1 &&
            guardianCallerlessSweeps_().indexOf('commProposalsIngest') === -1,
            'ServiceIdentity.gs or it answers 403; Guardian.gs or it reads as a sweep with no caller');
  stAssert_(out, 'proposals: the daily lane keeps its own list, apart from the hourly ones',
            GUARDIAN_RELAY_CLOCK_ACTIONS.indexOf('commProposalsIngest') === -1 &&
            GUARDIAN_RELAY_DAILY_ACTIONS.length === 1,
            'an hourly name is late after two hours and a daily one is not — one list, one answer ' +
            'to "how long is too long"');
}

// ------------------------------------------------------------------ COMM CALLS — the clear side may carry facts…
function stCommCalls_(out) {
