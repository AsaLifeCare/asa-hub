  stAssert_(out, 'settles: a write that fails says so',
            stCode_(digestSettleSweep_).indexOf('digest_settle_write_failed') !== -1,
            'the first live settlement handed its receipt in and then failed to record it ' +
            'on the row, and the swallowed exception left the ledger disagreeing with ' +
            'staff_clearance where nobody could see it');
  stAssert_(out, 'digest: a clip is filed like any other document',
            stCode_(digestOne_).indexOf("digestRouteFile_(fileId, 'media'") !== -1,
            'the media branch decided a verdict and returned without ever calling the ' +
            'filer, so every video stayed loose in the intake folder for good while the ' +
            'papers around it were catalogued');
  stAssert_(out, 'digest: the cleaner walks the folder the files land in',
            (function () {
              return typeof digestIntakeFolder_ === 'function' &&
                     stCode_(digestIntakeFolder_).indexOf('documents_folder') !== -1 &&
                     stCode_(digestTidyMaybe_).indexOf('digestUnnestMaybe_(intake') !== -1 &&
                     /* it must never MAKE the intake folder — the store does that */
                     stCode_(digestIntakeFolder_).indexOf('createFolder') === -1;
            })(),
            'the store resolved the intake folder from the words book and the cleaner ' +
            'resolved its PARENT, so it spent the day walking past asa-documents, ' +
            'Database and document-drop and reporting success');
  stAssert_(out, 'digest: nested shelves are emptied from the INSIDE OUT',
            (function () {
              var c = stCode_(digestUnnestInto_);
              // depth-first: the recursive call must come BEFORE the emptiness test, or an inner shell keeps its…
              var rec = c.indexOf('digestUnnestInto_(home, shells[i]');
              var test = c.indexOf('!shells[i].getFiles().hasNext()');
              return rec !== -1 && test !== -1 && rec < test &&
                     stCode_(digestUnnestMaybe_).indexOf('digestUnnestInto_') !== -1;
            })(),
            'the cleaner walked one level and the mess was three — it reached the middle ' +
            'shell, refused to trash a folder with something inside it, and never visited ' +
            'the thing inside: timesheet/timesheet/timesheet, for ever');
  stAssert_(out, 'digest: a drained ledger still does its housekeeping',
            (function () {
              var c = stCode_(digestSweepMaybe_);
              return c.indexOf('if (!pend.length) continue;') === -1 &&
                     c.indexOf('var willDecode = pend.length > 0') !== -1 &&
                     c.indexOf('willDecode && n < pend.length') !== -1;
            })(),
            'the sweep used to skip compaction, the folder tidy, the stalled check and ' +
            'the late settlements whenever a ledger had nothing to decode — invisible ' +
            'for as long as a file was always waiting, and total the moment one drained');
  stAssert_(out, 'settles: turning the key reaches papers already in the building',
            typeof digestSettleSweep_ === 'function' &&
            stCode_(digestSettleSweep_).indexOf('digestSettle_(led') !== -1 &&
            stCode_(digestSettleSweep_).indexOf("was.candidate !== 'owed' && was.staff !== 'owed'") !== -1 &&
            stCode_(digestSweepMaybe_).indexOf('digestSettleSweep_') !== -1,
            'the dial is a decision that arrives after the reading — without this it ' +
            'would only ever govern uploads that had not happened yet, and it re-runs ' +
            'the SAME gates so it is not a looser second path into a checklist');

  // THE ESTATE GATE.
  stAssert_(out, 'estate: an unreviewed expiry never becomes accepted fact',
            (function () {
              var c = stCode_(HUB_ACTIONS.employeeDbFill);
              return c.indexOf('empdbDateAllowed_') !== -1 &&
                     c.indexOf("d.status === 'verified' || d.review_status === 'verified'") !== -1 &&
                     c.indexOf("(d.status !== 'uploaded' && d.status !== 'verified')") === -1;
            })(),
            'an expiry is a reading of a page that governs compliance — it waits for ' +
            'a human, or graduation quietly turns OCR into canonical truth');
  stAssert_(out, 'estate: a PRESENCE flag still trusts the upload',
            (function () {
              var c = stCode_(HUB_ACTIONS.employeeDbFill);
              return c.indexOf('empdbHasIt_(hs)') !== -1 &&
                     c.indexOf('empdbHasIt_(dl)') !== -1 &&
                     c.indexOf('empdbHasIt_(ss)') !== -1;
            })(),
            '"this person has a diploma" is exactly what an arriving file proves — ' +
            'gating presence on review would be a different, wrong law');
  stAssert_(out, 'estate: nothing is withheld in silence',
            (function () {
              var c = stCode_(HUB_ACTIONS.employeeDbFill);
              return c.indexOf('waiting_on_review: withheld') !== -1 &&
                     c.indexOf('employee_db_withheld') !== -1;
            })(),
            'an empty cell with no story is how a gate becomes a bug report six ' +
            'months later — every held date is named in the response and the log');
  stAssert_(out, 'settles: the receipt names the file that SURVIVES compaction',
            stCode_(digestOne_).indexOf('var liveId = zipped ? zipped.file_id : fileId') !== -1 &&
            stCode_(digestOne_).indexOf('file_id: liveId') !== -1,
            'compaction trashes the original and mints a new id — an evidence pointer ' +
            'must not depend on a row of the zip list staying the way it is');
  stAssert_(out, 'answers: a typed name walks the SAME door a printed one walks',
            (function () {
              var c = stCode_(digestOne_);
              var at = c.indexOf('merged.fill.person');
              if (at === -1) return false;
              var after = c.slice(at, at + 900);
              return after.indexOf('digestWhoIs_(merged.fill.person') !== -1 &&
                     after.indexOf("'answer+roster'") !== -1 &&
                     after.indexOf('if (!who)') !== -1;   // the paper keeps its anchor
            })(),
            'a typed name filled the person cell with WORDS and stopped — it never ' +
            'became an id, so a card the OCR could not read was unreachable even when ' +
            'the sender had typed exactly whose it was');
  stAssert_(out, 'answers: the sender never raises the platform\'s certainty about itself',
            (function () {
              // an id earns its usual points; the CORROBORATION bonus stays for the roster, the ledger and the page…
              var c = stCode_(digestConfidence_);
              return c.indexOf("f.person_source === 'roster'") !== -1 &&
                     c.indexOf("'answer+roster'") === -1;
            })(),
            'the sender controls the filename and the typed name both — letting a claim ' +
            'add confidence would let one person settle another person\'s obligation');
  stAssert_(out, 'settles: a name is enough to INDEX a file, never to settle a debt',
            stCode_(digestSettle_).indexOf('!reach.peopleId && !reach.candidateId') !== -1 &&
            stCode_(digestSettle_).indexOf('does not know this person by id') !== -1,
            'the first live run printed "Test Person" on a card, the overlay honestly ' +
            'answered owed, and a receipt would have been filed against a human who ' +
            'does not exist — the roster or the users bridge has to have said so');
  stAssert_(out, 'settles: two accounts for one name is SILENCE',
            stCode_(digestReach_).indexOf('hits.length === 1') !== -1 &&
            stCode_(digestReach_).indexOf('two accounts bridge to this name') !== -1,
            'an obligation settled against the wrong person is worse than one left open');
  stAssert_(out, 'settles: it arrives switched off',
            stCode_(digestSettle_).indexOf("digestSetting_('distribute', 'record')") !== -1 &&
            stCode_(digestSettle_).indexOf("mode !== 'write'") !== -1 &&
            stCode_(digestSettle_).indexOf("distribute_confidence") !== -1,
            'the resting state works everything out and writes it on the row only — a ' +
            'few get read before the key is turned');
  stAssert_(out, 'settles: silence is never the answer',
            stCode_(digestSettle_).indexOf('out.why') !== -1 &&
            stCode_(digestOne_).indexOf('settles:') !== -1,
            'this is the one step whose silence would be indistinguishable from a bug — ' +
            'every row says what it settled or why it settled nothing');

  stAssert_(out, 'digest: "saw nothing" is a verdict with an author',
            (function () {
              var c = stCode_(digestOne_);
              return c.indexOf("digest_state: 'empty'") !== -1 &&
                     c.indexOf('note: \'extraction ran and saw nothing\'') !== -1 &&
                     /empty[\s\S]{0,400}v: DIGEST_VERSION/.test(c);
            })() &&
            stCode_(digestSweepMaybe_).indexOf("state === 'empty'") !== -1,
            'an image-only certificate came back blank and the second OCR path was ' +
            'built for exactly it — an empty row that names no decoder can never be ' +
            'reconsidered, and the fix cannot reach the file that caused it');
  stAssert_(out, 'digest: a decoder that learned something can go back',
            stCode_(digestWantsRetry_).indexOf('reread_before_version') !== -1 &&
            stCode_(digestWantsRetry_).indexOf('<= DIGEST_VERSION') !== -1,
            'a CPR card sat at confidence 93 with the COMPANY as its person, and the ' +
            'rule that keeps the platform cheap made it permanent — the dial is in the ' +
            'book, clamped to the version actually running so it can never loop');

  stAssert_(out, 'form files: the SESSION door HAS a policy row, roles from its context',
            !!HUB_POLICY.formFileStore &&
            HUB_POLICY.formFileStore.lane === 'tool' &&
            JSON.stringify(HUB_POLICY.formFileStore.roles) ===
              JSON.stringify(FORM_UPLOAD_CONTEXTS.forms.roles),
            'the public door is gated by the link token; the in-app door is gated by the ' +
            'resolver AND re-checked against the context registry inside the handler');
  stAssert_(out, 'form files: both doors walk one store core',
            stCode_(formPublicFileStorePub_).indexOf('formFileStoreCore_') !== -1 &&
            stCode_(HUB_ACTIONS.formFileStore).indexOf('formFileStoreCore_') !== -1,
            'two copies of the cap/allow-list is how they drift apart');
  stAssert_(out, 'forms import: a FILE_UPLOAD question imports as the file kind',
            stCode_(formImportAppItems_).indexOf("one.type = 'file'") !== -1 &&
            stCode_(formImportPublicFetch_).indexOf("13: 'file'") !== -1,
            'skipped-and-named was right when the Hub had no upload lane; it has one now');
}

// ------------------------------------------------------------------ Forms import — the mapper RUN, not read…
function stFormsImportRuntime_(out) {
  if (typeof formImportAppItems_ !== 'function') {
    stAssert_(out, 'forms mapper: formImportAppItems_ exists', false,
              'Forms.gs missing the editor-lane flattener');
    return;
  }
  var req = function () { return true; };
  var opt = function () { return false; };
  var choices = function (names) {
    return names.map(function (n) { return { getValue: function () { return n; } }; });
  };
  var item = function (type, title, help, typed) {
    var it = { getType: function () { return type; },
               getTitle: function () { return title; },
               getHelpText: function () { return help || ''; } };
    for (var k in typed) it[k] = typed[k];
    return it;
  };
  var fake = { getItems: function () { return [
    item('TEXT', 'Your name', 'as on the badge', {
      asTextItem: function () { return { isRequired: req }; } }),
    item('PARAGRAPH_TEXT', 'Tell us more', '', {
      asParagraphTextItem: function () { return { isRequired: opt }; } }),
    item('MULTIPLE_CHOICE', 'Coming?', '', {
      asMultipleChoiceItem: function () { return { isRequired: req,
        getChoices: function () { return choices(['Yes', 'No', '']); } }; } }),
    item('LIST', 'Shirt colour', '', {
      asListItem: function () { return { isRequired: opt,
        getChoices: function () { return choices(['Red', 'Green', 'Blue']); } }; } }),
    item('CHECKBOX', 'Days you can work', '', {
      asCheckboxItem: function () { return { isRequired: req,
        getChoices: function () { return choices(['Sat', 'Sun']); } }; } }),
    item('SCALE', 'How was it', '', {
      asScaleItem: function () { return { isRequired: opt,
        getLowerBound: function () { return 1; },
        getUpperBound: function () { return 5; },
        getLeftLabel: function () { return 'Poor'; },
        getRightLabel: function () { return 'Excellent'; } }; } }),
    item('RATING', 'Stars', '', {
      asRatingItem: function () { return { isRequired: opt,
        getRatingScaleLevel: function () { return 7; } }; } }),
    item('DATE', 'Start date', '', {
      asDateItem: function () { return { isRequired: req }; } }),
    item('TIME', 'Best time', '', {
      asTimeItem: function () { return { isRequired: opt }; } }),
    item('GRID', 'Team skills', 'one per row', {
      asGridItem: function () { return { isRequired: req,
        getRows: function () { return ['Alice', 'Bob']; },
        getColumns: function () { return ['Low', 'Mid', 'High']; } }; } }),
    item('CHECKBOX_GRID', 'Availability', '', {
      asCheckboxGridItem: function () { return { isRequired: opt,
        getRows: function () { return ['Mon', 'Tue']; },
        getColumns: function () { return ['AM', 'PM']; } }; } }),
    item('SECTION_HEADER', 'Part two', 'read carefully', {}),
    item('PAGE_BREAK', '', '', {}),
    item('IMAGE', 'A photo', '', {}),
    item('FILE_UPLOAD', 'Your CV', '', {}),
    item('DATETIME', 'Pickup', '', {}),
    item('DURATION', 'How long', '', {})
  ]; } };

  var got = formImportAppItems_(fake);

  stEq_(out, 'forms mapper: 17 typed items flatten to 19 entries (grids widen, nothing vanishes)',
        got.length, 19);
  var kept = got.filter(function (o) {
    return !o.skip && o.type !== 'furniture' && o.type !== 'heading';
  });
  var headings = got.filter(function (o) { return o.type === 'heading'; });
  var furniture = got.filter(function (o) { return o.type === 'furniture'; });
  var skippedNames = got.filter(function (o) { return !!o.skip; })
                        .map(function (o) { return o.skip; });
  stEq_(out, 'forms mapper: 14 questions kept (file joined, 2026-09-08)', kept.length, 14);
  stEq_(out, 'forms mapper: sections become headings, both of them', headings.length, 2);
  stEq_(out, 'forms mapper: an image passes as furniture', furniture.length, 1);
  stEq_(out, 'forms mapper: exactly the two unmappable kinds are named',
        JSON.stringify(skippedNames),
        JSON.stringify(['date and time', 'duration']));

  stAssert_(out, 'forms mapper: TEXT — required arrives through asTextItem, help kept',
            got[0].type === 'text' && got[0].required === true &&
            got[0].help === 'as on the badge' && got[0].label === 'Your name',
            JSON.stringify(got[0]));
  stAssert_(out, 'forms mapper: PARAGRAPH_TEXT is long, optional',
            got[1].type === 'long' && got[1].required === false,
            JSON.stringify(got[1]));
  stAssert_(out, 'forms mapper: MULTIPLE_CHOICE keeps its options and drops an empty choice',
            got[2].type === 'choice' && got[2].required === true &&
            JSON.stringify(got[2].options) === '["Yes","No"]',
            JSON.stringify(got[2]));
  stAssert_(out, 'forms mapper: LIST (the dropdown) answers through asListItem',
            got[3].type === 'choice' &&
            JSON.stringify(got[3].options) === '["Red","Green","Blue"]',
            JSON.stringify(got[3]));
  stAssert_(out, 'forms mapper: CHECKBOX is multi with its options',
            got[4].type === 'multi' && got[4].required === true &&
            JSON.stringify(got[4].options) === '["Sat","Sun"]',
            JSON.stringify(got[4]));
  stAssert_(out, 'forms mapper: SCALE 1..5 keeps its values AND its anchor words',
            got[5].type === 'scale' &&
            JSON.stringify(got[5].options) === '["1","2","3","4","5"]' &&
            got[5].left === 'Poor' && got[5].right === 'Excellent',
            JSON.stringify(got[5]));
  stAssert_(out, 'forms mapper: RATING asks its level — 7 stars, not the default 5',
            got[6].type === 'scale' &&
            JSON.stringify(got[6].options) === '["1","2","3","4","5","6","7"]',
            JSON.stringify(got[6]));
  stAssert_(out, 'forms mapper: DATE and TIME keep their kinds and their required flags',
            got[7].type === 'date' && got[7].required === true &&
            got[8].type === 'time' && got[8].required === false,
            JSON.stringify([got[7], got[8]]));
  stAssert_(out, 'forms mapper: GRID — one LIKERT row per row, labeled "Title — Row"',
