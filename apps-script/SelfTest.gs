            })(),
            'FORM_FIELD_KINDS is derived from FORM_KINDS — a kind without an entry cannot be drawn, stored or validated');
  stAssert_(out, 'form kinds: the submit loop dispatches, it does not enumerate',
            stCode_(formPublicSubmitPub_).indexOf('spec.answer') !== -1 &&
            stCode_(formPublicSubmitPub_).indexOf("=== 'file'") === -1,
            'a composite kind shapes its own answer through the registry — one more else-if is how the engine rots');
  stAssert_(out, 'form files: the public store door has NO policy row',
            !HUB_POLICY.formPublicFileStore &&
            typeof formPublicFileStorePub_ === 'function',
