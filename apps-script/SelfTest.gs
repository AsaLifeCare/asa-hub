    // THE ENTRY DOOR MOVED HOUSES — the entrance that used to be in another app is in this one now, and it feeds…
    var addSrc = stCode_(HUB_ACTIONS.talentPipelineAdd);
    stAssert_(out, 'pipeline add: the identity floor is THE one, not a copy of it',
              addSrc.indexOf('hubIntakeIdentityCheck_') !== -1,
