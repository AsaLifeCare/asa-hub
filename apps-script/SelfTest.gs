  stAssert_(out, 'settles: the decoder hands in a receipt, never a verdict',
            (function () {
              var c = stCode_(digestSettle_);
              return c.indexOf("status: 'uploaded'") !== -1 &&
                     c.indexOf("review_status: 'pending'") !== -1 &&
                     c.indexOf("verified") !== -1 &&
                     c.indexOf("verified_by: ''") !== -1 &&
                     stCode_(clearanceRecordUpload_).indexOf("'submitted'") !== -1;
            })(),
            'a file arriving is not a human checking it — three tables in this platform ' +
            'keep those apart on purpose and the decoder does not get to fuse them');
  stAssert_(out, 'settles: no new table, and never the estate',
            (function () {
              var c = stCode_(digestSettle_);
              return c.indexOf('hubAppendRow_(DOCS_TAB') !== -1 &&
                     c.indexOf('clearanceRecordUpload_(') !== -1 &&
                     c.indexOf('emp360WriteCell_') === -1 &&
                     c.indexOf('hubTabEnsure_') === -1;
            })(),
            'candidate_documents and staff_clearance already do this — the estate Master ' +
            'has exactly one writer and it is not a sweep');
  stAssert_(out, 'digest: a row is CLAIMED before it is read',
            (function () {
              // two lanes poll for `pending`; whoever writes `working` first owns the file, and the word is written…
              return stCode_(formFileAnswer_).indexOf("digest_state: 'working'") !== -1 &&
                     stCode_(digestStuckMaybe_).indexOf("stState !== 'working'") !== -1;
            })(),
            'the row is born pending and the other lane polls for exactly that word — ' +
            'between the row being written and the decode finishing, both lanes could ' +
            'take the same file: two OCR bills and two hands moving one file');
  stAssert_(out, 'digest: the file is read when it ARRIVES, not when a clock says so',
            (function () {
              var c = stCode_(formFileAnswer_);
              return c.indexOf('digestOne_(fresh, led)') !== -1 &&
                     c.indexOf('> 25000') !== -1 &&      // budgeted: somebody is waiting
                     // the engine takes ONE and the second lane takes the rest — a dial, because how many is a…
                     c.indexOf("digestSetting_('arrival_files', 1") !== -1;
            })(),
            'a card that landed twenty-four seconds after a sweep waited seven minutes ' +
            'for a decode that takes two — the sweep was never the mechanism, only the ' +
            'safety net, and the work arriving is what starts the work');

  /* SIX LISTS THAT GREW OUT OF THE CODE. */
  stAssert_(out, 'book: one door reads the words book for everybody',
            typeof hubBookRows_ === 'function' && typeof hubBookList_ === 'function' &&
            typeof hubBookMerge_ === 'function' && typeof hubBookText_ === 'function' &&
            stCode_(hubBookRows_).indexOf('HUB_GENERIC_CONFIG_ID') !== -1,
            'the decoder proved the pattern on 09-09 — every list that grows belongs ' +
            'in a row somebody can edit, not in a deploy');
  stAssert_(out, 'book: the code keeps the FLOOR',
            (function () {
              /* an unreadable book is never an empty vocabulary */
              return contactsStatusVocab_().length > 0 &&
                     contactsRoleVocab_().length > 0 &&
                     contactsInstitutional_().length > 0 &&
                     smartMailboxEvents_().length > 0 &&
                     smartAiRequests_().length > 0 &&
                     smartExtraSituations_().length > 0 &&
                     !!smartGeneric_().sms_text && !!smartDoddSms_();
