            'was reverted: the header carries the words and nothing else does');
  stAssert_(out, 'forms import: one source, one row — never a "-2" twin',
            stCode_(HUB_ACTIONS.formImportGoogle).indexOf('formBySourceUrl_') !== -1 &&
            stCode_(HUB_ACTIONS.formImportGoogle).indexOf('getScriptLock') !== -1,
            'a doubled send raced past the slug check and minted duplicates ' +
