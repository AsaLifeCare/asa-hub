                                                    { role: 'admin', email: 'e' });
              return c.status === 403 && a.status === 403 &&
                     str_(c.message).indexOf(t + ' is a ledger') === 0 &&
                     str_(a.message).indexOf(t + ' is a ledger') === 0;
            }),
            'a hand-typed row silences a real reminder forever, and nothing audits it');

  // ---- WHICH ledger, and WHOSE (review) --------------------- The guard used to convict on a name.
  var hubDbId = '';
  try { hubDbId = str_(hubId_('HUB_DB_ID')); } catch (eDb) { hubDbId = ''; }
