  stEq_(out, 'shim: A1 notation counts its rows', runtimeSheetPos_('B2:D5').rows, 4);
  stEq_(out, 'shim: column letters past Z still resolve', runtimeSheetCol_('AA'), 27);
  stEq_(out, 'shim: an append with no candidate id is refused, not guessed',
