  stAssert_(out, 'forms import: the ASA contact block is opt-in, never a default',
            stCode_(HUB_ACTIONS.formImportGoogle).indexOf("asks_contact: 'no'") !== -1,
            'the original never carries Your name / E-mail / Phone — no import turns it on');

  // THE KIND ENGINE: kinds are registry entries, never else-if chains — file first, list inputs and selection…
  stAssert_(out, 'form kinds: every kind is a registry entry',
            (function () {
              for (var i = 0; i < FORM_FIELD_KINDS.length; i++) {
