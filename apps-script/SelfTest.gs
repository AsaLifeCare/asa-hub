      out.failures++;
      out.checks.push({ check: sections[i][0] + ': the section itself threw',
                        pass: false, detail: String((e && e.message) || e) });
    }
  }
  } finally {
    HUB_QUIET_NOW = heldQuietNow;
  }
  var failed = out.checks.filter(function (c) { return !c.pass; });
  // SKIPS ARE REPORTED BESIDE THE FAILURES, not buried in the pass list.
  var skipped = out.checks.filter(function (c) { return c.skipped; });
  var result = {
    failures: out.failures,
    ran: out.checks.length,
    live: out.live,
    sending: (typeof rpcSendEnabled_ === 'function' && rpcSendEnabled_()) ? 'ON' : 'off',
    failed: failed,
    skipped: skipped,
    passed: out.checks.filter(function (c) { return c.pass && !c.skipped; })
              .map(function (c) { return c.check; })
  };
  Logger.log(JSON.stringify(result, null, 2));
  return result;
