// ------------------------------------------------------------------ SELF-TEST — the hiring pipeline, asserted…
// Everything here runs against the REAL functions — no mocks, no copies of the logic.

function stAssert_(out, name, pass, detail) {
  out.checks.push({ check: name, pass: !!pass, detail: pass ? '' : String(detail || '') });
  if (!pass) out.failures++;
  return !!pass;
}

// A CHECK THAT CANNOT RUN HERE, SAID OUT LOUD.
function stSkip_(out, name, why) {
  out.checks.push({ check: 'SKIPPED — ' + name, pass: true, skipped: true,
                    detail: String(why || '') });
}

// A function's CODE, with its comments removed.
function stSrcBetween_(src, from, to) {
  var i = String(src).indexOf(from);
  if (i === -1) return '';
  var j = String(src).indexOf(to, i + from.length);
  return j === -1 ? String(src).slice(i) : String(src).slice(i, j);
}

function stCode_(fn) {
  return String(fn == null ? '' : fn)
    .replace(/\/\*[\s\S]*?\*\//g, ' ')
    .replace(/\/\/[^\n]*/g, ' ');
}

// ONE ASSERTION, WITH THE SENDING DIAL HELD AT A NAMED WORD.
function stWithDial_(word, fn) {
  var heldDial = commDial_;
  var heldMemo = COMM_DIAL_MEMO;
  // THE WORD IS NAMED, SO IT WAS READ: a real read an earlier section made (and failed) must not make this one…
  var heldBlind = COMM_DIAL_UNREADABLE;
  COMM_DIAL_MEMO = '';
  COMM_DIAL_UNREADABLE = false;
  commDial_ = function () { return String(word || 'off'); };
  try { return fn(); }
  finally {
    commDial_ = heldDial;
    COMM_DIAL_MEMO = heldMemo;
    COMM_DIAL_UNREADABLE = heldBlind;
  }
}

// THE CONFIGURATION, HELD STILL FOR ONE ASSERTION (review).
function stWithSettings_(cfg, fn) {
  var held = HIRING_ALERTS_MEMO;
  HIRING_ALERTS_MEMO = cfg || {};
  try { return fn(); } finally { HIRING_ALERTS_MEMO = held; }
}

// DOES THIS GETTER GO THROUGH THE ONE DOOR?
function stRoutes_(fn) {
  var src = stCode_(fn);
  return src.indexOf('hubTabEnsure_') !== -1 ||
         src.indexOf('hubTabSheet_') !== -1 ||
         src.indexOf('hubTabWorkbook_') !== -1;
}

function stEq_(out, name, got, want) {
  return stAssert_(out, name, String(got) === String(want),
                   'got ' + JSON.stringify(got) + ', wanted ' + JSON.stringify(want));
}

// ------------------------------------------------------------------ ONE DOOR — the routing question has exactly…
function stOneDoor_(out) {
  var router = stCode_(hubTabWorkbook_);

  // The order IS the contract: a world re-points everything, a place keeps its own non-central tabs, and only then…
  var iWorld = router.indexOf('HUB_WORLD_CTX');
  var iTenant = router.indexOf('tenantSpreadsheetId_');
  var iDissolved = router.indexOf('hiringTabDissolved_');
  var iMoved = router.indexOf('houseMoved_');
  var iHome = router.indexOf('hubTabHomeId_');
  var iDb = router.indexOf('HUB_DB_ID');

  stAssert_(out, 'one door: a world is asked before anything else',
            iWorld !== -1 && iWorld < iTenant && iWorld < iDissolved,
            'a declaration about headquarters must never reach inside a world');
  stAssert_(out, "one door: a place's own book outranks the declarations",
            iTenant !== -1 && iTenant < iDissolved && iTenant < iMoved,
            "serving a tenant's rows from headquarters' house is a data leak");
  stAssert_(out, 'one door: dissolved is asked before moved',
            iDissolved !== -1 && iDissolved < iMoved,
            'a dissolved tab has no workbook at all');
  stAssert_(out, 'one door: the house outranks the book map',
            iMoved !== -1 && iHome !== -1 && iMoved < iHome,
            'the house needs an explicit switch; the book map is implicit — ' +
            'the sixteen readers already order it this way');
  stAssert_(out, 'one door: HUB_DB is the last answer, never the first',
            iDb !== -1 && iDb > iHome,
            'home is still home, but only once nothing else claimed the tab');

  // The maker asks the runtime first and refuses what has been declared gone.
  var ensure = stCode_(hubTabEnsure_);
  stAssert_(out, 'one door: the maker never makes a tab in the runtime',
            ensure.indexOf('runtimeSheetFor_') !== -1 &&
            ensure.indexOf('runtimeSheetFor_') < ensure.indexOf('insertSheet'),
            'the runtime book has no tabs to create');
  stAssert_(out, 'one door: the maker refuses a tab declared gone',
            ensure.indexOf('hubTabDeclaredGone_') !== -1 &&
            ensure.indexOf('hubTabDeclaredGone_') < ensure.indexOf('insertSheet'),
            'this is the whole point — insertSheet on a killed tab is the resurrection');

  // THE FLOOR.
  var gone = stCode_(hubTabDeclaredGone_);
  stAssert_(out, 'one door: the refusal has a floor no outage can lift',
            gone.indexOf('HIRING_DISSOLVABLE_TABS') !== -1 &&
            gone.indexOf('HUB_TAB_HOME') !== -1 &&
            gone.indexOf('houseIdFor_') !== -1,
            'all three declarations that live in the CODE answer when the ' +
            'depot cannot: the dissolvable roll, the book map, and a house ' +
            'pointer — nobody points a tab at a house it does not live in');

  // The generic verbs inherit all of it rather than re-deciding.
  stAssert_(out, 'one door: the generic verbs go through the router',
            stCode_(sheetFor_).indexOf('hubTabEnsure_') !== -1,
            'sheetFor_ is the door every list, create, update and delete opens');

 // THE THIRD ENGINE (RuntimeEngine.gs).
  stAssert_(out, 'three engines: the runtime engine owns the data books alone',
            stCode_(runtimeRegistry_).indexOf('runtimeOwnsContext_') !== -1 &&
            stCode_(flowConditionsSweepRun_).indexOf('runtimeOwnsContext_') !== -1,
            'two engines judging one book race for the same Condition Instance ' +
            'row and undo each other on alternate ticks');
  stAssert_(out, 'three engines: the runtime engine keeps its own cursor',
            stCode_(runtimeConditionsSweepRun_).indexOf('RUNTIME_JUDGE_CURSOR') !== -1 &&
            stCode_(runtimeConditionsSweepRun_).indexOf('FLOW_JUDGE_CURSOR') === -1 &&
            SCRIPT_PROP_RUNTIME.indexOf('RUNTIME_JUDGE_CURSOR') !== -1,
            'a shared cursor makes the two fight over one position and neither finishes');
  stAssert_(out, 'three engines: the runtime engine borrows the judging, never copies it',
            stCode_(runtimeConditionsSweepRun_).indexOf('flowConditionStatus_') !== -1 &&
            stCode_(runtimeConditionsSweepRun_).indexOf('flowRuleFacts_') !== -1,
            'two engines that disagree about what satisfied MEANS is worse than one slow engine');
  stAssert_(out, 'three engines: the runtime engine obeys the honesty law too',
            stCode_(runtimeConditionsSweepRun_).indexOf('skipped++') !== -1,
            'a rule whose facts the clock cannot answer is skipped, never guessed');

  // THE RUNTIME IS READ ONCE PER EXECUTION, HANDLE AND ROWS BOTH.
  stAssert_(out, 'one door: the runtime rows are memoised per execution',
            stCode_(hiringLegacyRows_).indexOf('HIRING_LEGACY_MEMO') !== -1,
            'each ask was a round trip plus a parse of the whole tab');
  stAssert_(out, 'one door: one shim per tab per execution',
            stCode_(runtimeSheetFor_).indexOf('RUNTIME_SHEET_MEMO') !== -1,
            'a real Sheet handed out twice IS the same sheet');
  stAssert_(out, 'one door: a runtime write drops both memos',
            stCode_(hiringLegacyWrite_).indexOf('HIRING_LEGACY_MEMO') !== -1 &&
            stCode_(hiringLegacyWrite_).indexOf('RUNTIME_SHEET_MEMO') !== -1,
            'a memo that outlives its write serves the row somebody just changed');

  // A DISSOLVED TAB'S GETTER MUST NOT WIDEN THE SHIM'S HEADER.
  stAssert_(out, 'one door: a dissolved getter never widens the runtime header',
            stCode_(resumeInboxSheet_).indexOf('isRuntimeBacked') !== -1 &&
            stCode_(interviewSheet_).indexOf('isRuntimeBacked') !== -1 &&
            stCode_(tpSheet_).indexOf('isRuntimeBacked') !== -1,
            'widening a rebuilt header moves the columns underneath the write');

  // THE PER-ROW READS IN userPublic_ EACH NEED A MEMO.
  stAssert_(out, 'one door: the per-row config read is memoised per execution',
            stCode_(hiringAlerts_).indexOf('HIRING_ALERTS_MEMO') !== -1,
            'multiplied by 261 accounts, a round trip per row is the ceiling');
  stAssert_(out, 'one door: every writer clears the memo, not just the cache',
            stCode_(hiringAlertsBump_).indexOf('HIRING_ALERTS_MEMO = null') !== -1 &&
            stCode_(hiringAlertsBump_).indexOf('HIRING_ALERTS_CACHE_KEY') !== -1,
            'a memo that outlives its write serves the value somebody just changed');

  // A CURSOR THE SWEEP ADVANCES MUST BE DECLARED RUNTIME.
  stAssert_(out, 'one door: the judge cursor is a runtime property',
            (typeof SCRIPT_PROP_RUNTIME !== 'undefined') &&
            SCRIPT_PROP_RUNTIME.indexOf('FLOW_JUDGE_CURSOR') !== -1,
            'an undeclared cursor is a cursor that never moves');
  stAssert_(out, 'one door: the judge advances instead of restarting at the head',
            stCode_(flowConditionsSweepRun_).indexOf('FLOW_JUDGE_CURSOR') !== -1 &&
            stCode_(flowConditionsSweepRun_).indexOf('walked') !== -1,
            'with more books than the cap, the tail is never judged at all — ' +
            'and the first forty coming back green is what hides it');

  // THE TWO NAMES A HOUSE MAY USE, and the fence around the second one.
  var inTab = stCode_(hubHouseTabIn_);
  stAssert_(out, 'one door: a house answers to its own tab name first',
            inTab.indexOf('getSheetByName(tab)') < inTab.indexOf('HOUSE_DATA_TAB'),
            'the rename runs house by house — an un-renamed house must answer ' +
            'exactly as it did before the matrix name existed');
  stAssert_(out, 'one door: only the DECLARED house may answer to the matrix name',
            inTab.indexOf('houseIdFor_') !== -1 && inTab.indexOf('ss.getId()') !== -1,
            'a tenant book or an imported spreadsheet can have a Data tab of ' +
            'its own; serving those rows under another name is the quietest wrong answer');
  stAssert_(out, 'one door: the readers resolve a house through that one helper',
            stCode_(hubTabSheet_).indexOf('hubHouseTabIn_') !== -1 &&
            stCode_(hubTabEnsure_).indexOf('hubHouseTabIn_') !== -1 &&
            stCode_(readTabRawKeys_).indexOf('hubHouseTabIn_') !== -1 &&
            stCode_(readTabNormalized_).indexOf('hubHouseTabIn_') !== -1 &&
            stCode_(bulkTabsRead_).indexOf('hubHouseTabIn_') !== -1 &&
            stCode_(bulkTabsRevs_).indexOf('hubHouseTabIn_') !== -1,
            'a reader that re-resolves by name is a reader that goes blind on rename — ' +
            'and these are handed the HOUSE directly, so HUB_DB-only seams do not save them');

 // Two declared addresses is no address (mar_errors, routed to the care book and given a house pointer on the same…
  var clash = [];
  try { clash = hubTabAddressConflicts_(); } catch (eC) { clash = []; }
  stAssert_(out, 'one door: no tab has two declared addresses',
            clash.length === 0,
            'both a house pointer and a HUB_TAB_HOME entry: ' + clash.join(', '));
}

// ------------------------------------------------------------------ 1.
function stReferral_(out) {
  var good = { source: 'Referral', first: 'Maria', last: 'Silva',
               phone: '3305551234', email: 'maria.silva@gmail.com', referrer: 'Ana Costa' };
  var r = referralFastLaneCheck_(good);
  stAssert_(out, 'referral: a complete referral is accepted', r.ok, r.reasons);

  var noSource = JSON.parse(JSON.stringify(good)); noSource.source = 'Indeed';
  stAssert_(out, 'referral: refused when the source is not a referral',
            !referralFastLaneCheck_(noSource).ok, 'accepted a non-referral');

  var noRef = JSON.parse(JSON.stringify(good)); noRef.referrer = '';
  stAssert_(out, 'referral: refused with nobody named as the referrer',
            !referralFastLaneCheck_(noRef).ok, 'accepted without a referrer');

  // An area code cannot start with 0 or 1 — a number that cannot be dialled is not a number, and placing somebody…
  var badPhone = JSON.parse(JSON.stringify(good)); badPhone.phone = '1235551234';
  stAssert_(out, 'referral: refused on an undialable area code',
            !referralFastLaneCheck_(badPhone).ok, 'accepted an impossible area code');

  var shortPhone = JSON.parse(JSON.stringify(good)); shortPhone.phone = '33055512';
  stAssert_(out, 'referral: refused on a short number',
            !referralFastLaneCheck_(shortPhone).ok, 'accepted 8 digits');

  // Our own line identifies nobody.
  if (typeof SHARED_LINE_DIGITS !== 'undefined' && SHARED_LINE_DIGITS.length) {
    var ourLine = JSON.parse(JSON.stringify(good)); ourLine.phone = SHARED_LINE_DIGITS[0];
    stAssert_(out, 'referral: refused when the number is one of our own lines',
              !referralFastLaneCheck_(ourLine).ok, 'accepted a company line as a personal number');
  }

  var placeholder = JSON.parse(JSON.stringify(good)); placeholder.email = 'a@example.com';
  stAssert_(out, 'referral: refused on a placeholder e-mail domain',
            !referralFastLaneCheck_(placeholder).ok, 'accepted example.com');

  stAssert_(out, 'referral: a name must look like a name',
            referralNamePart_('Maria') && !referralNamePart_('7') && !referralNamePart_(''),
            'name validation is not discriminating');

  // Every reason at once, not one per round trip: a form that reveals its objections one at a time takes five…
  var empty = referralFastLaneCheck_({ source: 'Referral' });
  stAssert_(out, 'referral: all reasons are returned together',
            empty.reasons && empty.reasons.length >= 3,
            'only ' + ((empty.reasons || []).length) + ' reason(s) returned');

  // THE E-MAIL LEFT THE REQUIRED LIST — required is first name, last name and phone number; the e-mail is wanted…
  stAssert_(out, 'intake: a card with no e-mail at all is accepted',
            hubIntakeIdentityCheck_('Maria', 'Silva', '3305551234', '').ok,
            'somebody typed in off a phone call is refused at the door');
  stAssert_(out, 'intake: an e-mail that is not an address is still refused',
            !hubIntakeIdentityCheck_('Maria', 'Silva', '3305551234', 'maria.silva@gmail').ok,
            'every letter to it is composed, sent, accepted by nobody and never comes back');
  stAssert_(out, 'intake: the refusal no longer names the e-mail',
            hubIntakeIdentityCheck_('', '', '', '').message.toLowerCase().indexOf('mail') === -1,
            'a sentence listing four required fields teaches a rule that is not the rule');
  stAssert_(out, 'intake: the name and the number are still required, each on its own',
            !hubIntakeIdentityCheck_('', 'Silva', '3305551234', '').ok &&
            !hubIntakeIdentityCheck_('Maria', '', '3305551234', '').ok &&
            !hubIntakeIdentityCheck_('Maria', 'Silva', '', '').ok, '');
  stAssert_(out, 'intake: both doors that mint a card ask the ONE function',
            stCode_(HUB_ACTIONS.hubIntake).indexOf('hubIntakeIdentityCheck_') !== -1 &&
            stCode_(HUB_ACTIONS.resumeIntakeCommit).indexOf('hubIntakeIdentityCheck_') !== -1,
            'the rule would live in two places and drift');
  stAssert_(out, 'referral: the FAST LANE still demands a real e-mail',
            !referralFastLaneCheck_({ source: 'Referral', first: 'Maria', last: 'Silva',
                                      phone: '3305551234', email: '', referrer: 'Ana Costa' }).ok,
            'it skips four stages on the strength of what was typed — the address is part of that');
 // THE HOLE THE E-MAIL USED TO PLUG ( review).
  stAssert_(out, 'intake: a phone that is not a number is refused',
            !hubIntakeIdentityCheck_('Maria', 'Silva', 'n/a', '').ok &&
            !hubIntakeIdentityCheck_('Maria', 'Silva', '3305', '').ok,
            'with no e-mail either, nothing about this card could ever be de-duplicated');
  stAssert_(out, 'intake: the phone shape is checked in the shared function, not at one door',
            stCode_(hubIntakeIdentityCheck_).indexOf('length < 7') !== -1,
            'a floor that lives at one door leaves the other minting cards nobody can dial');
}

// ------------------------------------------------------------------ 2.
function stPacketHold_(out) {
  stAssert_(out, 'hold: no hold column means no hold',
            packetHold_({}) === null, 'invented a hold out of nothing');

  // AMBER IS IMMEDIATE.
  var future = new Date(Date.now() + 3600000).toISOString();
  var h1 = packetHold_({ packetholduntil: future, packetholdsince: new Date().toISOString() });
  stEq_(out, 'hold: the card is amber from the moment onboarding ends', h1 && h1.phase, 'overdue');
  stAssert_(out, 'hold: inside the day the team has NOT been told yet',
            h1 && h1.escalate === false,
            'four phones ring for every completed visit');

  var past = new Date(Date.now() - 3600000).toISOString();
  var h2 = packetHold_({ packetholduntil: past, packetholdsince: past });
  stEq_(out, 'hold: after the day it is still amber', h2 && h2.phase, 'overdue');
  stAssert_(out, 'hold: after the day the team IS told',
            h2 && h2.escalate === true,
            'the day passes and nobody hears about it');
  // TWO messages, each with its own stamp: immediate amber plus its notification, then a second when the day runs…
  stAssert_(out, 'hold: the first escalation fires with the colour, not a day later',
            SMART_EVENTS.packet_missing.applies(
              { candidateid: 'CAN_X', packetholduntil: future,
                packetholdsince: new Date().toISOString() }).fires === true,
            'the card goes amber and nobody is told for twenty-four hours');
  stAssert_(out, 'hold: the second escalation waits for the day to run out',
            SMART_EVENTS.packet_day_elapsed.applies(
              { candidateid: 'CAN_X', packetholduntil: future,
                packetholdsince: new Date().toISOString() }).fires === false &&
            SMART_EVENTS.packet_day_elapsed.applies(
              { candidateid: 'CAN_X', packetholduntil: past, packetholdsince: past }).fires === true,
            'the two messages fire at the same moment, or the second never does');
  stAssert_(out, 'hold: the three alerts cannot suppress each other',
            PACKET_COL_AMBER_ALERTED !== PACKET_COL_OVERDUE_ALERTED &&
            PACKET_COL_OVERDUE_ALERTED !== PACKET_COL_RED_ALERTED &&
            PACKET_COL_AMBER_ALERTED !== PACKET_COL_RED_ALERTED,
            'one stamp for several messages means only one of them ever goes');

  // ---- RED: a deadline a PERSON extended, that has now expired ---------- RED IS A NEW STATE, AFTER AMBER.
  var longAgo2 = new Date(Date.now() - 400 * 86400000).toISOString();
  var ahead = new Date(Date.now() + 3 * 86400000).toISOString();
  stEq_(out, 'red: a card with nothing wrong is not coloured',
        hubCardUrgency_({ candidateid: 'CAN_X', status: 'New' }).level, 'none');
  stEq_(out, 'red: held without the packet is AMBER, not red',
        hubCardUrgency_({ candidateid: 'CAN_X', status: 'Onboarding',
          packetholduntil: longAgo2, packetholdsince: longAgo2 }).level, 'amber');
  stEq_(out, 'red: an extension that ran out is RED',
        hubCardUrgency_({ candidateid: 'CAN_X', status: 'Onboarding',
          onboardingaccessuntil: longAgo2 }).level, 'red');
  stEq_(out, 'red: an extension still running is NOT red',
        hubCardUrgency_({ candidateid: 'CAN_X', status: 'Onboarding',
          packetholduntil: longAgo2, onboardingaccessuntil: ahead }).level, 'amber');
  stAssert_(out, 'red: the colour carries the sentence that explains it',
            /\d{4}-\d{2}-\d{2}/.test(hubCardUrgency_({ candidateid: 'CAN_X',
              status: 'Onboarding', onboardingaccessuntil: longAgo2 }).why),
            'a colour with no reason is one two people read differently');
  // ARRIVING AT THE LAST COLUMN OWING THINGS IS AMBER, with or without a hold stamp.
  stEq_(out, 'becoming staff: owing things on arrival is amber, stamp or no stamp',
        hubCardUrgency_({ candidateid: 'CAN_X', status: 'Becoming Staff' }).level, 'amber');
  stAssert_(out, 'becoming staff: the colour says WHAT is owed',
            hubCardUrgency_({ candidateid: 'CAN_X', status: 'Becoming Staff' })
              .why.indexOf('owing') !== -1,
            'a colour with no list is one somebody has to go hunting behind');
  stAssert_(out, 'becoming staff: the colour and the checklist read one definition',
            stCode_(hubCardUrgency_).indexOf('hubBecomingStaffDone_') !== -1,
            'the colour is worked out separately from the list and will disagree');
  stEq_(out, 'becoming staff: an earlier stage is not coloured by this rule',
        hubCardUrgency_({ candidateid: 'CAN_X', status: 'Onboarding' }).level, 'none');

  // A FILL THAT FAILED FOR A REASON THAT CHANGES MUST BE TRIED AGAIN.
  var sweepSrc = stCode_(empdbStepSweep_);
  stAssert_(out, 'employee db: a "Not filled" card comes back on the next pass',
            sweepSrc.indexOf("note.indexOf('Not filled') === 0") !== -1,
            'one attempt ever — the packet arrives and the row stays empty forever');
  stAssert_(out, 'employee db: a card somebody is filling BY HAND is left alone',
            sweepSrc.indexOf("note.indexOf('Left alone') === 0") !== -1,
            'the sweep overwrites a person who is already doing it, which is worse than not filling');
  stAssert_(out, 'employee db: it looks at the stage that still exists',
            sweepSrc.indexOf("!== 'hired'") !== -1 &&
            sweepSrc.indexOf("!== 'becoming-staff'") === -1 &&
            sweepSrc.indexOf("!== 'internal-docs'") === -1,
            'it watches a retired stage and finds nobody, forever — the graduation lives on Hired since 2026-08-13');

  stAssert_(out, 'red: the board and the drawer read ONE answer',
            stCode_(talentRecord_).indexOf('hubCardUrgency_') !== -1,
            'the colour is worked out twice and will disagree');

  // Amber is indefinite BY DESIGN: while the New Hire packet has not been filled in, the card stays amber.
  var ancient = new Date(Date.now() - 40 * 86400000).toISOString();
  var h3 = packetHold_({ packetholduntil: ancient, packetholdsince: ancient });
  stEq_(out, 'hold: still overdue forty days later, never released by time',
        h3 && h3.phase, 'overdue');

  stAssert_(out, 'hold: an unreadable date is not a hold',
            packetHold_({ packetholduntil: 'not a date' }) === null,
            'a garbage date produced a hold');

  // ---- the day, where the COMPANY is ------------------------------------ The project ran America/Sao_Paulo (now…
  stEq_(out, 'timezone: a day starts at midnight where the company is',
        hubTzEdgeIso_('2026-08-11', '-0400', false), '2026-08-11T00:00:00.000-04:00');
  stEq_(out, 'timezone: and ends at the last millisecond of that day',
        hubTzEdgeIso_('2026-08-11', '-0400', true), '2026-08-11T23:59:59.999-04:00');
  stEq_(out, 'timezone: winter offset is carried, not assumed',
        hubTzEdgeIso_('2026-01-11', '-0500', false), '2026-01-11T00:00:00.000-05:00');
  // The instant it names must BE that midnight, not one seven hours off.
  stEq_(out, 'timezone: the edge is a real instant, five hours before UTC midnight',
        new Date(hubTzEdgeIso_('2026-08-11', '-0400', false)).toISOString(),
        '2026-08-11T04:00:00.000Z');
  stAssert_(out, 'timezone: the interview window uses it',
            stCode_(interviewDayBounds_).indexOf('hubTzDayEdge_') !== -1,
            'the window still opens on the evening before, in another country');
  stAssert_(out, 'timezone: so does the onboarding window',
            stCode_(obOnboardingWindow_).indexOf('hubTzDayEdge_') !== -1,
            'a new hire is shut out an evening early');
  stAssert_(out, 'timezone: and the weekday the interview is counted from',
            stCode_(hubResolveInterviewDate_).indexOf('hubTzWeekday_') !== -1,
            'an evening call rolls into tomorrow and "next Tuesday" skips a week');
  // A configurable default, because the company is not the only reader.
  stAssert_(out, 'timezone: it falls back to the company, never to the project',
            stCode_(hiringTimeZone_).indexOf('America/New_York') !== -1,
            'an empty cell silently returns to São Paulo');

  // ---- the onboarding window -------------------------------------------- This is the only gate on the platform…
  var future = new Date(Date.now() + 3 * 86400000).toISOString();
  var longAgo = new Date(Date.now() - 400 * 86400000).toISOString();

  stAssert_(out, 'ob window: no date to anchor to means OPEN',
            obOnboardingWindow_({ candidateid: 'CAN_X' }).open === true,
            'a referral inserted straight at Onboarding would be locked out');
  stAssert_(out, 'ob window: an unreadable date means OPEN',
            obOnboardingWindow_({ candidateid: 'CAN_X',
              onboardingscheduledfor: 'not a date' }).open === true,
            'a typo in one cell shuts a hired person out of the portal');
  stAssert_(out, 'ob window: no card at all means OPEN',
            obOnboardingWindow_(null).open === true,
            'a lookup that failed becomes a refusal');
  stAssert_(out, 'ob window: inside the tail it is open',
            obOnboardingWindow_({ candidateid: 'CAN_X',
              onboardingscheduledfor: new Date(Date.now() - 2 * 86400000).toISOString() }).open === true,
            'two days after the visit is inside a seven-day tail');
  var missed = obOnboardingWindow_({ candidateid: 'CAN_X', onboardingscheduledfor: longAgo });
  stAssert_(out, 'ob window: long past the tail it is closed',
            missed.open === false, 'the window never closes, so it is not a window');
  // Somebody who misses the window has to ask the team for an extension — and has to be TOLD so, by name of date…
  stAssert_(out, 'ob window: the refusal names the date and the way out',
            /\d{4}-\d{2}-\d{2}/.test(str_(missed.reason)) &&
            missed.reason.indexOf('team') !== -1,
            'a blank wall: ' + missed.reason);
  // THE TEAM'S GRANT OUTRANKS THE WINDOW, which is the whole point of it.
  stAssert_(out, 'ob window: an extension reopens a missed window',
            obOnboardingWindow_({ candidateid: 'CAN_X', onboardingscheduledfor: longAgo,
              onboardingaccessuntil: future }).open === true,
            'the extension the team grants does nothing');
  stAssert_(out, 'ob window: an expired extension closes again',
            obOnboardingWindow_({ candidateid: 'CAN_X',
              onboardingaccessuntil: longAgo }).open === false,
            'an extension with an end date that never ends');
  // THE TEAM CAN SEE IT TOO.
  stAssert_(out, 'ob window: a closed window reaches the card, not just the portal',
            stCode_(talentRecord_).indexOf('obOnboardingWindow_') !== -1,
            'the only place a closed window exists is the screen of the person it shut out');
  stAssert_(out, 'ob window: an ordinary open card carries no chip',
            (function () {
              try {
                var w = obOnboardingWindow_({ candidateid: 'CAN_X' });
                return w.open === true && !str_(w.until);
              } catch (e) { return false; }
            })(),
            'every card would wear a window chip, and a chip on every card is one nobody reads');

  stAssert_(out, 'ob window: the portal reads it per person, not per seat',
            String(HUB_ACTIONS.obFlow || '').indexOf('obOnboardingWindow_') !== -1 ||
            String(obFlow_ || '').indexOf('obOnboardingWindow_') !== -1,
            'the window is computed and never consulted');

  // ---- finding the envelope ourselves ---------------------------------- A NAME IS A SEARCH, NEVER A KEY.
  var match = String(packetMatch_);
  stAssert_(out, 'packet: the automatic matcher still keys on e-mail and phone only',
            match.indexOf('emailKeys') !== -1 && match.indexOf('phoneKey') !== -1 &&
            match.indexOf('candidatename') === -1 && match.indexOf('nameTokens_') === -1,
            'name became a key in the matcher that runs with nobody looking');
  stAssert_(out, 'packet: the by-name search proposes and never writes',
            String(HUB_ACTIONS.packetFind).indexOf('hubSetFieldLastRow_') === -1 &&
            String(HUB_ACTIONS.packetFind).indexOf('nameTokens_') !== -1,
            'the search binds by itself, which is name-matching with extra steps');
  stAssert_(out, 'packet: a name search needs two parts of the name, not one',
            String(HUB_ACTIONS.packetFind).indexOf('hit >= 2') !== -1,
            'one token matches every John and buries the right answer');

  // BINDING IS THE DANGEROUS HALF, so both of its refusals are asserted.
  var bind = String(HUB_ACTIONS.packetBind);
  stAssert_(out, 'packet: binding an envelope that does not exist is refused',
            bind.indexOf('No envelope ') !== -1,
            'a typo would freeze the card as signed with nothing behind it');
  stAssert_(out, 'packet: one envelope cannot be bound to two cards',
            bind.indexOf('already bound to') !== -1 && bind.indexOf('status: 409') !== -1,
            'two people would share one signature');
  stAssert_(out, 'packet: binding an UNSIGNED envelope releases nobody',
            bind.indexOf("if (status === 'signed')") !== -1,
            'identifying which signature we await would let somebody through without it');
  stAssert_(out, 'packet: the binding records WHO confirmed it',
            bind.indexOf('confirmed by ') !== -1,
            'an identification with no author is indistinguishable from a guess');
}

// ------------------------------------------------------------------ 3.
function stSendable_(out) {
  stEq_(out, 'sendable: a normal number is usable',
        packetSendableNumber_('(330) 555-1234'), '+13305551234');
  stEq_(out, 'sendable: the leading 1 is not a digit of the number',
        packetSendableNumber_('13305551234'), '+13305551234');
  stEq_(out, 'sendable: a short number is refused', packetSendableNumber_('5551234'), '');
  stEq_(out, 'sendable: empty is refused', packetSendableNumber_(''), '');
  if (typeof SHARED_LINE_DIGITS !== 'undefined' && SHARED_LINE_DIGITS.length) {
    stEq_(out, 'sendable: our own line is refused — texting ourselves is a loop',
          packetSendableNumber_(SHARED_LINE_DIGITS[0]), '');
  }
}

// ------------------------------------------------------------------ 4.
function stStages_(out) {
  if (typeof HUB_STAGE_TO_STATUS === 'undefined') {
    stAssert_(out, 'stages: HUB_STAGE_TO_STATUS exists', false, 'missing');
    return;
  }
  // THE RETIRED STAGE STILL READS BACK.
  stEq_(out, 'stages: the retired "Minimal Internal Documentation Ready" lands in Hired',
        talentStage_('Minimal Internal Documentation Ready'), 'hired');
  stEq_(out, 'stages: and so does its id form',
        talentStage_('internal-docs'), 'hired');
 // THE MERGE reads back the same way: Becoming Staff is a status the platform no longer writes, and every card…
  stEq_(out, 'stages: the merged "Becoming Staff" lands in Hired',
        talentStage_('Becoming Staff'), 'hired');
  stAssert_(out, 'stages: nothing writes the merged status any more',
            HUB_STAGE_TO_STATUS['becoming-staff'] === undefined,
            'a card can still be moved into a column that no longer exists');
  stEq_(out, 'stages: Ready to Start reads back as the last stage',
        talentStage_('Ready to Start'), 'ready');
  // The manager's hand: only a READY card starts, and starting is declared.
  stEq_(out, 'stages: hiredStart is a recruiter-or-admin write',
        HUB_POLICY.hiredStart.roles.join(','), 'admin,manager');
  var g9 = hubGate_({ cand: { candidateid: 'CAN_TEST000000', status: 'Hired',
                              candidatename: 'T', email: '', hiredcompleteat: '' }, analysis: {} });
  stAssert_(out, 'gate: a drag cannot reach Ready to start before the graduation',
            g9.ok === false && g9.to === 'ready',
            'an unfinished person landed in the manager\'s queue by gesture');
  stAssert_(out, 'stages: nothing writes the retired status any more',
            HUB_STAGE_TO_STATUS['internal-docs'] === undefined,
            'a card can still be moved into a column that no longer exists');

  for (var stage in HUB_STAGE_TO_STATUS) {
    if (!HUB_STAGE_TO_STATUS.hasOwnProperty(stage)) continue;
    var status = HUB_STAGE_TO_STATUS[stage];
    stEq_(out, 'stages: "' + status + '" reads back as ' + stage, talentStage_(status), stage);
  }
  if (typeof TALENT_STAGE_ORDER !== 'undefined') {
    for (var i = 0; i < TALENT_STAGE_ORDER.length; i++) {
      var s = TALENT_STAGE_ORDER[i];
      stEq_(out, 'stages: the stage id "' + s + '" is its own reverse', talentStage_(s), s);
    }
  }

  // ---- NOBODY COULD REACH THEM: archived, and the queue moves again ----- The release is cadenced — three come in…
  if (typeof unreachableArchiveSweepMaybe_ !== 'undefined') {
    var uSrc = stCode_(unreachableArchiveSweepMaybe_);
    // THE STEP IT WATCHES IS THE STEP A MACHINE PRODUCES.
    stAssert_(out, 'unreachable: it watches the ladder a SWEEP actually fires',
              uSrc.indexOf("'manual_contact'") !== -1,
              'keyed only on outreach, no machine ever produces the state it waits for');
    stAssert_(out, 'unreachable: only somebody still standing at New is archived',
              uSrc.indexOf("talentStage_(str_(cand.status)) !== 'new'") !== -1,
              'a card that moved on answered some other way, and one already archived is done');
    stAssert_(out, 'unreachable: an archive that failed to write sends no letter',
              uSrc.indexOf('unreachable_archive_failed') !== -1 &&
              uSrc.indexOf('continue;') !== -1,
              'announcing something that did not happen is worse than staying quiet');
    stAssert_(out, 'unreachable: a letter that failed never un-archives anybody',
              uSrc.indexOf('unreachable_notice_failed') !== -1,
              'a person left blocking the queue because an e-mail bounced is the ' +
              'opposite of what this exists for');
    stAssert_(out, 'unreachable: the switch is the situation row, and OFF says so out loud',
              uSrc.indexOf("commSituationId_('hiring.unreachable_archived', 'hiring_unreachable_archived')") !== -1 &&
              uSrc.indexOf('smartSituationOn_') !== -1 &&
              uSrc.indexOf('tpSweepIdle_') !== -1,
              'a pass that does nothing in silence is how the hiring lane stopped for months');
    stAssert_(out, 'unreachable: bounded per pass, and it names who it archived',
              uSrc.indexOf('UNREACHABLE_PER_PASS') !== -1 &&
              uSrc.indexOf('unreachable_archived') !== -1,
              'a sweep that can archive everybody silently is one nobody can undo');
    // THE ORDERING IS THE FEATURE: the floor must count New AFTER the archive, or the next name waits a whole cycle…
    var chain = stCode_(hubHiredSweepMaybe_);
    stAssert_(out, 'unreachable: the archive and the floor left this pass (the relay rings Python\'s, archive first)',
              chain.indexOf('unreachableArchiveSweepMaybe_()') === -1 && chain.indexOf('tpAutoFillNewMaybe_()') === -1,
              'calling the next person straight away IS this ordering, not a second machine');
    var uSit = null;
    SMART_HIRING_EVENTS.forEach(function (e) { if (e.id === 'hiring_unreachable_archived') uSit = e; });
    stAssert_(out, 'unreachable: the situation exists and ships OFF',
              !!uSit && !smartOn_(uSit.enabled),
              'a seed that arrives enabled starts archiving real people on the next publish');
    // THE REASON GOES ON A PERSON'S RECORD, so it comes from THEIR ask and not from a config cell read once for the…
    stAssert_(out, 'unreachable: the archive reason is read off the candidate OWN ask',
              uSrc.indexOf('unreachableTriesSaid_(spent[cid])') !== -1 &&
              uSrc.indexOf("simAttemptsFor_('outreach')") === -1,
              'the two ladders run on different clocks, so one figure cannot describe both');
    stAssert_(out, 'unreachable: it counts what was SENT, not what was planned',
              typeof unreachableTriesSaid_ === 'function' &&
              stCode_(unreachableTriesSaid_).indexOf('sentcount') !== -1,
              'max_attempts is the ceiling; the sentence written as fact must be the history');
  }

  // ---- THE FENCE MUST NOT SWALLOW THE REHEARSAL --------------------------- The cast check ran BEFORE rpcCall_…
  if (typeof simOutboundAllowed_ !== 'undefined') {
    var fSrc = stCode_(simOutboundAllowed_);
    stAssert_(out, 'fence: a destination the redirect will REPLACE is let through',
              fSrc.indexOf('hubTestRedirect_') !== -1 && fSrc.indexOf('carried') !== -1,
              'blocking it hides the rehearsal from the only person meant to see it');
    stAssert_(out, 'fence: it FAILS CLOSED — an unreadable config keeps the cast check',
              /catch\s*\([^)]*\)\s*\{\s*redir = null;/.test(fSrc),
              'hubTestRedirect_ falls through to PRODUCTION on a read error, so a bypass ' +
              'that assumed test mode there would send a stranger a real letter');
    stAssert_(out, 'fence: the bypass is PER CHANNEL, exactly as rpcSend_ requires',
              fSrc.indexOf('redir.emails') !== -1 && fSrc.indexOf('redir.sms') !== -1,
              'rpcSend_ REFUSES a channel with no tester rather than falling back — a ' +
              'bypass wider than that would out-permit the transport it is trusting');
  }

  // ---- THE FIRST CONTACT REACHES EVERY WAY IN, NOT ONE --------------------
  if (typeof manualCardIs_ !== 'undefined') {
    var mSrc = stCode_(manualCardIs_);
    stAssert_(out, 'first contact: provenance no longer decides whether we speak at all',
              mSrc.indexOf('createdby') === -1,
              'the created_by prefix silenced every crossed-in and resume-born card — ' +
              'the Simulator passed because its rehearsal card was the one shape it allowed');
    stAssert_(out, 'first contact: it still needs a contact we can use',
              mSrc.indexOf('str_(c.phone)') !== -1 && mSrc.indexOf('str_(c.email)') !== -1,
              'messaging somebody with no phone and no address books an ask nothing can answer');
    stAssert_(out, 'first contact: what we SAY still depends on how they arrived',
              typeof manualCardOrigin_ === 'function' &&
              stCode_(manualCardOpening_).indexOf("'open.'") !== -1 &&
              stCode_(manualCardOpening_).indexOf('applied') !== -1,
              'telling somebody who filled in our own form that a colleague named them ' +
              'is the platform not recognising the person it is writing to — the four ' +
              'openings live in the book (open.applied/resume/store/named) since 2026-09-01');
    // AND THE SENDER MUST REACH IT.
    var sendSrc = stCode_(HUB_ACTIONS.manualContactSend);
    stAssert_(out, 'first contact: the origin-aware opening is REACHED, not merely written',
              sendSrc.indexOf('manualCardOpening_(manualCardOrigin_(ev.cand), first)') !== -1 &&
              sendSrc.indexOf("simText_('manual_contact_sms', '')") === -1,
              'an `||` whose left side can never be empty is a branch that never runs');
    stAssert_(out, 'first contact: the words resolve situation -> config -> the opening',
              sendSrc.indexOf('fcWords_') !== -1 &&
              sendSrc.indexOf("sit.sit[sitKey]") !== -1,
              'the Smart Comms row is the screen this is configured from; a cell already ' +
              'typed must still win over the shipped floor');
    stAssert_(out, 'first contact: it asks a situation, like every other message here',
              sendSrc.indexOf("outreachAllowed_(commSituationId_('hiring.first_contact', 'hiring_first_contact'))") !== -1,
              'it was the only outreach in the file that asked nobody, so it was invisible ' +
              'on the Smart Comms screen and nothing switched there could reach it');
    var fcSit = null;
    SMART_HIRING_EVENTS.forEach(function (e) { if (e.id === 'hiring_first_contact') fcSit = e; });
    stAssert_(out, 'first contact: the situation exists and ships ON',
              !!fcSit && smartOn_(fcSit.enabled),
              'it has been sending since 2026-08-26 as a hardcoded call, so a row that ' +
              'arrives OFF does not expose the machine — it STOPS it, which is exactly ' +
              'what happened on the publish of 2026-08-29');
    stAssert_(out, 'first contact: a switched-off situation is SAID, never silent',
              stCode_(manualContactSweepMaybe_).indexOf('tpSweepIdle_') !== -1,
              'the manual ladder wrote one event in its life and that is how it stayed ' +
              'invisible; a pass that does nothing has to name the reason');
 // ---- the return leg: the two things that closed it ---- (a) the résumé was asked ONCE, with no book entry — and…
    stAssert_(out, 'return: the résumé ask is a rung, not a shout',
              typeof HUB_ACTIONS.manualResumeAsk === 'function' &&
              stCode_(HUB_ACTIONS.manualResumeAsk).indexOf("simTrackSend_('manual_resume'") !== -1,
              'every other rung here has a ceiling and a clock; this one was asked once');
    stAssert_(out, 'return: it is its OWN step, never resume_request',
              stCode_(HUB_ACTIONS.manualResumeAsk).indexOf("'resume_request'") === -1,
              'resume_request belongs to the referral ladder, whose ending writes to a ' +
              'REFERRER — a store card has none, so borrowing the step writes to nobody');
    stAssert_(out, 'return: a refused leg does not burn an attempt',
              stCode_(manualResumeAskRun_).indexOf('(rs && rs.sent) || (rm && rm.sent)') !== -1,
              'with both legs refused nothing was asked, and the ladder would spend ' +
              'itself on silence — the fence taught this one');
    stAssert_(out, 'return: a résumé already filed SETTLES the ask',
              stCode_(HUB_ACTIONS.manualResumeAsk).indexOf('resume_present') !== -1,
              'asking somebody for a document we are already holding');
    // (b) the ear settles to 'answered', and the only automatic New → Phone Screen read open/exhausted only.
    var doorSrc = stCode_(manualCallDoorRun_);
    stAssert_(out, 'return: answering does not close the call door',
              doorSrc.indexOf("st === 'answered'") !== -1,
              'the person who did what we asked was the one it stopped recognising');
    stAssert_(out, 'return: and the STAGE is what makes that safe',
              doorSrc.indexOf("talentStage_(str_(ev.cand.status)) !== 'new'") !== -1,
              "with 'answered' accepted, an old call could drag somebody already at " +
              'Onboarding back to Phone Screen');
    // (c) in test mode the tester IS the recipient, so their reply is the card's reply — otherwise the only person…
    stAssert_(out, 'return: the testers may answer for a card while the redirect is live',
              typeof simTesterKeys_ === 'function' &&
              stCode_(manualContactScanRun_).indexOf('simTesterKeys_') !== -1 &&
              doorSrc.indexOf('simTesterKeys_') !== -1,
              'test mode redirects the ask to the tester and then waits for the candidate ' +
              'to reply — the round trip could never be walked');
    stAssert_(out, 'return: and it FAILS CLOSED, so production keeps one key',
              /catch\s*\([^)]*\)\s*\{\s*redir = null;/.test(stCode_(simTesterKeys_)) &&
              stCode_(simTesterKeys_).indexOf('if (!redir) return out;') !== -1,
              'an unreadable config falls through to PRODUCTION by design; an empty list ' +
              'there leaves every ear exactly as it was');
    stAssert_(out, 'first contact: the seeded words carry {opening}',
              !!fcSit && str_(fcSit.sms_text).indexOf('{opening}') !== -1 &&
              str_(fcSit.email_text).indexOf('{opening}') !== -1,
              'without the placeholder the row is a fixed referrer sentence again, and the ' +
              'four origins collapse back into one');
  }

  // ---- ONLY REACHABLE PEOPLE WAIT IN THE STORE --------------------------
  if (typeof tpArchiveNoContactMaybe_ !== 'undefined') {
    var nSrc = stCode_(tpArchiveNoContactMaybe_);
    stAssert_(out, 'no-contact: the same test the crossing door uses',
              nSrc.indexOf('str_(row.phone) || str_(row.email)') !== -1,
              'the store and the queue would disagree about who is reachable');
    stAssert_(out, 'no-contact: bounded per pass, and it names who it archived',
              nSrc.indexOf('TP_NOCONTACT_PER_PASS') !== -1 &&
              nSrc.indexOf('talent_nocontact_archived') !== -1,
              'a sweep that can rewrite two hundred rows silently is one nobody can undo');
  }

  // ---- CADENCES: the screen may not promise an ask that cannot happen ---- The retry pass re-presses `action`…
  if (typeof FLOW_CADENCE_STEPS !== 'undefined') {
    var lying = [];
    FLOW_CADENCE_STEPS.forEach(function (s) {
      var pressable = !!(s.action && typeof HUB_ACTIONS[s.action] === 'function');
      if (s.retry === 'pass' && !pressable) {
        lying.push(s.id + ' says the retry pass presses "' + s.action + '", and it is not a handler');
      }
      if (s.retry !== 'pass' && pressable) {
        lying.push(s.id + ' says it is not re-pressed, but "' + s.action + '" IS a handler');
      }
    });
    stAssert_(out, 'flow admin: every step tells the truth about whether it asks again',
              lying.length === 0, lying.join(' · '));
    stAssert_(out, 'flow admin: an unknown asking step is refused by name',
              stCode_(HUB_ACTIONS.flowCadenceRearm).indexOf('There is no asking step') !== -1,
              'a re-arm for a step nobody books must say which steps exist');
    // Re-arming is about the FUTURE of a conversation, never its history.
    stAssert_(out, 'flow admin: re-arming only touches asks that are still open',
              stCode_(HUB_ACTIONS.flowCadenceRearm).indexOf("!== 'open'") !== -1,
              'rewriting a closed ask would reopen a conversation that ended');
    stAssert_(out, 'flow admin: re-arming never rewrites how many times somebody was asked',
              stCode_(HUB_ACTIONS.flowCadenceRearm).indexOf('sentcount') === -1 &&
              stCode_(HUB_ACTIONS.flowCadenceRearm).indexOf('sent_count') === -1,
              'lowering the count would ask a real person all over again');
    // The floor does not clamp — it falls through.
    stAssert_(out, 'flow admin: the 5-minute floor still FALLS THROUGH rather than clamping',
              stCode_(simAttemptsFor_).indexOf('perMin >= 5') !== -1,
              'if this ever clamps instead, the cadence screen’s warning becomes wrong');
  }

  // ---- EVERY TRANSITION ASKS FOR SOMETHING ----------------------------- Onboarding → Hired returned ok:true…
  var gOb = hubGate_({ cand: { candidateid: 'CAN_TEST000000', status: 'Onboarding',
                               candidatename: 'T', email: '' }, analysis: {} });
  stAssert_(out, 'gate: a drag can never take a card from Onboarding to Hired',
            gOb.ok === false && gOb.from === 'onboarding' && gOb.to === 'hired',
            'the drag is open again — one gesture reaches Hired with nothing done');
  stAssert_(out, 'gate: the refusal names the button that IS the way through',
            String(gOb.reasons.join(' ')).indexOf('Manual onboarding') !== -1,
            'it states a rule without naming the door, which reads as "the platform is broken"');

  // The button attests; the drag does not.
  stAssert_(out, 'gate: the button records who attested, and which of the two stories it is',
            String(HUB_ACTIONS.onboardingManualComplete).indexOf('manual_onboarding_by') !== -1 &&
            String(HUB_ACTIONS.onboardingManualComplete).indexOf('manual_onboarding_method') !== -1,
            'an attestation with no author, or one that cannot tell a portal visit from an e-mail');
  stAssert_(out, 'gate: onboarding evidence has ONE definition',
            typeof hubOnboardingDone_ === 'function' &&
            String(hubHiredFacts_).indexOf('hubOnboardingDone_') !== -1 &&
            stCode_(hubHiredQuietCarry_).indexOf('hubHiredFacts_(') !== -1,
            'the sweep and the gate read the same fact two different ways');

  // ---- THE FIRST RUNG LOST BOTH ITS DOCUMENTS -------------------------- CJIS stopped blocking and the resume…
  var newEv = { cand: { candidateid: 'CAN_TEST000000', status: 'New',
                        candidatename: 'T', email: '', resumelink: '' }, analysis: {} };
  var gNew = hubGateFor_(newEv, 'new');
  stAssert_(out, 'gate: a card with no resume is no longer held at New for it',
            gNew.reasons.join(' · ').indexOf('resume on file') === -1,
            'the ladder is waiting for a document that is declared not required');
  stAssert_(out, 'gate: nor for the background report',
            gNew.reasons.join(' · ').indexOf('CJIS') === -1,
            'the NON-BLOCK law of 2026-08-25 has been reversed');
  stAssert_(out, 'gate: what the rung still waits for is the DECISION',
            gNew.ok === false && gNew.reasons.join(' · ').indexOf('resume decision Advance') !== -1,
            'a card would leave New with nobody having looked at it');
  var gDecided = hubGateFor_({ cand: { candidateid: 'CAN_TEST000000', status: 'New',
                                       candidatename: 'T', email: '', resumelink: '' },
                               analysis: { decisionstatus: 'Advance' } }, 'new');
  stAssert_(out, 'gate: an Advance with no document anywhere opens the rung',
            gDecided.ok === true && gDecided.to === 'phone-screen',
            'somebody screened by voice cannot be moved');
  stAssert_(out, 'gate: and the decision button no longer refuses that Advance either',
            [stCode_(HUB_ACTIONS.setDecision), stCode_(hubSetDecision_), stCode_(hubSetDecisionHeld_)]
              .join('\n').indexOf('requires a resume on file') === -1,
            'the rung would open and the button in front of it would still say no');
}

// ------------------------------------------------------------------ 5.
function stOcr_(out) {
  if (typeof clearanceDateFromText_ !== 'function') return;

  var cpr = 'American Heart Association\nBLS Provider\nDate Completed: 05/15/2025\nRenew By: 05/15/2027';
  stEq_(out, 'ocr: a CPR card reads its RENEW BY, not the day of the course',
        clearanceDateFromText_(cpr, 'cpr'), '2027-05-15');

  var lic = 'OHIO DRIVER LICENSE\nDOB 03/11/1988\nISS 01/02/2021\nEXP 03/11/2029';
  stEq_(out, 'ocr: a licence reads its EXP, never the date of birth',
        clearanceDateFromText_(lic, 'id'), '2029-03-11');

  var dodd = 'DODD 8 Hour Training\nExpires: 12/31/2026';
  stEq_(out, 'ocr: a labelled expiry is taken as the expiry',
        clearanceDateFromText_(dodd, 'dodd'), '2026-12-31');

  // Blank beats a guess: blank reads as "No" and gets chased; a wrong date is believed and never questioned.
  var nothing = 'This certificate is awarded for completion of the course.';
  stEq_(out, 'ocr: no date at all yields nothing, not a guess',
        clearanceDateFromText_(nothing, 'dodd'), '');

  var dobOnly = 'Name: John Smith\nDate of Birth: 04/09/1970';
  stEq_(out, 'ocr: a bare date of birth is never an expiry',
        clearanceDateFromText_(dobOnly, 'id'), '');
}

// ------------------------------------------------------------------ 6.
function stResolver_(out) {
  var audit = resolverAudit_();
  stEq_(out, 'resolver: nothing is undeclared', audit.undeclared_count, 0);
  stEq_(out, 'resolver: no declaration is malformed', audit.invalid.length, 0);
  stAssert_(out, 'resolver: the audit sees the whole surface',
            audit.actions_total >= 100, 'only ' + audit.actions_total + ' actions seen');

  // ---- the scorecard belongs to the interviewer ------------------------- Only the dedicated interviewer login…
  stAssert_(out, 'interview: the interviewer may record',
            interviewCanRecord_({ role: 'interviewer', email: 'i@asa' }) === true, '');
  stAssert_(out, 'interview: an admin may NOT record by virtue of being an admin',
            interviewCanRecord_({ role: 'admin', email: 'a@asa' }) === false,
            'a scorecard signed from a desk is indistinguishable from one signed in the room');
  stAssert_(out, 'interview: nor a manager',
            interviewCanRecord_({ role: 'manager', email: 'm@asa' }) === false, '');
  // THREE ROUTES IN, and each revokes where it was given — a grant must be holdable and revocable from both sides.
  stAssert_(out, 'interview: an address on the config list may record',
            typeof interviewScorecardEmails_ === 'function' &&
            stCode_(interviewCanRecord_).indexOf('interviewScorecardEmails_') !== -1,
            'the list in Hiring rules grants nothing');
  stAssert_(out, 'interview: the list is matched case-insensitively',
            stCode_(interviewScorecardEmails_).indexOf('toLowerCase') !== -1,
            'an address typed with a capital letter silently grants nothing');
  stAssert_(out, 'interview: an empty list admits nobody extra',
            interviewCanRecord_({ role: 'admin', email: 'a@asa' }) === false,
            'a blank cell opened the scorecard to everybody');
  // THE SCREEN MUST SHOW THE UNION.
  stAssert_(out, 'interview: the screen can see all three routes',
            typeof interviewWhoCanRecord_ === 'function' &&
            stCode_(HUB_ACTIONS.hiringAlertsGet).indexOf('interviewWhoCanRecord_') !== -1,
            'removing an address looks like a revocation and is not');

  // AND THE DOOR OUT MUST WORK, or this becomes a stage nobody can pass on the day the interviewer account is…
  stAssert_(out, 'interview: a granted permission still records',
            interviewCanRecord_({ role: 'admin', email: 'a@asa',
              overrides: { 'hiring.interview': true } }) === true,
            'narrowing the role with no escape hatch strands the whole pipeline');
  stAssert_(out, 'interview: the declaration admits that grant too',
            hubPolicyGate_('interviewSave', { candidate_id: 'CAN_X' },
              { role: 'manager', email: 'm@asa', overrides: { 'hiring.interview': true } }) === null,
            'the resolver refuses before the handler is reached — the grant is ornamental again');
  // Widening the window stays a recruiter's job — that IS theirs.
  stAssert_(out, 'interview: recruiters still widen the access window',
            stCode_(HUB_ACTIONS.interviewGet).indexOf('can_extend: hubIsWriter_') !== -1,
            'nobody can extend an interview window any more');

  // ---- the door must not refuse what the room would admit --------------- A handler that honours a per-user grant…
  var withGrant = { role: 'manager', email: 'm@asa', overrides: { 'hiring.dateManual': true } };
  stAssert_(out, 'resolver: a granted permission opens the door',
            hubPolicyGate_('screenSetDateAccepted', { candidate_id: 'CAN_X' }, withGrant) === null,
            'the delegated access still 403s at the declaration');
  stAssert_(out, 'resolver: the grant WIDENS and never narrows',
            hubPolicyGate_('screenSetDateAccepted', {}, { role: 'admin', email: 'a@asa' }) === null,
            'an admin lost access because a perm was declared');
  var noGrant = hubPolicyGate_('screenSetDateAccepted', {}, { role: 'manager', email: 'm@asa' });
  stAssert_(out, 'resolver: without the grant the door still refuses',
            noGrant && noGrant.status === 403,
            'declaring a perm opened the action to every role');
  stAssert_(out, 'resolver: the refusal names where the grant is given',
            noGrant && String(noGrant.message).indexOf('Access control') !== -1,
            'the person is told no with nothing to do about it');

  // A PERMISSION CANNOT BE GRANTED BY A SPREADSHEET.
  var cfgCatalog = hiringAlertsCatalog_();
  var cfgRows = cfgCatalog.rows;
  stAssert_(out, 'config: the catalogue answers, and says where it came from',
            cfgRows.length > 0 && (cfgCatalog.source === 'sheet' || cfgCatalog.source === 'shipped'),
            'the catalogue reader returned ' + cfgRows.length + ' row(s) from "' +
            cfgCatalog.source + '"');
  // ONE LIST, TWO SECTIONS: ST_CONFIG_GROUPS is what the catalogue section also checks the shipped copy against, so…
  var KNOWN_GROUPS = ST_CONFIG_GROUPS;
  var strayGroup = [];
  cfgRows.forEach(function (d) {
    var g = d.group || 'alerts';
    if (!KNOWN_GROUPS[g]) strayGroup.push(d.key + ' → "' + g + '"');
  });
  stAssert_(out, 'config: every key belongs to a group a screen renders',
            strayGroup.length === 0,
            'a key nobody can reach: ' + strayGroup.join(', '));
  // Each group must actually HAVE keys.
  var counts = {};
  cfgRows.forEach(function (d) {
    var g = d.group || 'alerts';
    counts[g] = (counts[g] || 0) + 1;
  });
  // THE MESSAGES GROUP IS HISTORY — the texts ARE Smart Comms now.
  stAssert_(out, 'config: the messages group is history, every row is a msg_ key',
            (counts.messages || 0) > 0 &&
            cfgRows.every(function (d) {
              return d.group !== 'messages' || d.key.indexOf('msg_') === 0;
            }),
            'a messages-group key that is not a retired template');
  // AND THE NOTE — WHICH IS THE SHEET'S TO CARRY, SO IT IS ASSERTED WHERE A SHEET ANSWERS, AND SKIPPED OUT LOUD…
  if (cfgCatalog.read) {
    stAssert_(out, 'config: every retired message row says it moved to Smart Comms',
              cfgRows.every(function (d) {
                return d.group !== 'messages' ||
                       String(d.note).indexOf('moved to Smart Comms') !== -1;
              }),
              'a messages-group key without the moved-to-Smart-Comms note reads as live');
  } else {
    stSkip_(out, 'config: every retired message row says it moved to Smart Comms',
            'no catalogue sheet answered here (source "' + cfgCatalog.source + '"), and the ' +
            'last-resort copy carries no notes by design — the same sentence is asserted by ' +
            'tools/check-alerts-catalogue.mjs against tools/hiring-alerts-catalogue.json');
  }
  stAssert_(out, 'config: every message key IS in the messages group',
            cfgRows.every(function (d) {
              return d.key.indexOf('msg_') !== 0 || d.group === 'messages';
            }),
            'a message template is hiding on another screen');
  // And every old key feeds its situation row through the migration map — the one reader that keeps…
  var migFed = {};
  if (typeof SMART_HIRING_MIGRATION !== 'undefined') {
    SMART_HIRING_MIGRATION.forEach(function (m) {
      for (var cell in m.cells) if (m.cells.hasOwnProperty(cell)) migFed[m.cells[cell]] = m.id;
    });
  }
  stAssert_(out, 'config: every retired message key feeds a Smart Comms row',
            cfgRows.every(function (d) {
              return d.group !== 'messages' || !!migFed[d.key];
            }),
            'a msg_* key the migration never copies is a text that silently died');

  // The seeder appends under a lock and re-reads inside it.
  stAssert_(out, 'config: the seeder cannot append the same key twice',
            stCode_(hiringAlertsSheet_).indexOf('tryLock') !== -1 &&
            stCode_(hiringAlertsSheet_).indexOf('sheet.getDataRange().getValues()') !== -1,
            'read-then-append with no lock, on an account running 30 executions at once');
  stAssert_(out, 'config: an unlocked run still seeds rather than skipping',
            stCode_(hiringAlertsSheet_).indexOf('missing.forEach') !== -1,
            'a key that never arrives is worse than one that arrives twice');

  // THE WIDEST READ ON THIS PLATFORM WAS THE LEAST DECLARED.
  stAssert_(out, 'resolver: the performance board is not open to any session',
            (HUB_POLICY.perfBoard.roles || []).length > 0 &&
            HUB_POLICY.perfBoard.roles.indexOf('client') === -1,
            'a client or onboarding account reads every employee scorecard');

  // The gate must refuse a role the handler itself refuses, and let through one it allows.
  var admin = { role: 'admin', email: 'selftest@asa' };
  var staff = { role: 'staff', email: 'selftest@asa' };
  var adminOnly = null;
  for (var a in HUB_POLICY) {
    if (!HUB_POLICY.hasOwnProperty(a)) continue;
    var roles = HUB_POLICY[a].roles || [];
    if (roles.length === 1 && roles[0] === 'admin') { adminOnly = a; break; }
  }
  if (adminOnly) {
    stAssert_(out, 'resolver: an admin passes the gate on an admin-only action',
              hubPolicyGate_(adminOnly, {}, admin) === null, 'the gate refused an admin');
    var refused = hubPolicyGate_(adminOnly, {}, staff);
    stAssert_(out, 'resolver: a staff account is refused on an admin-only action',
              refused && refused.status === 403, 'the gate let staff through');
  }

  // The service identity reads as a machine and must not be role-gated into a corner — it is refused by…
  stAssert_(out, 'resolver: the service identity is not blocked by the role gate',
            hubPolicyGate_(adminOnly || 'resolverAudit', {}, { is_service: true, role: 'manager' }) === null,
            'the role gate blocked the machine');
}

// ------------------------------------------------------------------ 7.
function stRpc_(out) {
  var undeclared = rpcCall_('thisMethodDoesNotExist', {}, { dry_run: true });
  stAssert_(out, 'rpc: an undeclared method is refused',
            undeclared.ok === false && undeclared.error === 'undeclared_method',
            'an undeclared call was accepted');

  var missing = rpcCall_('smsSend', { to: '+13309195558', reason: 'self-test' }, { dry_run: true });
  stAssert_(out, 'rpc: a missing required parameter is refused at home',
            missing.ok === false && missing.error === 'missing_param',
            'sent without a body');

  var ok = rpcCall_('smsSend',
    { to: '+13309195558', body: 'self-test', reason: 'self-test' }, { dry_run: true });
  stAssert_(out, 'rpc: a complete call passes validation', ok.ok === true, ok.detail);
  stAssert_(out, 'rpc: a dry run never reports having sent', ok.sent !== true,
            'DRY RUN REPORTED sent:true — the gate leaks');

  // Every declared method must have something that carries it, or the contract describes a promise nothing keeps.
  for (var m in HUB_RPC) {
    if (!HUB_RPC.hasOwnProperty(m)) continue;
    var c = HUB_RPC[m];
    stAssert_(out, 'rpc: "' + m + '" declares what carries it and why',
              !!c.channel && !!c.what, 'channel or description missing');
    stAssert_(out, 'rpc: "' + m + '" says whether it reaches a person',
              c.reaches_a_person === true || c.reaches_a_person === false,
              'reaches_a_person is not declared');
  }

  // The masking exists so a phone number never lands in a log in full.
  var masked = rpcSafeParams_({ to: '+13309195558', body: 'x' });
  stAssert_(out, 'rpc: a number is masked before it can be logged',
            String(masked.to).indexOf('3309195') === -1,
            'the full number survived masking: ' + masked.to);
}

// ------------------------------------------------------------------ 8.
function stLive_(out) {
  var ss = ssOpen_(hubId_('HUB_DB_ID'));
  var cands = readTabNormalized_(ss, TALENT_CANDIDATES_TAB);
  out.live = { candidates: cands.length };

  // Every live card must belong to a column on the board.
  var orphans = [], offBoard = 0;
  cands.forEach(function (c) {
    if (str_(c.archived).toLowerCase() === 'true') return;
    if (typeof talentTerminal_ === 'function' && talentTerminal_(c.status)) { offBoard++; return; }
    var st = talentStage_(c.status);
    if (!st || (typeof TALENT_STAGE_ORDER !== 'undefined' && TALENT_STAGE_ORDER.indexOf(st) === -1)) {
      orphans.push(str_(c.candidatename) + ' [' + str_(c.status) + ']');
    }
  });
  out.live.offBoard = offBoard;
  stAssert_(out, 'live: every card lands in a stage the board renders, or was declined',
            orphans.length === 0, orphans.slice(0, 6).join(' · '));

  // A duplicate id would make "the card" ambiguous everywhere it is used.
  var seen = {}, dupes = [];
  cands.forEach(function (c) {
    var id = str_(c.candidateid);
    if (!id) return;
    if (seen[id]) dupes.push(id); else seen[id] = true;
  });
  stAssert_(out, 'live: candidate ids are unique', dupes.length === 0, dupes.slice(0, 5).join(', '));

  // A held card with no hold date, or a hold date on a card that is not at onboarding, means the two halves of the…
  var badHold = [];
  cands.forEach(function (c) {
    if (!str_(c.packetholduntil)) return;
    if (talentStage_(c.status) !== 'onboarding') {
      badHold.push(str_(c.candidatename) + ' held but at ' + talentStage_(c.status));
    }
  });
  stAssert_(out, 'live: nobody carries a packet hold outside Onboarding',
            badHold.length === 0, badHold.slice(0, 5).join(' · '));

  // ── THE SITUATIONS AS THE HOUSE ACTUALLY HOLDS THEM ─────────────────── THIS IS THE PIN THAT WAS MISSING, and…
  var liveSits = null;
  try { liveSits = smartSituations_(); } catch (eSit) { liveSits = null; }
  stAssert_(out, 'live: the situations house is readable — a check that cannot see it must say so, not pass',
            liveSits !== null && liveSits.length > 0,
            'smartSituations_ answered ' + (liveSits === null ? 'with a throw' : 'nothing'));
  if (liveSits && liveSits.length) {
    out.live.situations = liveSits.length;
    var seedCallOff = {};
    smartDefaults_().forEach(function (d) {
      if (String(d.kind) === 'call_off') seedCallOff[String(d.id)] = d;
    });
    var liveWordy = [], liveDeadTo = [], liveNoWords = [], liveDrift = [];
    liveSits.forEach(function (s) {
      var id = String(s.id || '');
      // A CALL-OFF ROW MAY CARRY WORDS ONLY ON A CHANNEL IT NAMES.
      if (seedCallOff[id]) {
        var liveChans = smartList_(s.channels).map(function (c) { return c.toLowerCase(); });
        [['sms_text', 'sms'], ['email_subject', 'email'], ['email_text', 'email']]
          .forEach(function (pair) {
            if (!String(s[pair[0]] || '').trim()) return;
            if (liveChans.indexOf(pair[1]) !== -1) return;       // words for a channel it names
            liveWordy.push(id + (smartOn_(s.enabled) ? ' (ON!)' : '') +
                           '.' + pair[0] + ' = "' + String(s[pair[0]]).slice(0, 40) +
                           '" on a channel this row does not name');
          });
        // AND WHICH OF THOSE IS THE CODE'S OWN PLANTING.
        ['sms_text', 'email_subject', 'email_text'].forEach(function (f) {
          if (smartUnwrittenWords_(s, f)) liveDrift.push(id + '.' + f);
        });
      }
      /* AND AN ENABLED ROW THAT NAMES A `to` MUST NAME SOMEBODY. */
      if (smartOn_(s.enabled) && smartList_(s.to).length && !smartAddressable_(s.to)) {
        liveDeadTo.push(id + ': "' + String(s.to).slice(0, 30) + '"');
      }
      // AND AN ENABLED ROW THAT NAMES A CHANNEL MUST HAVE WORDS FOR IT — otherwise it is a lane that looks alive…
      if (smartOn_(s.enabled) && String(s.kind || '') !== 'ai') {
        var chans = smartList_(s.channels).map(function (c) { return c.toLowerCase(); });
        if (chans.indexOf('sms') !== -1 && !String(s.sms_text || '').trim()) liveNoWords.push(id + ' sms');
        if (chans.indexOf('email') !== -1 && !String(s.email_subject || '').trim()) liveNoWords.push(id + ' email');
      }
    });
    stAssert_(out, 'live: a call-off row in the house carries words only on a channel it names — a template on any other is drift',
              liveWordy.length === 0,
              'somebody would be sent words nobody wrote for them: ' + liveWordy.join(' · '));
    out.live.words_unwritten = liveDrift.length;
    stAssert_(out, 'live: no house cell holds the generic credential letter behind a call-off row — and the send door refuses it either way',
              liveDrift.length === 0,
              'the code planted these, nobody wrote them, and the send door will refuse the ' +
              'channel until they are written or blanked: ' + liveDrift.join(' · '));
    stAssert_(out, 'live: no switched-on situation carries a `to` that addresses nobody',
              liveDeadTo.length === 0,
              'these look armed and reach nobody: ' + liveDeadTo.join(' · '));
    stAssert_(out, 'live: every switched-on situation has words for every channel it names',
              liveNoWords.length === 0,
              'these would send an empty message, or nothing at all: ' + liveNoWords.join(' · '));
  }

  // The mirror the packet state reads from.
  var mirror = packetMirrorRows_();
  out.live.envelopes = mirror.length;
  stAssert_(out, 'live: the Dropbox Sign mirror has rows',
            mirror.length > 0, 'the mirror is empty — runRecruitmentSync has not landed');

  // Every candidate resolves to a packet state without throwing.
  var broke = [];
  cands.slice(0, 60).forEach(function (c) {
    try { packetState_(c, mirror); }
    catch (e) { broke.push(str_(c.candidatename) + ': ' + String((e && e.message) || e)); }
  });
  stAssert_(out, 'live: the packet state computes for every card',
            broke.length === 0, broke.slice(0, 4).join(' · '));
}


// ------------------------------------------------------------------ 9.
function stOnboarding_(out) {
  if (typeof onboardingChecklist_ !== 'function' || typeof ONB_CHECKLIST === 'undefined') {
    stAssert_(out, 'onboarding: the checklist builder exists', false, 'missing');
    return;
  }
  var none = { state: 'unknown', label: 'not found' };
  var rows = onboardingChecklist_({}, 'packet', '', none, {});

  stEq_(out, 'onboarding: every checklist row is drawn', rows.length, ONB_CHECKLIST.length);

  // EVERY row must carry its stage.
  var noStage = rows.filter(function (r) { return !r.stage; });
  stAssert_(out, 'onboarding: every row knows which step it belongs to',
            noStage.length === 0,
            noStage.map(function (r) { return r.id; }).join(', '));

  var badStage = rows.filter(function (r) { return ONB_STAGES.indexOf(r.stage) === -1; });
  stAssert_(out, 'onboarding: no row claims a step that does not exist',
            badStage.length === 0, badStage.map(function (r) { return r.id + '=' + r.stage; }).join(', '));

  var ids = {};
  rows.forEach(function (r) { ids[r.id] = (ids[r.id] || 0) + 1; });
  var dupe = Object.keys(ids).filter(function (k) { return ids[k] > 1; });
  stAssert_(out, 'onboarding: row ids are unique', dupe.length === 0, dupe.join(', '));

  // --- the packet row answers to Dropbox Sign, not to a local flag ----
  var signed = onboardingChecklist_({}, 'packet', '', { state: 'signed', label: 'signed' }, {});
  var packetRow = signed.filter(function (r) { return r.id === 'new-hire-packet'; })[0];
  stEq_(out, 'onboarding: a signed envelope closes the packet row',
        packetRow && packetRow.status, 'done');

  var unsigned = onboardingChecklist_({}, 'packet', '', { state: 'unsigned', label: 'not signed' }, {});
  var pr2 = unsigned.filter(function (r) { return r.id === 'new-hire-packet'; })[0];
  stAssert_(out, 'onboarding: an unsigned envelope does NOT close the packet row',
            pr2 && pr2.status !== 'done', 'an unsigned packet was marked done');

  // `unknown` is OUR failure, not an accusation: 243 of 423 people have no envelope at all.
  var uploaded = onboardingChecklist_({ dropbox_packet: { status: 'verified' } }, 'packet', '',
                                      { state: 'unknown', label: 'not found' }, {});
  var pr3 = uploaded.filter(function (r) { return r.id === 'new-hire-packet'; })[0];
  stEq_(out, 'onboarding: a hand-verified packet survives an unmatched envelope',
        pr3 && pr3.status, 'done');

  // The recruiter already recorded the background result upstream; asking for the same report twice is asking a…
  var cjis = onboardingChecklist_({}, 'background', 'Clear', none, {});
  var bg = cjis.filter(function (r) { return r.id === 'background-check'; })[0];
  stEq_(out, 'onboarding: a clear CJIS result closes the background row',
        bg && bg.status, 'done');

  // A step that has not been reached yet is PENDING, not MISSING.
  var early = onboardingChecklist_({}, 'packet', '', none, {});
  var future = early.filter(function (r) { return r.stage === 'training' && r.doc; });
  var wrongly = future.filter(function (r) { return r.status === 'missing'; });
  stAssert_(out, 'onboarding: a step not yet reached is pending, never missing',
            wrongly.length === 0, wrongly.map(function (r) { return r.id; }).join(', '));

  // IDENTITY COMES FROM THE SESSION, NEVER FROM THE PAYLOAD.
  stAssert_(out, 'onboarding: a staff session may not name anybody else',
            obMayAddressOther_({ role: 'staff', email: 's@asa' }) === false, '');
  stAssert_(out, 'onboarding: the shared seat may, because the account is not the person',
            obMayAddressOther_({ role: 'onboarding', email: 'onboarding@asalifecare.com' }) === true, '');
  // THE BADGE IS NOT THE SEAT.
  stAssert_(out, 'onboarding: the onboarding badge alone is not the seat',
            obMayAddressOther_({ role: 'onboarding', email: 'someone.else@asalifecare.com' }) === false, '');
  stAssert_(out, 'onboarding: the seat is the declared account, wherever its role lands',
            seatIsSeatAccount_({ email: 'ONBOARDING@asalifecare.com' }) === true &&
            seatIsSeatAccount_({ email: 'onboarding@asaop.org' }) === false &&
            seatIsSeatAccount_({}) === false, '');
  stAssert_(out, 'onboarding: a writer and the machine may',
            obMayAddressOther_({ role: 'admin' }) === true &&
            obMayAddressOther_({ role: 'manager' }) === true &&
            obMayAddressOther_({ is_service: true, role: 'staff' }) === true, '');
  stAssert_(out, 'onboarding: a client and a session that is not there may not',
            obMayAddressOther_({ role: 'client' }) === false &&
            obMayAddressOther_(null) === false, '');

  // The doors must ASK before honouring a typed address.
  ['packetState', 'packetUpload', 'obFlow'].forEach(function (name) {
    var src = stCode_(HUB_ACTIONS[name]);
    stAssert_(out, 'onboarding: ' + name + ' honours a typed address only for callers entitled to',
              src.indexOf('obMayAddressOther_(user)') !== -1 &&
              src.indexOf('str_(payload.email) || str_(user.email)') === -1, '');
  });
  stAssert_(out, 'onboarding: the name claim belongs to the seat, not to a parameter',
            stCode_(HUB_ACTIONS.obSetName).indexOf('obMayAddressOther_(user)') !== -1, '');
  stAssert_(out, 'onboarding: the window of a stranger is refused',
            stCode_(HUB_ACTIONS.onboardingWindowGet).indexOf('obMayAddressOther_(user)') !== -1, '');
}

// ------------------------------------------------------------------ 10.
function stExceptions_(out) {
  if (typeof REFERRAL_STAGE_ORDER === 'undefined') {
    stAssert_(out, 'exceptions: the referral stage order exists', false, 'missing');
    return;
  }
  // Hired is reached by finishing onboarding, never by typing somebody in.
  stAssert_(out, 'exceptions: a referral can never be placed straight into Hired',
            REFERRAL_STAGE_ORDER.indexOf('hired') === -1,
            'hired is reachable by insertion');
  stAssert_(out, 'exceptions: onboarding IS reachable — that is the exception asked for',
            REFERRAL_STAGE_ORDER.indexOf('onboarding') !== -1,
            'the fast lane cannot reach onboarding');

  // Skipped stages are written as SKIPPED.
  if (typeof HUB_STAGE_TO_STATUS !== 'undefined') {
    stAssert_(out, 'exceptions: every fast-lane stage has a real status to be written as',
              REFERRAL_STAGE_ORDER.every(function (s) { return !!HUB_STAGE_TO_STATUS[s]; }),
              'a fast-lane stage has no status');
  }
}


// ------------------------------------------------------------------ 11.
function stRpcPath_(out) {
  if (typeof rpcSend_ !== 'function') {
    stAssert_(out, 'rpc path: the transport exists', false, 'rpcSend_ missing');
    return;
  }
  // The provider verdict, tested where it lives.
  var vHtml = rpcProviderVerdict_(200, '<html>maintenance</html>');
  stAssert_(out, 'rpc path: a 200 of HTML is NOT a delivery',
            vHtml.ok === false && vHtml.error === 'provider_bad_shape', JSON.stringify(vHtml));
  var vNoId = rpcProviderVerdict_(200, '{"ok":true}');
  stAssert_(out, 'rpc path: a 2xx with no message id is NOT a delivery',
            vNoId.ok === false, JSON.stringify(vNoId));
  var vEmpty = rpcProviderVerdict_(204, '');
  stAssert_(out, 'rpc path: an empty 2xx is NOT a delivery', vEmpty.ok === false, JSON.stringify(vEmpty));
  var vGood = rpcProviderVerdict_(202, '{"data":{"id":"MSG123"}}');
  stAssert_(out, 'rpc path: a real message id IS a delivery',
            vGood.ok === true && vGood.sent === true && vGood.receipt === 'MSG123', JSON.stringify(vGood));
  var v4xx = rpcProviderVerdict_(422, '{"message":"invalid to +13305551234"}');
  stAssert_(out, 'rpc path: a refusal is a failure', v4xx.ok === false, JSON.stringify(v4xx));
  stAssert_(out, 'rpc path: the provider sentence is not carried into the log',
            String(v4xx.detail).indexOf('3305551234') === -1,
            'the rejected number rode up in detail: ' + v4xx.detail);

  var calls = [];
  var real = RPC_TEST_TRANSPORT;
  var was = null;
  // The brake answers "I cannot read the list" with no spreadsheet, and refusing is exactly right (stOptOut_…
  var realOptOut = (typeof optOutIndex_ === 'function') ? optOutIndex_ : null;
  if (realOptOut) optOutIndex_ = function () { return { by: {}, error: '' }; };
  // THE PROVIDER FLOOR, FOR THE WHOLE SECTION.
  var providerCalls = [];
  var realProvider = { sms: rpcOpenPhoneSms_, mail: platformMailOut_, team: hubTeamNotify_ };
  rpcOpenPhoneSms_ = function () {
    providerCalls.push('sms');
    return { ok: false, sent: false, gated: false, error: 'self_test_floor',
             detail: 'the self-test refused a provider call' };
  };
  platformMailOut_ = function () { providerCalls.push('mail'); return { sent: false, receipt: '' }; };
  hubTeamNotify_ = function () { providerCalls.push('team'); return { sms: 0, email: 0 }; };
  // AND THE BOOKS, FOR THE WHOLE SECTION.
  var bookRows = [], bookLines = [];
  // the dial is memoised per execution: a row written under the stood-in switch must not leave its word behind
  var realBooks = { write: commMockWrite_, log: hubSysLog_, dead: COMM_MOCK_DEAD,
                    written: COMM_MOCK_WRITTEN, now: HUB_QUIET_NOW,
                    dialMemo: COMM_DIAL_MEMO, dialUnreadable: COMM_DIAL_UNREADABLE };
  commMockWrite_ = function (row) { bookRows.push(row || {}); };
  hubSysLog_ = function (who, what) { bookLines.push(String(what || '')); return true; };
  COMM_MOCK_DEAD = {};
  COMM_MOCK_WRITTEN = 0;
  // the section is about the transport, not the night: a daytime instant, so it asserts the same at any hour
  HUB_QUIET_NOW = (typeof ST_QUIET_DAYTIME !== 'undefined') ? ST_QUIET_DAYTIME : '2026-09-22T16:00:00Z';
  // AND THE SEND SWITCH IS STOOD IN FOR ONLY WHERE A STAND-IN TRANSPORT IS.
  var realAlerts = (typeof hiringAlerts_ === 'function') ? hiringAlerts_ : null;
  try {
    // 1.
    RPC_TEST_TRANSPORT = null;
    var props = PropertiesService.getScriptProperties();
    was = props.getProperty(RPC_SEND_PROP);
    for (var m in HUB_RPC) {
      if (!HUB_RPC.hasOwnProperty(m)) continue;
      RPC_TEST_TRANSPORT = function (name) {
        return { ok: true, sent: true, gated: false, method: name, receipt: 'stand-in' };
      };
      var r = rpcSend_(m, HUB_RPC[m], {});
      stAssert_(out, 'rpc path: "' + m + '" reaches a transport',
                r && r.error !== 'no_transport', 'declared but nothing carries it');
    }

    // 2.
    RPC_TEST_TRANSPORT = null;
    if (!rpcSendEnabled_()) {
      var gated = rpcSend_('smsSend', HUB_RPC.smsSend,
                           { to: '+13309195558', body: 'x', reason: 'self-test' });
      stAssert_(out, 'rpc path: the transport itself refuses while sending is off',
                gated && gated.sent !== true,
                'rpcSend_ SENT with HUB_RPC_SEND off');
    } else {
      stSkip_(out, 'rpc path: the transport itself refuses while sending is off',
              'sending is ON in this project, so there is nothing for the transport to refuse — the ' +
              'law is asserted wherever sending is off (the node runner, a paused project)');
    }
    if (realAlerts) hiringAlerts_ = function () { return { test_mode: 'off' }; };

    // 3.
    RPC_TEST_TRANSPORT = function (name) {
      return { ok: false, sent: false, gated: false, method: name,
               error: 'provider_bad_shape' };
    };
    RPC_TEST_FORCE_ON = true;
    var bad = rpcCall_('smsSend',
      { to: '+13309195558', body: 'x', reason: 'self-test' }, {});
    stAssert_(out, 'rpc path: an unprovable send is a failure, never a success',
              bad.ok === false && bad.sent !== true, JSON.stringify(bad));

    // 4. The same logical request twice reaches a person once.
    RPC_TEST_TRANSPORT = function (name) {
      calls.push(name);
      return { ok: true, sent: true, gated: false, method: name, receipt: 'stand-in' };
    };
    var key = 'selftest_' + new Date().getTime();
    var first = rpcCall_('smsSend',
      { to: '+13309195558', body: 'x', reason: 'self-test' }, { idempotency_key: key });
    var second = rpcCall_('smsSend',
      { to: '+13309195558', body: 'x', reason: 'self-test' }, { idempotency_key: key });
    if (first.sent) {
      stAssert_(out, 'rpc path: the same request twice sends once',
                second.deduplicated === true && second.sent !== true,
                'the second call sent again: ' + JSON.stringify(second));
    }
  } catch (e) {
    stAssert_(out, 'rpc path: the section ran', false, String((e && e.message) || e));
  } finally {
    // ALWAYS.
    RPC_TEST_FORCE_ON = false;
    RPC_TEST_TRANSPORT = real || null;
    if (realOptOut) optOutIndex_ = realOptOut;
    if (realAlerts) hiringAlerts_ = realAlerts;
    rpcOpenPhoneSms_ = realProvider.sms;
    platformMailOut_ = realProvider.mail;
    hubTeamNotify_ = realProvider.team;
    commMockWrite_ = realBooks.write;
    hubSysLog_ = realBooks.log;
    COMM_MOCK_DEAD = realBooks.dead;
    COMM_MOCK_WRITTEN = realBooks.written;
    HUB_QUIET_NOW = realBooks.now;
    COMM_DIAL_MEMO = realBooks.dialMemo;
    COMM_DIAL_UNREADABLE = realBooks.dialUnreadable;
  }
  stAssert_(out, 'rpc path: no provider was knocked on — not one SMS, e-mail or team page left this section',
            providerCalls.length === 0, 'provider calls: ' + providerCalls.join(', '));
  stAssert_(out, 'rpc path: the rows and log lines the stood-in sends produce land in recorders, never in the ' +
                 'live mock outbox or the live log — a `sent` row for a message nothing carried is a false record',
            bookRows.length > 0 && bookRows.some(function (r) { return String(r.result) === 'sent'; }) &&
            bookLines.indexOf('rpc_sent') !== -1 &&
            commMockWrite_ === realBooks.write && hubSysLog_ === realBooks.log,
            'rows=' + bookRows.length + ' lines=' + bookLines.join(','));
  // The property is not restored because it is never written.
  stAssert_(out, 'rpc path: the test never writes the global send switch',
            (function () {
              try {
                var now = PropertiesService.getScriptProperties().getProperty(RPC_SEND_PROP);
                return String(now || '') === String(was || '');
              } catch (e2) { return false; }
            })(),
            'HUB_RPC_SEND was changed by the test — every concurrent execution shares it');
  stAssert_(out, 'rpc path: the per-execution override is off again',
            RPC_TEST_FORCE_ON === false, 'RPC_TEST_FORCE_ON was left set');
  // And the override must be INERT on its own: on, with nothing to stop it, is the state that would have reached…
  stAssert_(out, 'rpc path: forcing sending on without a stand-in changes nothing',
            (function () {
              var t = RPC_TEST_TRANSPORT, f = RPC_TEST_FORCE_ON;
              try {
                RPC_TEST_TRANSPORT = null;
                RPC_TEST_FORCE_ON = false; var whenOff = rpcSendEnabled_();
                RPC_TEST_FORCE_ON = true;  var whenOn = rpcSendEnabled_();
                return whenOn === whenOff;
              } finally { RPC_TEST_TRANSPORT = t; RPC_TEST_FORCE_ON = f; }
            })(),
            'RPC_TEST_FORCE_ON changed the answer with no stand-in installed');
  stAssert_(out, 'rpc path: the stand-in transport is put back',
            RPC_TEST_TRANSPORT === null || RPC_TEST_TRANSPORT === real, 'left set');
}


// ------------------------------------------------------------------ 12.
function stAmberRecipients_(out) {
  if (typeof PACKET_AMBER_SMS_FLOOR === 'undefined') {
    stAssert_(out, 'amber: the required recipients exist', false, 'floor missing');
    return;
  }
 // THE ASSERTION IS THE PROPERTY, NOT THE PEOPLE.
  var floorKeys = PACKET_AMBER_SMS_FLOOR.map(function (x) {
    return String(x).replace(/\D/g, '').slice(-10);
  });
  stAssert_(out, 'amber: the shipped floor names the three responsible people',
            floorKeys.indexOf('3309195559') !== -1 &&
            floorKeys.indexOf('3309197779') !== -1 &&
            floorKeys.indexOf('3309195558') !== -1,
            'the fallback the platform ships with changed: ' + floorKeys.join(', '));
  stAssert_(out, 'amber: the phone-screen line is NOT paged',
            floorKeys.indexOf('3307544040') === -1,
            'escalations are landing in the middle of screening traffic');

  // THE FLOOR IN FORCE cannot be emptied.
  if (typeof packetAmberFloor_ === 'function') {
    var live = packetAmberFloor_();
    stAssert_(out, 'amber: the floor in force reaches somebody',
              !!(live && live.length),
              'an escalation narrowed to nobody is the one that goes missing');
    stAssert_(out, 'amber: the live floor keeps the phone-screen line free',
              live.map(function (x) {
                return String(x).replace(/\D/g, '').slice(-10);
              }).indexOf('3307544040') === -1,
              'somebody put the screening line on the escalation floor');
  }

  // The union must never drop one of them, whatever the config holds.
  if (typeof packetAmberRecipients_ === 'function') {
    var got = packetAmberRecipients_().map(function (x) {
      return String(x).replace(/\D/g, '').slice(-10);
    });
    var lost = floorKeys.filter(function (k) { return got.indexOf(k) === -1; });
    stAssert_(out, 'amber: the configured list can add but never remove',
              lost.length === 0, 'dropped: ' + lost.join(', '));
    var dupes = got.filter(function (k, i) { return got.indexOf(k) !== i; });
    stAssert_(out, 'amber: nobody is texted twice for one card',
              dupes.length === 0, 'duplicated: ' + dupes.join(', '));
  }
}

// ------------------------------------------------------------------ 14.
function stMorningFixes_(out) {
  // 1.
  if (typeof packetIsRehearsal_ === 'function') {
    stAssert_(out, 'rehearsal: a "[test]" name is a rehearsal whatever number it carries',
              packetIsRehearsal_({ candidatename: '[test] Someone', phone: '+13305551234' }) === true,
              'a test card with a real number would have been texted');
    stAssert_(out, 'rehearsal: the test line is a rehearsal',
              packetIsRehearsal_({ candidatename: 'Someone', phone: '+1 330 919-5558' }) === true, '');
    stAssert_(out, 'rehearsal: an ordinary card is NOT a rehearsal',
              packetIsRehearsal_({ candidatename: 'Jane Doe', phone: '+13305551234' }) === false,
              'a real applicant was classified as a test');
  } else {
    stAssert_(out, 'rehearsal: the recogniser exists', false, 'packetIsRehearsal_ missing');
  }

  // 2.
  if (typeof clearanceExpiryMs_ === 'function') {
    var jan = clearanceExpiryMs_('20260101');
    var dash = clearanceExpiryMs_('2026-01-01');
    stAssert_(out, 'clearance: YYYYMMDD and YYYY-MM-DD are the same day',
              jan !== null && jan === dash, jan + ' vs ' + dash);
    stAssert_(out, 'clearance: a date earlier this year IS in the past',
              jan < new Date(2026, 7, 7).getTime(),
              'the string compare bug is back: 20260101 read as not expired');
    stAssert_(out, 'clearance: a date that is not a date reads as unknown, never expired',
              clearanceExpiryMs_('see attached') === null &&
              clearanceExpiryMs_('2026-02-31') === null, '');
  } else {
    stAssert_(out, 'clearance: the date reader exists', false, 'clearanceExpiryMs_ missing');
  }

  // 3.
  var vocab = ['valid', 'expiring', 'expired', 'missing'];
  var src = String(typeof clearanceApply_ === 'function' ? clearanceApply_ : '');
  stAssert_(out, 'clearance: it writes no status the matrix cannot render',
            src.indexOf("status: 'submitted'") === -1 && src.indexOf("status: 'verified'") === -1,
            'clearanceApply_ still writes a word outside ' + vocab.join('|'));

  // 4. The packet columns are created before they are written.
  stAssert_(out, 'packet: something creates the packet_* columns',
            typeof packetEnsureColumns_ === 'function',
            'nothing creates them — every write would be dropped in silence');

  // 5.
  if (typeof hubHiredSweep_ === 'function') {
    stAssert_(out, 'graduation: the sweep collects the final stage as well',
              String(hubHiredSweep_).indexOf("'internal-docs'") !== -1,
              'a card dragged past becoming-staff never gets an account');
  }
}

// ------------------------------------------------------------------ 15.
function stPrivate_(out) {
  // THE DECLARED STAMP.
  var cfgS = { stampWhen: { field: 'column', equals: 'done', stamp: 'completedAt', clearOnLeave: true } };
  var p1 = { column: 'done' };
  hubStampWhen_(cfgS, { column: 'in-progress' }, p1);
  stAssert_(out, 'tasks: landing in Done stamps completedAt', !!p1.completedAt, JSON.stringify(p1));

  var p2 = { column: 'in-progress' };
  hubStampWhen_(cfgS, { column: 'done', completedAt: '2026-01-01T00:00:00Z' }, p2);
  stAssert_(out, 'tasks: leaving Done clears completedAt', p2.completedAt === '',
            'a reopened card kept its completion date, and every "finished this week" count is wrong');

  // Editing a done card must NOT re-date it — the patch does not touch `column`.
  var p3 = { title: 'renamed' };
  hubStampWhen_(cfgS, { column: 'done', completedAt: '2026-01-01T00:00:00Z' }, p3);
  stAssert_(out, 'tasks: editing a done card does not re-date it',
            p3.completedAt === undefined, 'renaming a card moved when it was finished');

  // Already in Done and saved again: same column, so nothing is rewritten.
  var p4 = { column: 'done' };
  hubStampWhen_(cfgS, { column: 'done', completedAt: '2026-01-01T00:00:00Z' }, p4);
  stAssert_(out, 'tasks: re-saving a done card keeps the original date',
            p4.completedAt === undefined, 'the completion date moved on an unrelated save');

  if (typeof hubRedactAnswer_ !== 'function') {
    stAssert_(out, 'private: the redactor is loaded', false, 'hubRedactAnswer_ missing');
    return;
  }
  var gone = function (name, k, v) {
    stAssert_(out, 'private: ' + name, hubRedactAnswer_(k, v) === null,
              'kept: ' + JSON.stringify(hubRedactAnswer_(k, v)));
  };
  // NOT masked — DROPPED.
  var masked = function (name, k, v) {
    stAssert_(out, 'private: ' + name, hubRedactAnswer_(k, v) === null,
              'kept: ' + JSON.stringify(hubRedactAnswer_(k, v)));
  };

  // The three names the SAME number arrives under on this form.
  masked('an "ssn" field is not collected', 'ssn', '293089837');
  masked('a "social security number" field is not collected', 'social security number', '289700094');
  masked('"textbox5" is not collected — the name says nothing', 'textbox5', '289-70-0094');
  // The one that would have escaped a name-only redactor: Packet.gs records that Textbox1 alone held 171 SSNs out…
  masked('"textbox1" is not collected when it holds a number shaped like an SSN',
         'textbox1', '123-45-6789');
  // And it must NOT mangle the same field when it holds what it usually holds.
  stAssert_(out, 'private: "textbox1" holding a first name is left alone',
            hubRedactAnswer_('textbox1', 'Brandy') === 'Brandy',
            'a first name was redacted');

  gone('a bank account number is dropped entirely',
       "employee's account's number", '874554777');
  gone('a routing number is dropped', 'routing number', '041215663');

  stAssert_(out, 'private: ordinary answers pass through untouched',
            hubRedactAnswer_('city or town', 'North Canton') === 'North Canton' &&
            hubRedactAnswer_('zip code', '44720') === '44720', '');

  // ---- THE ROWS THAT WERE ALREADY THERE -------------------------------- The redactor shipped and did not reach a…
  var rsync = stCode_(HUB_ACTIONS.recruitmentSync);
  stAssert_(out, 'private: no row is written back without passing the redactor',
            rsync.indexOf('if (carried) kept = null') === -1 &&
            rsync.indexOf('carried || JSON.stringify(kept)') === -1,
            'rows already in the sheet keep their SSN and bank account forever');
  stAssert_(out, 'private: unparseable stored JSON is emptied, not passed through',
            rsync.indexOf('fields = {};') !== -1,
            'malformed JSON is the one input that skips every filter');

  // THE FINGERPRINT IS OF THE SSN, not of whatever had nine digits first.
  stAssert_(out, 'private: a routing number is not mistaken for an SSN',
            hubIsSsnAnswer_('routing number', '041215663') === false &&
            hubIsSsnAnswer_("employee's account's number", '874554777') === false,
            'the strong key empdbFindRow_ refuses on could be a bank routing number');
  stAssert_(out, 'private: a ZIP+4 is not mistaken for an SSN',
            hubIsSsnAnswer_('zip', '44720-1234') === false,
            'nine digits is not a social security number');
  stAssert_(out, 'private: the real SSN is still recognised, named or not',
            hubIsSsnAnswer_('textbox5', '123-45-6789') === true &&
            hubIsSsnAnswer_('social security number', '123456789') === true,
            'the number this exists to drop would pass through');
  stAssert_(out, 'private: the fingerprint is taken only from an SSN answer',
            rsync.indexOf('hubIsSsnAnswer_(fk, fv)') !== -1,
            'the first nine-digit answer in for-in order becomes the join key');

  // Nothing of the number reaches the mirror — not even the last four.
  stAssert_(out, 'private: not one digit of an SSN survives the redaction',
            hubRedactAnswer_('ssn', '293089837') === null &&
            hubRedactAnswer_('textbox5', '289-70-0094') === null, '');

  // The fingerprint: same number same answer, different number different answer, and never the number itself.
  var salt = null;
  try {
    var pp = PropertiesService.getScriptProperties();
    salt = pp.getProperty(HUB_PII_SALT_PROP);
    if (!salt) pp.setProperty(HUB_PII_SALT_PROP, 'selftest-salt-0123456789abcdef');
    var a = hubSsnFingerprint_('293-08-9837');
    var b = hubSsnFingerprint_('293089837');
    var c = hubSsnFingerprint_('289700094');
    stAssert_(out, 'private: the fingerprint ignores punctuation', a && a === b, a + ' vs ' + b);
    stAssert_(out, 'private: different numbers fingerprint differently', a !== c, '');
    stAssert_(out, 'private: the fingerprint contains none of the digits',
              a && a.indexOf('9837') === -1 && a.indexOf('293') === -1, a);
    stAssert_(out, 'private: the strong key survives the redaction',
              typeof empdbSsnKey_ === 'function' &&
              empdbSsnKey_('293-08-9837') === empdbSsnKey_('293089837') &&
              empdbSsnKey_('293089837') !== empdbSsnKey_('289700094'),
              'empdbFindRow_ lost the key that lets it refuse');
  } finally {
    try {
      var pp2 = PropertiesService.getScriptProperties();
      if (salt) pp2.setProperty(HUB_PII_SALT_PROP, salt);
      else pp2.deleteProperty(HUB_PII_SALT_PROP);
    } catch (e) { /* reported below */ }
  }

  // THE SALT CREATES ITSELF, ONCE.
  stAssert_(out, 'private: a fingerprint is available with nothing set up by hand',
            (function () {
              try {
                var pp = PropertiesService.getScriptProperties();
                var had = pp.getProperty(HUB_PII_SALT_PROP);
                pp.deleteProperty(HUB_PII_SALT_PROP);
                var r = hubSsnFingerprint_('293089837');
                var made = String(pp.getProperty(HUB_PII_SALT_PROP) || '');
                if (had) pp.setProperty(HUB_PII_SALT_PROP, had);
                return r !== '' && made.length >= 16;
              } catch (e) { return false; }
            })(),
            'no fingerprint without a hand-set salt — the silent fallback is back');
  stAssert_(out, 'private: the salt is made once, not once per call',
            (function () {
              try {
                var pp = PropertiesService.getScriptProperties();
                var had = pp.getProperty(HUB_PII_SALT_PROP);
                pp.deleteProperty(HUB_PII_SALT_PROP);
                var a = hubSsnFingerprint_('293089837');
                var b = hubSsnFingerprint_('293089837');
                if (had) pp.setProperty(HUB_PII_SALT_PROP, had);
                return a !== '' && a === b;
              } catch (e) { return false; }
            })(),
            'a second call produced a different fingerprint — the salt is being regenerated');
}

// ------------------------------------------------------------------ 16.
function stAiProviders_(out) {
  if (typeof SCREEN_AI_PROVIDERS === 'undefined') {
    stAssert_(out, 'ai: the provider chain is loaded', false, 'SCREEN_AI_PROVIDERS missing');
    return;
  }
  var props = SCREEN_AI_PROVIDERS.map(function (p) { return p.prop; });
  stAssert_(out, 'ai: the original key keeps its K spelling',
            props.indexOf('GROK_API_KEY') === 0,
            'GROK_API_KEY must stay FIRST — renaming it unplugs the phone screen silently');
  stAssert_(out, 'ai: both new Groq keys are in the chain',
            props.indexOf('GROQ_KEY1') !== -1 && props.indexOf('GROQ_KEY2') !== -1,
            'GROQ_KEY1/GROQ_KEY2 belong in the chain; got ' + props.join(','));
  stAssert_(out, 'ai: something answers when every Groq key is spent',
            props.indexOf('OPENAI_API_KEY') === props.length - 1,
            'the non-Groq fallback must be last');

  // The model override used to be DERIVED by replacing '_API_KEY' with '_MODEL'.
  for (var i = 0; i < SCREEN_AI_PROVIDERS.length; i++) {
    var p = SCREEN_AI_PROVIDERS[i];
    stAssert_(out, 'ai: ' + p.name + ' names its model property',
              !!p.modelProp && p.modelProp !== p.prop,
              'a model property equal to the key property reads the KEY as the model name');
  }
  // Behaviour, not source text: an earlier version of this assertion read the function's source and tripped over…
  try {
    PropertiesService.getScriptProperties().setProperty('GROQ_KEY1', 'gsk_secret_value');
    var got = screenAiModel_({ prop: 'GROQ_KEY1', modelProp: 'GROQ_MODEL', model: 'llama-3.3-70b-versatile' });
    stEq_(out, 'ai: an unset override falls back to the built-in model', got, 'llama-3.3-70b-versatile');
    stAssert_(out, 'ai: the API KEY is never returned as the model name',
              got.indexOf('gsk_') === -1,
              'the model name came out of the key property — Groq would be sent the secret as its model');
  } finally {
    try { PropertiesService.getScriptProperties().deleteProperty('GROQ_KEY1'); } catch (e) {}
  }
}

// THE LEDGER KEY IS THE MEMORY.
function stPlatformMail_(out) {
  if (typeof HUB_ACTIONS === 'undefined' || typeof HUB_ACTIONS.platformMailInbox !== 'function') {
    stAssert_(out, 'mail: the inbox action is declared', false, 'PlatformMail.gs missing');
    return;
  }
  // Not master = 404 "Unknown action" — the refusal must not advertise that there is a mailbox to be refused from.
  var r = HUB_ACTIONS.platformMailInbox({}, { email: 'somebody@asalifecare.com', role: 'admin' });
  stEq_(out, 'mail: a non-master admin gets 404, not 403', r.status, 404);
  stAssert_(out, 'mail: the refusal names no mailbox',
            String(r.message).toLowerCase().indexOf('mail') === -1,
            'the message leaks what exists: ' + r.message);
  // The transport helper exists and the RPC email path uses it: the door did not move, only what carries the…
  stAssert_(out, 'mail: the transport helper is loaded', typeof platformMailOut_ === 'function', 'missing');
  stAssert_(out, 'mail: the RPC email path sends through it',
            String(rpcSend_).indexOf('platformMailOut_') !== -1,
            'emailSend still calls MailApp directly — the platform address never happens');

  // SENDING IS EVERYBODY'S — every user sends.
  var heldAlertsForSend = hiringAlerts_;
  var send;
  try {
    hiringAlerts_ = function () { return {}; };
    send = HUB_ACTIONS.platformMailSend({}, { email: 'somebody@asalifecare.com', role: 'staff' });
  } finally { hiringAlerts_ = heldAlertsForSend; }
  stEq_(out, 'mail: a staff user reaches the composer (refused on substance, not existence)',
        send.status, 400);
  stAssert_(out, 'mail: the send policy admits the internal roles',
            HUB_POLICY.platformMailSend.roles.indexOf('staff') !== -1 &&
            HUB_POLICY.platformMailSend.roles.indexOf('manager') !== -1,
            'roles: ' + HUB_POLICY.platformMailSend.roles.join(','));
  stAssert_(out, 'mail: the external audiences are NOT among them',
            HUB_POLICY.platformMailSend.roles.indexOf('client') === -1 &&
            HUB_POLICY.platformMailSend.roles.indexOf('onboarding') === -1,
            'the platform voice handed to an outside session');
  stAssert_(out, 'mail: the send declares that it reaches people',
            HUB_POLICY.platformMailSend.emits.indexOf('emailSend') !== -1,
            'emits must name emailSend');
  stAssert_(out, 'mail: the switch is read from the configs',
            String(HUB_ACTIONS.platformMailSend).indexOf('platform_email_enabled') !== -1,
            'the feature cannot be turned off from Settings');
}

function stSmartLedgerKey_(out) {
  if (typeof smartLedgerKey_ !== 'function' || typeof smartEventSweep_ !== 'function') {
    stAssert_(out, 'ledger: smart comms is loaded', false, 'SmartComms.gs missing');
    return;
  }

  stEq_(out, 'ledger: the key names situation, person and occasion',
        smartLedgerKey_('sit', 'CAN_1', '2026-08-12T10:00:00Z'), 'sit|CAN_1|2026-08-12');
  stAssert_(out, 'ledger: two people under one situation are two keys',
            smartLedgerKey_('sit', 'CAN_1', '2026-08-12') !== smartLedgerKey_('sit', 'CAN_2', '2026-08-12'),
            'one key for two people silences the second person forever');

  // Every record in the event sweep must write the COMPOSITE key.
  var src = String(smartEventSweep_);
  stAssert_(out, 'ledger: the event sweep never records under the bare situation id',
            src.indexOf('smartRecord_(sit.id,') === -1,
            'a send recorded under sit.id can never be found by smartLedgerKey_ — it repeats every pass');
}

function stSmartPreviewDry_(out) {
  var src = (typeof smartEventSweep_ === 'function') ? String(smartEventSweep_) : '';
  if (!src) {
    stAssert_(out, 'preview: the event sweep is loaded', false, 'smartEventSweep_ missing');
    return;
  }
  stAssert_(out, 'preview: the sweep READS opts.dry_run', src.indexOf('opts.dry_run') !== -1,
            'dry_run is passed by runSmartEventPreview and ignored — the preview sends for real');

  var atFlag = src.indexOf('opts.dry_run');
  var atSend = src.indexOf('rpcCall_');
  stAssert_(out, 'preview: it answers BEFORE the first send', atFlag !== -1 && atFlag < atSend,
            'the dry-run branch sits after a send — some messages would already be gone');

  // A dry run that skips the guards describes a pass nobody will ever have.
  var atRehearsal = src.indexOf('packetIsRehearsal_');
  stAssert_(out, 'preview: it answers AFTER the guards', atRehearsal !== -1 && atRehearsal < atFlag,
            'the dry-run branch runs before the rehearsal guard — it would list rows the real pass skips');
}

function stSmartComms_(out) {
  if (typeof smartRender_ !== 'function') {
    stAssert_(out, 'smart comms: the module is loaded', false, 'SmartComms.gs did not load');
    return;
  }

  // 1.
  var src = String(smartDue_);
  stAssert_(out, 'smart comms: the window is <=, never an exact date match',
            src.indexOf('left > before') !== -1 && !/left\s*===\s*before/.test(src),
