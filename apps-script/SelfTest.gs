// ---------------- release users (ReleaseUsers.gs) ------------------------- The release door: master-only…
function stReleaseUsers_(out) {
  // ---- the door is the master's alone --------------------------------------
  stEq_(out, 'release: status is an admin-gated read',
        (HUB_POLICY.releaseUserStatus.roles || []).join(','), 'admin');
  stEq_(out, 'release: release is an admin-gated write',
        (HUB_POLICY.releaseUser.roles || []).join(','), 'admin');
  stAssert_(out, 'release: the handler re-checks master, not just the policy',
            String(releaseMasterOnly_).indexOf('hubIsMaster_') !== -1,
            'roles:[admin] alone would let any admin reset a password to the shared default');
  stEq_(out, 'release: nobody is refused', releaseMasterOnly_(null), true);
  stEq_(out, 'release: a service session is refused',
        releaseMasterOnly_({ is_service: true, role: 'admin', email: 'svc@x' }), true);
  stEq_(out, 'release: a non-master role is refused before any property is read',
        releaseMasterOnly_({ role: 'staff', email: 'a@b.c' }), true);

  // ---- what a release arms and clears --------------------------------------
  var src = String(HUB_ACTIONS.releaseUser);
  stAssert_(out, 'release: every press mints its own random password — never a property or a shared constant',
            src.indexOf('tempPassword_()') !== -1 && src.indexOf('FIRST_USER_PASSWORD') === -1 &&
            src.indexOf('ONBOARDING_USER_PASSWORD') === -1, '');
  stAssert_(out, 'release: the password gate is armed (must_change stamped)',
            src.indexOf("{ name: 'mustchange', value: 'true' }") !== -1,
            'a release without the gate hands out a standing shared password');
  stAssert_(out, 'release: last_login is cleared for the first-sign-in path',
            src.indexOf("{ name: 'lastlogin', value: '' }") !== -1, '');
  stEq_(out, 'release: the wire declares BOTH legs it emits',
        (HUB_POLICY.releaseUser.emits || []).join(','), 'emailSend,smsSend');

  // ---- THE TWO LETTERS ARE ROWS NOW, NOT LITERALS ------------------------ Both used to be built in…
  var relSit = {};
  smartDefaults_().forEach(function (d) {
    if (String(d.id) === 'user_release_invite' || String(d.id) === 'app_release_announced') {
      relSit[String(d.id)] = d;
    }
  });
  var invite = relSit.user_release_invite, appRow = relSit.app_release_announced;
  stAssert_(out, 'release: both letters exist as situations',
            !!invite && !!appRow, 'a letter with no row is a wording nobody can change');
  if (invite && appRow) {
    var bothLegs = function (d) {
      var named = smartList_(d.channels);
      return named.indexOf('sms') !== -1 && named.indexOf('email') !== -1 &&
             String(d.sms_text || '').trim() !== '' && String(d.email_text || '').trim() !== '';
    };
    stAssert_(out, 'release: both letters are named AND written on both channels',
              bothLegs(invite) && bothLegs(appRow),
              'a channel with no words is a promise the send door refuses downstream');
    var inviteWords = String(invite.sms_text) + String(invite.email_text);
    stAssert_(out, 'release: the invite carries the login and the first password',
              inviteWords.indexOf('{login}') !== -1 && inviteWords.indexOf('{password}') !== -1,
              'the login and the initial password have to travel together');
    var appWords = String(appRow.sms_text) + String(appRow.email_text) + String(appRow.email_subject);
    stAssert_(out, 'release: the app letter never carries a credential',
              appWords.indexOf('{password}') === -1,
              'that letter is about a door, not about an account');
    stEq_(out, 'release: neither row can be pointed at somebody else',
          String(invite.to || '') + '|' + String(appRow.to || ''), '|');
    // THE SENTENCE THAT WAS NOT TRUE.
    stAssert_(out, 'release: the app letter no longer promises nothing to set up',
              appWords.indexOf('nothing to set up') === -1 &&
              String(appReleaseLetterOut_).indexOf('nothing to set up') === -1,
              'a page may say what it knows, never one of its three states in the words of another');
  }
  // THE CALL, NOT THE WORD.
  stAssert_(out, 'release: the invite leaves through the one door',
            src.indexOf('releaseTellInvite_(') !== -1 &&
            stCode_(releaseTellInvite_).indexOf('commReleaseInviteTell_(') !== -1 &&
            src.indexOf('platformMailOut_(') === -1 &&
            stCode_(releaseTellInvite_).indexOf('platformMailOut_(') === -1,
            'a call site reaching past the rehearsal redirect is a brake nobody can see');
  stAssert_(out, 'release: the announcement leaves through the one door',
            String(appReleaseLetterOut_).indexOf('commReleaseAppTell_(') !== -1 &&
            String(appReleaseLetterOut_).indexOf('platformMailOut_(') === -1, '');
  stAssert_(out, 'release: a temporary password is never texted to a shared line',
            String(commReleaseTell_).indexOf('commReleaseSharedLine_') !== -1,
            'several people read a shared number — a credential sent there is handed to a room');
  stAssert_(out, 'release: a held message is not reported as a person told',
            src.indexOf('var reached = told.named_sent > 0;') !== -1 &&
            src.indexOf('emailed: reached') !== -1 && src.indexOf('held: told.held > 0') !== -1,
            'while test mode is on, holding the text is the correct behaviour and not an outage');

  // ---- THE LETTER FIRST, THE CREDENTIAL AFTER ---------------------------- The invite is the only way the…
  var codeRel = stCode_(HUB_ACTIONS.releaseUser);
  stAssert_(out, 'release: the letter is asked for before the row is rearmed',
            codeRel.indexOf('releaseTellInvite_(') !== -1 &&
            codeRel.indexOf('releaseTellInvite_(') < codeRel.indexOf('releaseRearm_(') &&
            codeRel.indexOf('!reached && !anyway') !== -1 &&
            codeRel.indexOf('!reached && !anyway') < codeRel.indexOf('releaseRearm_('),
            'a rearm that cannot be told is a person locked out of their own account');
  stAssert_(out, 'release: an unreadable test-mode switch refuses before anything is asked or written',
            codeRel.indexOf('!mode.readable && !anyway') !== -1 &&
            codeRel.indexOf('!mode.readable && !anyway') < codeRel.indexOf('releaseTellInvite_(') &&
            stCode_(releaseTestMode_).indexOf('hubTestModeOn_()') !== -1 &&
            stCode_(releaseTestMode_).indexOf('hubRehearsalToSheet_') === -1,
            'hubRehearsalToSheet_ reads a throw as off, and the send door then goes to the real person');
  stEq_(out, 'release: a test-mode read that throws is unknown, never off',
        (function () {
          var held = hubTestModeOn_;
          try {
            hubTestModeOn_ = function () { throw new Error('config unreadable'); };
            var m = releaseTestMode_();
            return m.word + '/' + m.readable;
          } finally { hubTestModeOn_ = held; }
        })(), 'unknown/false');
  stAssert_(out, 'release: every cell is resolved before the first one is written',
            codeRel.indexOf('RELEASE_REQUIRED_COLUMNS') !== -1 &&
            codeRel.indexOf('RELEASE_REQUIRED_COLUMNS') < codeRel.indexOf('releaseRearm_('),
            'a missing column throws mid-write and leaves the row half-rearmed');
  stAssert_(out, 'release: a rearm that throws puts every written cell back',
            stCode_(releaseRearm_).indexOf('done[j].before') !== -1,
            'a new salt beside the old hash is the state in which no password works');
  stAssert_(out, 'release: the live sessions end with the release',
            src.indexOf('releaseEndSessions_(') !== -1,
            'no next sign-in means no gate, no tour and no first-login anything');
  stAssert_(out, 'release: an unreadable sessions tab is never "no open session"',
            stCode_(releaseEndSessions_).indexOf('complete') !== -1 &&
            codeRel.indexOf('sessions.complete ? sessions.ended : null') !== -1,
            'a failed read reported as zero is a person still signed in');
  stAssert_(out, 'release: "rearmed, nothing sent" is an answer, not an error',
            src.indexOf('status: 502') === -1,
            'gasAction throws on a 4xx/5xx, so the third outcome never reaches the screen');
  stAssert_(out, 'release: the idempotency key names the press, not the person or the clock',
            codeRel.indexOf("'release_' + uid + '_' + pressId") !== -1 &&
            !!(HUB_POLICY.releaseUser.params || {}).press_id,
            'a key per call made the one re-sent press a second letter');
  stAssert_(out, 'release: which brake held it is carried up, not guessed at',
            src.indexOf('held_reason') !== -1 &&
            stCode_(commReleaseTell_).indexOf('commReleaseHeldReason_(') !== -1,
            'no dial position ever releases an opt-out');
  stEq_(out, 'release: an opt-out is not the mockup',
        commReleaseHeldReason_({ gated: true, reason: 'opted_out' }), 'opted_out');
  stEq_(out, 'release: the quiet window is not the mockup',
        commReleaseHeldReason_({ gated: true, reason: 'quiet_hours' }), 'quiet_hours');
  stEq_(out, 'release: the mockup is the mockup',
        commReleaseHeldReason_({ rehearsed: true, reason: 'the dial is at the sheet' }), 'rehearsal');
  stAssert_(out, 'release: an already-sent letter is not a refusal',
            stCode_(commReleaseTell_).indexOf('res.deduplicated') !== -1,
            'the door answering "already sent" read as the door refusing');
  /* the books themselves are run through the real door in stReleaseCount_ */
  stAssert_(out, 'release: both legs of the invite name the first password as the string no record may keep',
            stCode_(commReleaseInviteBuild_).indexOf('secret || true') !== -1 &&
            stCode_(commReleaseTell_).indexOf('letter.withhold = [secretText]') !== -1 &&
            stCode_(commReleaseTell_).indexOf('text.withhold = [secretText]') !== -1,
            'comm_mock, comm_rehearsal and the mail log keep the rendered words, and `body` is not a withheld column');
  stAssert_(out, 'release: a named secret is withheld from a record',
            (function () {
              var kept = hubWithhold_('use Sw0rdf1sh! to sign in', ['Sw0rdf1sh!']);
              return kept.indexOf('Sw0rdf1sh!') === -1 && /withheld/.test(kept);
            })(), hubWithhold_('use Sw0rdf1sh! to sign in', ['Sw0rdf1sh!']));
  stEq_(out, 'release: nothing is withheld when the message named nothing',
        hubWithhold_('use Sw0rdf1sh! to sign in'), 'use Sw0rdf1sh! to sign in');

  /* ---- THE ANNOUNCEMENT'S AUDIENCE AND ITS THREE NUMBERS ----------------- */
  var annSrc = String(HUB_ACTIONS.appReleaseAnnounce);
  var autoSrc = String(appReleaseAutoAnnounce_);
  stAssert_(out, 'release: a held letter is never also counted as refused',
            annSrc.indexOf('appReleaseCount_(tally, res)') !== -1 &&
            autoSrc.indexOf('appReleaseCount_(tally, res)') !== -1 &&
            (function () {
              var t = appReleaseTally_();
              appReleaseCount_(t, { outcome: 'dial', why: [] });
              appReleaseCount_(t, { outcome: 'quiet', why: [] });
              appReleaseCount_(t, { outcome: 'declined', why: [] });
              return t.held_dial === 1 && t.held_quiet === 1 && t.declined === 1 && t.failed === 0;
            })(),
            'a run merely paused by a brake read as a run the transport rejected');
  stAssert_(out, 'release: an already-sent announcement is neither sent again nor refused',
            (function () {
              var t = appReleaseTally_();
              appReleaseCount_(t, { outcome: 'already_sent', why: [] });
              return t.already_sent === 1 && t.failed === 0 && t.sent === 0;
            })(),
            'the door answering "already sent" was counted as a refusal');
  var oneAnswer = (function () {
    var held = commReleaseAppTell_;
    try {
      commReleaseAppTell_ = function () { return { sent: 1, held: 1, deduplicated: 0, legs: [], why: [] }; };
      var mixed = appReleaseLetterOut_({ uid: 'u', email: 'a@b.c' }, { id: 'x' });
      commReleaseAppTell_ = function () { return { sent: 0, held: 0, deduplicated: 1, legs: [], why: [] }; };
      var dup = appReleaseLetterOut_({ uid: 'u', email: 'a@b.c' }, { id: 'x' });
      return [mixed.sent, mixed.redirected, dup.sent, dup.deduplicated, dup.redirected].join(',');
    } finally { commReleaseAppTell_ = held; }
  })();
  stEq_(out, 'release: one answer per person — a letter that left with its text held is sent, not also held',
        oneAnswer, 'true,false,false,true,false');
  stAssert_(out, 'release: the automatic pass keeps a held count of its own',
            autoSrc.indexOf('tally.held_dial') !== -1 &&
            autoSrc.indexOf('status: !logged ? 500 : failed ? 502 : (unwritten ? 206 : 200)') !== -1,
            'a red ledger line for a message the platform deliberately held');
  stAssert_(out, 'release: the button skips everybody already told, and only `again` re-sends',
            annSrc.indexOf('appReleaseAlreadyTold_()') !== -1 &&
            annSrc.indexOf('!again && appReleaseWasTold_(told.map') !== -1,
            'after an automatic pass that stopped at its budget, the button wrote to everybody again');
  stAssert_(out, 'release: an unreadable app_release_log is never "nobody was told"',
            stCode_(appReleaseAlreadyTold_).indexOf('readable') !== -1 &&
            annSrc.indexOf('!told.readable && !again') !== -1 &&
            autoSrc.indexOf('!told.readable') !== -1,
            'read as empty, a hiccup re-sends the announcement to everybody');
  stAssert_(out, 'release: the automatic pass stamps the once-per-app property too',
            autoSrc.indexOf('APP_RELEASE_ANNOUNCED_PROP') !== -1,
            'the screen says an app announces only once');
  stAssert_(out, 'release: nobody hears the same app announcement twice',
            autoSrc.indexOf('appReleaseWasTold_(') !== -1,
            'one letter per badge keystroke while the matrix is being edited');
  stAssert_(out, 'release: the automatic pass answers to a budget of its own',
            autoSrc.indexOf('APP_RELEASE_AUTO_BUDGET_MS') !== -1 &&
            autoSrc.indexOf('APP_RELEASE_AUTO_MAX_LETTERS') !== -1,
            'it rides the badge save’s execution and must not take it down');
  // THE AUDIENCE IS WHOEVER THE MASTER RELEASED.
  stAssert_(out, 'release: the audience is the released accounts, not every account with a password',
            stCode_(appReleaseReleased_).indexOf('c.rel') !== -1 &&
            stCode_(appReleaseReleased_).indexOf('hash') === -1 &&
            annSrc.indexOf('appReleaseReleased_(') !== -1 && autoSrc.indexOf('appReleaseReleased_(') !== -1,
            'a guardian given the default password at creation is not somebody released');
  stAssert_(out, 'release: addressed, matched and not-released are numbers on the answer',
            annSrc.indexOf('not_released: notReleased') !== -1 &&
            annSrc.indexOf('matched: matched') !== -1 &&
            annSrc.indexOf('already_told: alreadyTold') !== -1,
            'the screen printed the addressed count as "people can open this app"');
  // commMockSituationFrom_ reads the id off the TAIL of the reason, so the app in brackets after it left every…
  stAssert_(out, 'release: the app letter’s reason ends at the situation id',
            stCode_(commReleaseAppTell_).indexOf("'release: ' + COMM_RELEASE_APP_SITUATION,") !== -1,
            'the mock outbox cannot be read by situation when the id is not the tail');
  stEq_(out, 'release: both rows name the file that fires them',
        String(SMART_EVENT_SENDERS.user_release_invite) + '/' +
        String(SMART_EVENT_SENDERS.app_release_announced),
        'CommRelease.gs/CommRelease.gs');
  stAssert_(out, 'release: the text leg has a number to read',
            String(releaseUserCols_(['phone', 'phones']).phone) !== '-1' ||
            String(releaseUserCols_(['phone', 'phones']).phones) !== '-1',
            'the tab keeps two columns for one number and the letter needs either');

  // ---- the marks that make a login feel like the first ----------------------
  stEq_(out, 'release: all three first-login marks are named',
        RELEASE_FIRST_LOGIN_PREF_KEYS.join(','), 'asa-tour-seen,asa-playground-intro-seen,asa-myworld-intro-seen');
  // THE SHAPE THE SHEET REALLY HOLDS.
  var marks = releaseMarks_({ 'asa-tour-seen': '["u1","u2"]', 'asa-accent': 'mint' }, 'u2');
  stEq_(out, 'release: a tour mark naming this person reads as seen', marks['asa-tour-seen'], true);
  stEq_(out, 'release: an absent intro mark reads as not seen', marks['asa-playground-intro-seen'], false);
  stEq_(out, 'release: an empty id-list reads as not seen',
        releaseMarks_({ 'asa-tour-seen': '[]' }, 'u2')['asa-tour-seen'], false);
  stEq_(out, 'release: somebody else’s id on a shared browser is not this person',
        releaseMarks_({ 'asa-tour-seen': '["u1","u3"]' }, 'u2')['asa-tour-seen'], false);
  stEq_(out, 'release: a list written by hand is read the same way',
        releaseMarks_({ 'asa-tour-seen': ['u2'] }, 'u2')['asa-tour-seen'], true);
  // A DELETED KEY IS A CLEAR THE BROWSER CANNOT SEE: `applyPrefs` only writes the keys the blob names, so the stale…
  var mine = { 'asa-tour-seen': '["u1","u2"]', 'asa-accent': 'mint' };
  var touched = releaseClearMarks_(mine, 'u2');
  stEq_(out, 'release: clearing a mark rewrites it without this person',
        String(mine['asa-tour-seen']), '["u1"]');
  stEq_(out, 'release: clearing names the key it touched', touched.join(','), 'asa-tour-seen');
  stEq_(out, 'release: a mark this person never carried is left alone',
        String(mine['asa-playground-intro-seen'] === undefined), 'true');
  stEq_(out, 'release: nothing else in the blob is touched', String(mine['asa-accent']), 'mint');
  // THE STAMP THE BROWSER CANNOT OVERWRITE.
  stAssert_(out, 'release: the release stamps the preference blob',
            stCode_(releaseClearMarksFor_).indexOf('held.prefs[PREFS_RELEASED_KEY] = stamp') !== -1, '');
  stEq_(out, 'release: a push without the stamp keeps the stored one',
        JSON.parse(prefsKeepReleased_({ 'asa-tour-seen': '["u2"]' },
                                      JSON.stringify({ 'asa-released-at': '2030-01-02T00:00:00.000Z' })))
          ['asa-released-at'], '2030-01-02T00:00:00.000Z');
  stEq_(out, 'release: a push can never move the stamp backwards',
        JSON.parse(prefsKeepReleased_({ 'asa-released-at': '2029-01-01T00:00:00.000Z' },
                                      JSON.stringify({ 'asa-released-at': '2030-01-02T00:00:00.000Z' })))
          ['asa-released-at'], '2030-01-02T00:00:00.000Z');
  stEq_(out, 'release: a blob that never was released carries no stamp',
        prefsKeepReleased_({ 'asa-accent': 'mint' }, '{"asa-accent":"blue"}'), '{"asa-accent":"mint"}');
  stAssert_(out, 'release: prefsSet writes through the stamp keeper',
            stCode_(HUB_ACTIONS.prefsSet).indexOf('prefsKeepReleased_(') !== -1, '');
}

// THE MATRIX ENGINE (part 1) — the rule grammar and the registry's fail-closed edges.
function stMatrixEngine_(out) {
  var F = { 'hiring.application.present': 'true',
            'hiring.application.status': 'Signed',
            'hiring.interview.score': '4',
            'hiring.cpr.on_file': true };

  // ---- the matrix's rule operators, one by one -----------------------------
  stEq_(out, 'matrix: equals true matches the string the sheet stores',
        hiringRuleOk_({ fact: 'hiring.application.present', equals: true }, F), true);
  stEq_(out, 'matrix: equals true matches a real boolean fact',
        hiringRuleOk_({ fact: 'hiring.cpr.on_file', equals: true }, F), true);
  stEq_(out, 'matrix: equals false refuses a true fact',
        hiringRuleOk_({ fact: 'hiring.cpr.on_file', equals: false }, F), false);
  stEq_(out, 'matrix: equals_ci ignores case',
        hiringRuleOk_({ fact: 'hiring.application.status', equals_ci: 'signed' }, F), true);
  stEq_(out, 'matrix: gte passes at the floor',
        hiringRuleOk_({ fact: 'hiring.interview.score', gte: 4 }, F), true);
  stEq_(out, 'matrix: gte refuses below the floor',
        hiringRuleOk_({ fact: 'hiring.interview.score', gte: 5 }, F), false);
  stEq_(out, 'matrix: gte refuses a non-number fact',
        hiringRuleOk_({ fact: 'hiring.application.status', gte: 1 }, F), false);
  stEq_(out, 'matrix: a bare fact means present-and-not-false',
        hiringRuleOk_({ fact: 'hiring.application.present' }, F), true);
  stEq_(out, 'matrix: a bare absent fact is false',
        hiringRuleOk_({ fact: 'hiring.nothing' }, F), false);

  // ---- composition ---------------------------------------------------------
  stEq_(out, 'matrix: all needs every leg',
        hiringRuleOk_({ all: [{ fact: 'hiring.cpr.on_file', equals: true },
                              { fact: 'hiring.interview.score', gte: 5 }] }, F), false);
  stEq_(out, 'matrix: any needs one leg',
        hiringRuleOk_({ any: [{ fact: 'hiring.interview.score', gte: 5 },
                              { fact: 'hiring.cpr.on_file', equals: true }] }, F), true);
  stEq_(out, 'matrix: rules nest',
        hiringRuleOk_({ all: [{ fact: 'hiring.cpr.on_file' },
                              { any: [{ fact: 'hiring.nothing' },
                                      { fact: 'hiring.application.status', equals_ci: 'SIGNED' }] }] }, F), true);

  // ---- the cell forms and the closed edges ---------------------------------
  stEq_(out, 'matrix: a cell arrives as a JSON string and still evaluates',
        hiringRuleOk_('{"fact":"hiring.application.status","equals_ci":"signed"}', F), true);
  stEq_(out, 'matrix: a blank cell means no rule',
        hiringRuleOk_('', F), true);
  stEq_(out, 'matrix: broken JSON fails closed',
        hiringRuleOk_('{"fact":', F), false);
  stEq_(out, 'matrix: an unknown shape fails closed',
        hiringRuleOk_({ when: 'someday' }, F), false);

  // ---- the words live in the book, never in the code -----------------------
  var textRows = HIRING_SIM_CFG_DEFAULTS.filter(function (d) {
    return String(d.key).indexOf('sim_text_') === 0;
  });
  stEq_(out, 'words: the sim table still names every text row', textRows.length, 59);
  stEq_(out, 'words: no sim_text row ships words in code',
        textRows.filter(function (d) { return str_(d.value) !== ''; }).length, 0);
  stEq_(out, 'words: every sim_text row keeps its note for the panel',
        textRows.filter(function (d) { return !str_(d.note); }).length, 0);
  var std = stCode_(simTextDefault_);
  stAssert_(out, 'words: the shipped floor reads the book, sim.text.*',
            std.indexOf("bookText_('Strings', 'sim.text.'") !== -1,
            'simTextDefault_ must fetch from the word depot');
  var parked = stCode_(readyParkedNotify_);
  stAssert_(out, 'words: the parked letter fetches its words from the book',
            parked.indexOf("bookText_('Strings', 'ready_parked.") !== -1 &&
            parked.indexOf('waiting at Ready to Start') === -1,
            'the letter must not say anything on its own');
  var seeder = stCode_(hiringSimCfgSheet_);
  stAssert_(out, 'words: the seeder plants the book words, not blanks',
            seeder.indexOf('simTextDefault_') !== -1,
            'a seeded text cell must start with the shipped words');

  // ---- the registry before the flip ----------------------------------------
  stEq_(out, 'matrix: an empty context resolves to nothing', hiringBookFor_(''), '');
  stEq_(out, 'matrix: an unregistered context resolves to nothing — the caller keeps today\'s path',
        hiringBookFor_('never-a-module'), '');
  var reg = stCode_(hiringBookFor_);
  stAssert_(out, 'matrix: only an ON row resolves',
            reg.indexOf("'on'") !== -1,
            'a registry row must opt in — a pasted id alone must not flip a module');

  // ---- the engine declares its reads ---------------------------------------
  stAssert_(out, 'matrix: a resolved book is stamped as read',
            reg.indexOf('hiringUsageStamp_') !== -1,
            'a book being used must be VISIBLE as such');
  var stamp = stCode_(hiringUsageStamp_);
  stAssert_(out, 'matrix: the stamp is cache-gated and fail-silent',
            stamp.indexOf('hiring_lastread_') !== -1 &&
            stamp.indexOf('catch (e)') !== -1,
            'a stamp on the hot path, or one that can throw, costs real reads');
  stAssert_(out, 'matrix: the status door exists and reads only',
            typeof HUB_ACTIONS.hiringMatrixStatus === 'function' &&
            HUB_POLICY.hiringMatrixStatus.lane === 'read' &&
            (HUB_POLICY.hiringMatrixStatus.emits || []).length === 0, '');
  stAssert_(out, 'matrix: the service line may ask the status door',
            stCode_(HUB_ACTIONS.hiringMatrixStatus).indexOf('is_service') !== -1 &&
            SERVICE_READ_ACTIONS.indexOf('hiringMatrixStatus') !== -1,
            'check-matrix-books.py asks as the service — both gates must agree');

  // ---- conditions, in the matrix's own columns -----------------------------
  var COND = { 'Condition ID': 'hiring.x', Truth: 'The thing must be true.',
               'Applicability Rule': '', 'Terminal Rule': '', 'Failure Rule': '',
               'Satisfies Rule': '{"fact":"hiring.application.status","equals_ci":"signed"}' };
  stEq_(out, 'cond: a satisfied rule reads satisfied', hiringConditionStatus_(COND, F), 'satisfied');
  stEq_(out, 'cond: an unmet rule reads open',
        hiringConditionStatus_(COND, { 'hiring.application.status': 'draft' }), 'open');
  stEq_(out, 'cond: inapplicable wins over everything',
        hiringConditionStatus_(Object.assign({}, COND,
          { 'Applicability Rule': '{"fact":"hiring.nothing","equals":true}' }), F), 'not_applicable');
  stEq_(out, 'cond: terminal wins over failure and satisfaction',
        hiringConditionStatus_(Object.assign({}, COND,
          { 'Terminal Rule': '{"fact":"hiring.cpr.on_file","equals":true}',
            'Failure Rule': '{"fact":"hiring.cpr.on_file","equals":true}' }), F), 'terminal');
  stEq_(out, 'cond: failure beats an unmet satisfies',
        hiringConditionStatus_(Object.assign({}, COND,
          { 'Failure Rule': '{"fact":"hiring.cpr.on_file","equals":true}' }), F), 'failed');
  stEq_(out, 'cond: no satisfies rule means nothing is demanded',
        hiringConditionStatus_({ 'Condition ID': 'hiring.y' }, {}), 'satisfied');

  // ---- the gate out of the book --------------------------------------------
  var TRANS = [{ 'Transition ID': 'new_to_phone_screen', From: 'new', To: 'phone-screen',
                 'Requires All': '["hiring.x"]', 'Requires Any': '', 'When Rule': '' }];
  var gOk = hiringGateEval_(TRANS, [], [COND], F, 'new', 'phone-screen');
  stEq_(out, 'book gate: a satisfied requirement opens the rung', gOk.ok, true);
  var gNo = hiringGateEval_(TRANS, [], [COND], { 'hiring.application.status': 'draft' },
                            'new', 'phone-screen');
  stEq_(out, 'book gate: the Truth sentence is the reason',
        gNo.ok === false && gNo.reasons[0], 'The thing must be true.');
  stEq_(out, 'book gate: no rung in the book means the book abstains',
        hiringGateEval_(TRANS, [], [COND], F, 'interview', 'onboarding'), null);
  stEq_(out, 'book gate: a condition the book does not carry closes the rung',
        hiringGateEval_([{ From: 'new', To: 'phone-screen', 'Requires All': '["ghost"]' }],
                        [], [COND], F, 'new', 'phone-screen').ok, false);
  var gAny = hiringGateEval_([{ From: '*', To: 'phone-screen',
                                'Requires Any': '["ghost","hiring.x"]' }],
                             [], [COND], F, 'new', 'phone-screen');
  stEq_(out, 'book gate: any needs one leg, and a met any wipes its reasons',
        gAny.ok === true && gAny.reasons.length, 0);
  stEq_(out, 'book gate: the when rule can close an otherwise open rung',
        hiringGateEval_([{ From: 'new', To: 'phone-screen',
                           'When Rule': '{"fact":"hiring.nothing"}' }],
                        [], [COND], F, 'new', 'phone-screen').ok, false);
  // The matrix dialect: Requires names a BINDING, which hops to its condition.
  var gHop = hiringGateEval_(
    [{ From: 'new', To: 'phone-screen', 'Requires All': '["new.x_binding"]' }],
    [{ 'Binding ID': 'new.x_binding', 'Condition ID': 'hiring.x' }],
    [COND], F, 'new', 'phone-screen');
  stEq_(out, 'book gate: a requirement resolves through Flow Bindings', gHop.ok, true);
  stAssert_(out, 'book gate: the ride hands the bindings to the evaluator',
            stCode_(hiringGateRide_).indexOf("'Flow Bindings'") !== -1,
            'the Requires columns name binding ids, not condition ids');

  // ---- the ride ------------------------------------------------------------
  var ride = stCode_(hiringGateRide_);
  stAssert_(out, 'ride: every gate caller goes through it',
            stCode_(hubGateFor_).indexOf('hiringGateRide_') !== -1 &&
            stCode_(hubGateFor_).indexOf('hubGateCode_') !== -1, '');
  stAssert_(out, 'ride: shadow serves the CODE verdict, on serves the book',
            ride.indexOf("mode.status === 'on' ? book : code") !== -1, '');
  stAssert_(out, 'ride: a broken book never breaks the board',
            ride.indexOf('return code') !== -1 && /catch \(e\) \{ return code; \}/.test(ride), '');
  stAssert_(out, 'ride: divergence is throttled, agreement is silent',
            stCode_(hiringShadowLog_).indexOf('hiring_shadow_') !== -1 &&
            ride.indexOf('book.ok !== code.ok') !== -1, '');
  stEq_(out, 'ride: an unregistered context costs nothing and changes nothing',
        hiringGateRide_({ cand: { candidateid: 'CAN_TEST000000' } },
                        { from: 'new', to: 'phone-screen', ok: false, reasons: ['x'] }).reasons[0], 'x');

  // ---- facts from evidence -------------------------------------------------
  stEq_(out, 'facts: a boolean cell coerces', hiringFactValue_('TRUE', 'boolean'), true);
  stEq_(out, 'facts: a URL in a boolean column means PRESENT',
        hiringFactValue_('https://drive.google.com/x', 'boolean'), true);
  stEq_(out, 'facts: an empty boolean cell is false', hiringFactValue_('', 'boolean'), false);
  stEq_(out, 'facts: a written-out false is false', hiringFactValue_('False', 'boolean'), false);
  stEq_(out, 'facts: a number cell coerces', hiringFactValue_('4', 'number'), 4);
  stEq_(out, 'facts: a bad number stays a string', hiringFactValue_('n/a', 'number'), 'n/a');

  // ---- one Fact row against the evidence -----------------------------------
  var EV2 = { cand: { resumelink: '' },
              analysis: { analyzedat: '2026-09-01', compositescore: '', summary: '' } };
  stEq_(out, 'facts: Current Sources means ANY cell answers — the code\'s own OR',
        hiringFactFromRow_({ 'Fact ID': 'hiring.resume.on_file', Type: 'boolean',
          'Current Sources': '["entity_candidates.resume_link","entity_resume_analyses.analyzed_at"]',
          'Current Resolver': '', 'Current Source': '' }, EV2).value, true);
  stEq_(out, 'facts: all sources blank reads false, not absent',
        hiringFactFromRow_({ Type: 'boolean',
          'Current Sources': '["entity_candidates.resume_link"]',
          'Current Resolver': '', 'Current Source': '' },
          { cand: { resumelink: '' } }).value, false);
  stEq_(out, 'facts: an unregistered resolver reads as absent, never a guess',
        hiringFactFromRow_({ 'Current Resolver': 'somethingNew_', Type: 'boolean' },
                           EV2).ok, false);
  stAssert_(out, 'facts: the resolver registry calls the REAL predicates',
            stCode_(HIRING_FACT_RESOLVERS.interviewScored_).indexOf('interviewScored_(') !== -1 &&
