    days = 300;
    var lapse = [st('annroe', BM), st('deeold', BM)];
    days = 0;
    SCHED_IST_MEMO = null; calls = 0;
    schedIstFor_('annroe', BM); schedIstFor_('benleft', BM);
    var once = calls;
    src = 'shipped';
    var shipped = st('annroe', BM);
    src = 'sheet'; recThrows = true;
    var down = st('annroe', BM);
    recThrows = false; recs = [];
    var empty = st('annroe', BM);
    recs = [{ staffName: 'Ann Roe', house: 'BM4060', status: 'done', trainedAt: '2026-01-05', clientName: 'C1' }];
