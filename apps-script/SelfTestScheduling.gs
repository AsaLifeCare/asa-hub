function stScheduling_(out) {
  var P = 'scheduling: ';
  var g = (typeof globalThis !== 'undefined') ? globalThis : this;

  // ---- declarations ----
  var bad = [];
  SCHED_ACTIONS.forEach(function (a) {
    var p = HUB_POLICY[a];
    if (!p || p.file !== 'Scheduling.gs' || typeof HUB_ACTIONS[a] !== 'function') { bad.push(a + ': undeclared'); return; }
    var want = a === 'schedulingBoard' ? 'read' : 'tool';
    if (p.lane !== want) bad.push(a + ': lane ' + p.lane);
    if (p.store !== 'sheet') bad.push(a + ': store ' + p.store);
    if (JSON.stringify(p.roles) !== '["admin","director","manager","staff"]') bad.push(a + ': roles ' + JSON.stringify(p.roles));
    // a cell save that cancels a waiting flow says that flow's texts: the one write that emits
    var emits = a === 'schedulingCellSave' ? '["smsSend"]' : '[]';
    if ((p.invalidates || []).length || JSON.stringify(p.emits || []) !== emits) bad.push(a + ': invalidates/emits');
    if (RESOLVER_COSTS.indexOf(p.cost) === -1) bad.push(a + ': cost');
    var params = p.params || {};
    Object.keys(params).forEach(function (k) {
      if (!params[k] || !params[k].type) bad.push(a + ': ' + k + ' untyped');
      if (params[k] && params[k].required) bad.push(a + ': ' + k + ' required at the door');
    });
    if (a === 'schedulingBoard' && p.idempotent !== true) bad.push(a + ': a read not idempotent');
  });
  stAssert_(out, P + 'every action is declared in Scheduling.gs — the board on the read lane, every write on the tool ' +
                 'lane, for the four staff-side roles, typed params, no slice invalidated, and only the cell save (which ' +
                 'can cancel a waiting flow) emits',
            bad.length === 0 && SCHED_ACTIONS.length === 8, bad.join('; '));

  // ---- the grammar: parity with server/shift_slices.py ----
  var miss = [];
  ST_SCHED_PARITY.forEach(function (pair) {
    var got = schedClassifyRaw_(pair[0]);
    var norm = got ? JSON.parse(JSON.stringify(got)) : null;
    if (norm && got.token === null) norm.token = null;
    var want = pair[1];
    if (JSON.stringify(norm) !== JSON.stringify(want)) miss.push(JSON.stringify(pair[0]) + ' → ' + JSON.stringify(norm));
  });
  stAssert_(out, P + 'the grammar answers what the Python classify answers for all ' + ST_SCHED_PARITY.length +
                 ' measured cell texts (times, chains, stars, overnights, OFF, R/O, C/O, NCNS, aliases)',
            miss.length === 0 && ST_SCHED_PARITY.length >= 60, miss.slice(0, 5).join('; '));
