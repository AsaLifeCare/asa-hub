              reopened.text === '3P-11P' && co4.kind === 'call_off' && co4.source === 'training' &&
              co4.person_key === 'niawest' &&
              itemsOf(function (i) { return i.flow_id === t4 && i.box === 'work' && i.state === 'waiting'; }).length === 0 &&
              itemsOf(function (i) { return i.flow_id === t4 && i.to_uid === 'USR_NW' && /^Training declined/.test(i.title); }).length === 1 &&
              itemsOf(function (i) { return i.flow_id === t4 && i.kind === 'warning' && i.seat === 'director'; }).length === 2 &&
              sent.some(function (s) { return s.situation === 'sched_calloff_house'; }) &&
