        houses: 'BM4060, ZZ9999', status: 'scheduled', dir_by: 'Ty Bond', dir_at: '2026-09-15T12:00:00Z',
        time_off_reason: 'a trip', createdAt: '2026-09-10T12:00:00Z' },
      { id: 'TO00000000A2', person: 'Regina M Bowman', person_key: 'reginambowman', start_date: '2026-10-12',
        end_date: '2026-10-13', houses: 'BM', status: 'pending' },
      { id: 'TO00000000A3', person: 'Ben Left', person_key: 'benleft', start_date: '2026-10-20', end_date: '2026-10-20',
        houses: '', status: 'scheduled' },
      { id: 'TO00000000A4', person: 'Nobody Here', start_date: '2026-10-07', end_date: '2026-10-07', houses: 'BM4060',
        status: 'scheduled' },
      { id: 'TO00000000A5', person: 'Kim Lead', start_date: '2026-09-20', end_date: '2026-09-21', houses: '48TH (B)',
        status: 'pending' },
      { id: 'TO00000000A6', person: 'Ann Roe', start_date: '2025-01-02', end_date: '2025-01-03', status: 'history' },
      { id: 'TO00000000A7', person: 'Ben Left', start_date: '2026-11-02', end_date: '2026-11-03', status: 'needs_review' },
      { id: 'TO00000000A8', person: 'Ann Roe', start_date: '2026-11-09', end_date: '2026-11-09', status: 'denied' }
