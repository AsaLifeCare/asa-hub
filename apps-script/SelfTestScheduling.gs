    var every = st('annroe', BM);
    mapThrows = true;
    var noMap = st('annroe', BM);
    scope = 'house'; mapThrows = false;
    stAssert_(out, P + 'IST: trained at THAT house as the relay reads it — done or a trainedAt date counts, owed and ' +
                   'nothing do not, another house does not, a lapse under ist_valid_days is owed; settings never read, a ' +
                   'book that throws or is empty, or an unreadable client map read as unreadable (never trained); the ' +
                   'book is read once an execution; no sentence names a client',
