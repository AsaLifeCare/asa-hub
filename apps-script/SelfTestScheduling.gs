/** An in-memory house tab: the calls schedRead_/schedWrite_/schedRemove_ and ensureHeader_ make. */
function stSchedSheet_(grid) {
  var width = function () { return grid.length ? grid[0].length : 0; };
  return {
    grid: grid,
    getLastRow: function () { return grid.length; },
    getLastColumn: function () { return width(); },
    getMaxRows: function () { return Math.max(grid.length, 1000); },
    insertRowsAfter: function () {},
    deleteRow: function (r) { grid.splice(r - 1, 1); },
    getDataRange: function () {
      return { getValues: function () { return grid.map(function (row) { return row.slice(); }); } };
    },
    getRange: function (r, c, nr, nc) {
      nr = nr || 1; nc = nc || 1;
      return {
        getValues: function () {
          var out = [];
          for (var i = 0; i < nr; i++) {
            var row = [];
            for (var j = 0; j < nc; j++) {
              var src = grid[r - 1 + i];
              row.push(src && src[c - 1 + j] !== undefined ? src[c - 1 + j] : '');
            }
            out.push(row);
          }
          return out;
        },
        setValues: function (vals) {
          for (var i = 0; i < nr; i++) {
            while (grid.length < r + i) grid.push([]);
            for (var j = 0; j < nc; j++) grid[r - 1 + i][c - 1 + j] = vals[i][j];
          }
        },
        setNumberFormat: function () { return this; }
      };
    }
  };
}

/** The six houses held in memory, filled from plain rows: { tab: sheet }. */
function stSchedStore_(data) {
  var store = {};
  Object.keys(SCHED_HEADERS).forEach(function (tab) {
    var header = SCHED_HEADERS[tab];
    var grid = [header.slice()];
    (data[tab] || []).forEach(function (row) {
      grid.push(header.map(function (h) { return row[h] === undefined ? '' : String(row[h]); }));
    });
    store[tab] = stSchedSheet_(grid);
  });
  return store;
}

function stSchedRowsOf_(store, tab) {
  var grid = store[tab].grid, header = grid[0];
  return grid.slice(1).map(function (line) {
    var o = {};
    header.forEach(function (h, i) { o[h] = String(line[i] == null ? '' : line[i]).replace(/^'/, ''); });
    return o;
  });
}

function stSchedCell_(house, rowId, date, text, extra) {
  var cls = schedClassify_(text);
  var row = { id: schedCellId_(house, rowId, date), period_id: 'P2026-09-28', house_code: house, date: date,
              row_id: rowId, text: text, kind: cls ? cls.kind : '',
              start_min: cls && cls.start !== null ? Math.round(cls.start * 60) : '',
              end_min: cls && cls.end !== null ? Math.round(cls.end * 60) : '',
              hours: cls ? cls.hours.toFixed(2) : '0.00', state: 'scheduled', source: 'seed:test' };
  for (var k in (extra || {})) row[k] = extra[k];
  return row;
}

