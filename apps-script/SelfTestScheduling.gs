      fresh: fresh, setStore: function (s) { store = s; }, getStore: function () { return store; },
      MASTER: MASTER, TY: TY, RB: RB, ANN: ANN, BEN: BEN, keep: keep
    });
    stSchedTimeOffImport_(out, P, {
      fresh: fresh, setStore: function (s) { store = s; }, getStore: function () { return store; },
      MASTER: MASTER, ANN: ANN
    });
  } catch (e) {
    stAssert_(out, P + 'the section ran to the end', false, String((e && e.stack) || e).slice(0, 400));
  } finally {
    houseMoved_ = keep.moved; hubTabEnsure_ = keep.ensure; sheetDbGateHolds_ = keep.holds;
    hubProfileAppGate_ = keep.gate; hubIsRealMaster_ = keep.real; certPicture_ = keep.certs;
    hubTestModeState_ = keep.test; reconCalendarLinks_ = keep.links;
    if (keep.people) commBroadcastPeople_ = keep.people;
    HUB_USERS_ROWS = keep.users; HUB_MEMBER_CTX = keep.member;
    g.hubSchedHoursHidden_ = keep.hours;
    if (keep.hours === undefined) { try { delete g.hubSchedHoursHidden_; } catch (eD) {} }
    try { CacheService.getScriptCache().remove(SCHED_BADGES_KEY); } catch (eB) {}
    SCHED_BOARD_VERSION_KEY = keep.vkey; SCHED_BADGES_KEY = keep.bkey; SCHED_CHUNK = keep.chunk;
    if (keep.tell) smartTell_ = keep.tell;
    SCHED_FLOW_NOW = keep.flowNow;
    LockService.getScriptLock = keep.getLock; SpreadsheetApp.flush = keep.flush; schedBuildBase_ = keep.build;
    if (keep.sha1) { try { delete Utilities.DigestAlgorithm.SHA_1; } catch (eS) {} }
    SCHED_IST_MEMO = null;
    hubGrantReader_ = keep.grant; listRows_ = keep.listRows; istConfig_ = keep.istConfig;
    istConfigSource_ = keep.istSource; istCfgChoice_ = keep.istChoice; istCfgInt_ = keep.istInt;
    try { PropertiesService.getScriptProperties().deleteProperty(SCHED_INBOX_SHARED_PROP); } catch (eP) {}
    try { CacheService.getScriptCache().remove(SCHED_INBOX_SHARE_TRY_KEY); } catch (eT) {}
    SCHED_INBOX_TOUCHED = false;
    schedMemoDrop_();
    SCHED_BOARD_MEMO = {};
  }
}

// The flows over the real data layer (both files, one in-memory store): what a lock reads, the one cell a row holds…
function stSchedFlowsOverData_(out, P, t) {
  var BM = 'BM4060', LD = 'LD4048';
  var CY = { id: 'USR_CY', display_name: 'Cy Far', email: 'cy@x', role: 'staff' };
  var sent = [];
  smartTell_ = function (o) {
    sent.push(o);
    return { situation: o.situation, state: 'held', held: 'test_mode', why: 'test mode', receipt: '', unreadable: false };
  };
  SCHED_FLOW_NOW = '2026-10-01T14:00:00Z';
  if (t.keep.people) {
    commBroadcastPeople_ = function () {
      var on = function (phone) { return { phone: phone, status: 'active' }; };
      return { readable: true, onStaff: { active: true },
               byKey: { reginabowman: on('3305550110'), annroe: on('3305550111'), benleft: on('3305550112'),
                        cyfar: on('3305550113') } };
    };
  }
  if (!HUB_USERS_ROWS.some(function (u) { return u.userid === 'USR_CY'; })) {
    HUB_USERS_ROWS = HUB_USERS_ROWS.concat([{ userid: 'USR_CY', displayname: 'Cy Far', email: 'cy@x', role: 'staff',
                                              types: 'STAFF', active: 'TRUE' }]);
  }
  var flowRow = function (o) {
    var r = {};
    SCHED_HEADERS.sched_flows.forEach(function (h) { r[h] = o[h] === undefined ? '' : o[h]; });
    return r;
  };
  t.setStore(stSchedStore_({
    sched_settings: [
      { key: 'houses', value: JSON.stringify([{ code: BM, location: 'CAN - BM - BM4060', short: 'BM' },
                                              { code: LD, location: 'CAN - LD - LD4048', short: 'LD' }]) },
      { key: 'periods', value: JSON.stringify([{ id: 'P2026-09-28', first: '2026-09-28', last: '2026-10-25', state: 'live' }]) },
      { key: 'directors', value: 'ty.bond@asalifecare.com' }
    ],
    sched_rows: [
      stSchedRow_(BM, 'OPEN:1', 'open', 'OPEN', '', 0), stSchedRow_(BM, 'P:reginabowman', 'person', 'Regina Bowman', '**', 1),
      stSchedRow_(BM, 'P:annroe', 'person', 'Ann Roe', '', 2), stSchedRow_(BM, 'P:benleft', 'person', 'Ben Left', '', 3),
      stSchedRow_(BM, 'P:cyfar', 'person', 'Cy Far', '', 4), stSchedRow_(LD, 'OPEN:1', 'open', 'OPEN', '', 0),
      stSchedRow_(LD, 'P:cyfar', 'person', 'Cy Far', '', 1)
    ],
    sched_cells: [
      stSchedCell_(BM, 'P:annroe', '2026-10-20', '7A-3P'), stSchedCell_(BM, 'OPEN:1', '2026-10-20', '3P-11P', { state: 'open' }),
      stSchedCell_(BM, 'P:cyfar', '2026-10-21', '7A-3P'), stSchedCell_(BM, 'P:benleft', '2026-10-21', '3P-11P'),
      stSchedCell_(BM, 'P:annroe', '2026-10-21', 'OFF'), stSchedCell_(BM, 'P:benleft', '2026-10-22', '3P-11P'),
      stSchedCell_(BM, 'P:annroe', '2026-10-23', '8A-4P'), stSchedCell_(BM, 'OPEN:1', '2026-10-23', '4P-12A', { state: 'open' }),
      stSchedCell_(BM, 'P:benleft', '2026-10-24', '3P-11P'), stSchedCell_(BM, 'P:benleft', '2026-10-25', '7A-3P'),
      stSchedCell_(BM, 'P:annroe', '2026-10-26', '8A-4P'), stSchedCell_(BM, 'P:cyfar', '2026-10-19', 'LD'),
      stSchedCell_(LD, 'OPEN:1', '2026-10-19', '8A-4P', { state: 'open' }), stSchedCell_(LD, 'P:cyfar', '2026-10-20', '4P-12A')
    ],
    sched_flows: [flowRow({
      id: 'SFAAAAAAAAAA', kind: 'swap', state: 'waiting_staff', house_code: BM, date: '2026-10-18', row_id: 'P:benleft',
      person: 'Ben Left', person_key: 'benleft', person_uid: 'USR_BL', shift_text: '3P-11P', start_min: 900, end_min: 1380,
      replacement: 'Cy Far', replacement_key: 'cyfar', replacement_uid: 'USR_CY', outreach_next_at: '2026-10-01T13:00:00.000Z',
      outreach_log: JSON.stringify({ owed: [{ idem: 'sched:SFAAAAAAAAAA:sched_swap_ask:cyfar', sit: 'sched_swap_ask',
                                               key: 'cyfar', vars: {}, while: 'waiting_staff' }] })
    })]
  }));
  var store = t.getStore();
  schedBump_();
  var rows = function (tab) { return stSchedRowsOf_(store, tab); };
  var setField = function (tab, id, field, value) {
    var grid = store[tab].grid, col = grid[0].indexOf(field);
    grid.forEach(function (line, i) { if (i && line[0] === id) line[col] = value; });
  };
  var putCell = function (c) { store.sched_cells.grid.push(SCHED_HEADERS.sched_cells.map(function (h) { return c[h] === undefined ? '' : String(c[h]); })); };
  var act = function (name, payload, who) { t.fresh(); return HUB_ACTIONS[name](payload, who); };
  var at = function (house, rowId, date) { t.fresh(); return schedCellAt_(house, rowId, date); };
  var flowOf = function (id) { t.fresh(); return schedFlowFlowById_(id) || {}; };
  var answer = function (flowId, who, word) {
    var item = rows('sched_inbox').filter(function (i) {
      return i.flow_id === flowId && i.to_uid === who.id && i.box === 'work' && i.state === 'waiting';
    })[0];
    return item ? act('schedulingAnswer', { item_id: item.id, word: word || 'approve' }, who) : { status: 0, message: 'no item' };
  };
  var swapThrough = function (house, from, rowKey, date, toKey, toWho) {
    var p = act('schedulingSwapPropose', { house: house, row_id: 'P:' + rowKey, date: date, replacement: toKey }, from);
    var id = p.status === 200 ? p.data.flow_id : '';
    var said = [p.status, answer(id, toWho).status, answer(id, t.RB).status, answer(id, t.TY).status];
    return { id: id, said: said };
  };

  // ---- a lock reads the houses afresh: rows held from before it are another execution's past ----
  t.fresh();
  schedRead_('sched_flows');
  setField('sched_flows', 'SFAAAAAAAAAA', 'state', 'waiting_director');
  var inLock = schedLock_(function () { return schedFlowFlowById_('SFAAAAAAAAAA').state; });
  t.fresh();
  schedRead_('sched_flows');
  setField('sched_flows', 'SFAAAAAAAAAA', 'state', 'waiting_manager');
  var worked = schedFlowWork_(['SFAAAAAAAAAA'], 5000, 0, false);
  var afterWork = flowOf('SFAAAAAAAAAA');
  schedRead_('sched_flows');
  setField('sched_flows', 'SFAAAAAAAAAA', 'state', 'withdrawn');
  schedFlowRecord_([{ id: 'SFAAAAAAAAAA', state: '', stage: 0, next_at: '', why: '', handled: [], texts: [], owed_next: '' }]);
  var afterRecord = flowOf('SFAAAAAAAAAA');
  stAssert_(out, P + 'under the lock every house is read again: a lock, the clock\'s claim and its record never write ' +
                 'back rows this execution held from before another execution changed them',
            inLock === 'waiting_director' && worked.ran === true && afterWork.state === 'waiting_manager' &&
            (schedJson_(afterWork.outreach_log, {}).owed || []).length === 0 && afterRecord.state === 'withdrawn',
            JSON.stringify([inLock, afterWork.state, afterRecord.state]));

  // ---- one row holds one cell a day ----
  var annTake = act('schedulingTake', { house: BM, row_id: 'OPEN:1', date: '2026-10-20' }, t.ANN);
  var benToCy = act('schedulingSwapPropose', { house: BM, row_id: 'P:benleft', date: '2026-10-21', replacement: 'cyfar' }, t.BEN);
  stAssert_(out, P + 'a take or a swap never writes over a second shift at the same house that day (a handover is free, ' +
                 'but the row holds one cell): refused, and nothing changes',
            annTake.status === 409 && annTake.message === 'You already have 7A-3P at BM that day — a row holds one shift a day.' &&
            at(BM, 'P:annroe', '2026-10-20').text === '7A-3P' && at(BM, 'OPEN:1', '2026-10-20').state === 'open' &&
            benToCy.status === 409 && /^Cy Far already has 7A-3P at BM that day/.test(benToCy.message),
            JSON.stringify([annTake, benToCy]));
  var late = act('schedulingSwapPropose', { house: BM, row_id: 'P:benleft', date: '2026-10-22', replacement: 'cyfar' }, t.BEN);
  var lateId = late.status === 200 ? late.data.flow_id : '';
  var lateSeats = [answer(lateId, CY).status, answer(lateId, t.RB).status];
  putCell(stSchedCell_(BM, 'P:cyfar', '2026-10-22', '7A-3P'));
  var lateLast = answer(lateId, t.TY);
  var lateFlow = flowOf(lateId);
  stAssert_(out, P + 'a swap whose replacement was given another shift at that house meanwhile expires at the last ' +
                 'seat, and neither cell changes',
            late.status === 200 && lateSeats.join() === '200,200' && lateLast.status === 200 && lateFlow.state === 'expired' &&
            /now has another shift at BM/.test(lateFlow.note) && at(BM, 'P:benleft', '2026-10-22').text === '3P-11P' &&
            at(BM, 'P:cyfar', '2026-10-22').state === 'scheduled', JSON.stringify([late.status, lateSeats, lateFlow.state, lateFlow.note]));

  // ---- a genuinely open shift taken keeps the pattern; a call-off after it opens a new row ----
  var cyTake = act('schedulingTake', { house: BM, row_id: 'OPEN:1', date: '2026-10-23' }, CY);
  var cyCell = at(BM, 'P:cyfar', '2026-10-23') || {};
  var open1 = at(BM, 'OPEN:1', '2026-10-23') || {};
  var annCo = act('schedulingCallOff', { house: BM, row_id: 'P:annroe', date: '2026-10-23', reason: 'sick kid' }, t.ANN);
  var annFlow = flowOf(annCo.status === 200 ? annCo.data.flow_id : '');
  stAssert_(out, P + 'take of a genuinely open shift: the taker\'s cell is a one-off over their own base, the OPEN cell ' +
                 'keeps the shift as its base, and a later call-off that day opens a new OPEN row instead of using it',
            cyTake.status === 200 && cyCell.text === '4P-12A' && cyCell.state === 'taken' && cyCell.base === '' &&
            open1.text === '' && open1.state === 'taken' && open1.base === '4P-12A' &&
            annCo.status === 200 && annFlow.open_row_id === 'OPEN:2' && at(BM, 'OPEN:2', '2026-10-23').text === '8A-4P',
            JSON.stringify([cyTake.status, cyCell, open1, annFlow.open_row_id]));
  stAssert_(out, P + 'the call-off says what the house\'s texts did — held by test mode, nobody contacted — never ' +
                 '"being texted" when nothing went',
            annCo.status === 200 && /held by test mode — nobody was contacted/.test(annCo.data.said) &&
            !/being texted/.test(annCo.data.said), annCo.data && annCo.data.said);

  // ---- a call-off is private: busy and the refusal say only "not free" to whoever may not know ----
  t.fresh();
  var cyBoard = HUB_ACTIONS.schedulingBoard({}, CY).data;
  t.fresh();
  var rbBoard = HUB_ACTIONS.schedulingBoard({}, t.RB).data;
  var on = function (b, key, d) { return (b.busy[key] || []).filter(function (x) { return x[0] === d; })[0] || null; };
  var cySwap = act('schedulingSwapPropose', { house: BM, row_id: 'P:cyfar', date: '2026-10-23', replacement: 'annroe' }, CY);
  stAssert_(out, P + 'a call-off reaches other staff as "not free that day" only — no house, no span, no C/O — while ' +
                 'the house\'s editor reads it whole; a shift\'s own entry says it is work',
            JSON.stringify(on(cyBoard, 'annroe', '2026-10-23')) === '["2026-10-23",0,1440,"","day"]' &&
            JSON.stringify(on(rbBoard, 'annroe', '2026-10-23')) === '["2026-10-23",0,1440,"BM4060","day"]' &&
            JSON.stringify(on(cyBoard, 'cyfar', '2026-10-23')) === '["2026-10-23",960,1440,"BM4060","work"]' &&
            JSON.stringify(cyBoard).indexOf('sick kid') === -1,
            JSON.stringify([on(cyBoard, 'annroe', '2026-10-23'), on(rbBoard, 'annroe', '2026-10-23')]));
  stAssert_(out, P + 'a swap of a shift taken from OPEN is offered like any own shift, and its refusal never names ' +
                 'somebody else\'s call-off',
            cySwap.status === 409 && cySwap.message === 'Not possible: Ann Roe is not free that day.', JSON.stringify(cySwap));

  // ---- an editor gives the call-off's OPEN shift to somebody: one write, a one-off, the outreach covered ----
  var given = act('schedulingCellSave', { house: BM, row_id: 'P:benleft', date: '2026-10-23', open_row_id: 'OPEN:2', via: 'add' }, t.RB);
  var benCell = at(BM, 'P:benleft', '2026-10-23') || {};
  stAssert_(out, P + 'assign: the person\'s cell is the call-off\'s one-off (taken, the flow named), the OPEN cell is ' +
                 'cleared and the outreach is covered — all in one write that answers with the house\'s history',
            given.status === 200 && benCell.text === '8A-4P' && benCell.state === 'taken' && benCell.flow_id === annFlow.id &&
            at(BM, 'OPEN:2', '2026-10-23') === null && flowOf(annFlow.id).state === 'covered' &&
            !!(given.data.log && given.data.log[BM] && given.data.log[BM].length),
            JSON.stringify([given.status, given.message, benCell]));

  // ---- the chains the roll must keep right ----
  var toAsk = act('schedulingTimeOff', { from: '2026-10-23', to: '2026-10-23' }, CY);
  var toId = toAsk.status === 200 ? toAsk.data.flow_id : '';
  var toOk = answer(toId, t.TY);
  var cyOff = at(BM, 'P:cyfar', '2026-10-23') || {};
  var s1 = swapThrough(BM, t.BEN, 'benleft', '2026-10-24', 'cyfar', CY);
  var cyIn = at(BM, 'P:cyfar', '2026-10-24') || {};
  var cyCo = act('schedulingCallOff', { house: BM, row_id: 'P:cyfar', date: '2026-10-24' }, CY);
  var s2 = swapThrough(BM, t.BEN, 'benleft', '2026-10-25', 'cyfar', CY);
  var s3 = swapThrough(BM, CY, 'cyfar', '2026-10-25', 'annroe', t.ANN);
  stAssert_(out, P + 'a shift that came by a take or a swap is the person\'s own: time off opens it, it can be called ' +
                 'off, and it can be swapped again — each keeping that person\'s own base (here none)',
            toAsk.status === 200 && toOk.status === 200 && cyOff.text === 'R/O' && cyOff.state === 'time_off' && cyOff.base === '' &&
            s1.said.join() === '200,200,200,200' && cyIn.state === 'swap_in' && cyIn.base === '' &&
            cyCo.status === 200 && (at(BM, 'P:cyfar', '2026-10-24') || {}).base === '' &&
            s2.said.join() === '200,200,200,200' && s3.said.join() === '200,200,200,200' &&
            (at(BM, 'P:annroe', '2026-10-25') || {}).state === 'swap_in' && at(BM, 'P:cyfar', '2026-10-25') === null &&
            at(BM, 'OPEN:1', '2026-10-23').base === '4P-12A',
            JSON.stringify([toAsk.status, toOk.status, cyOff, s1.said, cyIn, cyCo.status, s2.said, s3.said]));
  t.fresh();
  var plan = schedRollPlan_({ id: 'P2026-09-28', first: '2026-09-28', last: '2026-10-25' },
                            { id: 'P2026-10-26', first: '2026-10-26', last: '2026-11-22' },
                            schedRead_('sched_cells'), schedRead_('sched_rows'), schedRead_('sched_flows'),
                            schedHouseTokens_(), 'T', 'test');
  var laid = function (house, d) {
    return plan.cells.filter(function (c) { return c.house_code === house && c.date === d; })
      .map(function (c) { return c.row_id + '=' + c.text + '/' + c.state; }).sort().join(' ');
  };
  stAssert_(out, P + 'the roll gives each shift back to whoever held it in the pattern — the OPEN row a taken genuine ' +
                 'open shift, the caller their called-off shift, the giver their swapped shift — and nothing to who ' +
                 'had it by a take, a swap, an assign or a chain of them; no shift is laid twice',
            laid(BM, '2026-11-20') === 'OPEN:1=4P-12A/open P:annroe=8A-4P/scheduled' &&
            laid(BM, '2026-11-21') === 'P:benleft=3P-11P/scheduled' &&
            laid(BM, '2026-11-22') === 'P:benleft=7A-3P/scheduled' &&
            laid(BM, '2026-11-17') === 'OPEN:1=3P-11P/open P:annroe=7A-3P/scheduled' &&
            laid(LD, '2026-11-16') === 'OPEN:1=8A-4P/open' && laid(BM, '2026-11-16') === '',
            JSON.stringify([laid(BM, '2026-11-20'), laid(BM, '2026-11-21'), laid(BM, '2026-11-22'), laid(LD, '2026-11-16'),
                            laid(BM, '2026-11-16')]));

  // ---- an echo of a house never blocks a shift at that house (the flows tell the clash where) ----
  var ldTake = act('schedulingTake', { house: LD, row_id: 'OPEN:1', date: '2026-10-19' }, CY);
  stAssert_(out, P + 'an unbacked echo naming LD does not stop its person taking LD\'s open shift that day',
            ldTake.status === 200, JSON.stringify(ldTake));

  // ---- the editor's writes ----
  var medDel = act('schedulingCellSave', { house: BM, row_id: 'P:cyfar', date: '2026-10-20', value: 'MED DEL 8A-4P', via: 'add' }, t.MASTER);
  var overOff = act('schedulingCellSave', { house: BM, row_id: 'P:annroe', date: '2026-10-21', value: '7A-3P', via: 'add' }, t.MASTER);
  var twice = act('schedulingCellSave', { house: BM, row_id: 'P:annroe', date: '2026-10-21', value: '3P-11P', via: 'add' }, t.MASTER);
  stAssert_(out, P + 'an alias with a time holds that time (8A-4P hands over to an evening elsewhere); an add over OFF ' +
                 'replaces it; an add over a working shift is refused',
            medDel.status === 200 && overOff.status === 200 && at(BM, 'P:annroe', '2026-10-21').text === '7A-3P' &&
            twice.status === 409, JSON.stringify([medDel.status, medDel.message, overOff.status, overOff.message, twice.status]));

  // ---- the roll names its source ----
  var rolledTwice = act('schedulingRoll', { dry_run: false, from: 'P2026-08-31' }, t.MASTER);
  stAssert_(out, P + 'a real roll that names a period that is no longer the last rolls nothing (a second press, a re-sent ' +
                 'request), and the roll and the seed are not re-sent by the relay',
            rolledTwice.status === 409 && /^Already rolled: the last period is now P2026-09-28/.test(rolledTwice.message) &&
            HUB_POLICY.schedulingRoll.idempotent === false && HUB_POLICY.schedulingSeed.idempotent === false &&
            HUB_POLICY.schedulingRoll.params.from.type === 'string', JSON.stringify(rolledTwice));

  // ---- the week's hours across the period's edge ----
  t.fresh();
  var weekB = HUB_ACTIONS.schedulingBoard({}, t.MASTER).data;
  var annW = weekB.grids[BM].rows.filter(function (r) { return r.row_id === 'P:annroe'; })[0];
  stAssert_(out, P + 'a Saturday week that straddles two periods counts the hours of both (Sat 10/24 – Fri 10/30)',
            annW.hours.by_week['2026-10-24'] === 16, JSON.stringify(annW.hours));

  // ---- the board is read back after the lock, and the writes are flushed before it goes ----
  var events = [], heldNow = false;
  LockService.getScriptLock = function () {
    return { tryLock: function () { heldNow = true; events.push('lock'); return true; },
             releaseLock: function () { heldNow = false; events.push('release'); } };
  };
  SpreadsheetApp.flush = function () { events.push('flush'); };
  schedBuildBase_ = function (p) { events.push(heldNow ? 'build-held' : 'build'); return t.keep.build(p); };
  var lo = act('schedulingCellSave', { house: BM, row_id: 'P:annroe', date: '2026-10-22', value: '8A-4P', via: 'add' }, t.MASTER);
  LockService.getScriptLock = t.keep.getLock; SpreadsheetApp.flush = t.keep.flush; schedBuildBase_ = t.keep.build;
  stAssert_(out, P + 'an editor\'s write flushes before the lock goes and reads the board back after it, never while ' +
                 'holding everyone else up',
            lo.status === 200 && events.indexOf('build-held') === -1 && events.indexOf('flush') > events.indexOf('lock') &&
            events.indexOf('flush') < events.indexOf('release') && events.lastIndexOf('build') > events.indexOf('release'),
            events.join(','));

  // ---- a fresh OPEN row number never lands on a cell already there; the seed reports timed echoes ----
  var pick = schedOpenRowFor_(BM, '2026-10-30', [stSchedRow_(BM, 'OPEN:1', 'open', 'OPEN', '', 0)],
                              (function () { var o = {}; o[schedCellId_(BM, 'OPEN:1', '2026-10-30')] = true;
                                             o[schedCellId_(BM, 'OPEN:2', '2026-10-30')] = true; return o; })());
  var book = function (code, short, text) {
    return { code: code, short: short, location: 'CAN - ' + short + ' - ' + code, book_id: 'b' + code, header_row: 1,
             dates: ['2026-09-28'], in_period: 1, weekday_mismatch: [], duplicates: [],
             rows: [{ row_id: 'P:annroe', row_kind: 'person', name: 'Ann Roe', person_key: 'annroe', designation: '', order: 1 }],
             cells: [{ row_id: 'P:annroe', row_kind: 'person', name: 'Ann Roe', date: '2026-09-28', text: text, color: '' }] };
  };
  var seeded = schedSeedPlan_([book('MS1234', 'MS', '8A-4P > 48TH (B)'), book('ABD1711', '48TH (B)', '8A-4P > MS')],
                              '2026-09-28', '2026-10-25', 'T');
  stAssert_(out, P + 'a new OPEN row is numbered past every cell that day; the seed lists the same hours written at two ' +
                 'houses that name each other (not guessed which is worked)',
            pick.row_id === 'OPEN:3' && seeded.report.timed_echoes.length === 2 &&
            seeded.report.timed_echoes[0].other === 'ABD1711', JSON.stringify([pick, seeded.report.timed_echoes]));
}

// The training: somebody new to a house without its IST, placed there by an editor, an assign, a take or a swap…
function stSchedTraining_(out, P, t) {
  var BM = 'BM4060', LD = 'LD4048';
  var NW = { id: 'USR_NW', display_name: 'Nia West', email: 'nia@x', role: 'staff' };
