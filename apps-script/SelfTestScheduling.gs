              dc.rows === 8 && dc.imported === 3 && dc.approved === 2 && dc.waiting === 1 && dc.unmatched === 1 &&
              dc.skipped === 4 && dc.already_imported === 0 && dc.with_conflicts === 1 && dc.by_status.history === 1 &&
              a1.outcome === 'would_import' && a1.matched === 'Ann Roe' && JSON.stringify(a1.houses) === '["BM4060"]' &&
