            { staffName: 'Ben Left', house: 'bm4060', status: 'owed', trainedAt: '', clientName: 'C1' },
            { staffName: 'Cy Far', house: 'BM4060', status: 'owed', trainedAt: '2026-02-01', clientName: 'C1' },
