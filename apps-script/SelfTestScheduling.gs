    stAssert_(out, P + 'time off import: a second run carries nothing (every row already carried is named, no flow or ' +
                   'item added), the waiting one is decidable by its director, the source is never written, and an ' +
                   'unreadable Time Off house is said',
              again.status === 200 && again.data.report.counts.imported === 0 &&
              again.data.report.counts.already_imported === 3 && rowsOf('sched_flows').length === flowsBefore + 3 &&
              rowsOf('sched_inbox').length === inboxBefore + 1 && told === 0 && !!asked && !!asked.item &&
              asked.item.id === items[0].id && JSON.stringify(src) === srcText && down.status === 503,
              JSON.stringify([again.status === 200 ? again.data.report.counts : again, asked, down.status]));
  } finally {
    schedTimeOffSourceRows_ = keep.source;
    if (keep.tell) smartTell_ = keep.tell;
    SCHED_FLOW_NOW = keep.now;
  }
}
