                   'open shift is theirs as a training (the OPEN row keeps its pattern), the take answers why',
              t4 && /as a training with the house manager, not as the DSP/.test(k1.data.said) && c4.state === 'training' &&
              c4.flow_id === t4 && f4.source === 'take' && o4.state === 'taken' && o4.base === '3P-11P' && o4.text === '',
              JSON.stringify([k1.status, k1.message || k1.data.said, c4, o4]));
    sent = [];
    var d4 = answer(t4, t.TY, 'decline');
    var f4b = flowOf(t4);
    var reopened = at(BM, f4b.open_row_id, '2026-10-21') || {};
    var co4 = flowOf(reopened.flow_id);
    stAssert_(out, P + 'training declined (one seat is enough): the trainee leaves the cell, the shift opens on an OPEN ' +
                   'row at the top with a call-off flow (source training) whose outreach never texts the trainee; every ' +
                   'item closes, the trainee, the house manager and the directors are told, the trainee is texted',
              d4.status === 200 && /is off the shift/.test(d4.data.said) && f4b.state === 'declined' &&
