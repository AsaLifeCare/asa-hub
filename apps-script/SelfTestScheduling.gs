    stAssert_(out, P + 'an editor changing the hours of a swapped-in shift keeps it swapped in with its holder\'s own base, ' +
                   'so the roll still gives the pattern to whoever held it first',
              swEdit.status === 200 && benIn.text === '8A-4P' && benIn.state === 'swap_in' && benIn.base === '' &&
              benIn.flow_id === 'SFX000000001', JSON.stringify(benIn));

    // ---- the roll never asks for an IST and gives each pattern back to its first holder ----
    t.fresh();
    var plan = schedRollPlan_({ id: 'P2026-09-28', first: '2026-09-28', last: '2026-10-25' },
                              { id: 'P2026-10-26', first: '2026-10-26', last: '2026-11-22' },
                              schedRead_('sched_cells'), schedRead_('sched_rows'), schedRead_('sched_flows'),
                              schedHouseTokens_(), 'T', 'test');
    var laid = function (house, d) {
      return plan.cells.filter(function (c) { return c.house_code === house && c.date === d; })
        .map(function (c) { return c.row_id + '=' + c.text + '/' + c.state; }).sort().join(' ');
    };
    var rollCode = stCode_(schedRollPlan_) + stCode_(schedRoll_);
    stAssert_(out, P + 'the roll and the trainings: an approved editor\'s training is the trainee\'s pattern; one still ' +
                   'waiting is laid on an OPEN row, not on the trainee; a take or a swap gives the trainee nothing (the ' +
                   'OPEN row and the giver keep theirs); a declined one leaves nothing twice — and the roll never reads an IST',
              laid(BM, '2026-11-21') === 'P:niawest=9A-5P/scheduled' && laid(BM, '2026-11-18') === 'OPEN:1=3P-11P/open' &&
              laid(LD, '2026-11-20') === 'OPEN:1=8A-4P/open' && laid(BM, '2026-11-17') === 'P:annroe=7A-3P/scheduled' &&
              laid(LD, '2026-11-19') === 'OPEN:1=7A-3P/open' && laid(BM, '2026-11-22') === '' &&
              plan.dropped.training_waiting === 1 && rollCode.indexOf('schedIst') === -1 &&
              rollCode.indexOf('schedTrainingNeed_') === -1,
              JSON.stringify([laid(BM, '2026-11-21'), laid(BM, '2026-11-18'), laid(LD, '2026-11-20'), laid(BM, '2026-11-17'),
                              laid(LD, '2026-11-19'), laid(BM, '2026-11-22'), plan.dropped]));

    // ---- the clock: a training nobody answered before its shift ended stood as one ----
    SCHED_FLOW_NOW = '2026-10-23T05:00:00Z';
    t.fresh();
    var gone = schedLock_(function () { return schedFlowExpireStale_(schedRead_('sched_flows'), schedFlowNow_()); });
    stAssert_(out, P + 'training: the clock closes one still waiting after its shift ended as expired — its items closed, ' +
                   'the trainee told it stood as a training, no text',
              gone.some(function (f) { return f.id === t9; }) && flowOf(t9).state === 'expired' &&
              itemsOf(function (i) { return i.flow_id === t9 && i.box === 'work' && i.state === 'waiting'; }).length === 0 &&
              itemsOf(function (i) { return i.flow_id === t9 && i.seat === 'trainee' && /^Not answered in time — Training/.test(i.title); }).length === 1,
              JSON.stringify(gone.map(function (f) { return f.id + ':' + f.state; })));
    SCHED_FLOW_NOW = '2026-10-01T14:00:00Z';

    stSchedEditorsVsFlows_(out, P, { act: act, at: at, flowOf: flowOf, itemsOf: itemsOf, waitingFor: waitingFor,
                                     answer: answer, store: store, sent: function () { return sent; },
                                     clearSent: function () { sent = []; }, RB: t.RB, TY: t.TY, ANN: t.ANN, BEN: t.BEN });

    // ---- nobody can approve: the placement is refused before anything is written ----
    var grid = store.sched_settings.grid, col = grid[0].indexOf('value');
    grid.forEach(function (line, i) { if (i && line[0] === 'directors') line[col] = ''; });
    schedBump_();
    store.sched_cells.grid.push(SCHED_HEADERS.sched_cells.map(function (h) {
      var c = stSchedCell_(LD, 'OPEN:1', '2026-10-24', '8A-4P', { state: 'open' });
      return c[h] === undefined ? '' : String(c[h]);
    }));
    var flowsBefore = rows('sched_flows').length;
    var refused = act('schedulingTake', { house: LD, row_id: 'OPEN:1', date: '2026-10-24' }, OL);
    stAssert_(out, P + 'training: with no director readable the take is refused with why, and nothing is written',
              refused.status === 503 && /Nobody can approve a training/.test(refused.message) &&
              rows('sched_flows').length === flowsBefore && (at(LD, 'OPEN:1', '2026-10-24') || {}).state === 'open',
              JSON.stringify(refused));

    // ---- the items house is shared with the relay's mirror, once ----
    var grants = [], grantOk = false;
    hubGrantReader_ = function (file, who, said) {
      grants.push(file.getId() + ' ' + who);
      if (said) { said.ok = grantOk; said.reason = grantOk ? '' : 'Drive answered 403'; }
      return grantOk;
    };
    houseIdFor_ = function (tab) { return 'BOOK_' + tab; };
    hubSysLog_ = function (a, ev, what) { logged.push(ev + ' ' + what); return true; };
    var props = PropertiesService.getScriptProperties();
    props.deleteProperty(SCHED_INBOX_SHARED_PROP);
    CacheService.getScriptCache().remove(SCHED_INBOX_SHARE_TRY_KEY);
    var item = function (n) {
      return { id: 'SITEST00000' + n, flow_id: 'SFTEST', box: 'inbox', kind: 'info', seat: 'everyone', title: 'x' + n,
               state: 'posted', created_at: 'T' };
    };
    var write = function (n) { t.fresh(); schedLock_(function () { schedAppend_('sched_inbox', [item(n)]); return {}; }); };
    write(1);
    var firstTry = grants.length, firstSaid = logged.slice();
    write(2);
    var throttled = grants.length;
    CacheService.getScriptCache().remove(SCHED_INBOX_SHARE_TRY_KEY);
    grantOk = true;
    write(3);
    var granted = grants.length, remembered = props.getProperty(SCHED_INBOX_SHARED_PROP);
    CacheService.getScriptCache().remove(SCHED_INBOX_SHARE_TRY_KEY);
    write(4);
    t.fresh();
    schedLock_(function () { schedAppend_('sched_log', [schedLogRow_(null, BM, '', '', '', '', 'add', '', '')]); return {}; });
    stAssert_(out, P + 'the items house is let in to the relay mirror through the silent door after its first write, ' +
                   'outside the lock: a refusal is said in the system log and tried again later (never claimed), a ' +
                   'success is remembered and never asked again, and other houses never ask',
              firstTry === 1 && grants[0] === 'BOOK_sched_inbox ' + SCHED_INBOX_READER &&
              firstSaid.some(function (l) { return /^scheduling_inbox_not_shared /.test(l) && /403/.test(l); }) &&
              throttled === 1 && granted === 2 && !!remembered && grants.length === 2,
              JSON.stringify([grants, logged, remembered]));
  } finally {
    istOhioToday_ = keep.today; houseIdFor_ = keep.houseId; hubSysLog_ = keep.syslog;
    SCHED_IST_MEMO = null;
  }
}

// The editors against the waiting flows: a cell a swap (either side of an exchange), a Request Off or a training…
function stSchedEditorsVsFlows_(out, P, t) {
  var BM = 'BM4060';
  var put = function (rowId, date, text) {
    t.store.sched_cells.grid.push(SCHED_HEADERS.sched_cells.map(function (h) {
      var c = stSchedCell_(BM, rowId, date, text);
      return c[h] === undefined ? '' : String(c[h]);
    }));
    schedBump_();
  };
  var textAt = function (rowId, date) { return (t.at(BM, rowId, date) || {}).text || ''; };
  var stateAt = function (rowId, date) { return (t.at(BM, rowId, date) || {}).state || ''; };
  var exchange = function (aDate, bDate, note) {
    var p = { house: BM, row_id: 'P:annroe', date: aDate, partner_house: BM, partner_row_id: 'P:benleft', partner_date: bDate };
    if (note) p.note = note;
    return t.act('schedulingSwapPropose', p, t.ANN);
  };

  // ---- both sides of a waiting exchange are held against an editor ----
  put('P:annroe', '2026-10-12', '7A-3P');
  put('P:benleft', '2026-10-13', '3P-11P');
  var ex = exchange('2026-10-12', '2026-10-13', 'family day');
  var exId = ex.status === 200 ? ex.data.flow_id : '';
  var onA = t.act('schedulingCellSave', { house: BM, row_id: 'P:annroe', date: '2026-10-12', value: '8A-4P', via: 'edit' }, t.RB);
  var onB = t.act('schedulingCellSave', { house: BM, row_id: 'P:benleft', date: '2026-10-13', via: 'delete' }, t.RB);
  var benItem = t.waitingFor(exId, t.BEN) || {};
  stAssert_(out, P + 'editors vs flows: an editor\'s write on either shift of a waiting exchange is refused with the ' +
                 'one sentence (naming whoever is on the other side) and nothing moves; the asker\'s note reaches the partner',
            ex.status === 200 && onA.status === 409 &&
            onA.message === 'This shift has a pending swap with Ben Left: answer it or cancel it first.' &&
            onB.status === 409 && onB.message === 'This shift has a pending swap with Ann Roe: answer it or cancel it first.' &&
            textAt('P:annroe', '2026-10-12') === '7A-3P' && textAt('P:benleft', '2026-10-13') === '3P-11P' &&
            t.flowOf(exId).state === 'waiting_staff' && t.flowOf(exId).note === 'family day' &&
            /"family day"/.test(benItem.body || ''),
            JSON.stringify([ex.status, ex.message, onA.message, onB.message, t.flowOf(exId).state, benItem.body]));

  // ---- an undo that would touch a held cell is refused (no cancel there) ----
  var add = t.act('schedulingCellSave', { house: BM, row_id: 'P:benleft', date: '2026-10-14', value: '7A-3P', via: 'add' }, t.RB);
  var rq = t.act('schedulingRequestOff', { house: BM, row_id: 'P:benleft', date: '2026-10-14' }, t.BEN);
  var undo = t.act('schedulingUndo', { house: BM }, t.RB);
  stAssert_(out, P + 'editors vs flows: an undo that would change a cell a Request Off waits on is refused with the same ' +
                 'sentence, and the cell stays',
            add.status === 200 && rq.status === 200 && undo.status === 409 &&
            undo.message === 'This shift has a pending Request Off: answer it or cancel it first.' &&
            textAt('P:benleft', '2026-10-14') === '7A-3P' && t.flowOf(rq.data.flow_id).state === 'waiting',
            JSON.stringify([add.status, rq.status, rq.message, undo.status, undo.message]));

  // ---- cancel_pending: the flow is cancelled in the same write, its items close, both sides are told ----
  t.clearSent();
  var cx = t.act('schedulingCellSave', { house: BM, row_id: 'P:benleft', date: '2026-10-13', value: '4P-12A', via: 'edit',
                                         cancel_pending: true }, t.RB);
  var fx = t.flowOf(exId);
  var told = t.itemsOf(function (i) { return i.flow_id === exId && i.box === 'inbox' && /^Swap cancelled — /.test(i.title); });
  var texts = t.sent().filter(function (s) { return s.situation === 'sched_swap_declined_manager'; })
    .map(function (s) { return s.person_key; }).sort().join();
  stAssert_(out, P + 'editors vs flows: "Cancel it and edit" — the exchange ends cancelled by the editor, its waiting ' +
                 'items close, the asker and the partner each get the declined words (a house manager\'s) and an ' +
                 'informative naming who changed the shift; then the edit lands and the other shift stays',
            cx.status === 200 && /The pending swap with Ann Roe was cancelled/.test(cx.data.said) &&
            fx.state === 'cancelled' && fx.closed_by === 'Regina Bowman' &&
            t.itemsOf(function (i) { return i.flow_id === exId && i.box === 'work' && i.state === 'waiting'; }).length === 0 &&
            told.length === 2 && told.every(function (i) {
              return i.body === 'Regina Bowman changed the shift, so the pending swap with Ann Roe was cancelled.';
            }) && told.map(function (i) { return i.to_uid; }).sort().join() === 'USR_AN,USR_BL' &&
            texts === 'annroe,benleft' && textAt('P:benleft', '2026-10-13') === '4P-12A' &&
            textAt('P:annroe', '2026-10-12') === '7A-3P' && stateAt('P:annroe', '2026-10-12') === 'scheduled',
            JSON.stringify([cx.status, cx.message || cx.data.said, fx.state, fx.closed_by, told.length, texts]));
  t.clearSent();
  var cr = t.act('schedulingCellSave', { house: BM, row_id: 'P:benleft', date: '2026-10-14', via: 'delete', cancel_pending: true }, t.RB);
  stAssert_(out, P + 'editors vs flows: cancelling a Request Off by an editor\'s delete texts the asker the decided ' +
                 'words and leaves nothing waiting',
            cr.status === 200 && t.flowOf(rq.data.flow_id).state === 'cancelled' && t.at(BM, 'P:benleft', '2026-10-14') === null &&
            t.sent().some(function (s) { return s.situation === 'sched_request_decided' && s.person_key === 'benleft'; }) &&
            t.itemsOf(function (i) { return i.flow_id === rq.data.flow_id && i.box === 'work' && i.state === 'waiting'; }).length === 0,
            JSON.stringify([cr.status, cr.message, t.flowOf(rq.data.flow_id).state]));

  // ---- the last seat: a shift changed underneath the exchange ends it, nothing moves ----
  put('P:annroe', '2026-10-15', '7A-3P');
  put('P:benleft', '2026-10-16', '3P-11P');
  var e2 = exchange('2026-10-15', '2026-10-16', '');
  var id2 = e2.status === 200 ? e2.data.flow_id : '';
  var seats = [t.answer(id2, t.BEN).status, t.answer(id2, t.RB).status];
  t.at(BM, 'P:benleft', '2026-10-16');
  schedLock_(function () {
    schedSetCell_(BM, 'P:benleft', '2026-10-16', { text: '4P-12A' }, 'edit', null, 'written in the book', '');
    return {};
  });
  var last = t.answer(id2, t.TY);
  var f2 = t.flowOf(id2);
  stAssert_(out, P + 'editors vs flows: a shift changed under a waiting exchange by another road is the completion\'s ' +
                 'last net — the director\'s yes ends it (the shift changed), both people are told, and no cell moves',
            e2.status === 200 && seats.join() === '200,200' && last.status === 200 && /could not finish/.test(last.data.said) &&
            f2.state === 'expired' && /A shift changed on the calendar/.test(f2.note) &&
            textAt('P:annroe', '2026-10-15') === '7A-3P' && stateAt('P:annroe', '2026-10-15') === 'scheduled' &&
            textAt('P:benleft', '2026-10-16') === '4P-12A' && t.at(BM, 'P:annroe', '2026-10-16') === null &&
            t.at(BM, 'P:benleft', '2026-10-15') === null &&
            t.itemsOf(function (i) { return i.flow_id === id2 && /^Swap could not finish/.test(i.title); }).length === 2,
            JSON.stringify([e2.status, e2.message, seats, last.status, last.message || last.data.said, f2.state, f2.note]));
}

