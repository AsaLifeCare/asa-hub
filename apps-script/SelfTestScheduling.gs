    var t1 = e1.status === 200 && e1.data.training ? e1.data.training.flow_id : '';
    var c1 = at(BM, 'P:niawest', '2026-10-24') || {};
    var f1 = flowOf(t1);
    var annB = act('schedulingBoard', {}, t.ANN).data;
    var rbB = act('schedulingBoard', {}, t.RB).data;
    var cellIn = function (b, house, rowId, iso) {
      var g = b.grids[house], r = g.rows.filter(function (x) { return x.row_id === rowId; })[0];
