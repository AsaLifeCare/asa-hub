# asa-hub-app environment: copy to app/.env (git-ignored) and fill the values there, never here.
# libpq DSN to asa-hub-db: host=asa-hub-db dbname=asa_hub user=asa_hub password=<secret>
HUB_DB_DSN=
# optional: the writer role's DSN (db/app-writer.sql); unset, every Locations write stays on Apps Script
HUB_DB_WRITE_DSN=
# the token the relay sends in X-Hub-Token; the same value goes into the relay's HUB_APP_TOKEN
HUB_APP_TOKEN=
# optional: the asatech account's OAuth client and refresh token, so Documents and the pack read Drive here
HUB_APP_GOOGLE_CLIENT_ID=
HUB_APP_GOOGLE_CLIENT_SECRET=
HUB_APP_GOOGLE_REFRESH_TOKEN=
# optional: seconds a book the mirror holds whole may trail Google (default 900)
HUB_APP_LAG_S=
